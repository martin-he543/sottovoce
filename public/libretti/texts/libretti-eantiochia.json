ung"],["EMMA","fuggo, volo a regioni più pure...","sung"],["EMMA","trovi in terra quel placido porto","sung"],["EMMA","ch'io nel cielo non fido trovar.","sung"],["EMMA","Questo voto d'un core già morto,","sung"],["EMMA","questo sol non è colpa formar.","sung"],["","(beve il veleno)","dir"]]},{"title":"Scena settima","description":"Adelia trattenuta dalle Damigelle e detta.","lines":[["ADELIA","Mi lasciate.","sung"],["DAMIGELLE","Oh! il passo arresta.","sung"],["EMMA","Chi vegg'io?","sung"],["ADELIA","Empia donna a me funesta,","sung"],["ADELIA","tu pur t'offri al guardo mio!","sung"],["ADELIA","Vieni, appressa, e gli occhi e il core","sung"],["ADELIA","pasci appien del mio dolore. ~","sung"],["ADELIA","Tutto, tutto mi togliesti...","sung"],["ADELIA","non mi puoi di più rapir.","sung"],["","(siede sul seggio)","dir"],["EMMA","(Ciel serbarmi ancor volesti","sung"],["EMMA","a quest'ultimo martir?)","sung"],["DAMIGELLE","Esci, deh!... la sua sventura","sung"],["DAMIGELLE","per pietà rispetta almeno.","sung"],["ADELIA","E la mia fors'è men dura?","sung"],["ADELIA","men di lei mi struggo e peno?","sung"],["EMMA","Più non reggo... io manco...","sung"],["DAMIGELLE","Oh! mira.","sung"],["","(commossa)","dir"],["ADELIA","Emma!...","sung"],["","(s'avvicina a lei)","dir"],["EMMA","Adelia! or vana è ogn'ira.","sung"],["EMMA","Fosti appieno vendicata...","sung"],["EMMA","pena estrema il ciel mi diè.","sung"],["ADELIA","Che mai festi sciagurata!","sung"],["DAMIGELLE","Qual pallor!","sung"],["EMMA","Di morte egli è.","sung"],["ADELIA","Ah! perdona a duolo estremo","sung"],["ADELIA","questi amari e crudi accenti;","sung"],["ADELIA","io non t'odio, io teco gemo,","sung"],["ADELIA","giungo i miei co' tuoi lamenti,","sung"],["ADELIA","infelici entrambe siamo...","sung"],["ADELIA","e tu forse più di me.","sung"],["ADELIA","Sorgi, sorgi, insiem piangiamo,","sung"],["ADELIA","se sperar più non si dée.","sung"],["EMMA","Sì, mesciamo i pianti nostri...","sung"],["EMMA","mai non fur più amari pianti,","sung"],["EMMA","la pietà che a me dimostri","sung"],["EMMA","già m'assolve a dio d'innanti;","sung"],["EMMA","odi l'ultima preghiera","sung"],["EMMA","ch'io morendo innalzo a te...","sung"],["EMMA","Ti consola, vivi... spera...","sung"],["EMMA","di tue pene avrai mercé.","sung"],["","(si scioglie da Adelia, e parte con passo malfermo)","dir"]]},{"title":"Scena ottava","description":"Adelia e Damigelle, indi Corrado.","lines":[["ADELIA","Odi ancora... mi fugge,","sung"],["ADELIA","si regge appena. Oh! la seguite.","sung"],["","(le damigelle partono)","dir"],["","(a Corrado che sopraggiunge)","dir"],["ADELIA","Accorri...","sung"],["ADELIA","Emma vid'io... Tremo per lei... lasciommi","sung"],["ADELIA","quasi morente.","sung"]]},{"title":"Scena ultima","description":"Damigelle che ritornano. La scena si empie di gente che accorre.","lines":[["CORI","Orribil vista... è vano","sung"],["CORI","ogni soccorso... Avvelenata ell'era ~","sung"],["CORI","morta è sul corpo d'Aladin trafitto.","sung"],["TUTTI","Oh sventura! oh delitto!","sung"],["ADELIA","Inorridita io sono.","sung"],["","(si abbandona fra le braccia di Corrado)","dir"],["CORRADO","Ciel mi serba la figlia... e a lei...","sung"],["TUTTI","Perdóno.","sung"]]}]}]}