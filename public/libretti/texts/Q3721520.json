{"id":"Q3721520","title":"Elena da Feltre","language":"Italian","form":"Dramma tragico in tre atti.","source":"librettidopera.it","source_url":"https://www.librettidopera.it/elenafeltre/elenafeltre.html","acts":[{"heading":"Atto primo","scenes":[{"title":"Scena prima","description":"Gabinetto negli appartamenti di Ubaldo.Ubaldo siede presso una tavola, immerso in cupa tristezza: lo accerchiano i suoi nobili Amici ed i Familiari della potente sua casa.","lines":[["CORO","Ti scuoti Ubaldo, e svelane","sung"],["CORO","i crudi affanni tuoi:","sung"],["CORO","dolce ti fia dividere","sung"],["CORO","l'ascoso duol con noi,","sung"],["CORO","dolce versar le lagrime","sung"],["CORO","in sen dell'amistà.","sung"],["","(piano fra loro)","dir"],["CORO","Muto egli resta, immobile!...","sung"],["CORO","Ogni conforto è vano:","sung"],["CORO","ahi! L'infelice è vittima","sung"],["CORO","del suo cordoglio arcano!","sung"],["CORO","Ahi! Volge a sera il misero","sung"],["CORO","nell'alba dell'età!","sung"]]},{"title":"Scena seconda","description":"Guido, e detti.","lines":[["GUIDO","Diletto amico!...","sung"],["","(scosso dalla voce di Guido, sorge e lo abbraccia)","dir"],["UBALDO","Qual cagion ti guida","sung"],["UBALDO","ne' lari miei?","sung"],["GUIDO","Svelarla","sung"],["GUIDO","a te soltanto io deggio.","sung"],["","(ad un cenno di Ubaldo il coro si allontana)","dir"],["GUIDO","Del tuo valor, de' prodi tuoi m'è d'uopo","sung"],["GUIDO","l'alto soccorso.","sung"],["UBALDO","Parla.","sung"],["GUIDO","È a te palese","sung"],["GUIDO","che il fero Boemondo a me destina","sung"],["GUIDO","dell'orgogliosa figlia","sung"],["GUIDO","il talamo superbo... Io lo detesto...","sung"],["GUIDO","Altra donna m'accese.","sung"],["UBALDO","E le promesse, o Guido, e la speranza","sung"],["UBALDO","che l'antica possanza","sung"],["UBALDO","risorga in te degli avi?","sung"],["GUIDO","Cede tutto ad amor.","sung"],["UBALDO","Tu dunque?...","sung"],["GUIDO","Io volo","sung"],["GUIDO","del signor di Comino entro il castello","sung"],["GUIDO","un asilo a cercar... Diman qui riedo...","sung"],["GUIDO","Accanto alla magion di lei che m'arde","sung"],["GUIDO","un tempio sorge, col favor notturno","sung"],["GUIDO","ivi la traggo, e sciolto","sung"],["GUIDO","il voto nuzial, fuggo repente","sung"],["GUIDO","questa città dolente.","sung"],["GUIDO","Pur sai che intorno delatori ascosi","sung"],["GUIDO","erran tuttora; ove i disegni miei","sung"],["GUIDO","discopra alcuno, assicurar mi déi","sung"],["GUIDO","tu con l'armi uno scampo.","sung"],["GUIDO","Me 'l prometti?","sung"],["UBALDO","Lo giuro. ~ E qual si noma","sung"],["UBALDO","colei che tua sarà dinanzi al cielo?","sung"],["GUIDO","Elena degli Uberti.","sung"],["","(come colpito da un fulmine)","dir"],["UBALDO","Elena!... (Io gelo!...) ~","sung"],["GUIDO","Che fu?... T'assale un tremito!","sung"],["GUIDO","Hai di pallor estremo","sung"],["GUIDO","tinte le gote!...","sung"],["UBALDO","Io?... Palpito","sung"],["UBALDO","per te... Per te sol tremo... ~","sung"],["UBALDO","Deh! Qual maligno genio,","sung"],["UBALDO","amico, a te consiglia?","sung"],["UBALDO","D'uom che fuggì al patibolo","sung"],["UBALDO","amar puoi tu la figlia?","sung"],["UBALDO","Puoi d'Eccelin la collera","sung"],["UBALDO","sul capo tuo chiamar?","sung"],["UBALDO","Ah! no: ti cangia...","sung"],["GUIDO","Ed Elena","sung"],["GUIDO","potrei dimenticar?","sung"],["GUIDO","Tu non sai qual dolce incanto,","sung"],["GUIDO","qual poter m'avvince a lei,","sung"],["GUIDO","e il destin de' giorni miei,","sung"],["GUIDO","è la vita, è il ciel per me.","sung"],["GUIDO","Io l'adoro: Iddio soltanto","sung"],["GUIDO","per amarla un cor mi diè.","sung"],["UBALDO","(Tanto avversa, orribil tanto","sung"],["UBALDO","la mia sorte io non credei...","sung"],["UBALDO","lei perduta, insiem con lei","sung"],["UBALDO","ogni speme il cor perdé...","sung"],["UBALDO","Sol per vivere nel pianto","sung"],["UBALDO","l'esistenza il ciel mi diè.)","sung"],["GUIDO","Per temer del tuo coraggio","sung"],["GUIDO","troppo, amico, io ti conosco.","sung"],["GUIDO","Quando in mar discese il raggio","sung"],["GUIDO","fia del giorno, e l'aer fosco,","sung"],["GUIDO","te domani, al fianco mio","sung"],["GUIDO","presso il tempio rivedrò?","sung"],["","(nella massima confusione)","dir"],["UBALDO","Sì...","sung"],["GUIDO","Un amplesso. ~ Un bacio. ~ Addio.","sung"],["UBALDO","(Che promisi!... Che farò?...)","sung"],["GUIDO","In te riposo, in te m'affido:","sung"],["GUIDO","sia l'amistade scudo all'amore.","sung"],["GUIDO","Di gioia immensa ho pieno il core...","sung"],["GUIDO","Ah! La dividi pu pur con me.","sung"],["UBALDO","Sì, la tua gioia con te divido...","sung"],["UBALDO","fia l'amistade scudo all'amore...","sung"],["UBALDO","(Più lacerato di questo core","sung"],["UBALDO","no, sulla terra un cor non v'è!)","sung"],["","(Guido parte. Ubaldo cade su una seggiola)","dir"],["","(dopo qualche momento di silenzio)","dir"],["UBALDO","La madre estinta, il genitor fuggiasco","sung"],["UBALDO","di tue repulse, ingrata,","sung"],["UBALDO","pretesti furo! Amavi...","sung"],["","(sorgendo agitatissimo)","dir"],["UBALDO","Ma non Ubaldo! ~ E renderò felice","sung"],["UBALDO","te col rivale, io stesso?","sung"],["UBALDO","No. ~ Pur... ~ Che mai decido?","sung"],["UBALDO","Il tutto sappia Boemondo... ~ Ah! Guido","sung"],["UBALDO","io perdo, e non ottengo","sung"],["UBALDO","la fatal donna!","sung"],["","(rimane taciturno colle braccia conserte, lo sguardo affisso nel suolo; quindi si riscuote, come colui che ha già preso una determinazione)","dir"],["UBALDO","Sì: rapirla... E fia","sung"],["UBALDO","che l'amistà, che la giurata fede","sung"],["UBALDO","sì vilmente io calpesti?...","sung"],["UBALDO","Cede tutto all'amor. Tu lo dicesti!","sung"],["","(entra nei suoi appartamenti)","dir"]]},{"title":"Scena terza","description":"Sala del palazzo di Sigifredo. ~ Porte laterali e verone in prospetto che risponde sul giardino.Elena.","lines":[["ELENA","Del tremendo Eccelin, di Boemondo","sung"],["ELENA","qui suo ministro, né di lui men crudo,","sung"],["ELENA","all'ire il padre s'involò!... Belluno","sung"],["ELENA","ricovero e difesa entro sue mura","sung"],["ELENA","al fuggente assicura. ~","sung"],["ELENA","Lieta son io, più lieta","sung"],["ELENA","il sol cadente mi vedrà domani!","sung"],["ELENA","Voti che amor formò, che benedisse","sung"],["ELENA","il consenso paterno,","sung"],["ELENA","benedirà domani anche l'eterno!","sung"],["ELENA","Ah! Del tenero amor mio","sung"],["ELENA","al trasporto appena io reggo...","sung"],["ELENA","Gl'inni ascolto, l'ara io veggo","sung"],["ELENA","ove sposa diverrò.","sung"],["ELENA","Sarò tua dinanzi a dio,","sung"],["ELENA","tua per sempre, o mio diletto...","sung"],["ELENA","si comprende in questo detto","sung"],["ELENA","quanta gioia il ciel creò!","sung"]]},{"title":"Scena quarta","description":"Gualtiero, e detta.","lines":[["","(avanzandosi dal verone)","dir"],["GUALTIERO","Elena?...","sung"],["ELENA","Ebben, Gualtiero?...","sung"],["ELENA","Sembri agitato!...","sung"],["GUALTIERO","È vero...","sung"],["GUALTIERO","Tutta l'alma ho commossa... Un peregrino,","sung"],["GUALTIERO","dalla romita via che al parco adduce","sung"],["GUALTIERO","inoltrava guardingo; a lui d'incontro","sung"],["GUALTIERO","io mossi... Ah! Chi poteva","sung"],["GUALTIERO","immaginar soltanto!...","sung"],["GUALTIERO","Egli mi segue... Vedi...","sung"]]},{"title":"Scena quinta","description":"Sigifredo, e detti.","lines":[["","(egli appena arrivato protende le braccia ad Elena, e getta il cappello che fa parte del suo arnese da pellegrino, e di cui l'ala rovesciata gli ombreggiava il volto. Gualtiero si ritira da una porta laterale)","dir"],["SIGIFREDO","Figlia...","sung"],["ELENA","Tu, padre!...","sung"],["SIGIFREDO","O figlia mia...","sung"],["ELENA","Qui riedi,","sung"],["ELENA","qui, dove a prezzo il capo tuo fu posto!","sung"],["SIGIFREDO","Vano il fuggir tornò: cadde Belluno,","sung"],["SIGIFREDO","cadde in potere anch'essa","sung"],["SIGIFREDO","del barbaro Eccelino,","sung"],["SIGIFREDO","all'odio ghibellino","sung"],["SIGIFREDO","co' miei seguaci un'ospital capanna","sung"],["SIGIFREDO","più dì m'ascose, ma drappel di sgherri","sung"],["SIGIFREDO","ne rintracciò...","sung"],["ELENA","Che ascolto!...","sung"],["SIGIFREDO","In questo arnese, dalla notte avvolto,","sung"],["SIGIFREDO","a me soltanto il fato","sung"],["SIGIFREDO","scampar concesse... Al fianco tuo ritorno,","sung"],["SIGIFREDO","che almen perir vogl'io","sung"],["SIGIFREDO","fra le tue braccia, o figlia...","sung"],["ELENA","Un calpestio","sung"],["ELENA","l'udito mi ferì!... T'ascondi...","sung"],["","(Sigifredo entra dal lato opposto a quello onde si ritirò Gualtiero)","dir"]]},{"title":"Scena sesta","description":"Gualtiero, quindi Ubaldo, e detta.","lines":[["","(comparendo sulla soglia)","dir"],["GUALTIERO","Ubaldo","sung"],["GUALTIERO","s'appressa.","sung"],["","(rientra)","dir"],["ELENA","Egli!... Che fia?...","sung"],["","(ad Ubaldo)","dir"],["ELENA","- Tu giungi ad ora","sung"],["ELENA","ben tarda!","sung"],["UBALDO","In tempo a possederti ancora","sung"],["UBALDO","io giungo. Vieni.","sung"],["ELENA","Ah! Dove?","sung"],["UBALDO","Ne' lari miei.","sung"],["ELENA","Che parli?...","sung"],["UBALDO","Donde non uscirai che mia consorte.","sung"],["ELENA","Ed oseresti?","sung"],["UBALDO","Opporti a' miei desiri,","sung"],["UBALDO","più, crudele, or non puoi...","sung"],["ELENA","Ciel! Tu deliri!","sung"],["UBALDO","Tremendo è il mio delirio!","sung"],["UBALDO","Ebbro d'amor son io!...","sung"],["UBALDO","Forza è seguirmi...","sung"],["ELENA","Scostati...","sung"],["ELENA","Cessa...","sung"],["UBALDO","Che indugi?","sung"],["ELENA","Oh dio!...","sung"],["ELENA","parla sommesso...","sung"],["","(guardando atterrita dalla parte ove si nascose il padre)","dir"],["UBALDO","Ascolta:","sung"],["UBALDO","schiera è de' miei raccolta","sung"],["UBALDO","quinci da presso...","sung"],["ELENA","(Io palpito!...)","sung"],["UBALDO","Se parlo un solo accento,","sung"],["UBALDO","accorrerà sollecita...","sung"],["ELENA","(M'opprime lo spavento!...)","sung"],["UBALDO","Che giova omai resistere?","sung"],["UBALDO","Chi può sottrarti a me?","sung"],["","(accostandosi ad Elena, come per trascinarla seco)","dir"]]},{"title":"Scena settima","description":"Sigifredo, e detti.","lines":[["SIGIFREDO","Io...","sung"],["","(egli ha deposte le spoglie di pellegrino e stringe nella destra il brando sguainato)","dir"],["UBALDO","Sigifredo!... ~ Un demone","sung"],["UBALDO","qui lo conduce!...","sung"],["ELENA","Ahimè!...","sung"],["SIGIFREDO","Un nume, un nume vindice","sung"],["SIGIFREDO","qui, traditor, mi guida.","sung"],["SIGIFREDO","L'onore in suon terribile","sung"],["SIGIFREDO","sangue domanda, e grida...","sung"],["SIGIFREDO","E nel tuo sangue, o perfido,","sung"],["SIGIFREDO","l'oltraggio io laverò.","sung"],["UBALDO","Tutto m'investe un fremito,","sung"],["UBALDO","corre all'acciar la mano;","sung"],["UBALDO","dell'ira temeraria,","sung"],["UBALDO","dovrei punirti, insano...","sung"],["UBALDO","ma togliere al carnefice","sung"],["UBALDO","i dritti suoi non vo'.","sung"],["ELENA","Ah! può scovrirti e perdere","sung"],["ELENA","un grido solo, un detto!...","sung"],["ELENA","Rammenta qual patibolo","sung"],["ELENA","hanno i crudeli eretto!...","sung"],["ELENA","Pensa che sopravvivere","sung"],["ELENA","la figlia a te non può.","sung"],["","(avviandosi dalla parte del giardino)","dir"],["SIGIFREDO","Snuda il ferro, ed esci meco,","sung"],["SIGIFREDO","o dirò, che un vil tu sei.","sung"],["UBALDO","Vile!","sung"],["","(supplichevole)","dir"],["ELENA","Ubaldo!","sung"],["UBALDO","Io vile!... Ah cieco","sung"],["UBALDO","son di sdegno!... Andiam...","sung"],["ELENA","No... Déi","sung"],["ELENA","prima uccidermi spietato...","sung"],["","(cadendo a piè di Ubaldo, e stringendogli le ginocchia)","dir"],["SIGIFREDO","Vieni...","sung"],["UBALDO","Resta...","sung"],["","(sciogliendosi da Elena)","dir"]]},{"title":"Scena ottava","description":"I seguaci di Ubaldo, poi Gualtiero, quindi un drappello di Armigeri e detti.","lines":[["","(accorrendo)","dir"],["SEGUACI","In tuo soccorso...","sung"],["SEGUACI","Qui costui!...","sung"],["","(nel massimo spavento)","dir"],["GUALTIERO","Nemico fato!...","sung"],["GUALTIERO","Stuol di sgherri ai gridi accorso,","sung"],["GUALTIERO","già si avanza...","sung"],["ELENA","Cielo! Aiuto...","sung"],["ELENA E GUALTIERO","Fuggi...","sung"],["","(spingendo Sigifredo verso i giardini)","dir"],["SIGIFREDO","È tardi.","sung"],["IL CAPO DEGLI ARMIGERI","Chi mai vedo!...","sung"],["UBALDO","(Ah, che feci!...)","sung"],["SIGIFREDO","(Son perduto.)","sung"],["","(getta la spada)","dir"],["ARMIGERI","Il ribelle Sigifredo!","sung"],["IL CAPO DEGLI ARMIGERI","Si circondi.","sung"],["ELENA","Ah!...","sung"],["","(avviticchiandosi al padre)","dir"],["ARMIGERI","T'allontana.","sung"],["ELENA","Non fia ver...","sung"],["GUALTIERO","Di lei pietà...","sung"],["ARMIGERI","Stolta, ed osi!...","sung"],["ELENA","Forza umana","sung"],["ELENA","separarci non potrà.","sung"],["ELENA","Tigri... Furie dell'averno,","sung"],["ELENA","quelle spade in me vibrate,","sung"],["ELENA","ma strapparmi al sen paterno,","sung"],["ELENA","fin ch'io vivo, non sperate. ~","sung"],["ELENA","Disfidiam la cruda sorte","sung"],["ELENA","ne colpisca insiem la morte,","sung"],["ELENA","ed insieme, o padre amato,","sung"],["ELENA","ne raccolga iddio nel ciel.","sung"],["SIGIFREDO","Figlia, addio... Per sempre addio...","sung"],["SIGIFREDO","al supplizio già m'appresto;","sung"],["SIGIFREDO","ma l'onor del sangue mio","sung"],["SIGIFREDO","sulla terra illeso io resto.","sung"],["SIGIFREDO","È confin di mie sciagure,","sung"],["SIGIFREDO","è trionfo a me la scure...","sung"],["SIGIFREDO","Tu conforta il cor piagato,","sung"],["SIGIFREDO","miglior padre avrai nel ciel.","sung"],["UBALDO","(Mi seguiro al giunger mio","sung"],["UBALDO","lutto e morte in queste mura...","sung"],["UBALDO","quale un empio in ira a Dio","sung"],["UBALDO","porto meco la sciagura?","sung"],["UBALDO","Ho nel cor l'atroce morso","sung"],["UBALDO","d'un terribile rimorso...","sung"],["UBALDO","Ah! L'amico è vendicato,","sung"],["UBALDO","maledetto fui dal ciel.)","sung"],["GUALTIERO","Trista notte!... Sventurato!...","sung"],["GUALTIERO","Ho di morte in petto il gel!","sung"],["ARMIGERI","T'apparecchia, scellerato,","sung"],["ARMIGERI","al supplizio più crudel.","sung"],["","Elena è divelta dal fianco del Padre, e mentre lo vede allontanarsi ferocemente trascinato, cade priva di sensi nelle braccia di Gualtiero.","dir"],["","Ubaldo si allontana desolato, la sua Gente lo segue.","dir"]]}]},{"heading":"Atto secondo","scenes":[{"title":"Scena prima","description":"Sala nel Palazzo municipale.Boemondo ed Ubaldo, seduti.","lines":[["UBALDO","Dunque?...","sung"],["BOEMONDO","Tutto è già fermo.","sung"],["BOEMONDO","Il silenzio profondo della notte","sung"],["BOEMONDO","di Sigifredo avvolse","sung"],["BOEMONDO","la prigionia: qual d'un estinto in petto,","sung"],["BOEMONDO","nel cor de' miei tace l'arcano...","sung"],["UBALDO","E tace","sung"],["UBALDO","nel cor de' miei pur anco.","sung"],["BOEMONDO","Entro la rete","sung"],["BOEMONDO","Guido cadrà... ~ Giunge colei.","sung"],["","(sorgono)","dir"]]},{"title":"Scena seconda","description":"Elena, e detti.","lines":[["ELENA","Me vedi,","sung"],["ELENA","nella polve... A' tuoi piedi... ~","sung"],["ELENA","svena, svena la figlia, o Boemondo,","sung"],["ELENA","e viva il padre.","sung"],["BOEMONDO","Al mio voler t'arrendi,","sung"],["BOEMONDO","ed ei vivrà.","sung"],["ELENA","Fia vero!... Imponi.","sung"],["BOEMONDO","Ubaldo,","sung"],["BOEMONDO","l'irrevocabil mio comando a lei","sung"],["BOEMONDO","parla.","sung"],["","(egli si muove per uscire. Elena fa qualche passo alla sua volta, in atto supplichevole e come per parlargli)","dir"],["BOEMONDO","Obbedir t'è forza...","sung"],["BOEMONDO","Ciecamente obbedir.","sung"],["","(parte)","dir"],["ELENA","Pronunzia dunque","sung"],["ELENA","la mia sentenza.","sung"],["UBALDO","M'odi.","sung"],["UBALDO","Onde salvar del padre tuo la vita,","sung"],["UBALDO","è mestier che ad Imberga","sung"],["UBALDO","offra Guido la man.","sung"],["ELENA","Prosegui.","sung"],["UBALDO","Ed egli","sung"],["UBALDO","mai no 'l farà, se pria","sung"],["UBALDO","fra voi non sorge una barriera eterna.","sung"],["ELENA","Quindi?","sung"],["UBALDO","Seguir tu déi","sung"],["UBALDO","altr'uomo all'ara...","sung"],["ELENA","Altr'uomo! E quel tu sei?","sung"],["UBALDO","È ver, son io, che avvampo, ardo, mi struggo","sung"],["UBALDO","d'amor per te...","sung"],["ELENA","D'amor!... Quel reo tuo core","sung"],["ELENA","non conosce, non sa che cosa è amore.","sung"],["UBALDO","Il mio sangue, i giorni miei","sung"],["UBALDO","per l'amico io speso avrei...","sung"],["UBALDO","ma saperlo a te consorte!","sung"],["UBALDO","Ma vederlo a te dappresso!...","sung"],["UBALDO","Quest'idea peggior di morte","sung"],["UBALDO","mi sospinse a nero eccesso!","sung"],["UBALDO","La mia fede ho violata,","sung"],["UBALDO","l'amistade ho calpestata...","sung"],["UBALDO","Ah! Misura, o sconoscente,","sung"],["UBALDO","l'amor mio, dal mio fallir!","sung"],["ELENA","Sorridendo il ciel m'offria","sung"],["ELENA","quanti beni un cor desia!...","sung"],["ELENA","Tutto perdo... Me infelice!","sung"],["ELENA","Tutto sparve ad un istante!...","sung"],["ELENA","Dunque infida e traditrice","sung"],["ELENA","me saper dovrà l'amante?...","sung"],["ELENA","Io sarò da lui spregiata,","sung"],["ELENA","maledetta, abominata!...","sung"],["ELENA","No, tant'oltre non consente","sung"],["ELENA","ad un'alma Iddio soffrir.","sung"],["UBALDO","Dunque non vuoi?","sung"],["ELENA","Discendere","sung"],["ELENA","vo' pria nel freddo avello.","sung"],["UBALDO","Altri però precederti","sung"],["UBALDO","deve, ostinata, in quello.","sung"],["UBALDO","Già nel segreto carcere","sung"],["UBALDO","s'inalza un palco... Trema!","sung"],["UBALDO","Quando dal maggior tempio","sung"],["UBALDO","udrai squillar l'estrema","sung"],["UBALDO","ora del giorno, i complici","sung"],["UBALDO","morran di Sigifredo!","sung"],["UBALDO","O cedi, o sul patibolo","sung"],["UBALDO","anch'ei...","sung"],["","(inorridita)","dir"],["ELENA","Non dirlo... ~ Io cedo. ~","sung"],["ELENA","Sarò tua sposa.","sung"],["UBALDO","(Oh giubilo!...)","sung"],["UBALDO","Fra poco, ed al cospetto","sung"],["UBALDO","di Boemondo, apprestati","sung"],["UBALDO","a confermare il detto","sung"],["UBALDO","con giuramento.","sung"],["ELENA","Basti...","sung"],["ELENA","Promisi... Giurerò.","sung"],["UBALDO","Il genitor salvasti...","sung"],["ELENA","Guido!... Perduto io l'ho!...","sung"],["UBALDO","Arderà più vivo ognora","sung"],["UBALDO","del mio cor l'immenso affetto...","sung"],["UBALDO","Come un idolo si adora,","sung"],["UBALDO","adorarti ognor prometto.","sung"],["UBALDO","Anche un barbaro destino","sung"],["UBALDO","lieto fia con te diviso...","sung"],["UBALDO","Mi parrà di gioia un riso","sung"],["UBALDO","fin la morte in braccio a te.","sung"],["ELENA","O perduta mia speranza,","sung"],["ELENA","fu dover l'abbandonarti,","sung"],["ELENA","non tacciarmi d'incostanza...","sung"],["ELENA","era figlia pria d'amarti. ~","sung"],["ELENA","È compito il mio destino...","sung"],["ELENA","già la morte in sen mi piomba...","sung"],["","(volgendosi ad Ubaldo, con disperazione)","dir"],["ELENA","non il talamo, la tomba","sung"],["ELENA","apprestar tu devi a me.","sung"],["","(partono)","dir"]]},{"title":"Scena terza","description":"Appartamenti di Boemondo.S'apre nel fondo un uscio segreto, dal quale s'inoltra Guido, preceduto da molti Uomini d'armi, che si allontanano per altra via.","lines":[["GUIDO","Che fia! Nella cittade","sung"],["GUIDO","ritorno appena, e come atteso al varco,","sung"],["GUIDO","questi di Boemondo","sung"],["GUIDO","guerrieri, o sgherri, a lui che favellarmi","sung"],["GUIDO","chiede bramoso, per quell'uscio arcano,","sung"],["GUIDO","m'han tratto! Il cor m'intesi","sung"],["GUIDO","palpitar qui giungendo...","sung"],["GUIDO","qual uom che pose entro temuto, orrendo","sung"],["GUIDO","carcere il piè! ~ Terribile sospetto!","sung"],["GUIDO","Penetrato egli avrebbe?... ~ Un crudo inganno","sung"],["GUIDO","forse mi conduceva in queste porte!...","sung"],["GUIDO","Forse m'attende qui vendetta e morte! ~","sung"],["GUIDO","Entro al mio sangue immergere","sung"],["GUIDO","non ardirà la mano.","sung"],["GUIDO","Pur che non può quell'empio,","sung"],["GUIDO","quel mostro disumano,","sung"],["GUIDO","di tradimento fabbro,","sung"],["GUIDO","capace d'ogni orror?","sung"],["GUIDO","Ma sia che vuol: del barbaro","sung"],["GUIDO","l'ira tremenda io sfido. ~","sung"],["GUIDO","Sospiro di quest'anima,","sung"],["GUIDO","spento cadrò, ma fido,","sung"],["GUIDO","col nome tuo sul labbro,","sung"],["GUIDO","col nome tuo nel cor!","sung"],["GUIDO","Vien Boemondo!","sung"]]},{"title":"Scena quarta","description":"Boemondo, e detto.","lines":[["BOEMONDO","Incauto!","sung"],["BOEMONDO","M'è noto il tuo disegno:","sung"],["BOEMONDO","pur desta in me l'ingiuria","sung"],["BOEMONDO","più sprezzo assai, che sdegno;","sung"],["BOEMONDO","né movo a te rimproverò","sung"],["BOEMONDO","d'un fallo già punito.","sung"],["GUIDO","Che!...","sung"],["BOEMONDO","Sconsigliato giovine!...","sung"],["GUIDO","Ebben?","sung"],["BOEMONDO","Tu sei tradito.","sung"],["GUIDO","Da te.","sung"],["BOEMONDO","No: dalla perfida","sung"],["BOEMONDO","che mancator ti rese.","sung"],["GUIDO","Cessa...","sung"],["BOEMONDO","Quel cor volubile...","sung"],["GUIDO","Taci...","sung"],["BOEMONDO","D'altr'uom s'accese.","sung"],["GUIDO","Calunnia vil!... Possibile","sung"],["GUIDO","non è cotanto eccesso.","sung"],["","(con fermezza)","dir"],["BOEMONDO","E testimone, e giudice","sung"],["BOEMONDO","sarai del ver tu stesso.","sung"],["GUIDO","Io!... Quando?","sung"],["BOEMONDO","In breve.","sung"],["GUIDO","(Oh smania!...)","sung"],["GUIDO","Odimi ancor...","sung"],["","(Boemondo gli accenna di tacere ed attendere: quindi rientra)","dir"],["GUIDO","Partì!...","sung"],["GUIDO","Dubbio crudele, orribile!...","sung"],["GUIDO","Menti!... ~ Ma pur?... ~ Menti!...","sung"],["GUIDO","No, tu non sei colpevole","sung"],["GUIDO","alma dell'alma mia...","sung"],["GUIDO","Ah! Se tradisce un angelo","sung"],["GUIDO","ove trovar più fé!","sung"],["GUIDO","O ciel, se deggio apprendere","sung"],["GUIDO","infedeltà sì ria,","sung"],["GUIDO","ciel, ti domando un fulmine...","sung"],["GUIDO","meglio è morir per me.","sung"],["","(parte)","dir"]]},{"title":"Scena quinta","description":"Magnifica sala, pomposamente apparecchiata, per festeggiarvi la conquista di Belluno.Dame e Cavalieri della corte di Boemondo: Ubaldo è fra loro.","lines":[["TUTTI","Già Belluno al vento spiega","sung"],["TUTTI","la bandiera d'Eccelino!","sung"],["TUTTI","Pugni invan lombarda Lega","sung"],["TUTTI","contro il ferro ghibellino.","sung"],["TUTTI","Guelfi, l'itala contrada","sung"],["TUTTI","sgombra alfin di voi sarà:","sung"],["TUTTI","all'impero della spada","sung"],["TUTTI","ogni forza cederà.","sung"]]},{"title":"Scena sesta","description":"Boemondo conduce Imberga, Guido li segue: i suddetti. Al giungere di Boemondo tutti s'inchinano.","lines":[["","(a parte)","dir"],["BOEMONDO","Di tanta gioia, cavalieri,","sung"],["BOEMONDO","vien la figlia con me.","sung"],["","(le dame accerchiano Imberga: i cavalieri fan corona a Boemondo)","dir"],["BOEMONDO","Per voi di Feltre","sung"],["BOEMONDO","sappian le genti, che l'età malvagia","sung"],["BOEMONDO","lo astringe al sangue, ma non è clemenza","sung"],["BOEMONDO","virtù straniera a Boemondo, e ch'egli","sung"],["BOEMONDO","delle paterne colpe","sung"],["BOEMONDO","l'onta e la pena ricader non lascia","sung"],["BOEMONDO","sull'innocente figlio.","sung"],["BOEMONDO","L'esempio giovi a contestare il detto:","sung"],["BOEMONDO","mirate or voi qual donna entro il mio tetto","sung"],["BOEMONDO","accolsi.","sung"]]},{"title":"Scena settima","description":"S'apre una porta, donde comparisce Elena: i suddetti.","lines":[["GUIDO","(Elena!...)","sung"],["ELENA","(Guido!...)","sung"],["DAME","Costei!...","sung"],["CAVALIERI","Fia ver!... Del tuo mortal nemico","sung"],["CAVALIERI","la figlia!...","sung"],["BOEMONDO","Sì, di lui","sung"],["BOEMONDO","che rovesciar del mio signore in Feltre","sung"],["BOEMONDO","tentava il seggio: egli campò fuggendo...","sung"],["BOEMONDO","Del ribelle si taccia.","sung"],["ELENA","(Oh doppio core!)","sung"],["BOEMONDO","Priva del genitore,","sung"],["BOEMONDO","a lei manca un sostegno;","sung"],["BOEMONDO","lo avrà. Possente cavalier ne vive","sung"],["BOEMONDO","amante riamato... ~ Or tu lo noma,","sung"],["BOEMONDO","e sciogli il giuramento,","sung"],["BOEMONDO","che il rito nuzial precede ognora.","sung"],["ELENA","(Ahi! Dura terra, e non ti schiudi ancora?","sung"],["ELENA","Non trovo il detto!... Fatal momento!...)","sung"],["GUIDO","(Ho l'alma incerta!)","sung"],["UBALDO","(Il cor mi trema!...)","sung"],["IMBERGA E BOEMONDO","(Io già ti provo, io già ti sento","sung"],["IMBERGA E BOEMONDO","della vendetta gioia suprema!)","sung"],["ELENA","(Parlami al core voce paterna,","sung"],["ELENA","che sei pe' figli voce di dio...","sung"],["ELENA","dammi costanza bontade eterna,","sung"],["ELENA","poni l'accento sul labbro mio...","sung"],["ELENA","Ogni altro affetto mi taccia in cor...","sung"],["ELENA","Muoia la figlia pe 'l genitor.)","sung"],["GUIDO E UBALDO","(Un punto solo, un solo accento","sung"],["GUIDO E UBALDO","può trista, o lieta farmi la sorte!...","sung"],["GUIDO E UBALDO","Palpito, gemo, spero, e pavento,","sung"],["GUIDO E UBALDO","qual non sospeso fra vita e morte! ~","sung"],["GUIDO E UBALDO","Di tema agghiaccio, ardo d'amor...","sung"],["GUIDO E UBALDO","a tanto assalto non regge un cor.)","sung"],["","(piano ad Elena, rimasta sempre accanto ad essi)","dir"],["IMBERGA E BOEMONDO","(Figlia crudele, se indugi ancor,","sung"],["IMBERGA E BOEMONDO","la tomba schiudi al genitor!)","sung"],["","(sommessamente fra loro)","dir"],["DAME E CAVALIERI","(Guido è turbato! ~ Ubaldo ancor! ~","sung"],["DAME E CAVALIERI","Colei si tinse d'atro pallor!)","sung"],["BOEMONDO","Svela pur gli affetti tuoi:","sung"],["BOEMONDO","troppo, o donna, omai tacesti.","sung"],["","(con mistero)","dir"],["BOEMONDO","Qui d'alcun temer non puoi:","sung"],["BOEMONDO","io qui sono, io: m'intendesti?","sung"],["","(è ancora esitante; ma ella vede balenare nel guardo di Boemondo una tremenda minaccia, quindi raccogliendo tutta la sua costanza, dice le seguenti parole, come persona già presso a morire)","dir"],["ELENA","Amo... Ubaldo... e giuro a lui...","sung"],["ELENA","fé... di sposa...","sung"],["","(qual uomo che smarrisce la ragione)","dir"],["GUIDO","Ho il vero udito!...","sung"],["GUIDO","Tu giurasti?… Ed è costui?... ~","sung"],["GUIDO","Sì vilmente io son tradito!...","sung"],["GUIDO","Empia... Infida... ~ Oh! Quale accento","sung"],["GUIDO","rampognarti appien potria?","sung"],["ELENA","(Ah! Terribile cimento!...)","sung"],["GUIDO","Va'... Non merti l'ira mia...","sung"],["GUIDO","Ti dispregio.","sung"],["","(ad Imberga)","dir"],["GUIDO","- Un forsennato","sung"],["GUIDO","chieder osa il tuo perdono...","sung"],["GUIDO","Ah! Dimentica il passato","sung"],["GUIDO","e tuo sposo, Imberga, io sono... ~","sung"],["GUIDO","tu però scontar dovrai","sung"],["GUIDO","col tuo sangue, o traditor...","sung"],["","(si avventa contro Ubaldo, con la spada sguainata)","dir"],["UBALDO","Sciagurato!...","sung"],["ELENA","Ciel!...","sung"],["IMBERGA, BOEMONDO E CORO","Che fai!...","sung"],["","(lo disarmano)","dir"],["GUIDO","Ah!... Son ebbro di furor...","sung"],["GUIDO","Un demone presieda,","sung"],["GUIDO","spergiuri, al vostro imene...","sung"],["GUIDO","A voi non si conceda","sung"],["GUIDO","un'ombra mai di bene...","sung"],["GUIDO","Del talamo esecrato","sung"],["GUIDO","vegli il rimorso al lato...","sung"],["GUIDO","Vi renda il giusto cielo","sung"],["GUIDO","miseri più di me.","sung"],["ELENA","(Non v'ha supplizio eguale!...","sung"],["ELENA","Non v'ha più rio martoro!...","sung"],["ELENA","Ogni suo detto è strale!","sung"],["ELENA","Ad ogni istante io moro!)","sung"],["","(osservando la gioia che traluce negli occhi di Boemondo)","dir"],["ELENA","(È gioia intanto all'empio","sung"],["ELENA","di questo cor lo scempio!...","sung"],["ELENA","la tua giustizia, o cielo,","sung"],["ELENA","non porge aita a me?)","sung"],["","(a Guido)","dir"],["UBALDO","D'Elena in sen m'ardea","sung"],["UBALDO","il più cocente amore...","sung"],["UBALDO","squarciarmelo potea,","sung"],["UBALDO","ma non cangiarmi il core. ~","sung"],["UBALDO","Invan tua rabbia cieca","sung"],["UBALDO","al mio legame impreca...","sung"],["UBALDO","Sarà la terra un cielo,","sung"],["UBALDO","d'accanto a lei, per me!","sung"],["IMBERGA E BOEMONDO","(Perfida, è questo un saggio","sung"],["IMBERGA E BOEMONDO","del tuo castigo appena:","sung"],["IMBERGA E BOEMONDO","tremendo fu l'oltraggio,","sung"],["IMBERGA E BOEMONDO","sarà maggior la pena.","sung"],["IMBERGA E BOEMONDO","Strazio crudel t'aspetta,","sung"],["IMBERGA E BOEMONDO","e tanta e tal vendetta,","sung"],["IMBERGA E BOEMONDO","che della morte il gelo","sung"],["IMBERGA E BOEMONDO","men crudo fia per te!)","sung"],["CORO","L'ira che t'arde in petto","sung"],["CORO","spegni, o nascondi, insano.","sung"],["CORO","A più sublime oggetto","sung"],["CORO","porger tu déi la mano...","sung"],["CORO","Non mai sì basso amore","sung"],["CORO","dovea macchiarti il core...","sung"],["CORO","Lo covra eterno velo;","sung"],["CORO","se puoi, lo nega a te.","sung"],["","Guido si allontana nel massimo furore; tutti lo seguono, tranne Ubaldo, ed Elena che disperatamente si abbandona su una seggiola.","dir"]]}]},{"heading":"Atto terzo","scenes":[{"title":"Scena prima","description":"Galleria adorna di ritratti, nel palazzo di Sigifredo.Elena prostrata innanzi all'effigie di sua madre.","lines":[["ELENA","Madre, che in ciel sei del bel numer'una,","sung"],["ELENA","e in lui t'affisi che non cape in mente","sung"],["ELENA","di noi bassi mortali, ah! tu m'impetra","sung"],["ELENA","il fin di questa mia","sung"],["ELENA","vita non già, ma prolungata morte.","sung"],["ELENA","Troppo acerba è la prova, ed io mal reggo","sung"],["ELENA","debole, e sola... Giunge alcun... ~ Traveggo!...","sung"]]},{"title":"Scena seconda","description":"Guido, e detta.","lines":[["ELENA","Tu qui, mentre s'appresta","sung"],["ELENA","delle tue nozze il rito","sung"],["ELENA","nel vicin tempio?","sung"],["GUIDO","Sì: pria che m'annodi","sung"],["GUIDO","la catena fatal, che trascinarmi","sung"],["GUIDO","deve alla tomba, io cedo al prepotente","sung"],["GUIDO","desio di favellarti.","sung"],["GUIDO","Tutto, per accusarti,","sung"],["GUIDO","tutto s'unisce... Dal mio cor soltanto","sung"],["GUIDO","sorge un ultimo grido","sung"],["GUIDO","in tua difesa.","sung"],["ELENA","O Guido!...","sung"],["GUIDO","Colà, di Boemondo","sung"],["GUIDO","nella temuta soglia, orride voci","sung"],["GUIDO","tu proferisti! Ma dettate furo","sung"],["GUIDO","dall'alma? O forse un tradimento infame...","sung"],["GUIDO","il terror d'una pena","sung"],["GUIDO","le strappò dal tuo labbro?","sung"],["ELENA","(Il cor ferito","sung"],["ELENA","con dura mano egli mi tocca!...)","sung"],["GUIDO","Il vero","sung"],["GUIDO","svelar qui puoi, soli qui siam. Favella;","sung"],["GUIDO","ma pensa che decidi","sung"],["GUIDO","la mia sorte, e la tua!","sung"],["ELENA","(M'investe un gelo!...)","sung"],["GUIDO","Pensa, che aprir mi déi l'inferno, o il cielo!","sung"],["GUIDO","Ardon già le sacre faci...","sung"],["GUIDO","Già di fiori è sparso il tempio...","sung"],["GUIDO","Io sol manco...","sung"],["ELENA","Taci, ah! Taci...","sung"],["ELENA","(gelosia tremendo scempio","sung"],["ELENA","fa di me!...)","sung"],["GUIDO","Se più non m'ami,","sung"],["GUIDO","sol dall'odio consigliato,","sung"],["GUIDO","volo a stringere i legami","sung"],["GUIDO","d'un imene sciagurato...","sung"],["GUIDO","E ti lascio al tuo rimorso,","sung"],["GUIDO","t'abbandono al tuo rossor.","sung"],["ELENA","(Bever deggio a sorso a sorso","sung"],["ELENA","questo nappo di dolor!)","sung"],["GUIDO","Ma se dirmi ancor tu puoi:","sung"],["GUIDO","t'amo, e fida a te son io:","sung"],["GUIDO","qui m'atterro a' piedi tuoi...","sung"],["ELENA","(Madre, aita... O mi vedrai","sung"],["ELENA","vinta alfine in tanta guerra...)","sung"],["GUIDO","Ti discolpa, e mia sarai...","sung"],["GUIDO","e vivrem beati in terra,","sung"],["GUIDO","l'un dell'altro sempre accanto...","sung"],["GUIDO","in un'estasi d'amor!","sung"],["ELENA","(Dio, lo vedi... A tale incanto","sung"],["ELENA","non resiste umano cor!)","sung"],["GUIDO","Parla... Ah! Parla, ed or ti guido,","sung"],["GUIDO","or mia speme, a piè dell'ara.","sung"],["ELENA","(Ei trionfa!...) Sappi, Guido,","sung"],["ELENA","ch'io giammai...","sung"],["","(la campana del maggior tempio suona l'ultima ora del giorno: Elena è presa da tremito convulso)","dir"],["GUIDO","Finisci, o cara...","sung"],["","(con l'accento della disperazione)","dir"],["ELENA","Ch'io giammai per te non arsi,","sung"],["ELENA","che d'Ubaldo è l'alma mia,","sung"],["ELENA","che fra noi barriera alzarsi","sung"],["ELENA","deve eterna...","sung"],["GUIDO","Eterna? Il sia.","sung"],["GUIDO","Corro al tempio, ed ivi, ingrata,","sung"],["GUIDO","nuovi giuri scioglierò...","sung"],["GUIDO","Questa man da te spregiata","sung"],["GUIDO","offro ad altra... E poi... morrò!","sung"],["GUIDO","Ah! tradisti d'ogni amore","sung"],["GUIDO","il più fervido, il più santo...","sung"],["GUIDO","lacerasti, o cruda, un core","sung"],["GUIDO","che vivea per te soltanto...","sung"],["GUIDO","Ahi! Pensiero non intende","sung"],["GUIDO","le mie smanie atroci, orrende...","sung"],["GUIDO","il dolor che fai provarmi","sung"],["GUIDO","perdonarti iddio sol può.","sung"],["ELENA","Vanne all'ara, e benedica","sung"],["ELENA","i tuoi voti un dio d'amore...","sung"],["ELENA","Abbia pur la mia nemica","sung"],["ELENA","la tua destra, ed il tuo core...","sung"],["ELENA","Una stilla del tuo pianto","sung"],["ELENA","sia concessa a me soltanto...","sung"],["ELENA","Ah! ne aspergi i freddi marmi","sung"],["ELENA","ove in breve dormirò.","sung"],["","(Guido parte disperato: Elena si ritira)","dir"]]},{"title":"Scena terza","description":"Appartamenti di Ubaldo, come all'atto I.Ubaldo.","lines":[["","(egli si avanza a passi rapidi, incerti, vacillanti: è coperto di pallore, le sue membra sono tremanti, inorriditi gli sguardi)","dir"],["UBALDO","Oh inaudita perfidia! Oh sanguinoso","sung"],["UBALDO","orribil tradimento!...","sung"],["UBALDO","Nella profonda sotterranea volta,","sung"],["UBALDO","in cui fu tratto Sigifredo, io mossi,","sung"],["UBALDO","onde affrettar l'istante","sung"],["UBALDO","che i lacci suoi scioglier dovea... Ma quale,","sung"],["UBALDO","ahi! qual s'offerse a me vista ferale!...","sung"],["UBALDO","Al chiarore di lugubri tede","sung"],["UBALDO","vidi un palco di sangue bagnato!...","sung"],["UBALDO","E balzar del carnefice al piede","sung"],["UBALDO","il suo capo dal busto troncato!...","sung"],["UBALDO","Quella cruda, terribile scena","sung"],["UBALDO","ho presente al pensiero tuttor!","sung"],["UBALDO","Ed un gel mi ricerca ogni vena!...","sung"],["UBALDO","I capelli mi drizza l'orror!","sung"],["","(si getta a sedere. Un momento di silenzio)","dir"],["UBALDO","Quando fia noto l'orrido inganno","sung"],["UBALDO","qual della figlia sarà l'affanno!...","sung"],["","(sorgendo)","dir"],["UBALDO","Ahimè! Che prezzo della sua mano","sung"],["UBALDO","era la vita del genitore!","sung"],["UBALDO","Dunque io la perdo!... Ho dunque invano","sung"],["UBALDO","di grave colpa macchiato il core!...","sung"],["UBALDO","Or che mi resta? ~ Che? Vendicarmi.","sung"],["UBALDO","Olà?","sung"]]},{"title":"Scena quarta","description":"Ubaldo e la sua gente.","lines":[["UBALDO","Miei prodi, sorgete all'armi...","sung"],["UBALDO","lo sdegno guelfo che in sen vi cova,","sung"],["UBALDO","sbocchi a vendetta di molte offese... ~","sung"],["UBALDO","Elena ancor veder mi giova...","sung"],["UBALDO","ma s'ella nega... Ma s'ella apprese...","sung"],["UBALDO","o Boemondo, dell'empio eccesso","sung"],["UBALDO","ragion col ferro ti chiederò.","sung"],["CORO","L'ardir sopito, l'odio represso","sung"],["CORO","un sol tuo grido in noi destò.","sung"],["UBALDO","Se deggio perdere l'amato oggetto,","sung"],["UBALDO","la vita un peso divien per me;","sung"],["UBALDO","siccome al reprobo, al maledetto","sung"],["UBALDO","che la speranza del ciel perdé. ~","sung"],["UBALDO","Ma trema infame, ho brando e core...","sung"],["UBALDO","fiumi di sangue scorrer farò...","sung"],["UBALDO","Giuro commettere qualunque orrore...","sung"],["UBALDO","più scellerato di te sarò.","sung"],["CORO","Giunse il momento vendicatore!...","sung"],["CORO","e cielo e terra colui stancò.","sung"],["","(partono)","dir"]]},{"title":"Scena quinta","description":"Stanza di Elena: due porte laterali, ed in fondo gran verone aperto da cui scorgesi la cupola della cattedrale: è notte; un doppiere arde su una tavola.Elena pallida come la morte, e giacente sopra una seggiola. Gualtiero le sta mestamente dappresso.","lines":[["","(sorge agitatissima: il suo piede è tremulo, fioca la sua voce)","dir"],["ELENA","Condurre Ubaldo in libertà dovea","sung"],["ELENA","fra queste braccia il padre...","sung"],["ELENA","della promessa già trascorsa è l'ora,","sung"],["ELENA","ma pur... la sua dimora","sung"],["ELENA","gelar mi fa!","sung"],["GUALTIERO","Pavento anch'io...","sung"],["ELENA","Deh! Vanne","sung"],["ELENA","al carcere paterno,","sung"],["ELENA","e la cagion del fero","sung"],["ELENA","indugio chiedi.","sung"],["GUALTIERO","Oh cielo!... E posso, e deggio,","sung"],["GUALTIERO","nello stato crudele in cui ti veggio,","sung"],["GUALTIERO","lasciarti?...","sung"],["ELENA","Sia preghiera, o sia comando,","sung"],["ELENA","va' non tardar... Se resti, l'incertezza","sung"],["ELENA","m'ucciderà.","sung"],["","(Gualtiero parte: ella rimane come assorta in letargo. Tutto ad un tratto un'improvvisa luce si diffonde nella stanza)","dir"],["ELENA","Che fia!...","sung"],["ELENA","mi balza il core!...","sung"],["","(accorre vacillando al verone)","dir"],["ELENA","Oh vista!...","sung"],["ELENA","Il nuzial corteggio!... E Guido... Ah! Guido","sung"],["ELENA","presso la sua!... ~ Non posso,","sung"],["ELENA","non posso dirlo. Ahimè!... Giungono al tempio!...","sung"],["ELENA","Varcan la soglia!... ~ Almen, deh! rispettate","sung"],["ELENA","questi d'un infelice","sung"],["ELENA","momenti estremi... ~ Ah! Già dagli occhi miei","sung"],["ELENA","spàrvero!... Morte, e così lenta sei?","sung"],["","(intanto s'ode lo squillo delle campane suonanti a festa, ed il seguente)","dir"],["CORO","O tu che i mondi innumeri","sung"],["CORO","d'un cenno e festi e reggi,","sung"],["CORO","tu che dettasti agli uomini","sung"],["CORO","d'amor le sante leggi,","sung"],["CORO","volgi sull'ara pronuba","sung"],["CORO","un guardo di favor.","sung"],["CORO","E stretti in sacro vincolo","sung"],["CORO","fa' di due cori un cor.","sung"],["ELENA","Tace la squilla!... Cessano","sung"],["ELENA","i cantici devoti!... ~","sung"],["ELENA","Tristo, fatal silenzio!...","sung"],["ELENA","Egli... or... pronunzia i voti!... ~","sung"],["ELENA","Fu detto il sì terribile,","sung"],["ELENA","fu detto, il cor l'udì!","sung"],["","(nel delirio della gelosia fa qualche passo verso il verone e protende le mani, come in atto di maledire, ma pentita immantinente, cade in ginocchio, ed alza al cielo i lumi irrigati di lacrime)","dir"],["ELENA","Per questo orrendo strazio","sung"],["ELENA","che mi conduce a morte...","sung"],["ELENA","di lui, di lui propizia,","sung"],["ELENA","rendi, signor la sorte...","sung"],["ELENA","Guido non è colpevole...","sung"],["ELENA","un empio lo tradì!...","sung"],["ELENA","Chi giunge?","sung"],["","(levandosi a stento)","dir"],["ELENA","Ubaldo... Oh palpito","sung"],["ELENA","mortale!...","sung"]]},{"title":"Scena sesta","description":"Ubaldo con Séguito, e detta.","lines":[["ELENA","Il genitore","sung"],["ELENA","ov'è? Rispondi...","sung"],["UBALDO","Calmati...","sung"],["UBALDO","Udrai... Ma qual pallore!...","sung"],["UBALDO","Qual angoscioso anelito!...","sung"],["UBALDO","Donna! Tu manchi!... Oh dio!","sung"],["UBALDO","S'aiti...","sung"],["ELENA","No... Scostatevi...","sung"],["ELENA","Il padre... il padre mio?...","sung"],["","(odesi il rimbombo di musica giuliva)","dir"],["ELENA","Suonan le vie di giubilo!...","sung"],["UBALDO E CORO","Ah! Mal ti regge il piede!...","sung"],["ELENA","Guidan gli sposi... al… talamo!...","sung"],["","(con smania sempre crescente)","dir"],["ELENA","E il servo ancor non riede!...","sung"],["ELENA","Padre... deh! Padre... Affrettati...","sung"],["ELENA","Se indugi troverai","sung"],["ELENA","spenta la figlia...","sung"]]},{"title":"Scena ultima","description":"Gualtiero e detti.","lines":[["GUALTIERO","Oh misera!","sung"],["GUALTIERO","Più genitor non hai...","sung"],["GUALTIERO","Mira di lui che avanza...","sung"],["","(le porge la sciarpa di Sigifredo insanguinata)","dir"],["GUALTIERO","la scure lo colpì.","sung"],["ELENA","La... scure!... ed... io!...","sung"],["CORO","Costanza...","sung"],["UBALDO","Elena!...","sung"],["","(ella si accosta la sciarpa alle labbra, ma presa da sincope mortale piomba al suolo)","dir"],["GUALTIERO E CORO","Oh ciel!...","sung"],["UBALDO","Morì!...","sung"],["","(cacciandosi disperatamente le mani fra i capelli)","dir"],["","(Gualtiero, soccorso dalla gente di Ubaldo, rialza Elena, e l'adagia su una seggiola, ~ breve silenzio. ~ Elena riapre languidamente gli occhi, che restano affissi al cielo, qual di persona rapita da visione celeste)","dir"],["ELENA","No, non è spento il padre,","sung"],["ELENA","egli lassù m'attende...","sung"],["ELENA","ecco la man mi stende... ~","sung"],["ELENA","io corro... io volo a te...","sung"],["ELENA","nell'estasi beata...","sung"],["ELENA","del tuo paterno amplesso,","sung"],["ELENA","il cielo, il cielo istesso...","sung"],["ELENA","più bello... fia... per me!","sung"],["","(spira)","dir"],["","(in ginocchio presso l'estinta)","dir"],["UBALDO","Tutta la vita... in lagrime...","sung"],["UBALDO","sul cener tuo... vivrò...","sung"],["GUALTIERO E CORO","Dal ciel mancava un angelo...","sung"],["GUALTIERO E CORO","iddio lo richiamò.","sung"]]}]}]}