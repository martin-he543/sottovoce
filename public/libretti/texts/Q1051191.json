"]]},{"title":"Scena quarta","description":"Detti, Tarabotto.","lines":[["","(uscendo)","dir"],["TARABOTTO","Chi chiama?","sung"],["","(accennandogli Bertrando)","dir"],["ORMONDO","Il Duca tuo signor quest'è che vedi.","sung"],["TARABOTTO","Che fortuna! M'umilio!...","sung"],["BERTRANDO","Sapresti tu indicarmi","sung"],["BERTRANDO","ove soggiorna un certo Tarabotto","sung"],["BERTRANDO","capo de' minatori?","sung"],["TARABOTTO","Eccolo ai suoi comandi.","sung"],["TARABOTTO","La sua picciola casa è quella là!","sung"],["TARABOTTO","Ivi con Nisa sua cara nipote","sung"],["TARABOTTO","vive poveramente,","sung"],["TARABOTTO","ma sempre allegramente.","sung"],["BERTRANDO","Aver m'è d'uopo","sung"],["BERTRANDO","da te gran lumi. Seguimi","sung"],["BERTRANDO","in quelle rocce. Ormondo tu frattanto,","sung"],["","(Ormondo s'inchina e parte)","dir"],["BERTRANDO","e tu Batone eseguirete quanto","sung"],["BERTRANDO","io v'imposi di già.","sung"],["","(s'avvia alla cavità)","dir"],["TARABOTTO","(Batone e Ormondo! Oh benvenuti qua.)","sung"],["","(entra col Duca nelle cavità, seguiti dai soldati)","dir"]]},{"title":"Scena quinta","description":"Batone, indi Isabella.","lines":[["BATONE","Prima d'andar a farmi squinternare","sung"],["BATONE","fra quelle catapecchie","sung"],["BATONE","vorrei bere un pochetto. Ho proprio sete.","sung"],["BATONE","Disse quell'uom che in casa ha una nipote","sung"],["BATONE","che ha nome Nisa. Chiamerò costei.","sung"],["","(chiamando alla casa)","dir"],["BATONE","Oh Nisa!...","sung"],["ISABELLA","Chi mi vuole?... ah!...","sung"],["","(per iscappare. Egli glielo impedisce, ed ella si nasconde il viso)","dir"],["BATONE","Cos'è stato?","sung"],["BATONE","Un uom vi fa paura?","sung"],["ISABELLA","(Qui Batone!)","sung"],["BATONE","Io volea bere un po' d'acqua...","sung"],["ISABELLA","Vengo.","sung"],["","(per andare, sempre senza voltarsi, ma egli la trattiene)","dir"],["BATONE","Ohibò che vedere io voglio in prima","sung"],["BATONE","il vostro bel babb