{"id":"libretti-auro_ric","title":"L'Aurora Ingannata","composer":"Girolamo GIACOBBI","language":"Italian","form":"Favoletta in musica","source":"librettidopera.it","source_url":"https://www.librettidopera.it/auro_ric/auro_ric.html","acts":[{"heading":"Intermedio primo","scenes":[{"title":"Scena prima","description":"Aurora, Venere.","lines":[["AURORA","Cefalo, dove sei, garzon crudele?","sung"],["AURORA","O contraria mia sorte!","sung"],["AURORA","Là 've non giunge il piè risuonan forte","sung"],["AURORA","i miei tronchi sospiri,","sung"],["AURORA","le giuste mie querele,","sung"],["AURORA","e pur a' miei martiri,","sung"],["AURORA","fero già non rispondi.","sung"],["AURORA","Ohimè, dove t'ascondi?","sung"],["AURORA","Tu d'Amor genitrice,","sung"],["AURORA","che col bel viso adorno,","sung"],["AURORA","precorri il novo giorno,","sung"],["AURORA","pietosissima ascolta,","sung"],["AURORA","chi per soverchio amore","sung"],["AURORA","vive in dolore.","sung"],["VENERE","Scopri, amante infelice,","sung"],["VENERE","nel profondo del cor tua pena involta:","sung"],["VENERE","che poc'arde o non ama","sung"],["VENERE","chi soccorso non chiama.","sung"],["AURORA","Per bellezza infinita","sung"],["AURORA","colma di feritade","sung"],["AURORA","infinito è il desire,","sung"],["AURORA","infinito è il martire.","sung"],["VENERE","Fero mostro, empia fera","sung"],["VENERE","è ritrosa beltade!","sung"],["VENERE","Misera, io t'ho pietade.","sung"],["AURORA","Non giova la pietà senza l'aita.","sung"],["VENERE","Alle tue voglie pronta, ecco m'avrai.","sung"],["VENERE","A gli amorosi guai soccorso spera:","sung"],["VENERE","dimmi l'angosce tue, narra gl'affanni.","sung"],["AURORA","De' miei penosi danni","sung"],["AURORA","questo appunto saprai,","sung"],["AURORA","ch'amo Cefalo il crudo,","sung"],["AURORA","adorno di beltà, di pietà nudo.","sung"],["VENERE","Se le vaghezze tue d'Amor tesoro,","sung"],["VENERE","(onde amoroso appare","sung"],["VENERE","il bel volto di rose e il tuo crin d'oro),","sung"],["VENERE","non potero destare","sung"],["VENERE","in quel rigido cor foco dovuto,","sung"],["VENERE","ah, sarà forse il mio","sung"],["VENERE","tardo soccorso intempestivo aiuto.","sung"],["AURORA","D'esser gradita già non chiedo tanto,","sung"],["AURORA","se ben tanto desio","sung"],["AURORA","che quel garzon feroce","sung"],["AURORA","ne i cani e ne le fiere ha il cor sepolto.","sung"],["AURORA","E perché io l'amo, intanto?","sung"],["AURORA","Cinge di gelo il core, e d'ira il volto.","sung"],["AURORA","Ahi, ch'una sola voce,","sung"],["AURORA","una stilla di pianto","sung"],["AURORA","sdegna mirar, nega d'udire e poi","sung"],["AURORA","m'asconde ancora il sol de gli occhi suoi.","sung"],["VENERE","Dunque, che brami tu, mia vaga amica?","sung"],["AURORA","Ch'ei mi si scopra. E il piè fugace e lieve","sung"],["AURORA","non mova al corso, ohimè, pria ch'io gli dica","sung"],["AURORA","il mio tormento greve.","sung"],["AURORA","Tu vaga e bella dèa,","sung"],["AURORA","dammi questo contento,","sung"],["AURORA","che sai ben tu che fra le pene amare","sung"],["AURORA","è non amato amare,","sung"],["AURORA","è più crudo martoro","sung"],["AURORA","è pria morir che poter dir «io moro».","sung"],["VENERE","Vanne, ch'io ti prometto","sung"],["VENERE","oprarmi al tuo diletto.","sung"]]},{"title":"Scena seconda","description":"Aurora, Venere con le tre Grazie, Amore.","lines":[["","(coro)","dir"],["","Iº","dir"],["VENERE E LE GRAZIE","Amor nume leggiadro,","sung"],["VENERE E LE GRAZIE","ch'invece di ferir l'anime furi,","sung"],["VENERE E LE GRAZIE","va', più ch'esperto arcier sagace ladro,","sung"],["VENERE E LE GRAZIE","Cefalo, crudo e fero,","sung"],["VENERE E LE GRAZIE","ribellante al tuo impero,","sung"],["VENERE E LE GRAZIE","prendi, impiaga, innamora","sung"],["VENERE E LE GRAZIE","de la sprezzata Aurora.","sung"],["","IIº","dir"],["VENERE E LE GRAZIE","Tu, che i cori più saldi,","sung"],["VENERE E LE GRAZIE","e del macigno ancor più freddi e duri,","sung"],["VENERE E LE GRAZIE","col tuo poter incenerisci e scaldi,","sung"],["VENERE E LE GRAZIE","Cefalo, crudo e fero,","sung"],["VENERE E LE GRAZIE","ribellant' al tuo impero,","sung"],["VENERE E LE GRAZIE","prendi, impiaga, innamora","sung"],["VENERE E LE GRAZIE","de la sprezzata Aurora.","sung"],["AMORE","Arde Cefalo, ed ama,","sung"],["AMORE","ama sì che non cura","sung"],["AMORE","nov'amorosa cura.","sung"],["AMORE","Arde sì, che sol brama","sung"],["AMORE","ch'eterno sia l'ardore:","sung"],["AMORE","dunque, come poss'io","sung"],["AMORE","far pago il tuo desio?","sung"],["AMORE","Come ferir quel core,","sung"],["AMORE","se non può aver un cor più d'un amore?","sung"],["VENERE","Figlio, la tua possanza,","sung"],["VENERE","ogn'altra forza avanza.","sung"],["AMORE","Madre, il mio non volere","sung"],["AMORE","mi toglie ogni potere.","sung"],["VENERE","Dunque non vuoi?","sung"],["AMORE","Non voglio.","sung"],["VENERE","O fanciul pien d'orgoglio!","sung"],["AMORE","O donna dispettosa!","sung"],["VENERE","Figlio superbo e rio,","sung"],["VENERE","parto d'orsa crudel, non figliuol mio.","sung"],["VENERE","Non v'ho, né avrò mai posa,","sung"],["VENERE","fin che l'afflitta Aurora io non rimiri","sung"],["VENERE","contenta appien de' cari suoi desiri.","sung"],["VENERE","E dove non potranno","sung"],["VENERE","le forze aperte, adoprerò l'inganno.","sung"]]}]},{"heading":"Intermedio secondo","scenes":[{"title":"Scena prima","description":"Aurora, Cefalo, Coro de' cacciatori.","lines":[["","Iº","dir"],["CEFALO E CACCIATORI","Aura dolce e diletta,","sung"],["CEFALO E CACCIATORI","aura pura e gradita,","sung"],["CEFALO E CACCIATORI","fiato gentil de le celesti sfere,","sung"],["CEFALO E CACCIATORI","il tuo chiaro n'alletta,","sung"],["CEFALO E CACCIATORI","il tuo fresco n'invita","sung"],["CEFALO E CACCIATORI","a mirar, a godere","sung"],["CEFALO E CACCIATORI","da quest'alte pendici","sung"],["CEFALO E CACCIATORI","le bellezze del mondo allettatrici.","sung"],["","IIº","dir"],["CEFALO E CACCIATORI","Ecco ne l'oriente","sung"],["CEFALO E CACCIATORI","vaga magion del giorno,","sung"],["CEFALO E CACCIATORI","scoprir le pompe sue nascendo il sole,","sung"],["CEFALO E CACCIATORI","e col raggio lucente","sung"],["CEFALO E CACCIATORI","fa' che spuntino intorno","sung"],["CEFALO E CACCIATORI","le rose e le viole,","sung"],["CEFALO E CACCIATORI","con cui s'adorna poi","sung"],["CEFALO E CACCIATORI","Procri nel seno i caldi avori suoi.","sung"],["AURORA","Odi, Cefalo ingrato,","sung"],["AURORA","bella e cruda cagion de' miei tormenti;","sung"],["AURORA","odi gl'ultimi accenti","sung"],["AURORA","d'un core disperato.","sung"],["CEFALO","Dì pure, e quante, e quali","sung"],["CEFALO","sian le tue pene rie,","sung"],["CEFALO","ma non sperarmi amante,","sung"],["CEFALO","ché le viscere mie","sung"],["CEFALO","sono duro diamante,","sung"],["CEFALO","e le preghiere tue qual vetro frali.","sung"],["AURORA","Più non voglio pregarti.","sung"],["AURORA","(Così potess'io dir: «non voglio amarti!»)","sung"],["AURORA","Vedi miseria estrema:","sung"],["AURORA","tu mi sprezzi, io t'adoro,","sung"],["AURORA","tu m'uccidi, io non moro.","sung"],["AURORA","E pur quel duro cor non scaldi o pieghi;","sung"],["AURORA","crudele, accetta un don, se sdegni i prieghi.","sung"],["CEFALO","Inespugnabil sono:","sung"],["CEFALO","quel che non poté Amor, non potrà il dono.","sung"],["AURORA","Queste mie chiome bionde,","sung"],["AURORA","queste guancie di rose,","sung"],["AURORA","queste luci gioconde,","sung"],["AURORA","questo sen d'alabastro,","sung"],["AURORA","queste poppe amorose,","sung"],["AURORA","me stessa al fine ed ogni mio desio","sung"],["AURORA","a te dono, ben mio.","sung"],["AURORA","O vago, o vivo scoglio,","sung"],["AURORA","tu non rispondi pur?","sung"],["AURORA","Lassa, ch'io veggio sfavillarti","sung"],["AURORA","ne gli occhi ira ed orgoglio.","sung"],["AURORA","O core di diaspro,","sung"],["AURORA","parla, ch'altro non chieggio.","sung"],["AURORA","Deh, non negar a chi per te vien meno,","sung"],["AURORA","se troppo è una parola, un cenno almeno.","sung"],["CEFALO","Non con cenni o con segni,","sung"],["CEFALO","ma con schietto parlare or ti fo chiaro","sung"],["CEFALO","ch'emmi il tuo amare amaro.","sung"],["CEFALO","Resta, ch'io t'assicuro","sung"],["CEFALO","che m'agghiaccia il tuo ardore,","sung"],["CEFALO","che i doni tuoi non curo,","sung"],["CEFALO","che per te non ho core.","sung"]]},{"title":"Scena seconda","description":"Aurora, Eco e le Grazie.","lines":[["AURORA","Fuggi, garzon feroce.","sung"],["AURORA","Fuggi, che pur ti segue addolorata","sung"],["AURORA","l'anima mia con questa fioca voce","sung"],["AURORA","per restar consolata","sung"],["AURORA","dovunque andrai fuggendo,","sung"],["AURORA","(ché sempre fuggitivo ohimè ti vede).","sung"],["AURORA","Teco verrà lambendo","sung"],["AURORA","l'orma gentil del leggiadretto piede.","sung"],["AURORA","Questo è dunque il conforto,","sung"],["AURORA","o dèa di Pafo,","sung"],["AURORA","da te promesso?","sung"],["ECO","...Esso.","sung"],["AURORA","Chi mi risponde? Or tu, chi sei cui io tanto","sung"],["AURORA","movo a pietà del dolor mio?","sung"],["ECO","...Io.","sung"],["AURORA","L'alma del terzo ciel cui Gnido onora","sung"],["AURORA","Venere bella...","sung"],["ECO","...Ella.","sung"],["AURORA","Deh, t'increscano omai vaga ciprigna","sung"],["AURORA","gl'aspri miei guai!","sung"],["ECO","...Ahi!","sung"],["AURORA","Ahi, dolor senza aita! Ecco a ragione","sung"],["AURORA","mio cor dispera!","sung"],["ECO","...Spera!","sung"],["AURORA","E che sperar poss'io quasi la morte,","sung"],["AURORA","ch'a questo solo il duol m'invita?","sung"],["ECO","...Vita.","sung"],["LE GRAZIE","Siam noi, le Grazie ancelle","sung"],["LE GRAZIE","di lei che vince in cielo","sung"],["LE GRAZIE","di bellezza e splendor tutte le stelle.","sung"],["LE GRAZIE","Venere a te ci manda,","sung"],["LE GRAZIE","e per noi ti comanda","sung"],["LE GRAZIE","che rassereni il volto afflitto e smorto,","sung"],["LE GRAZIE","ch'avrai se non contento, almen conforto.","sung"],["AURORA","Nutrendo andrò col mio pensier incerto","sung"],["AURORA","di dubbia speme il cor, nel dolor certo.","sung"]]}]},{"heading":"Intermedio terzo","scenes":[{"title":"Scena prima","description":"Venere, Adone.","lines":[["VENERE","Dove vai? perché parti?","sung"],["VENERE","O de l'anima mia vero soggiorno?","sung"],["VENERE","Ah! non partir ancora,","sung"],["VENERE","leggiadro Adon, che il tuo partir m'accora.","sung"],["VENERE","A pena a queste luci","sung"],["VENERE","col solo apparir facesti giorno,","sung"],["VENERE","che col presto fuggir lor notte adduci.","sung"],["ADONE","Non t'incresca il partire","sung"],["ADONE","che più soave fia","sung"],["ADONE","poscia il ritorno ancora, anima mia.","sung"],["VENERE","Crudelissima gita,","sung"],["VENERE","spietata dipartita.","sung"],["VENERE","Or provo sì, ma più lo prova il core,","sung"],["VENERE","che il più crudo dei mali è il mal d'amore.","sung"],["VENERE","Ma vedi, meraviglia,","sung"],["VENERE","per soccorrer l'Aurora il passo or movo","sung"],["VENERE","né aita per me trovo.","sung"],["VENERE","Eccomi giunta a le Cimerie grotte","sung"],["VENERE","del Sonno e della Notte.","sung"]]},{"title":"Scena seconda","description":"Venere con le Grazie, Adone, il Sonno, Morfeo.","lines":[["","Iº","dir"],["VENERE E LE GRAZIE","O nel silenzio involti!","sung"],["VENERE E LE GRAZIE","O nell'oblio sepolti,","sung"],["VENERE E LE GRAZIE","che in questo speco ascoso","sung"],["VENERE E LE GRAZIE","a gli occhi altrui dormite.","sung"],["VENERE E LE GRAZIE","A l'aura, a l'aura uscite","sung"],["VENERE E LE GRAZIE","o figli della notte e del riposo!","sung"],["","IIº","dir"],["VENERE E LE GRAZIE","Lasciar non vi sia grave","sung"],["VENERE E LE GRAZIE","la quiete soave,","sung"],["VENERE E LE GRAZIE","ch'a questa chiara luce","sung"],["VENERE E LE GRAZIE","colei v'invita e chiama,","sung"],["VENERE E LE GRAZIE","colei vi chiede e brama","sung"],["VENERE E LE GRAZIE","che diva è in terra e stella in ciel riluce.","sung"],["SONNO","Deh, qual voce or risuona","sung"],["SONNO","fra quest'ombre segrete,","sung"],["SONNO","ladra de la quiete?","sung"],["VENERE","Venere io son, son io","sung"],["VENERE","del vago Cipro il riverito donno.","sung"],["VENERE","Or non udite? o Sonno,","sung"],["VENERE","te chiedo. O Morfeo, te bramo e desio.","sung"],["","Iº","dir"],["SONNO E MORFEO","O vago nume,","sung"],["SONNO E MORFEO","o caro lume","sung"],["SONNO E MORFEO","che i nostri orrori","sung"],["SONNO E MORFEO","rischiari, e indori","sung"],["SONNO E MORFEO","coi vivi rai","sung"],["SONNO E MORFEO","comanda omai.","sung"],["","IIº","dir"],["SONNO E MORFEO","Per te fia lieve","sung"],["SONNO E MORFEO","fatica greve.","sung"],["SONNO E MORFEO","Veloci, e pronti","sung"],["SONNO E MORFEO","per piani, e monti","sung"],["SONNO E MORFEO","n'andremo noi","sung"],["SONNO E MORFEO","a' cenni tuoi.","sung"],["","IIIº","dir"],["SONNO E MORFEO","Augelli e fiere","sung"],["SONNO E MORFEO","veloci e fiere","sung"],["SONNO E MORFEO","dolce allettando","sung"],["SONNO E MORFEO","addormentando","sung"],["SONNO E MORFEO","cotanto forte","sung"],["SONNO E MORFEO","che paian morte.","sung"],["","IVº","dir"],["SONNO E MORFEO","Così dormendo","sung"],["SONNO E MORFEO","potrai volendo","sung"],["SONNO E MORFEO","farne pian piano","sung"],["SONNO E MORFEO","con la tua mano","sung"],["SONNO E MORFEO","care mine","sung"],["SONNO E MORFEO","nove rapine.","sung"],["VENERE","Di Cefalo crudel, Sonno, io vorrei,","sung"],["VENERE","nel lungo faticar già sazio e stanco,","sung"],["VENERE","ch'entrando ne' begli occhi or dolci e rei","sung"],["VENERE","per te quietasse il travagliato fianco.","sung"],["VENERE","E tu che del pensier l'imago sei,","sung"],["VENERE","Morfeo: un sogno desio non visto unquanco.","sung"],["VENERE","Dorma il garzone e veggia con la mente","sung"],["VENERE","nell'Aurora gentil Procri presente.","sung"],["SONNO","Non vana è la speranza","sung"],["SONNO","ch'hai de la mia possanza.","sung"],["MORFEO","Ed io, che Morfeo sono, al poter mio","sung"],["MORFEO","fo legge il tuo desio.","sung"],["VENERE","E così Aurora sei","sung"],["VENERE","da me servita, e se non quanto appieno","sung"],["VENERE","era il pronto voler come potei.","sung"],["VENERE E LE GRAZIE","Che non può, che non vale","sung"],["VENERE E LE GRAZIE","con vaghi pregi suoi","sung"],["VENERE E LE GRAZIE","oggi beltà fra noi?","sung"],["VENERE E LE GRAZIE","Un fiato sol che bella donna essale","sung"],["VENERE E LE GRAZIE","basta per suscitar in rozzo core","sung"],["VENERE E LE GRAZIE","dolce fiamma d'amore.","sung"]]}]},{"heading":"Intermedio quarto","scenes":[{"title":"Scena prima","description":"Cefalo, Sonno, Morfeo.","lines":[["","Iº","dir"],["CEFALO","O monti, o colli, o prati, ecco a voi riede,","sung"],["CEFALO","col veloce pensier pront'è il desio.","sung"],["","IIº","dir"],["CEFALO","Anzi, che resta il cor se parte il piede,","sung"],["CEFALO","che in voi s'annida ogni diletto mio?","sung"],["","IIIº","dir"],["CEFALO","Ma poiché alla stanchezza il vigor cede,","sung"],["CEFALO","ogn'altra cura dolcemente oblio.","sung"],["","IVº","dir"],["CEFALO","E gl'occhi miei, ch'aperti star non ponno,","sung"],["CEFALO","qui dono in preda a la quiete e al sonno.","sung"],["SONNO","Tanto l'attesi pur, ch'io giunsi al varco.","sung"],["SONNO","Ei già d'affanni scarco","sung"],["SONNO","soavemente posa e dorme queto;","sung"],["SONNO","onde io mi parto taciturno e lieto.","sung"],["MORFEO","Dorme Cefalo o finge?","sung"],["MORFEO","Ah, parmi pur che dorma.","sung"],["MORFEO","Così l'amata forma","sung"],["MORFEO","fia ben ch'or l'appresenti. Onde per questo","sung"],["MORFEO","visibil parto ed invisibil resto.","sung"]]},{"title":"Scena seconda","description":"Cefalo, Morfeo, Aurora, Titone, Procri.","lines":[["AURORA","O Cefalo spietato,","sung"],["AURORA","è questo il guiderdon della mia fede?","sung"],["AURORA","Il premio de' miei guai,","sung"],["AURORA","la mercé del dolore,","sung"],["AURORA","fuggirmi a tutte l'ore?","sung"],["AURORA","Dove sei? dove stai?","sung"],["AURORA","Ah! rispondimi omai,","sung"],["AURORA","che questo sol desio.","sung"],["CEFALO","Dolce cor mio!","sung"],["AURORA","Odi voce soave,","sung"],["AURORA","soavissimo suono!","sung"],["AURORA","Stolta, mentre ragiono","sung"],["AURORA","non miro il mio bel sol, non veggio quello","sung"],["AURORA","ch'ha del mio cor la chiave!","sung"],["AURORA","O prezioso ostello,","sung"],["AURORA","dove nasce la luce,","sung"],["AURORA","che al mio ben mi conduce.","sung"],["AURORA","Che fai tu qui soletto,","sung"],["AURORA","amato mio diletto?","sung"],["AURORA","Stanco forse pigliar cerchi ristoro?","sung"],["CEFALO","Sì, mio tesoro.","sung"],["AURORA","O parole amorose,","sung"],["AURORA","con opportuna aita","sung"],["AURORA","voi mi date la vita.","sung"],["AURORA","Vaghe labbra di rose","sung"],["AURORA","concedetemi almeno, e premio sia","sung"],["AURORA","de l'aspra pena mia,","sung"],["AURORA","de l'interno mio duolo,","sung"],["AURORA","un bacio, un bacio solo.","sung"],["AURORA","Per sì caro desire,","sung"],["AURORA","io mi sento morire,","sung"],["AURORA","si liquefa col cor l'anima insieme.","sung"],["CEFALO","Viva mia speme.","sung"],["AURORA","Pietosissima dèa,","sung"],["AURORA","quelle grazie ti rendo","sung"],["AURORA","cui deggio, e so, poiché per te comprendo","sung"],["AURORA","che vero è quel contento","sung"],["AURORA","che nasce da tormento.","sung"],["AURORA","Labbra cortese e pie,","sung"],["AURORA","datemi in parte omai, se non in tutto,","sung"],["AURORA","il desiato frutto","sung"],["AURORA","delle miserie mie,","sung"],["AURORA","de' miei penosi guai.","sung"],["CEFALO","Baciami omai.","sung"],["TITONE","Ferma l'audaci labbra o troppo ardita!","sung"],["TITONE","E ben fermarle déi,","sung"],["TITONE","che quei baci son miei.","sung"],["TITONE","Tu, tu dal letto uscita","sung"],["TITONE","lasciasti, sol per far la scorta al sole,","sung"],["TITONE","del tuo Titon le membra fredde e sole.","sung"],["TITONE","Or ecco a mezzo il giorno.","sung"],["TITONE","Quando fia il tuo ritorno?","sung"],["TITONE","Ah, veggio, sì, quanto veder mi spiace","sung"],["TITONE","e grida il cor se ben la lingua tace!","sung"],["","Iº","dir"],["PROCRI","Ohimè, che veggio? Ohimè, vista dolente?","sung"],["PROCRI","Quest'è la pura fé, Cefalo infido,","sung"],["PROCRI","quest'è, garzon crudel, l'amore ardente?","sung"],["","IIº","dir"],["PROCRI","O già del mio sperar ricetto e nido,","sung"],["PROCRI","così tradirmi? Or l'immenso amore,","sung"],["PROCRI","che per te m'arse il cor sveno ed ancido.","sung"],["","IIIº","dir"],["PROCRI","Queste lagrime mie, cui verso fuore,","sung"],["PROCRI","sono il sangue di lui perché nel seno cadendo","sung"],["PROCRI","estingua il mal gradito ardore.","sung"],["","IVº","dir"],["PROCRI","Deh perché il pianto, ohimè, non è veneno","sung"],["PROCRI","che bevendolo or or mi fora grato,","sung"],["PROCRI","col mio morir farti contento appieno.","sung"],["PROCRI","Cefalo traditor, Cefalo ingrato!","sung"],["TITONE","Or dunque affretta il piè dubbioso e tardo.","sung"],["AURORA","Io mi sento morire.","sung"],["CEFALO","Ah, non partire!","sung"],["PROCRI","Ed io tutta di sdegno avvampo ed ardo.","sung"],["TITONE","Deh, vieni e non tardare!","sung"],["AURORA","Ohimè, ch'io moro.","sung"],["CEFALO","Ahi, che martoro.","sung"],["PROCRI","Ed io di rabbia e gel mi discoloro;","sung"],["PROCRI","statti che dal tuo aspetto io mi dileguo.","sung"],["CEFALO","Perché fuggir? Deh ferma! Ed io ti seguo.","sung"],["CEFALO","Ohimè, son desto o dormo?","sung"],["CEFALO","O sol de gli occhi miei,","sung"],["CEFALO","Procri mia, dove sei?","sung"],["CEFALO","Come esser può che sia","sung"],["CEFALO","quasi smarrita a volo","sung"],["CEFALO","l'alma de l'alma mia?","sung"],["CEFALO","Ah, pur mi chiese un bacio, e un bacio solo!","sung"],["CEFALO","Ma guidatem