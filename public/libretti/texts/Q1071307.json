ung"],["TEBALDO","il dolor mi ucciderà.","sung"],["","(si dividono e partono entrambi nella massima desolazione)","dir"]]}]},{"heading":"Parte quarta","scenes":[{"title":"Scena prima","description":"Recinto ove sorgono le tombe dei Capelletti. Vicino agli spettatori avvi quella di Giulietta.Il luogo è chiuso: a replicati colpi si spalanca una porta, e n'esce Romeo con Séguito di Montecchi.","lines":[["CORO","Siam giunti. Il ciel consenta","sung"],["CORO","che non ti sia funesto","sung"],["CORO","l'esser disceso in questo","sung"],["CORO","albergo di squallor.","sung"],["","(scendono lentamente)","dir"],["","(scorgendo la sepoltura di Giulietta)","dir"],["ROMEO","Ecco la tomba...","sung"],["ROMEO","Ancor di fiori sparsa...","sung"],["ROMEO","molle di pianto ancor. Il mio ricevi","sung"],["ROMEO","più doloroso e amaro: altro fra poco,","sung"],["ROMEO","maggior del pianto, altro olocausto avrai.","sung"],["","(prostrandosi sul sasso)","dir"],["CORO","Signor, ritratti: omai","sung"],["CORO","eccede il tuo dolor.","sung"],["ROMEO","O del sepolcro","sung"],["ROMEO","profonda oscurità, cedi un istante,","sung"],["ROMEO","cedi al lume del giorno, e mi rivela","sung"],["ROMEO","per poco la tua preda. ~","sung"],["ROMEO","L'urna mi aprite voi... Ch'io la riveda!","sung"],["","(i Montecchi silenziosi sforzano il coperchio dell'urna e lo sollevano: vedesi Giulietta distesa nel sepolcro vestita di bianco; Romeo prorompe in un grido e corre da lei)","dir"],["ROMEO","Giulietta!... O mia Giulietta!","sung"],["ROMEO","Sei tu... ti veggio... ti ritrovo ancora. ~","sung"],["ROMEO","Morta non sei... dormi soltanto e aspetti","sung"],["ROMEO","che ti desti Romeo. ~ Sorgi, mio bene,","sung"],["ROMEO","al suon de' miei sospiri,","sung"],["ROMEO","ti chiama il tuo Romeo.","sung"],["CORO","Lasso! deliri.","sung"],["CORO","Vieni: partiam; periglio","sung"],["CORO","è l'indugiar di più.","sung"],["ROMEO","Per pochi istanti","sung"],["ROMEO","me qui lasciate... Arcani ha il duol che debbe","sung"],["ROMEO","solo alla tomba confidar...","sung"],["CORO","Lasciarti!...","sung"],["CORO","solo! e in tanto cordoglio!","sung"],["CORO","Ah! tu ci spezzi il cor...","sung"],["ROMEO","Partite; il voglio.","sung"],["","(il Coro parte)","dir"]]},{"title":"Scena seconda","description":"Romeo solo.","lines":[["ROMEO","Tu sola, o mia Giulietta,","sung"],["ROMEO","m'odi tu sola. ~ Ahi vana speme!... è sorda","sung"],["ROMEO","la fredda salma di mia voce al suono...","sung"],["ROMEO","deserto in terra, abbandonato io sono.","sung"],["ROMEO","Deh! tu, bell'anima","sung"],["ROMEO","che al cielo ascendi,","sung"],["ROMEO","a me rivolgiti,","sung"],["ROMEO","con te mi prendi:","sung"],["ROMEO","così scordarmi,","sung"],["ROMEO","così lasciarmi,","sung"],["ROMEO","non puoi, bell'anima,","sung"],["ROMEO","nel mio dolor.","sung"],["ROMEO","Voliamo a vivere","sung"],["ROMEO","d'eterno amor.","sung"],["ROMEO","O tu mia sola speme,","sung"],["ROMEO","tosco fatal, non mai da me diviso","sung"],["ROMEO","vieni al mio labbro... Raccogliete voi","sung"],["ROMEO","l'ultimo mio respiro,","sung"],["ROMEO","tombe de' miei nemici.","sung"],["","(si avvelena, e getta l'ampolla ecc.)","dir"]]},{"title":"Scena terza","description":"Giulietta, che si risveglia, e Romeo.","lines":[["","(dalla tomba)","dir"],["GIULIETTA","Ah!","sung"],["ROMEO","Qual sospiro!","sung"],["GIULIETTA","Romeo!... Romeo!...","sung"],["ROMEO","La voce sua!... mi chiama!...","sung"],["ROMEO","Già m'invita al suo sen.","sung"],["","(Giulietta sorge dalla tomba)","dir"],["ROMEO","Ciel! che vegg'io?...","sung"],["GIULIETTA","Romeo!","sung"],["ROMEO","Giulietta! oh dio!...","sung"],["GIULIETTA","Sei tu?","sung"],["ROMEO","Tu vivi?","sung"],["GIULIETTA","Ah! per non più lasciarti,","sung"],["GIULIETTA","io mi desto, mio ben... la morte mia","sung"],["GIULIETTA","fu simulata...","sung"],["ROMEO","Oh! che di' tu?","sung"],["GIULIETTA","L'ignori?","sung"],["GIULIETTA","Non vedesti Lorenzo?","sung"],["ROMEO","Altro io non vidi...","sung"],["ROMEO","altro io non seppi... ahimè!... ch'eri qui morta.","sung"],["ROMEO","E qui venni... Ah! infelice!","sung"],["GIULIETTA","Ebben, che importa?","sung"],["GIULIETTA","Son teco alfin: ogni dolor cancella","sung"],["GIULIETTA","un nostro amplesso... Andiam...","sung"],["ROMEO","Restarmi io deggio","sung"],["ROMEO","eternamente qui...","sung"],["GIULIETTA","Che dici mai?","sung"],["GIULIETTA","Parla... parla...","sung"],["","(si accorge dell'ampolla; Romeo si asconde il capo fra le mani)","dir"],["GIULIETTA","Ah! Romeo!","sung"],["ROMEO","Tutto già sai.","sung"],["GIULIETTA","Ah! crudel! che mai facesti?","sung"],["ROMEO","Morte io volli a te vicino.","sung"],["GIULIETTA","Deh! che scampo alcun t'appresti!...","sung"],["ROMEO","Ferma, è vano...","sung"],["GIULIETTA","Oh! rio destino!","sung"],["ROMEO","Cruda morte io chiudo in seno...","sung"],["GIULIETTA","Ch'io con te l'incontri almeno...","sung"],["GIULIETTA","Dammi un ferro...","sung"],["ROMEO","Ah! no... giammai.","sung"],["GIULIETTA","Un veleno...","sung"],["ROMEO","Il consumai.","sung"],["ROMEO","Vivi... vivi... e vien talora","sung"],["ROMEO","sul mio sasso a lagrimar.","sung"],["GIULIETTA","Ciel crudele! ah! pria ch'ei mora,","sung"],["GIULIETTA","i miei dì tu déi troncar.","sung"],["ROMEO","Giulietta!... al seno stringimi:","sung"],["ROMEO","io ti discerno appena.","sung"],["GIULIETTA","Ed io ritorno a vivere","sung"],["GIULIETTA","quando tu déi morir!","sung"],["ROMEO","Cessa... il vederti in pena","sung"],["ROMEO","accresce il mio martir.","sung"],["ROMEO","Più non ti veggo... ah! parlami...","sung"],["ROMEO","un solo accento ancor...","sung"],["ROMEO","rammenta il nostro amor...","sung"],["ROMEO","io manco... addio!...","sung"],["","Insieme","sung"],["GIULIETTA","Oh! sfortunato! attendimi...","sung"],["GIULIETTA","non mi lasciare ancor...","sung"],["GIULIETTA","posati sul mio cor...","sung"],["GIULIETTA","ei muore... oh! dio!","sung"],["","(Romeo muore; Giulietta cade sovr'esso)","dir"]]},{"title":"Scena ultima","description":"Rientrano precipitosamente i Seguaci di Romeo, inseguiti da Capellio, e da' suoi Armigeri che compariscono da varie parti. Tutto il luogo è rischiarato da faci. Lorenzo accorre sbigottito e frettoloso.","lines":[["CORO","Romeo! Romeo!","sung"],["CAPELLIO","S'inseguano.","sung"],["CORO","Cielo!","sung"],["","(spaventati allo spettacolo)","dir"],["LORENZO","Estinti ambidue!...","sung"],["CORO","Barbaro fato!","sung"],["","(a Capellio)","dir"],["LORENZO","Mira.","sung"],["CAPELLIO","Uccisi!... da chi?...","sung"],["TUTTI","Da te, spietato!","sung"],["","(Capellio si getta sul corpo di Giulietta, Lorenzo su quello di Romeo)","dir"]]}]}]}