ng"],["DORINA","ch'io non ho tale idea.","sung"],["NIBBIO","Ma questa è sua livrea,","sung"],["NIBBIO","o che la voglia o no.","sung"]]}]},{"heading":"Intermezzo secondo","scenes":[{"title":"Scena unica","description":"Dopo il secondo atto.Dorina vestita da teatro con Sartori e Cameriere, e poi Nibbio.","lines":[["","(in collera coi sartori)","dir"],["DORINA","Quest'abito vi dico che sta male:","sung"],["DORINA","da regina non è, non è alla moda:","sung"],["DORINA","un manto alla reale","sung"],["DORINA","deve aver dieci palmi e più di coda.","sung"],["NIBBIO","Mi confermo qual fui:","sung"],["NIBBIO","son qui con la cantata.","sung"],["","(alli suddetti, non guardando Nibbio)","dir"],["DORINA","(Ci mancava costui!) Serva obbligata.","sung"],["DORINA","Più corta questa parte;","sung"],["DORINA","tantin più, per favore.","sung"],["NIBBIO","Recita questa sera?","sung"],["DORINA","Sì signore.","sung"],["DORINA","Presto! presto! Che fate?","sung"],["DORINA","Un altro punto qui.","sung"],["NIBBIO","Farà la prima donna?","sung"],["DORINA","Signor sì.","sung"],["DORINA","Che manica storpiata!","sung"],["DORINA","Qui la voglio allargata:","sung"],["DORINA","in tutto ci si vede la miseria.","sung"],["NIBBIO","Credo che avrà materia","sung"],["NIBBIO","da poter farsi onore.","sung"],["DORINA","(Che noia!) Sì signore.","sung"],["DORINA","Pare che lo facciate per dispetto.","sung"],["DORINA","Larga, larga, vi ho detto.","sung"],["DORINA","Che razza di sartore!","sung"],["NIBBIO","L'opera quanto dura?","sung"],["DORINA","Sì signore.","sung"],["NIBBIO","(Che risposta!)","sung"],["DORINA","Partite,","sung"],["DORINA","levatevi di qui.","sung"],["DORINA","Lo porterò così per questa sera.","sung"],["NIBBIO","Ma certo, che maniera","sung"],["NIBBIO","è questa di servire una signora?","sung"],["NIBBIO","Via, birbanti, in malora!","sung"],["","(alli sartori, li quali partono scacciati)","dir"],["NIBBIO","(Così la finirà.)","sung"],["DORINA","Mi creda, in verità,","sung"],["DORINA","che