ir"],["CLEOFIDE, PORO, ERISSENA, GANDARTE, TIMAGENE","Degno sei di regnar su tutto il mondo.","sung"],["CLEOFIDE","Caro, vieni a' mio seno","sung"],["CLEOFIDE","dopo tanto soffrir!","sung"],["CLEOFIDE","Sento ch'io vengo meno","sung"],["CLEOFIDE","per un sì gran gioir.","sung"],["PORO","Cara, torno al tuo seno","sung"],["PORO","dopo tanto soffrir!","sung"],["PORO","Scaccia si bel sereno","sung"],["PORO","l'ombra del mio martir.","sung"],["TUTTI","Dopo tanto penare","sung"],["TUTTI","è più grato il piacer;","sung"],["TUTTI","chi sa costante amare,","sung"],["TUTTI","rende immenso il goder.","sung"]]}]}]}