,["","(parte)","dir"]]},{"title":"Scena decima","description":"Erissena e Gandarte.","lines":[["GANDARTE","Adorata Erissena,","sung"],["GANDARTE","fra sì crudi disastri fuggita da questa","sung"],["GANDARTE","in più sicura parte.","sung"],["GANDARTE","Tuo sposo e difensor sarà Gandarte.","sung"],["ERISSENA","Vanne solo: io sarei","sung"],["ERISSENA","d'impaccio al tuo fuggir. La tua salvezza","sung"],["ERISSENA","utile è all'Indie.","sung"],["ERISSENA","E un giorno ancor potrai","sung"],["ERISSENA","a favor degli oppressi usar la spada.","sung"],["GANDARTE","E dove senza te speri ch'io vada?","sung"],["GANDARTE","Se viver non poss'io","sung"],["GANDARTE","lungi da te mio bene,","sung"],["GANDARTE","lasciami almen ben mio,","sung"],["GANDARTE","morir vicino a te.","sung"],["GANDARTE","Che se partissi ancora,","sung"],["GANDARTE","l'alma faria ritorno;","sung"],["GANDARTE","e non so dirti allora","sung"],["GANDARTE","quel che farebbe il piè.","sung"],["","(parte)","dir"]]},{"title":"Scena undicesima","description":"Erissena.","lines":[["","E pur chi 'l crederia? Fra tanti affanni","sung"],["","non so dolermi; e mi figuro un bene,","sung"],["","quando costretta a disperar mi vedo;","sung"],["","ah fallaci speranze io non vi credo.","sung"],["","Di rendermi la calma","sung"],["","prometti O speme infida;","sung"],["","ma incredula quest'alma","sung"],["","più fede non ti dà.","sung"],["","Chi ne provò lo sdegno,","sung"],["","se folle al mar si fida,","sung"],["","de' suoi perigli è degno,","sung"],["","non merita pietà.","sung"],["","(parte)","dir"]]}]},{"heading":"Atto terzo","scenes":[{"title":"Scena prima","description":"Portici de' giardini reali.Poro, poi Erissena.","lines":[["PORO","Erissena!","sung"],["ERISSENA","Che miro?","sung"],["ERISSENA","Poro tu vivi?","sung"],["PORO","E quando morto io fui?","sung"],["ERISSENA","Si pubblicò che disperato","sung"],["ERISSENA","Asbite nell'Idaspe morì.","sung"],["PORO","Follia ingegnosa,","sung"],["PORO","che d'Alessandro 