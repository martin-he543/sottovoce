    <!--[if BLOCK]><![endif]-->        <div
    x-data="{
        active: 'images',

        /* Lowercased hash segment -> the tab's real id, so matching is
           case-insensitive without forcing callers to use lowercase ids. */
        idMap: JSON.parse('{\u0022images\u0022:\u0022images\u0022,\u0022videos\u0022:\u0022videos\u0022}'),

        /* '#gallery/videos' -> ['gallery', 'videos'] — one segment per nesting
           level. Duplicated from components/accordion.blade.php rather than shared,
           because tabs do not require an accordion around them and adding a JS
           helper would mean rebuilding the committed public/build assets. */
        hashSegments() {
            return window.location.hash.slice(1).split('/').filter(Boolean).map(s => s.toLowerCase());
        },

        /* Reverse order, so the DEEPEST matching segment wins. This matters when a tab
           id also names an ancestor section: the show gallery tab used to be id
           'gallery' inside a section anchored 'gallery', so '#gallery/videos' matched
           the first segment here and selected the wrong tab. That tab is now 'images',
           but section anchors are author-controlled in the CMS, so the collision can
           recur at any time — hence matching from the deepest segment rather than
           relying on ids never clashing. A bare '#images' still resolves, which is
           what standalone tabs outside an accordion rely on. */
        syncFromHash() {
            for (const segment of this.hashSegments().reverse()) {
                if (this.idMap[segment] !== undefined) {
                    this.active = this.idMap[segment];
                    return;
                }
            }
        },

        init() {
            this.syncFromHash();
            window.addEventListener('hashchange', () => this.syncFromHash());
        }
    }"
    class="tabs"
>
    
    <div
        role="tablist"
         aria-labelledby="show-title"         class="tabs__list"
        
        @keydown.arrow-right.prevent="
            const tabs = $el.querySelectorAll('[role=tab]');
            const idx   = [...tabs].indexOf(document.activeElement);
            const next  = tabs[(idx + 1) % tabs.length];
            next.click(); next.focus();
        "
        @keydown.arrow-left.prevent="
            const tabs = $el.querySelectorAll('[role=tab]');
            const idx   = [...tabs].indexOf(document.activeElement);
            const prev  = tabs[(idx - 1 + tabs.length) % tabs.length];
            prev.click(); prev.focus();
        "
        @keydown.home.prevent="
            const first = $el.querySelector('[role=tab]');
            first.click(); first.focus();
        "
        @keydown.end.prevent="
            const tabs = $el.querySelectorAll('[role=tab]');
            const last  = tabs[tabs.length - 1];
            last.click(); last.focus();
        "
    >
