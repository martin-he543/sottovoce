            <div class="bard-content !mb-0">
        
        <p><strong>Prince Edward Theatre<br></strong>Old Compton Street,<br>London, W1D 4HS</p>
    </div>
    

                        
                            

    
        
    
    <div class="flex flex-wrap gap-2 sm:gap-4 justify-start my-4">

        
            
                <a
        href="/theatres/prince-edward-theatre"
