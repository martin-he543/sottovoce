ge":"You have successfully subscribed to our newsletter."},"popupNewsletterSignup":{"newsletterHeading":"Email Newsletter","newsletterDescription":"<p data-block-key=\"8jgt0\">Sign up to our twice-weekly digest of world-class live concerts, events, live streams and news.</p>","fundraisingCheckboxLabel":"Please send me emails about campaigns, memberships and support","timer":"3000","disclaimerText":"<p data-block-key=\"iywzq\">Your personal data will be processed as described in our <a href=\"https://www.wigmore-hall.org.uk/box-office-help/policies-terms-and-conditions/privacy-notice\">Privacy Notice</a>.</p>","disablePopup":false},"uri":"whats-on","siteCopy":[{"id":"U2l0ZUNvcHk6MQ==","key":"PRIVACY_NOTICE","richText":"<p>Your personal data will be processed as described in our <a href=\"/box-office-help/policies-terms-and-conditions/privacy-policy\">Privacy Notice</a>.</p>","plainText":"Your personal data will be processed as described in our Privacy Notice."},{"id":"U2l0ZUNvcHk6Mw==","key":"REGISTER_NOTICE","richText":"<p data-block-key=\"4og2d\">Already have an account? <a href=\"/login\">Sign in.</a><br/>Your personal data will be processed as described in our <a href=\"/box-office-help/policies-terms-and-conditions/privacy-notice\">Privacy Notice</a>.</p>","plainText":"Already have an account? Sign in.Your personal data will be processed as described in our Privacy Notice."},{"id":"U2l0ZUNvcHk6Ng==","key":"LEGACY_MEMBERSHIP_DONATION_DISABLED_MESSAGE","richText":"<p data-block-key=\"6vpc1\">This donation option is not available online for Supporter Friend members. Please contact the Friends office directly to make this donation.</p>","plainText":"This donation option is not available online for Supporter Friend members. Please contact the Friends office directly to make this donation."},{"id":"U2l0ZUNvcHk6NQ==","key":"LEGACY_MEMBERSHIP_MESSAGE_AFTER","richText":"<p data-block-key=\"wvxl9\">If you need help with your Supporter Friends membership, please get in touch with the Membership Office.</p>","plainText":"If you need help with your Supporter Friends membership, please get in touch with the Membership Office."},{"id":"U2l0ZUNvcHk6NA==","key":"LEGACY_MEMBERSHIP_MESSAGE_BEFORE","richText":"<p data-block-key=\"xsabv\">From 1 September 2026, Supporter Friends memberships can no longer be managed online. Please contact the Membership Office directly to renew, upgrade, or make any other changes to your membership.</p>","plainText":"From 1 September 2026, Supporter Friends memberships can no longer be managed online. Please contact the Membership Office directly to renew, upgrade, or make any other changes to your membership."},{"id":"U2l0ZUNvcHk6Mg==","key":"PAYMENT_TOKENISATION_NOTICE","richText":"<p data-block-key=\"lnaap\">We do not hold your payment card data. We use payment tokenisation, a process where an organisation holds a unique identifier which has no exploitable value if breached. You can read more <a href=\"https://en.wikipedia.org/wiki/Payment_tokenization\" rel=\"noopener noreferrer\" target=\"_blank\">here</a>.</p>","plainText":"We do not hold your payment card data. We use payment tokenisation, a process where an organisation holds a unique identifier which has no exploitable value if breached. You can read more here."}]},"shouldRenderPage":true,"domain":"https://www.wigmore-hall.org.uk","location":"http://www.wigmore-hall.org.uk/whats-on?startDate=2026-12-27&page=5","pageComponent":"UnionPage","timezone":"Europe/London","userAgent":{"family":"Other","major":"0","minor":"0","patch":"0","device":{"family":"Other","major":"0","minor":"0","patch":"0"},"os":{"family":"Other","major":"0","minor":"0","patch":"0"}},"dev":false}</script>
