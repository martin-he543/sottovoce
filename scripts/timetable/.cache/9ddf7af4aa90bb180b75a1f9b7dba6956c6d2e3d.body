":{"alt":"","credit":"","caption":"","height":25,"id":"SW1hZ2VBc3NldDo1ODM4","loading":"https://admin.wigmore-hall.org.uk/images/9gWPTaNa3xUf5lkrZq3VahYLpQs=/5838/fill-1x1/TikTok.svg","original":"https://media.wigmore-hall.org.uk/original_images/TikTok.svg","psrc":"https://admin.wigmore-hall.org.uk/images/UeK45LXg4Ncs0CkwAPIrb3drl14=/5838/height-50/TikTok.svg","px2":"https://admin.wigmore-hall.org.uk/images/OKA954BlNYC-KfgtcUOhUmcdXTk=/5838/height-100/TikTok.svg","src":"https://admin.wigmore-hall.org.uk/images/UeK45LXg4Ncs0CkwAPIrb3drl14=/5838/height-50/TikTok.svg","title":"TikTok","x2":"https://admin.wigmore-hall.org.uk/images/OKA954BlNYC-KfgtcUOhUmcdXTk=/5838/height-100/TikTok.svg","width":22},"url":"https://www.tiktok.com/@wigmore_hall"}],"copyright":"© Wigmore Hall 2026 | Company Registered in England No. 2754525 • Charity No. 1024838 • VAT No. 625680628","highlightedMessage":"<p data-block-key=\"l70xq\">Box Office — 020 7935 2141</p>","donationHeading":"Donate","donationDescription":"<p data-block-key=\"10dop\">Please give in support of our Audience Fund, thank you</p>","donationCategory":{"id":"RG9uYXRpb25DYXRlZ29yeTo0","title":"Audience Fund","heading":"Thank you for your support.","description":"<p data-block-key=\"pt1n9\">Please select your donation amount and payment method from the options below.</p><p data-block-key=\"3l2mk\">To set up an annually recurring gift or to split your donation across 12 monthly instalments select ‘Pay by Direct Debit’ – applicable for UK bank accounts only.</p>","fundId":"122","onAccountId":null,"amounts":[30,50,150,500,1000],"minimumAmount":1,"allowOtherAmount":true,"callToAction":"Donate","displayDirectDebitButton":true,"requireLogin":true,"subcategories":[]},"newsletterHeading":"Stay in touch","newsletterDescription":"<p data-block-key=\"vw1tp\">We will send you only one or two emails each week, highlighting forthcoming concerts, special events, live streams and news.</p>"},"codeSnippet":{"id":"Q29kZVNuaXBwZXQ6MQ==","code":