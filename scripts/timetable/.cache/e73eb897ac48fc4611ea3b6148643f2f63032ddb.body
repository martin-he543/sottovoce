            <div class="c-container__header">
                            <h2 class="c-container-header__title u-txt-center">Reviews</h2>
                                        <div class="c-container-header__subtitle"><p style="text-align: center;">(2025 production)</p>
</div>
                    </div>
    
    <section class="c-container__blocks">

        <div class="o-layout o-layout--center">
                            <div class="o-layout__item u-1/1@desktop">
    <div class="c-construkt-col c-col c-col-reviews">
        <div class="c-col-reviews__title-block">
                                </div>

                    <div class="c-slick__container">
                <div class="slick-carousel__nav"></div>
                <div class="c-col-reviews__grid slick-carousel--reviews slick-theme" data-item-count="7">

                                            <div class="c-col-reviews__item">
                            <div class="c-col-reviews__stars"><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i></div>
                            <div class="c-col-reviews__content"><p>‘Gorgeously enchanting. Pinocchio is brought exquisitely to life’</p>
</div>
