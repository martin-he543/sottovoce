                                                                            <h1 class="c-masthead__title"><span><span class="h-large">MargaM VR &#8211; Divya Kasturi </span>
<span class="h-small h-indent-lg">A free VR experience on The Dance Floor</span>
</span></h1>
                                                                        <div class="c-masthead__intro c-col-text-area"><p class="lead-p"><strong><a class="c-btn" href="https://www.sadlerswells.com/take-part/the-dance-floor-at-sadlers-wells-east/">Part of The Dance Floor</a></strong></p>
</div>
                                
            </div>

            

                    </div>
    </div>

                        <figure class="c-masthead__img c-masthead__media u-opacity-10">
                <picture>
                    
                                            <source srcset="https://images.sadlerswells.com/uploads/2026/10/SW-Masthead-2-scaled.jpg?resize=25%2C10&gravity 25w, https://images.sadlerswells.com/uploads/2026/10/SW-Masthead-2-scaled.jpg?resize=375%2C150&gravity 375w, https://images.sadlerswells.com/uploads/2026/10/SW-Masthead-2-scaled.jpg?resize=750%2C300&gravity 750w, https://images.sadlerswells.com/uploads/2026/10/SW-Masthead-2-scaled.jpg?resize=1000%2C400&gravity 1000w, https://images.sadlerswells.com/uploads/2026/10/SW-Masthead-2-scaled.jpg?resize=1500%2C600&gravity 1500w, https://images.sadlerswells.com/uploads/2026/10/SW-Masthead-2-scaled.jpg?resize=1990%2C796&gravity 1990w" media="(min-width: 600px)">
                        <img
                                srcset="https://images.sadlerswells.com/uploads/2026/10/SW-Masthead-2-scaled.jpg?resize=150%2C150&gravity 150w, https://images.sadlerswells.com/uploads/2026/10/SW-Masthead-2-scaled.jpg?resize=15%2C15&gravity 15w, https://images.sadlerswells.com/uploads/2026/10/SW-Masthead-2-scaled.jpg?resize=320%2C320&gravity 320w, https://images.sadlerswells.com/uploads/2026/10/SW-Masthead-2-scaled.jpg?resize=500%2C500&gravity 500w, https://images.sadlerswells.com/uploads/2026/10/SW-Masthead-2-scaled.jpg?resize=640%2C640&gravity 640w, https://images.sadlerswells.com/uploads/2026/10/SW-Masthead-2-scaled.jpg?resize=960%2C960&gravity 960w, https://images.sadlerswells.com/uploads/2026/10/SW-Masthead-2-scaled.jpg?resize=300%2C300&gravity 300w, https://images.sadlerswells.com/uploads/2026/10/SW-Masthead-2-scaled.jpg?resize=400%2C400&gravity 400w, https://images.sadlerswells.com/uploads/2026/10/SW-Masthead-2-scaled.jpg?resize=600%2C600&gravity 600w"
