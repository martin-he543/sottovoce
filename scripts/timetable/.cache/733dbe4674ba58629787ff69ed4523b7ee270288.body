                                            <img width="450" height="600" src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAcIAAAJYAQMAAADLw3S+AAAABlBMVEUAAAD///+l2Z/dAAAAAXRSTlMAQObYZgAAAAlwSFlzAAAOxAAADsQBlSsOGwAAADhJREFUeNrtwQENAAAAwqD3T20PBxQAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD8G4fwAAHAiGHlAAAAAElFTkSuQmCC" class="attachment-3:4@450 size-3:4@450 lazyload" alt=""  decoding="async"  data-src="https://www.arcolatheatre.com/wp-content/uploads/2026/09/Hicks-450x600.jpeg" data-srcset="https://www.arcolatheatre.com/wp-content/uploads/2026/09/Hicks-450x600.jpeg 450w, https://www.arcolatheatre.com/wp-content/uploads/2026/09/Hicks-150x200.jpeg 150w, https://www.arcolatheatre.com/wp-content/uploads/2026/09/Hicks-300x400.jpeg 300w, https://www.arcolatheatre.com/wp-content/uploads/2026/09/Hicks-850x1133.jpeg 850w" data-sizes="auto" data-eio-rwidth="450" data-eio-rheight="600" /><noscript><img width="450" height="600" src="https://www.arcolatheatre.com/wp-content/uploads/2026/09/Hicks-450x600.jpeg" class="attachment-3:4@450 size-3:4@450" alt="" sizes="(max-width: 340px) 90vw, 300px" decoding="async" srcset="https://www.arcolatheatre.com/wp-content/uploads/2026/09/Hicks-450x600.jpeg 450w, https://www.arcolatheatre.com/wp-content/uploads/2026/09/Hicks-150x200.jpeg 150w, https://www.arcolatheatre.com/wp-content/uploads/2026/09/Hicks-300x400.jpeg 300w, https://www.arcolatheatre.com/wp-content/uploads/2026/09/Hicks-850x1133.jpeg 850w" data-eio="l" /></noscript>
