                    <li class="person not-prose no-image has-grey-background-color">
                                                                            
                        <div class="person__header">
                            <h3 class="type-h6">Henrik Ibsen</h3>

                                                            <p class="type-body-s">Playwright</p>
                            
                            <div class="person__header__flex">
                                
                                                            </div>
                        </div>

                                            </li>
                                                                                                                                        
                    <li class="person not-prose no-image has-grey-background-color">
                                                                                    <button class="btn btn--square person__dialog-trigger btn--grey"
                                    data-dialog-open="people-6"
                                    data-dialog-content-template="dialog-person-6-7696">
                                    <span class="sr-only">Open Bio for David Edgar</span>
                                    <div class="btn__icon">
                                        <div class="mask-icon"
                                            style="--icon--url: url('/wp-content/themes/arcola-theatre-theme/public/images/plus.svg')"></div>
                                    </div>
