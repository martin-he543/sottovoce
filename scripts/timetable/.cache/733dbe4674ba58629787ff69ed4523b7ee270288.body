                                                                                                                        <h1 class="page-header__heading">
                                                The Master Builder
                                            </h1>
                                                                                                                    <div class="type-h3 m:d-none page-header__event-date">16 Oct - 21 Nov 2026</div>
                                
                                                                                                                                                    <h2 class="page-header__subheading">
                                            By Henrik Ibsen
                                        </h2>
                                                    <div class="type-body-l page-header__additional-credits">A version by David Edgar<br>Directed by Mehmet Ergen</div>
                                                                        
                                                                                                                                </div>    <div class="page-header__sidebar margin-trim">
        <div class="page-header__actions stack stack--s">
            <div class="type-h3 d-none m:d-block page-header__event-date">16 Oct - 21 Nov 2026</div>

            <div class="event-booking-controls">
                                                                                                        
                    
                    
