                                                                                    <button class="btn btn--square person__dialog-trigger btn--grey"
                                    data-dialog-open="people-6"
                                    data-dialog-content-template="dialog-person-6-5593">
                                    <span class="sr-only">Open Bio for Ryan Denton</span>
                                    <div class="btn__icon">
                                        <div class="mask-icon"
                                            style="--icon--url: url('/wp-content/themes/arcola-theatre-theme/public/images/plus.svg')"></div>
                                    </div>
