 SE14 6NW","postal_code":"SE14 6NW","address_1":"8 Lewisham Way","address_2":"","latitude":"51.4742772","localized_multi_line_address_display":["8 Lewisham Way","London","SE14 6NW"],"localized_area_display":"London"},"organizer_id":"1614341840","google_place_id":"ChIJz9IbH_gCdkgR-NcAI13_LOs","id":"297461350"},"primary_organizer":{"website":"","organization_id":"22675090276","_type":"organizer","user_id":"22675090276","description":{"text":"Simon Education was started in 1987 by David Simon and runs Saturday schools, online schools and home tuition service. The company also publishes the Genius series which it distributes internationally. It has catered to over 13,500 students over its 31 years and won numerous awards."},"followed_by_you":false,"url":"https://www.eventbrite.co.uk/o/simon-education-1614341840","twitter":"","long_description":{"text":"Simon Education is an African-Caribbean UK based education company, established in 1987 by David Simon and Dr. L Simon-Bleasdille. In 2005 Nneb Akpom-Simon joined the organisation to become one of the three directors.The company runs an online school, publishing house, festival, online courses and the SEADS project that supports schools in several Caribbean and African countries.Simon Education is also the publisher of the Genius series that includes the bestsellingHow to Unlock Your Child's Genius and How to Unlock Your Genius Using Black History."},"logo_id":"591277239","num_followers":2732,"num_future_events":0,"is_saved":true,"num_past_events":0,"disable_marketing_opt_in":false,"id":"1614341840","name":"Simon Education"},"ticket_availability":{"start_sales_date":{"timezone":"Europe/London","local":"2026-04-23T00:00:00","utc":"2026-04-22T23:00:00Z"},"quantity_sold_add_on":0,"minimum_ticket_price_rounded":{"currency":"GBP","display":"0 GBP","value":0},"quantity_sold_paid":105,"remaining_capacity":1009,"end_sales_date":{"timezone":"Europe/London","local":"2026-10-24T17:30:00","utc":"2026-10-24T16:30:00Z"},"num_ticket_cla