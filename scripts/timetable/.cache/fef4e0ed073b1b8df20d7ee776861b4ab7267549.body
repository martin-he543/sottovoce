www.eventbrite.co.uk/e/black-book-festival-and-education-expo-2026-tickets-1988065638843","hide_start_date":false,"hide_end_date":false,"summary":"Simon Education presents the seventh Black Book Festival, including The Education Expo 2026, raising funds for the SEADS Project.","is_online_event":false,"eid":"1988065638843","id":"1988065638843","published":"2026-04-23T16:26:56Z","privacy_setting":"unlocked","primary_organizer_id":"1614341840","is_series":false,"timezone":"Europe/London","start_date":"2026-10-24","start_time":"11:00","end_date":"2026-10-24","end_time":"18:00","tags":[],"eventbrite_event_id":"1988065638843","promoted_listing_metadata":{"ad_id":"477536","is_promoted_event":true,"placement_id":"4f39ca82-002f-4322-ada5-6bc1e91d112b","campaign_id":"477536","experiments":[],"index_in_results":2,"include_follow_cta":false,"goal_adj_bid":0.0012},"primary_venue":{"user_id":"22675090276","name":"Goldsmiths, University of London","address":{"city":"London","country":"GB","region":"England","longitude":"-0.035417","localized_address_display":"8 Lewisham Way, London, SE14 6NW","postal_code":"SE14 6NW","address_1":"8 Lewisham Way","address_2":"","latitude":"51.4742772","localized_multi_line_address_display":["8 Lewisham Way","London","SE14 6NW"],"localized_area_display":"London"},"organizer_id":"1614341840","google_place_id":"ChIJz9IbH_gCdkgR-NcAI13_LOs","id":"297461350"},"primary_organizer":{"website":"","organization_id":"22675090276","_type":"organizer","user_id":"22675090276","description":{"text":"Simon Education was started in 1987 by David Simon and runs Saturday schools, online schools and home tuition service. The company also publishes the Genius series which it distributes internationally. It has catered to over 13,500 students over its 31 years and won numerous awards."},"followed_by_you":false,"url":"https://www.eventbrite.co.uk/o/simon-education-1614341840","twitter":"","long_description":{"text":"Simon Education is an African-Caribbean UK based education company, established in 1987 by David Simon and Dr. L Simon-Bleasdille. In 2005 Nneb Akpom-Simon joined the organisation to become one of the three directors.The company runs an online school, publishing house, festival, online courses and the SEADS project that supports schools in several Caribbean and African countries.Simon Education is also the publisher of the Genius series that includes the bestsellingHow to Unlock Your Child's Genius and How to Unlock Your Genius Using Black History."},"logo_id":"591277239","num_followers":2732,"num_future_events":0,"is_saved":true,"num_past_events":0,"disable_marketing_opt_in":false,"id":"1614341840","name":"Simon Education"},"ticket_availability":{"start_sales_date":{"timezone":"Europe/London","local":"2026-04-23T00:00:00","utc":"2026-04-22T23:00:00Z"},"quantity_sold_add_on":0,"minimum_ticket_price_rounded":{"currency":"GBP","display":"0 GBP","value":0},"quantity_sold_paid":105,"remaining_capacity":1009,"end_sales_date":{"timezone":"Europe/London","local":"2026-10-24T17:30:00","utc":"2026-10-24T16:30:00Z"},"num_ticket_classes":2,"has_available_hidden_tickets":false,"maximum_ticket_price":{"currency":"GBP","display":"12.00 GBP","value":1200},"minimum_ticket_price":{"currency":"GBP","display":"0.00 GBP","value":0},"is_free":false,"maximum_ticket_price_rounded":{"currency":"GBP","display":"12 GBP","value":1200},"is_hold_unavailable":false,"waitlist_enabled":false,"has_bogo_tickets":false,"has_available_tickets":true,"common_sales_end_date":null,"is_sold_out":false,"waitlist_available":false,"quantity_sold_free":1060,"quantity_sold":1165,"open_discount":null},"urgency_signals":{"messages":["goingFast","salesEndSoon"],"categories":[]},"image_large":{"edge_color_set":true,"edge_color":"#ff6127","url":"https://img.evbuc.com/https%3A%2F%2Fcdn.evbuc.com%2Fimages%2F1182973008%2F22675090276%2F1%2Foriginal.20260424-154344?crop=focalpoint\u0026fit=crop\u0026auto=format%2Ccompress\u0026q=75\u0026sharp=10\u0026fp-x=0.531\u0026fp-y=0.1