<script>
	jQuery(document).ready(function () {
		jQuery(".has-submenu-level3 > a").on("click", function (e) {
			e.preventDefault();

			let $li = jQuery(this).parent(".has-submenu-level3");
			let $submenu = jQuery(this).next(".sub-menu-level3");

			// अगर पहले से active है तो remove करो
			if ($submenu.hasClass("active")) {
				$submenu.removeClass("active");
				$li.removeClass("active");
			} else {

				// फिर सिर्फ इसी में add करो
				$submenu.addClass("active");
				$li.addClass("active");
			}
		});
	});
</script>							<div class="Mobile_SearchDonate">
