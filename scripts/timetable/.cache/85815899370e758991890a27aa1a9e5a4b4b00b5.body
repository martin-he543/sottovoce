	jQuery(document).ready(function() {
		jQuery(".BannerBookBtn").click(function(e) {
			e.preventDefault();
			jQuery(".TicketTimePopup").toggleClass("active");
		});
	})
	
	jQuery(document).ready(function() {
		jQuery(".close_Ticket,#ticketsschedules a").click(function(e) {
			e.preventDefault();
			jQuery(".TicketTimePopup").toggleClass("active");
		});
	})
	//Banner Title fixed on page scroll
	jQuery(document).ready(function() {
	  jQuery(window).scroll(function() {
		var distanceFromTop = jQuery(document).scrollTop();
		if (distanceFromTop >= jQuery('.EventDetail_banner').height() - 180) {   
		  	jQuery('.EventDetailHeading_Title,.sectionTabs').addClass('fixed');
			jQuery('body').addClass('PageScroll');
		} else { 
		  	jQuery('.EventDetailHeading_Title,.sectionTabs').removeClass('fixed');
			jQuery('body').removeClass('PageScroll');
		}
	  });
	});

	//Page Scroll Tabs
	/*jQuery(document).ready(function(){
	  // Add smooth scrolling to all links
	  jQuery(".nav-tabs a").on('click', function(event) {
		// Make sure this.hash has a value before overriding default behavior
		if (this.hash !== "") {
		  // Prevent default anchor click behavior
		  event.preventDefault();
		  // Store hash
		  var hash = this.hash;
		  jQuery('html, body').animate({
			scrollTop: jQuery(hash).offset().top-180
			//scrollTop: jQuery(hash).offset().top-250
		  }, 10, function(){
			// Add hash (#) to URL when done scrolling (default click behavior)
			window.location.hash = hash;
		  });
		} // End if
	  });
	});*/
	jQuery(document).ready(function (jQuery) {

    jQuery(".nav-tabs a[href^='#']").on("click", function (e) {
        e.preventDefault();

        var target = jQuery(this.getAttribute("href"));

        if (target.length) {
            jQuery("html, body").stop().animate({
                scrollTop: target.offset().top - 300
            }, 10);
        }
    });

});
	
	
</script>
