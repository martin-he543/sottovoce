					<style>
						.waiting-modal{
						display:none;
						position:fixed;
						inset:0;
						background:rgba(0,0,0,.6);
						z-index:9999;
						}

						.waiting-modal-content{
						background:#fff;
						max-width:480px;
						margin:2% auto;
						padding:30px;
						position:relative;
						}

						.waiting-close{
						position:absolute;
						right:15px;
						top:10px;
						font-size:22px;
						cursor:pointer;
						}
						.waitingSuccessMessage
						{
						font-size: 15px;
						font-weight: bold;
						}
						.waitingRecaptchaError{
						color:#c62828;
						font-size:14px;
						margin-top:10px;
						}
					</style>
					<script src="https://www.google.com/recaptcha/api.js?render=explicit" async defer></script>
					<script type="text/javascript">
						jQuery(function($){
							function resetWaitingModalState() {
								$('#waitingSuccessMessage').hide();
								$('.JoinWaitingFrom').show();
								$('#waitingRecaptchaError').hide();
								if (typeof grecaptcha !== 'undefined') {
									$('.g-recaptcha').each(function(){
										const widgetId = $(this).data('widget-id');
										if (typeof widgetId !== 'undefined') {
											grecaptcha.reset(widgetId);
										}
									});
								}
							}

							function ensureRecaptchaRendered() {
								if (typeof grecaptcha === 'undefined' || !grecaptcha.render) {
									return;
								}

								$('.g-recaptcha').each(function(){
									const $recaptcha = $(this);
									if (typeof $recaptcha.data('widget-id') !== 'undefined') {
										return;
									}

									const widgetId = grecaptcha.render(this, {
										sitekey: $recaptcha.data('sitekey')
									});

									$recaptcha.data('widget-id', widgetId);
								});
							}

							$('.JoinLink').on('click', function(e){
								e.preventDefault();
								console.log('Event time:', $(this).data('time'));

								let time = $(this).data('time');

								$('#event_time').val(time);
								resetWaitingModalState();
								ensureRecaptchaRendered();

								$('#waitingModal').fadeIn();
							});

							$('.waiting-close').on('click', function(){
								resetWaitingModalState();
								$('#waitingModal').fadeOut();
							});

							$('#submitWaiting').click(function(){
								let recaptchaResponse = '';
								let widgetId = $('.g-recaptcha').first().data('widget-id');

								if (typeof grecaptcha !== 'undefined' && typeof widgetId !== 'undefined') {
									recaptchaResponse = grecaptcha.getResponse(widgetId);
								}

								if (!recaptchaResponse) {
									$('#waitingRecaptchaError').show();
									return;
								}

								$('#waitingRecaptchaError').hide();

								let data = {
									action: 'join_waiting_list',
									name: $('#name_join').val(),
									email: $('#email_join').val(),
									tickets: $('#number').val(),
									info: $('#info').val(),
									title: $('#event_title').val(),
									time: $('#event_time').val(),
									g_recaptcha_response: recaptchaResponse
								};

								$.post('https://www.stmartin-in-the-fields.org/wp-admin/admin-ajax.php', data, function(){
									$('.JoinWaitingFrom').hide();
									$('#waitingSuccessMessage').show();

									setTimeout(function(){
										$('#waitingModal').fadeOut(function(){
											resetWaitingModalState();
										});
									}, 2000);
								});
							});

						});
					</script>


<script type="text/javascript">
	jQuery('.repeat-toggle').click(function()
{
     jQuery(this).toggleClass('open'); //Adds 'a', removes 'b' and vice versa
