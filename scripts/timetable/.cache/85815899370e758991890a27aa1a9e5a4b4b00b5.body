<script data-minify="1" src="https://www.stmartin-in-the-fields.org/wp-content/cache/min/1/wp-content/themes/suredigital-starter/assets/js/slick.js?ver=1792493493" type="text/javascript" charset="utf-8"></script>
<script type="text/javascript">
	jQuery(document).on('ready', function () {

		jQuery(".Gallery_Slider").slick({
			dots: false,
			//autoplay: true,
			infinite: true,
			centerMode: true,
			slidesToShow: 3,
			//variableWidth: true,
			//slidesToScroll: 3,
			centerPadding: '12.5%',
			prevArrow: '<button type="button" class="slick-prev">Prev</button>',
			nextArrow: '<button type="button" class="slick-next">Next</button>',
			appendArrows: jQuery('.Gallery-nav'),
			responsive: [
				{
					breakpoint:1450,
					settings: {
						centerPadding: '100px',
						//slidesToShow: 2,
					}
				},
				{
					breakpoint:780,
					settings: {
						centerPadding: '50px',
						slidesToShow: 2,
					}
				},
				{
					breakpoint:480,
					settings: {
						centerPadding: '50px',
						slidesToShow: 1,
					}
				}

			]
		});

		// Rebind fslightbox after Slick finishes initialising
		//refreshFsLightbox();

	});
</script>
<script type="text/javascript">
	jQuery(document).on('ready', function () {
		jQuery(".testimonialsSlider_notUse").slick({
			dots: false,
			//autoplay: true,
			infinite: true,
			//centerMode: true,
