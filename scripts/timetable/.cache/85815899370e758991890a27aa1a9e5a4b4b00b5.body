							<div class="JoinWaitingFrom_Item">
								<label>Name</label>
								<input class="TextFeild" id="name_join">
							</div>

							<div class="JoinWaitingFrom_Item">
								<label>Email</label>
								<input class="TextFeild" id="email_join">
							</div>

							<div class="JoinWaitingFrom_Item">
								<label>Number of tickets</label>
								<input class="TextFeild TicketNo" id="number">
							</div>

							<div class="JoinWaitingFrom_Item">
								<label>Other Info</label>
								<textarea class="TextFeild" id="info"></textarea>
							</div>
							<div class="JoinWaitingFrom_Item">
								<div class="g-recaptcha" data-sitekey="6LeRlsQsAAAAALswZSDo_pawMfq2j24HGNNiMH4P"></div>
								<div id="waitingRecaptchaError" class="waitingRecaptchaError" style="display:none;">Please complete the reCAPTCHA.</div>
							</div>
							<br/>

							<button type="button" id="submitWaiting" class="CommonBtn">Submit</button>

							</div>
							<div id="waitingSuccessMessage" class="waitingSuccessMessage" style="display:none;">Submitted successfully!</div>

						</div>
