<div  class="NewsLetter_Outer" id="SpektrixNewsletterSignup">
	<div class="spin" v-bind:style="{display: isLoading ? 'block' : 'none'}"></div>
			<div class="newsletterText">
				<h3>Sign up to hear about news, events and more...</h3>
			</div>

			<form id="JoinOurMailingListForm" v-show="!isSuccessfullySubmit">
				<div class="newsletterLeft">
					<div class="form-group">
						<label for="newsletterInputFirstName" class="control-label">First Name</label>
						<input class="form-control" name="reg_firstName" id="reg_firstName" type="text" v-model="reg_firstName" placeholder="">
					</div>
					<div class="form-group">
						<label for="newsletterInputLastName" class="control-label">Last Name</label>
						<input class="form-control" name="reg_lastName" id="reg_lastName" type="text" v-model="reg_lastName" placeholder="">
					</div>

					<div class="form-group fullWidth">
						<label for="newsletterInputEmail" class="control-label">Email</label>
						<input class="form-control" name="reg_email" id="reg_email" type="email" v-model="reg_email" placeholder="">
					</div>
				</div>
				<div class="newsletterRight">
						<label>Please select what you would like to hear about from the items below:</label>
						<div class="checkBoxRow">
							<span class="checkBoxStyle" v-for="reg_tag in reg_tags">
								<input type="checkbox" :value="reg_tag.id" v-model="selectedTagIds">
								<label class="checkmark">{{reg_tag.name}}</label>
							</span>
						</div>
						<div class="form-groupBtn">
						<button type="submit" class="CommonBtn center-block" >
							Sign up
						</button>
					</div>
				</div>
			</form>
			<div class="newsletterText" v-show="isSuccessfullySubmit">
				<p>Thanks for signing up to the newsletter! We will be in touch with you shortly.</p>
			</div>
</div>

<script type="text/javascript">
    const tag_groups_url = "https://tickets.stmartin-in-the-fields.org/stmartininthefields/api/v3/tag-groups";
    const agree_statements_url = "https://tickets.stmartin-in-the-fields.org/stmartininthefields/api/v3/statements";
    //const signup_url = "https://tickets.stmartin-in-the-fields.org/stmartininthefields/api/v3/customer";
    const signup_url = "https://www.stmartin-in-the-fields.org/wp-json/v1/send_spektrix_signup";


    const vm_reg_form = new Vue({
        el: '#SpektrixNewsletterSignup',
        data: {
            isLoading: true,
            isProcessing: false,
            isSuccessfullySubmit: false,
            //Step 1 fields
            reg_firstName: '',
            reg_lastName: '',
            reg_email: '',
            reg_tags: [],
            selectedTagIds: [],
            agreeStatements: [],
            selectedAgreeStatements: [],
        },
        created() {
            this.init();
        },
        methods: {
            init: function (params) {
                this.isLoading = false;
                this.isSuccessfullySubmit = false;
                this.loadTags();
                this.loadAgreeStatements();
            },
            loadTags: function () {

                this.isProcessing = true;

                this.isLoading = false;
                axios.get(tag_groups_url, { withCredentials: true }).then(response => {
                    //console.log(response.data);
                    this.reg_tags = response.data.filter(item => item.name === "Contact Preferences").map(item => item.tags)[0];
                    //console.log(this.reg_tags);
                    this.isProcessing = false;
                }).catch(function (error) {
                    this.isProcessing = false;
                    alert("Some problem in loading tag groups." );
                });

            },
            loadAgreeStatements: function () {
                this.isProcessing = true;
                this.isLoading = false;
                axios.get(agree_statements_url, { withCredentials: true }).then(response => {
                    //console.log(response.data);
                    this.agreeStatements = response.data;
                    //console.log(this.agreeStatements);
                    this.isProcessing = false;
                }).catch(function (error) {
                    this.isProcessing = false;
                    alert("Some problem in loading agree statements." );
                });
            },
            formSubmit: function () {

                this.isProcessing = true;

                //Match AgreedStatements based on tag names
                const selectedTagNames = this.reg_tags.filter(item => this.selectedTagIds.includes(item.id)).map(item => item.name);
                this.selectedAgreeStatements = this.agreeStatements.filter(item => selectedTagNames.includes(item.text));
                //console.log('this.selectedAgreeStatements:', this.selectedAgreeStatements);

                var AgreedStatementsIds = this.selectedAgreeStatements.map(item => item.id);
                AgreedStatementsIds.push('401ANPJQJQPQMRSBDNMVNLSPGTRBVQVRH'); //"id": "401ANPJQJQPQMRSBDNMVNLSPGTRBVQVRH", "text": "Yes, I am happy to be contacted by email.",
                
                postObject = {
                    firstName: this.reg_firstName,
                    lastName: this.reg_lastName,
                    email: this.reg_email,
                    Tags: this.selectedTagIds,
                    AgreedStatements: AgreedStatementsIds
                };

                this.isLoading = true;
                axios.post(signup_url, postObject, { withCredentials: true }).then(response => {
                    //console.log(response.data);
                    this.isProcessing = false;
                    this.isLoading = false;
                    this.isSuccessfullySubmit = true;
                    //window.location.href = '/join-our-mailing-list-success';
                }).catch(function (error) {
                    this.isProcessing = false;
                    this.isLoading = false;
                    alert("Some problem in signup.\nMay be this email address already registrated or you are already logged in.\n\nTo continue please logout first." );
                    window.location.href = '/my-account';
                });

            }
        }
    });
</script>

<script data-minify="1" src="https://www.stmartin-in-the-fields.org/wp-content/cache/min/1/ajax/libs/jquery-validate/1.19.3/jquery.validate.min.js?ver=1792493493" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script type="text/javascript">
    jQuery(document).ready(function () {
        jQuery("#JoinOurMailingListForm").validate({ // initialize the plugin
            ignore: [],
            rules: {
                reg_firstName: {
                    required: true
                },
                reg_lastName: {
                    required: true
                },
                reg_email: {
                    required: true,
                    email: true
                },
            },
            submitHandler: function (form) { // for demo
                console.log('JoinOurMailingListForm - valid'); // for demo
                vm_reg_form.formSubmit();
            }
        });
    });
</script>

