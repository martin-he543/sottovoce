			nextArrow: '<button type="button" class="slick-next">Next</button>',
			appendArrows: jQuery('.testimonials-nav'),
			responsive: [
				{
					breakpoint:780,
					settings: {
						//centerPadding: '50px',
						slidesToShow: 2,
					}
				},
				{
					breakpoint: 480,
					settings: {
						slidesToShow: 1,
					}
				}

			]
		});
	});
</script>
<script>
  document.addEventListener("DOMContentLoaded", function () {
    // Check if URL contains "#Tickets_in"
    if (window.location.hash === "#Tickets_in") {
      // Find the TicketTimePopup section
      var popup = document.getElementById("Tickets_in");
      
      if (popup) {
        popup.classList.add("active");
      }
    }
  });
</script>


