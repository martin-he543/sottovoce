ode":null,"message":null,"message_type":null},"eventbrite_event":{"id":"2002195730327","name":{"text":"Tonic - Jazz - Soul - Funk Jam @ Downstairs at Sucre, Soho"},"start":{"timezone":"Europe/London","local":"2026-10-29T20:30:00","utc":"2026-10-29T20:30:00Z"},"url":"https://www.eventbrite.co.uk/e/tonic-jazz-soul-funk-jam-downstairs-at-sucre-soho-tickets-2002195730327","is_free":true,"online_event":false,"listed":true,"summary":"Enjoy the hottest, hippest, happening vibes of the 'Jazz, Soul, Funk Collective' at Tonic. Let the groove move you."},"bookmarks_count":10,"widgets":null},{"_type":"destination_event","image_id":"1196374053","is_protected_event":false,"is_series_parent":false,"primary_venue_id":"299951972","series_id":null,"checkout_flow":"widget","tickets_by":"Eventbrite","tickets_url":"https://www.eventbrite.co.uk/checkout-external?eid=2003768626903","name":"Its a Love Thang!","language":"en-us","url":"https://www.eventbrite.co.uk/e/its-a-love-thang-tickets-2003768626903","hide_start_date":false,"hide_end_date":false,"summary":"IT\u2019S A LOVE THANG \u2764\ufe0f\n\nSoul Partizan takes over The Camden for an early Friday evening session dedicated to good music, good people \u0026 vibes","is_online_event":false,"eid":"2003768626903","id":"2003768626903","published":"2026-10-22T12:55:24Z","privacy_setting":"unlocked","primary_organizer_id":"29707673155","is_series":false,"timezone":"Europe/London","start_date":"2026-11-20","start_time":"18:00","end_date":"2026-11-20","end_time":"22:00","tags":[],"eventbrite_event_id":"2003768626903","promoted_listing_metadata":{"ad_id":"501637","is_promoted_event":true,"placement_id":"9e0e7dc6-be4c-4823-a053-9c8faf3f4259","campaign_id":"501637","experiments":[],"index_in_results":1,"include_follow_cta":false,"goal_adj_bid":0.0029},"primary_venue":{"user_id":"124600765361","name":"The Camden","address":{"city":"London","country":"GB","region":"England","longitude":"-0.1378523","localized_address_display":"65 Crowndale Road, London, NW1 1TN","postal_code":"NW1 1TN","address_1":"65 Crowndale Road","address_2":"","latitude":"51.5344697","localized_multi_line_address_display":["65 Crowndale Road","London","NW1 1TN"],"localized_area_display":"London"},"organizer_id":"29707673155","google_place_id":"ChIJJbeecdAbdkgRfde-p1s2Pr0","id":"299951972"},"primary_organizer":{"website":"","organization_id":"124600765361","_type":"organizer","user_id":"124600765361","description":{"text":"Soul Partizan is an East London-based cultural collective that has been a driving force in promoting events, running bars, and curating exhibitions for over 20 years. We collaborate with independent labels, artists, and designers, tapping into the vibrant energy of the \"Shoreditch phenomenon\"\u2014a cultural movement that began in the mid-90s and continues to shape the global creative scene today. Shoreditch\u2019s diverse and multicultural spirit, along with its innovation in technology and art, serves as the foundation of everything we do.For the past 10 years, our Soul Partizan podcast has been broadcast monthly across multiple platforms, including Totally Wired Radio (London), Radio Laser (Rennes), Ness Radio (Marrakech), and WHCR 90.3 FM (Harlem, New York). Presented by Rodger Cary Grant and produced by Simon Cordell, the show blends our nomadic lifestyle with a deep passion for music, curating the best underground, soul-influenced sounds. We interview both emerging talents and established artists, giving a voice to creatives while discussing relevant local, national, and international issues.Our podcast also serves as a window into our global travels, offering unique insights and perspectives on the destinations we visit. Additionally, Soul Partizan is featured on Mixcloud, and from August 2020, it has been available on Apple+ and Spotify.Through our social media platforms, we share the inspiring stories of pioneers who helped shape the cultural movement in East London, but who were displaced by gentrification. By shedding light on these issues, we aim to build awareness of how these changes impact the community and question the broader societal trends at play. Our mission is to foster modern, conscious thinking through our radio show, podcasts, and events, showcasing the best in art, music, technology, and emerging talent.With a continued series of exciting events, Soul Partizan is committed to not only celebrating the past but also shaping the future of culture, creativity, and community awareness."},"followed_by_you":false,"url":"https://www.eventbrite.co.uk/o/soul-partizan-29707673155","twitter":"soulpartizan","long_description":{"text":"London town is a rich and vibrant melting pot of culture. On almost every street corner you find a confluence of history and tradition, rhythm and vitality. The Soul Music that is created here has a wealth of musical forms \u0026 sounds crafted throughout the decades that continues to inspire and reinvent itself to this day.Soul Partizan Cultural Events, Art, Music \u0026 LifestyleSoul Partizan has its roots in East London where we have been promoting events, running bars and exhibitions for 20+ years. We hold  events with Independent labels, artists \u0026 designers with the energy of the \u2018Shoreditch\u201d phenomena that began in the mid-nineties and lasts to the present day. Shoreditch energy is richly diverse and multi-cultural with innovative work in technology \u0026 an explosion of creativity and open-mindedness ahead of its time on the global stage.Through social media, we re-tell the extraordinary stories and adventures of pioneers who laid down the foundations of this movement but were forced to move out of the area by gentrification. We want to highlight and challenge how these events affect the local communityBy building up an awareness, Soul Partizan aims to question where our society is headed and promote a new wave of modern conscious thinking via our radio show, podcast and all future events. We will showcase arts, music, technology \u0026 talent with a series of exciting events"},"logo_id":"879644623","num_followers":36,"num_future_events":0,"is_saved":true,"num_past_events":0,"disable_marketing_opt_in":false,"id":"29707673155","name":"Soul Partizan"},"ticket_availability":{"start_sales_date":{"timezone":"Europe/London","local":"2026-10-22T00:00:00","utc":"2026-10-21T23:00:00Z"},"quantity_sold_add_on":0,"minimum_ticket_price_rounded":{"currency":"GBP","display":"10 GBP","value":1000},"quantity_sold_paid":0,"remaining_capacity":300,"end_sales_date":{"timezone":"Europe/London","local":"2026-11-20T18:00:00","utc":"2026-11-20T18:00:00Z"},"num_ticket_classes":1,"has_available_hidden_tickets":false,"maximum_ticket_price":{"currency":"GBP","display":"10.00 GBP","value":1000},"minimum_ticket_price":{"currency":"GBP","display":"10.00 GBP","value":1000},"is_free":false,"maximum_ticket_price_rounded":{"currency":"GBP","display":"10 GBP","value":1000},"is_hold_unavailable":false,"waitlist_enabled":false,"has_bogo_tickets":false,"has_available_tickets":true,"common_sales_end_date":null,"is_sold_out":false,"waitlist_available":false,"quantity_sold_free":0,"quantity_sold":0,"open_discount":null},"urgency_signals":{"messages":[],"categories":["new"]},"image_large":{"edge_color_set":true,"edge_color":"#fbfcf7","url":"https://img.evbuc.com/https%3A%2F%2Fcdn.evbuc.com%2Fimages%2F1196374053%2F124600765361%2F1%2Foriginal.20261022-155812?crop=focalpoint\u0026fit=crop\u0026w=640\u0026auto=format%2Ccompress\u0026q=75\u0026sharp=10\u0026fp-x=0.5\u0026fp-y=0.5\u0026s=6c0040702920675cd7ee7f65f155aa19","original":{"url":"https://img.evbuc.com/https%3A%2F%2Fcdn.evbuc.com%2Fimages%2F1196374053%2F124600765361%2F1%2Foriginal.20261022-155812?auto=format%2Ccompress\u0026q=75\u0026sharp=10\u0026s=caaa9abaafa55d48d6f2caf370b9f819","width":1777,"height":885},"crop_mask":{"width":0,"top_left":{"y":0,"x":0},"height":0},"aspect_ratio":"2.005","id":"1196374053"},"image":{"edge_color_set":true,"edge_color":"#fbfcf7",