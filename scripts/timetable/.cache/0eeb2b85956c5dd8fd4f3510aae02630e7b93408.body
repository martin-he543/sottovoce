flineEventAttendanceMode"}},{"@type":"ListItem","position":4,"item":{"@type":"Event","name":"Conversations in Jazz:  Ilario Ferrari \u0026 Omar Puente (Feat. Mara Ashton)","description":"Ilario Ferrari \u0026 Omar Puente unite Italian soul and Cuban rhythms, with guest Mara Ashton, for an afternoon of songs and improvisation.","startDate":"2026-11-29","endDate":"2026-11-29","image":"https://img.evbuc.com/https%3A%2F%2Fcdn.evbuc.com%2Fimages%2F1195454279%2F712832097713%2F1%2Foriginal.20261009-150059?crop=focalpoint\u0026fit=crop\u0026w=355\u0026auto=format%2Ccompress\u0026q=75\u0026sharp=10\u0026fp-x=0.814\u0026fp-y=0.57\u0026s=0dc9bede64d176f600173b1d3f038b2a","url":"https://www.eventbrite.co.uk/e/conversations-in-jazz-ilario-ferrari-omar-puente-feat-mara-ashton-tickets-2003209018098","location":{"@type":"Place","name":"St John's Church, Watford","address":{"@type":"PostalAddress","addressRegion":"England","streetAddress":"Sutton Road","addressLocality":"Watford","addressCountry":"GB","postalCode":"WD17 2QQ"},"geo":{"@type":"GeoCoordinates","latitude":"51.65845300000001","longitude":"-0.3940254"}},"eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode"}},{"@type":"ListItem","position":5,"item":{"@type":"Event","name":"David Berkman: Masterclass and Concert","description":"Masterclass and concert with acclaimed pianist David Berkman.","startDate":"2026-11-13","endDate":"2026-11-13","image":"https://img.evbuc.com/https%3A%2F%2Fcdn.evbuc.com%2Fimages%2F1196090526%2F134386225427%2F1%2Foriginal.20261019-131514?crop=focalpoint\u0026fit=crop\u0026auto=format%2Ccompress\u0026q=75\u0026sharp=10\u0026fp-x=0.5\u0026fp-y=0.5\u0026s=3eda999875073529fe641ab3b2214fa8","url":"https://www.eventbrite.co.uk/e/david-berkman-masterclass-and-concert-tickets-2003604006519","location":{"@type":"Place","name":"Morley College Waterloo","address":{"@type":"PostalAddress","addressRegion":"Greater London","streetAddress":"61 Westminster Bridge Road","addressLocality":"London","add