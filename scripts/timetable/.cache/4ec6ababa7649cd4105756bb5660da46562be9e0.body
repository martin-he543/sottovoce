use, festival, online courses and the SEADS project that supports schools in several Caribbean and African countries.Simon Education is also the publisher of the Genius series that includes the bestsellingHow to Unlock Your Child's Genius and How to Unlock Your Genius Using Black History."},"logo_id":"591277239","num_followers":2732,"num_future_events":0,"is_saved":true,"num_past_events":0,"disable_marketing_opt_in":false,"id":"1614341840","name":"Simon Education"},"ticket_availability":{"start_sales_date":{"timezone":"Europe/London","local":"2026-04-23T00:00:00","utc":"2026-04-22T23:00:00Z"},"quantity_sold_add_on":0,"minimum_ticket_price_rounded":{"currency":"GBP","display":"0 GBP","value":0},"quantity_sold_paid":105,"remaining_capacity":1009,"end_sales_date":{"timezone":"Europe/London","local":"2026-10-24T17:30:00","utc":"2026-10-24T16:30:00Z"},"num_ticket_classes":2,"has_available_hidden_tickets":false,"maximum_ticket_price":{"currency":"GBP","display":"12.00 GBP","value":1200},"minimum_ticket_price":{"currency":"GBP","display":"0.00 GBP","value":0},"is_free":false,"maximum_ticket_price_rounded":{"currency":"GBP","display":"12 GBP","value":1200},"is_hold_unavailable":false,"waitlist_enabled":false,"has_bogo_tickets":false,"has_available_tickets":true,"common_sales_end_date":null,"is_sold_out":false,"waitlist_available":false,"quantity_sold_free":1060,"quantity_sold":1165,"open_discount":null},"urgency_signals":{"messages":["goingFast","salesEndSoon"],"categories":[]},"image_large":{"edge_color_set":true,"edge_color":"#ff6127","url":"https://img.evbuc.com/https%3A%2F%2Fcdn.evbuc.com%2Fimages%2F1182973008%2F22675090276%2F1%2Foriginal.20260424-154344?crop=focalpoint\u0026fit=crop\u0026auto=format%2Ccompress\u0026q=75\u0026sharp=10\u0026fp-x=0.531\u0026fp-y=0.172\u0026s=fec04a4d70ab58967b75cfc28666b65a","original":{"url":"https://img.evbuc.com/https%3A%2F%2Fcdn.evbuc.com%2Fimages%2F1182973008%2F22675090276%2F1%2Foriginal.20260424-154344?auto=format%2Ccompress\u0026q=