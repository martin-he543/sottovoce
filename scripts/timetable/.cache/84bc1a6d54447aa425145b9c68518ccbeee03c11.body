_PriorityBookingPatronsStarts":null,"attribute_PriorityBookingSoulmatesStarts":null,"attribute_PriorityBookingFriendsStarts":null},{"description":"1hr/15+ by Bourgeois & Maurice - Blending razor-sharp original songs with pitch-black comedy, this cabaret show transforms contemporary panic into something seductive, ridiculous and unexpectedly moving.","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"https://system.spektrix.com/youngvic/files/178d34bb-078c-47f9-9b6f-dff264576ce6.jpeg","isOnSale":true,"name":"Everything's Fine (WIP) (Shedinburgh)","instanceDates":"1 October-2 October","thumbnailUrl":"https://system.spektrix.com/youngvic/files/178d34bb-078c-47f9-9b6f-dff264576ce6-thumbnail.jpeg","webUrl":"","webEventId":null,"id":"15801AMKKPNSMSJBRKTDKDKJVGCKCBJKN","firstInstanceDateTime":"2026-10-01T21:30:00","firstInstanceDateTimeUtc":"2026-10-01T20:30:00Z","lastInstanceDateTime":"2026-10-02T21:30:00","lastInstanceDateTimeUtc":"2026-10-02T20:30:00Z","altText":"","attribute_Festival":"Shedinburgh","attribute_Genre":"Studio","attribute_SupplementaryEvent":false,"attribute_Venue":"The Maria Theatre","attribute_PriorityBookingPatronsStarts":null,"attribute_PriorityBookingSoulmatesStarts":null,"attribute_PriorityBookingFriendsStarts":null},{"description":"1hr/15+ - The Femmes of Colo(u)r Comedy Club celebrates and centers women and trans comedians of colour. Each show is impossible to repeat, disrupting the status quo with a 100% no-white-dudes-onstage guarantee. Big laughs, big energy.","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"https://system.spektrix.com/youngvic/files/a7792246-9d5c-40d6-b62f-b4bb669a0b42.jpeg","isOnSale":true,"name":"FOC it Up! with Kemah Bob (Shedinburgh)","instanceDates":"9 October-9 October","thumbnailUrl":"https://system.spektrix.com/youngvic/files/a7792246-9d5c-40d6-b62f-b4bb669a0b42-thumbnail.jpeg","webUrl":"","webEventId":null,"id":"14201ARTVMVMMBMSJNNDBHCBBRVSCTRNG","firstInstanceDateTime":"2026-10-0