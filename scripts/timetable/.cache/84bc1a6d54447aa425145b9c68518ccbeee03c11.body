[{"description":"50min/15+ by Ursula Rani Sarma - Irish novel adaptation. An Irish noblewoman in the 1700s and a young mother in the present day, both touched by tragedy, make unexpected contact as parallels between their lives emerge.","htmlDescription":"<div id>\r\n\r\n</div>","duration":50,"imageUrl":"https://system.spektrix.com/youngvic/files/d5a097e7-c7d9-4d08-b2f8-41c4f3f7520b.jpeg","isOnSale":true,"name":"A Ghost in the Throat (Shedinburgh)","instanceDates":"6 October-6 October","thumbnailUrl":"https://system.spektrix.com/youngvic/files/d5a097e7-c7d9-4d08-b2f8-41c4f3f7520b-thumbnail.jpeg","webUrl":"","webEventId":null,"id":"20201AVQHKKMVCNSSQSPNTVCQPQCKBBPV","firstInstanceDateTime":"2026-10-06T18:40:00","firstInstanceDateTimeUtc":"2026-10-06T17:40:00Z","lastInstanceDateTime":"2026-10-06T18:40:00","lastInstanceDateTimeUtc":"2026-10-06T17:40:00Z","altText":"","attribute_Festival":"Shedinburgh","attribute_SupplementaryEvent":false,"attribute_Venue":"The Maria Theatre","attribute_Genre":"","attribute_PriorityBookingPatronsStarts":null,"attribute_PriorityBookingSoulmatesStarts":null,"attribute_PriorityBookingFriendsStarts":null},{"description":"Former Royal Ballet Principal Edward Watson and performance artist Meow Meow star in Arthur Pita’s reimagining of Franz Kafka’s short story, with live music by Frank Moon. Running time: approximately 60 minutes with no interval.","htmlDescription":"<div id>\r\n\r\n</div>","duration":90,"imageUrl":"https://system.spektrix.com/youngvic/files/d508e936-72d8-4f6f-a190-9cf7576f4067.jpg","isOnSale":true,"name":"A HUNGER ARTIST","instanceDates":"9 June-26 June","thumbnailUrl":"https://system.spektrix.com/youngvic/files/d508e936-72d8-4f6f-a190-9cf7576f4067-thumbnail.jpg","webUrl":"","webEventId":null,"id":"25401ADKDNDVMDKDPLNQQVHNPHGRHDJGH","firstInstanceDateTime":"2027-06-09T20:00:00","firstInstanceDateTimeUtc":"2027-06-09T19:00:00Z","lastInstanceDateTime":"2027-06-26T20:00:00","lastInstanceDateTimeUtc":"2027-06-26T19:00:00Z","altT