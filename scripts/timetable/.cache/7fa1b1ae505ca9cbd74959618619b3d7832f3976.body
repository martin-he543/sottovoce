"78935"],"festival":null},{"id":"63269","sourceType":"event-detail","title":"Sip and Sketch: Costume Design Tour","imageTray":{"desktopPath":"https://images.prismic.io/royal-opera-house/ZpaOUB5LeNNTxNOa_veronikaward-roh-tour-adults-2023-135.jpg?auto=format,compress?auto=compress,format&rect=1264,0,4449,3337&w=1280&h=960","mobilePath":"https://images.prismic.io/royal-opera-house/ZpaOUB5LeNNTxNOa_veronikaward-roh-tour-adults-2023-135.jpg?auto=format,compress?auto=compress,format&rect=1280,0,4720,3540&w=460&h=345","thumbPath":null,"altText":null,"caption":null},"imageResult":{"desktopPath":"https://images.prismic.io/royal-opera-house/ZpaOUB5LeNNTxNOa_veronikaward-roh-tour-adults-2023-135.jpg?auto=format,compress?auto=compress,format&rect=1247,99,4753,3565&w=960&h=720","mobilePath":"https://images.prismic.io/royal-opera-house/ZpaOUB5LeNNTxNOa_veronikaward-roh-tour-adults-2023-135.jpg?auto=format,compress?auto=compress,format&rect=1237,11,4763,3572&w=460&h=345","thumbPath":"https://images.prismic.io/royal-opera-house/ZpaOUB5LeNNTxNOa_veronikaward-roh-tour-adults-2023-135.jpg?auto=format,compress?auto=compress,format&rect=1237,11,4763,3572&w=460&h=345","altText":null,"caption":null},"dateFieldOverride":null,"description":"<p>From concept to creation, explore the craftsmanship that transforms some of the most iconic costumes in stage history from concept to creation. </p>","carouselDescription":"<p>Peek inside our costume workroom and witness where designs come to life. Then, relax with a Bellini in our bar while trying your hand at sketching your own designs.</p>","productionPageUrl":null,"slug":"costume-design-tour","performances":[{"date":"2026-10-11T11:30:00+01:00","performanceType":"guided-tour"},{"date":"2026-11-21T11:30:00+00:00","performanceType":"guided-tour"}],"isCancelled":false,"ctaBehaviour":null,"cinemaBroadcastLink":{"validUntil":null,"url":"/cinemas/production/77413/findcinema"},"startTime":null,"endTime":null,"isHiddenFromTicketsAndEvents":false,"helpInformation":null,"tags":["927","1153","1349"],"bookingSeasons":["1001"],"locations":["0"],"performanceTimes":[],"onSaleDates":["dd2e69bae003659f39aa72759ccb78a7af81a1a9"],"runs":["77413"],"festival":null},{"id":"29735","sourceType":"single-production-page","title":"4.48 Psychosis","imageTray":{"desktopPath":"https://images.prismic.io/royal-opera-house/aasKDlxvIZEnjbPd_HERO_448_2627_PR8A58644.48PSYCHOSIS-PRODUCTIONIMAGE%C2%A9ROH.PHOTOGRAPHBYSTEPHENCUMMISKEY.jpg?auto=format,compress&rect=320,0,5120,3840&w=1280&h=960","mobilePath":"https://images.prismic.io/royal-opera-house/aasKDlxvIZEnjbPd_HERO_448_2627_PR8A58644.48PSYCHOSIS-PRODUCTIONIMAGE%C2%A9ROH.PHOTOGRAPHBYSTEPHENCUMMISKEY.jpg?auto=format,compress&rect=320,0,5120,3840&w=1280&h=960","thumbPath":null,"altText":"Four performers wearing black stand on stage with their backs to the audience. Large white numbers are brightly lit and projected directly onto the stage and performers. The numbers are layered on top of each other making it hard to read them properly. ","caption":null},"imageResult":{"desktopPath":"https://images.prismic.io/royal-opera-house/aasKDlxvIZEnjbPd_HERO_448_2627_PR8A58644.48PSYCHOSIS-PRODUCTIONIMAGE%C2%A9ROH.PHOTOGRAPHBYSTEPHENCUMMISKEY.jpg?auto=format,compress&rect=320,0,5120,3840&w=960&h=720","mobilePath":"https://images.prismic.io/royal-opera-house/aasKDlxvIZEnjbPd_HERO_448_2627_PR8A58644.48PSYCHOSIS-PRODUCTIONIMAGE%C2%A9ROH.PHOTOGRAPHBYSTEPHENCUMMISKEY.jpg?auto=format,compress&rect=320,0,5120,3840&w=960&h=720","thumbPath":"https://images.prismic.io/royal-opera-house/aasKDlxvIZEnjbPd_HERO_448_2627_PR8A58644.48PSYCHOSIS-PRODUCTIONIMAGE%C2%A9ROH.PHOTOGRAPHBYSTEPHENCUMMISKEY.jpg?auto=format,compress&rect=320,0,5120,3840&w=960&h=720","altText":"Four performers wearing black stand on stage with their backs to the audience. Large white numbers are brightly lit and projected directly onto the stage and performers. The numbers are layered on top of each other making it hard to read them properly. ","caption":null},"dateFieldOverride":null,"description":"<p>An unflinching portrait of fury and despair. Ted Huffman&#39;s stark and stripped-back staging of Philip Venables&#39;s opera makes its debut on the Linbury Stage. Conductor Naomi Woo draws out the moments of clarity, anguish and fleeting hope that colour the music, with the voices of six singers cutting to the heart of Sarah Kane’s text.</p>","carouselDescription":"<p>The operatic adaptation of Sarah Kane’s explosive and extraordinary play.</p>","productionPageUrl":"/production/448-psychosis-ted-huffman","slug":"448-psychosis-ted-huffman","performances":[{"date":"2026-10-17T19:15:00+01:00","performanceType":"standard"},{"date":"2026-10-19T19:15:00+01:00","performanceType":"standard"},{"date":"2026-10-20T19:15:00+01:00","performanceType":"standard"},{"date":"2026-10-22T19:15:00+01:00","performanceType":"standard"},{"date":"2026-10-24T19:15:00+01:00","performanceType":"standard"},{"date":"2026-10-25T14:00:00+00:00","performanceType":"standard"}],"isCancelled":false,"ctaBehaviour":null,"cinemaBroadcastLink":{"validUntil":null,"url":null},"startTime":"2026-10-17T19:15:00+01:00","endTime":"2026-10-25T14:00:00+00:00","isHiddenFromTicketsAndEvents":false,"helpInformation":null,"tags":["606","921","934","1063","1132","1349"],"bookingSeasons":["1001"],"locations":["73"],"performanceTimes":["936","935"],"onSaleDates":["1000ad5d978cdf1d2d9ed35a98915f049d5d5fcf","0558db9dbbbc1a516844d831f451d86397daa44e","5bfadc563bf9dfdf372cb06d772d287200e9a0b2","aa2d1537623290d7573a8dcca7caa5ef2d7c6b78","3a0bc3ec709efed904801f5433e3fb31029a519e","d79204d0ef8c691f2403c3ef25c74e58b557bc25","e2aca631972f28b09d3ac444027a5cdc6ed5fb7a","49718da6df662870fa691bfd3d21454d9f8fe1d2"],"runs":[],"festival":null},{"id":"24511","sourceType":"event-detail","title":"Family Sundays","imageTray":{"desktopPath":"https://images.prismic.io/royal-opera-house/Z5uo5pbqstJ9-DcA_RBOFamilySundayBlackHistoryMonthLauraAziz2024-180.jpg?auto=format,compress&rect=359,0,57