escription":"<p>Enjoy an evening of Italian-inspired dining and live opera on the terrace of the Royal Opera House.</p>","productionPageUrl":null,"slug":"opera-on-the-terrace","performances":[],"isCancelled":false,"ctaBehaviour":null,"cinemaBroadcastLink":{"validUntil":null,"url":null},"startTime":"2026-09-27T14:17:00+0000","endTime":"2026-11-29T15:18:00+0000","isHiddenFromTicketsAndEvents":true,"helpInformation":null,"tags":[],"bookingSeasons":[],"locations":["0"],"performanceTimes":[],"onSaleDates":[],"runs":[],"festival":null},{"id":"58087","sourceType":"event-detail","title":"The Making of The Nutcracker tour","imageTray":{"desktopPath":"https://images.prismic.io/royal-opera-house/01b86d15-b126-49e5-a793-88c89f0893c9_Children%27s+Tour+Backstage+The+Nutcracker+%C2%A92021+ROH.+Photograph+by+Andrej+Uspenski.jpg?auto=format%2Ccompress&rect=0%2C1489%2C3200%2C2400&w=1280&h=960","mobilePath":"https://images.prismic.io/royal-opera-house/01b86d15-b126-49e5-a793-88c89f0893c9_Children%27s+Tour+Backstage+The+Nutcracker+%C2%A92021+ROH.+Photograph+by+Andrej+Uspenski.jpg?auto=format%2Ccompress&rect=0%2C1600%2C3200%2C2400&w=460&h=345","thumbPath":null,"altText":null,"caption":null},"imageResult":{"desktopPath":"https://images.prismic.io/royal-opera-house/01b86d15-b126-49e5-a793-88c89f0893c9_Children%27s+Tour+Backstage+The+Nutcracker+%C2%A92021+ROH.+Photograph+by+Andrej+Uspenski.jpg?auto=format%2Ccompress&rect=0%2C1537%2C3200%2C2400&w=960&h=720","mobilePath":"https://images.prismic.io/royal-opera-house/01b86d15-b126-49e5-a793-88c89f0893c9_Children%27s+Tour+Backstage+The+Nutcracker+%C2%A92021+ROH.+Photograph+by+Andrej+Uspenski.jpg?auto=format%2Ccompress&rect=0%2C1600%2C3200%2C2400&w=460&h=345","thumbPath":"https://images.prismic.io/royal-opera-house/01b86d15-b126-49e5-a793-88c89f0893c9_Children%27s+Tour+Backstage+The+Nutcracker+%C2%A92021+ROH.+Photograph+by+Andrej+Uspenski.jpg?auto=format%2Ccompress&rect=0%2C1600%2C3200%2C2400&w=460&h=345","altText":null,"caption":null},"dateFiel