pera-house/aaqwf1xvIZEnjZ-o_HERO_TRITTICO_2627_%C2%A9BC20160222_GIANNI_SCHICCHI_1274SEEPHOTOCAPTIONSLIST-C-ROH.PHOTOGRAPHERBILLCOOPER-2.jpg?auto=format,compress&rect=221,0,3575,2681&w=960&h=720","mobilePath":"https://images.prismic.io/royal-opera-house/aaqwf1xvIZEnjZ-o_HERO_TRITTICO_2627_%C2%A9BC20160222_GIANNI_SCHICCHI_1274SEEPHOTOCAPTIONSLIST-C-ROH.PHOTOGRAPHERBILLCOOPER-2.jpg?auto=format,compress&rect=221,0,3575,2681&w=960&h=720","thumbPath":"https://images.prismic.io/royal-opera-house/aaqwf1xvIZEnjZ-o_HERO_TRITTICO_2627_%C2%A9BC20160222_GIANNI_SCHICCHI_1274SEEPHOTOCAPTIONSLIST-C-ROH.PHOTOGRAPHERBILLCOOPER-2.jpg?auto=format,compress&rect=221,0,3575,2681&w=960&h=720","altText":"A group of performers stand alongside a door frame in a room with flowered wallpaper on stage. A performer wearing a suit has come through the door and holds onto the handle. ","caption":null},"dateFieldOverride":null,"description":"<p>Join the cast and creatives of <em>Il trittico </em>as they prepare to bring Puccini’s triptych to the Main Stage this February.</p>","carouselDescription":"<p>Join cast and creatives in conversation about Puccini&#39;s triptych <em>Il trittico</em>, coming to the Royal Opera House Main Stage this February.</p>","productionPageUrl":"/production/insights-il-trittico","slug":"insights-il-trittico","performances":[{"date":"2027-02-16T19:30:00+00:00","performanceType":"landp-insights"}],"isCancelled":false,"ctaBehaviour":null,"cinemaBroadcastLink":{"validUntil":null,"url":null},"startTime":"2027-02-16T19:30:00+00:00","endTime":"2027-02-16T19:30:00+00:00","isHiddenFromTicketsAndEvents":false,"helpInformation":null,"tags":["585","924","1349"],"bookingSeasons":["1002"],"locations":["76"],"performanceTimes":["936"],"onSaleDates":["56acd2c71f4dd81e38737e29bf5e42d9b801b016","89c4fc939ddc25844651aeb528c63c4ef361890f","0558db9dbbbc1a516844d831f451d86397daa44e","4dea8cdd62d70185e3dc2feac037ff9c74e5a36e","4c636a8472121d512d4893830bc48b0d59ee0065","076d9e4636d8c0a604c62daf5f87e02472b4c54d","2f8c1e30683833b6d172dd5f2a643dc2a07c3ec6","727ac4dda2a8242d2100221df9dfcfca7629646a"],"runs":[],"festival":null},{"id":"60176","sourceType":"single-production-page","title":"MADDADDAM","imageTray":{"desktopPath":"https://images.prismic.io/royal-opera-house/aamkv1xvIZEnjXt-_HERO_MADDADDAM_2627_DSC1079.jpg?auto=format,compress&rect=291,0,4648,3486&w=1280&h=960","mobilePath":"https://images.prismic.io/royal-opera-house/aamkv1xvIZEnjXt-_HERO_MADDADDAM_2627_DSC1079.jpg?auto=format,compress&rect=291,0,4648,3486&w=1280&h=960","thumbPath":null,"altText":"A ballet dancer wearing a pink jumpsuit launches themselves into the air in front of a backdrop of a big red eye. ","caption":null},"imageResult":{"desktopPath":"https://images.prismic.io/royal-opera-house/aamkv1xvIZEnjXt-_HERO_MADDADDAM_2627_DSC1079.jpg?auto=format,compress&rect=291,0,4648,3486&w=960&h=720","mobilePath":"https://images.prismic.io/royal-opera-house/aamkv1xvIZEnjXt-_HERO_MADDADDAM_2627_DSC1079.jpg?auto=format,compress&rect=291,0,4648,3486&w=960&h=720","thumbPath":"https://images.prismic.io/royal-opera-house/aamkv1xvIZEnjXt-_HERO_MADDADDAM_2627_DSC1079.jpg?auto=format,compress&rect=291,0,4648,3486&w=960&h=720","altText":"A ballet dancer wearing a pink jumpsuit launches themselves into the air in front of a backdrop of a big red eye. ","caption":null},"dateFieldOverride":null,"description":"<p>Those who remain must find a new way of life. The dystopian future of Margaret Atwood&#39;s trilogy of novels comes alive in this multi-sensory three-act epic by Wayne McGregor. Featuring an original score by Max Richter, <em>MADDADDAM </em>sold out its premiere run in 2024.</p>","carouselDescription":"<p>Wayne McGregor’s ballet reimagines Margaret Atwood’s dystopic epic of annihilation and survival.</p>","productionPageUrl":"/production/maddaddam-wayne-mcgregor","slug":"maddaddam-wayne-mcgregor","performances":[{"date":"2027-02-22T19:30:00+00:00","performanceType":"standard"},{"date":"2027-02-24T19:30: