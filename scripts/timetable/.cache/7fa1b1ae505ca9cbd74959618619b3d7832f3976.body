:[],"festival":null},{"id":"75438","sourceType":"single-production-page","title":"Madam","imageTray":{"desktopPath":"https://images.prismic.io/royal-opera-house/aasTVVxvIZEnjbZT_HERO_MADAM_2627_7302619870_bbfd768161_o.jpg?auto=format,compress&rect=83,0,1333,1000&w=1280&h=960","mobilePath":"https://images.prismic.io/royal-opera-house/aasTVVxvIZEnjbZT_HERO_MADAM_2627_7302619870_bbfd768161_o.jpg?auto=format,compress&rect=83,0,1333,1000&w=1280&h=960","thumbPath":null,"altText":"A group of women sit around holding their arms upwards placing one hand in front of the other. The image is black and white and artistic. ","caption":null},"imageResult":{"desktopPath":"https://images.prismic.io/royal-opera-house/aasTVVxvIZEnjbZT_HERO_MADAM_2627_7302619870_bbfd768161_o.jpg?auto=format,compress&rect=83,0,1333,1000&w=960&h=720","mobilePath":"https://images.prismic.io/royal-opera-house/aasTVVxvIZEnjbZT_HERO_MADAM_2627_7302619870_bbfd768161_o.jpg?auto=format,compress&rect=83,0,1333,1000&w=960&h=720","thumbPath":"https://images.prismic.io/royal-opera-house/aasTVVxvIZEnjbZT_HERO_MADAM_2627_7302619870_bbfd768161_o.jpg?auto=format,compress&rect=83,0,1333,1000&w=960&h=720","altText":"A group of women sit around holding their arms upwards placing one hand in front of the other. The image is black and white and artistic. ","caption":null},"dateFieldOverride":null,"description":"<p>The Royal Ballet honours its founder Dame Ninette de Valois, who was known within the Company as ‘Madam’, including performances of excerpts from signature De Valois ballets as well as conversation, discussion and film delving into the enduring impact of this seminal figure on The Royal Ballet and the art form. This event is co-curated by Director Kevin O’Hare and Principal Guest Artist Lauren Cuthbertson. </p>","carouselDescription":"<p>A celebration of the pioneering woman who set the standard for British ballet.</p>","productionPageUrl":"/production/madam","slug":"madam","performances":[{"date":"2026-11-03T19:30:00+00:00","performanceType":"standard"},{"date":"2026-11-04T19:30:00+00:00","performanceType":"standard"}],"isCancelled":false,"ctaBehaviour":null,"cinemaBroadcastLink":{"validUntil":null,"url":null},"startTime":"2026-11-03T19:30:00+00:00","endTime":"2026-11-04T19:30:00+00:00","isHiddenFromTicketsAndEvents":false,"helpInformation":null,"tags":["606","922","1132","1349"],"bookingSeasons":["1001"],"locations":["73"],"performanceTimes":["936"],"onSaleDates":["1000ad5d978cdf1d2d9ed35a98915f049d5d5fcf","0558db9dbbbc1a516844d831f451d86397daa44e","5bfadc563bf9dfdf372cb06d772d287200e9a0b2","aa2d1537623290d7573a8dcca7caa5ef2d7c6b78","3a0bc3ec709efed904801f5433e3fb31029a519e","d79204d0ef8c691f2403c3ef25c74e58b557bc25","e2aca631972f28b09d3ac444027a5cdc6ed5fb7a","49718da6df662870fa691bfd3d21454d9f8fe1d2"],"runs":[],"festival":null},{"id":"74589","sourceType":"single-production-page","title":"Visionaries: Robbins and MacMillan","imageTray":{"desktopPath":"https://images.prismic.io/royal-opera-house/aal7m1xvIZEnjW5W_HERO_VISIONARY_HM2021-Dancers-at-a-Gathering-03.jpg?auto=format,compress&rect=107,0,4287,3215&w=1280&h=960","mobilePath":"https://images.prismic.io/royal-opera-house/aal7m1xvIZEnjW5W_HERO_VISIONARY_HM2021-Dancers-at-a-Gathering-03.jpg?auto=format,compress&rect=107,0,4287,3215&w=1280&h=960","thumbPath":null,"altText":"Three ballet dancers perform together wearing light coloured dresses in front of a blue backdrop on a stage. ","caption":null},"imageResult":{"desktopPath":"https://images.prismic.io/royal-opera-house/aal7m1xvIZEnjW5W_HERO_VISIONARY_HM2021-Dancers-at-a-Gathering-03.jpg?auto=format,compress&rect=107,0,4287,3215&w=960&h=720","mobilePath":"https://images.prismic.io/royal-opera-house/aal7m1xvIZEnjW5W_HERO_VISIONARY_HM2021-Dancers-at-a-Gathering-03.jpg?auto=format,compress&rect=107,0,4287,3215&w=960&h=720","thumbPath":"https://images.prismic.io/royal-opera-house/aal7m1xvIZEnjW5W_HERO_VISIONARY_HM2021-Dancers-at-a-Gathering-03.jpg?auto=format,compress&rect=107,0,4287,3215&w=960&h=720","altText":"Three ballet dancers perform together wearing light coloured dresses in front of a blue backdrop on a stage. ","caption":null},"dateFieldOverride":null,"description":"<p>Two profound meditations on humanity, community and connection. This mixed programme features Jerome Robbins’s <em>Dances at a Gathering </em>and Kenneth MacMillan’s <em>Song of the Earth.</em></p>","carouselDescription":"<p>Revel in the beauty of two 20th-century ballet masterpieces.</p>","productionPageUrl":"/production/visionaries-robbins-and-macmillan","slug":"visionaries-robbins-and-macmillan","performances":[{"date":"2026-11-09T19:30:00+00:00","performanceType":"standard"},{"date":"2026-11-12T19:30:00+00:00","performanceType":"standard"},{"date":"2026-11-17T19:30:00+00:00","performanceType":"standard"},{"date":"2026-11-20T19:30:00+00:00","performanceType":"standard"},{"date":"2026-11-23T19:30:00+00:00","performanceType":"standard"},{"date":"2026-11-24T19:30:00+00:00","performanceType":"standard"},{"date":"2026-11-28T13:00:00+00:00","performanceType":"standard"},{"date":"2026-11-28T19:00:00+00:00","performanceType":"standard"}],"isCancelled":false,"ctaBehaviour":null,"cinemaBroadcastLink":{"validUntil":null,"url":null},"startTime":"2026-11-09T19:30:00+00:00","endTime":"2026-11-28T19:00:00+00:00","isHiddenFromTicketsAndEvents":false,"helpInformation":null,"tags":["922","993","1132","1349"],"bookingSeasons":["1001"],"locations":["2"],"performanceTimes":["936","935"],"onSaleDates":["1000ad5d978cdf1d2d9ed35a98915f049d5d5fcf","0558db9dbbbc1a516844d831f451d86397daa44e","5bfadc563bf9dfdf372cb06d772d287200e9a0b2","aa2d1537623290d7573a8dcca7caa5ef2d7c6b78","3a0bc3ec709efed904801f5433e3fb31029a519e","d79204d0ef8c691f2403c3ef25c74e58b557bc25","e2aca631972f28b09d3ac444027a5cdc6ed5fb7a","49718da6df662870fa691bfd3d21454d9f8fe1d2"],"runs":[],"festival":null},{"id":"27577","sourceType":"single-production-page","title":"Insights: Un ballo in maschera","imageTray":{"desktopPath":"https://images.prismic.io/royal-opera-house/adkkf51ZCF7ETF1x_PhilippSt%C3%B6lzl_002_CopyrightTommyHetzel_2.jpg?auto=format%2Ccompress&rect=0%2C65%2C3500%2C2625&w=1280&h=960","mobilePath":"https://images.prismic.io/royal-opera-house/adkkf51ZCF7ETF1x_PhilippSt%C3%B6lzl_002_CopyrightTommyHetzel_2.jpg?auto=format%2Ccompress&rect=0%2C65%2C3500%2C2625&w=1280&h=960","thumbPath":null,"altText":"A black and white headshot of a person standing against a light wall wearing a black jacket, black hat, plastic rimmed glasses and a white knitted scarf. It is an image of the German director Philipp Stölzl.","caption":null},"imageResult":{"desktopPath":"https://images.prismic.io/royal-opera-house/adkkf51ZCF7ETF1x_PhilippSt%C3%B6lzl_002_CopyrightTommyHetzel_2.jpg?auto=format%2Ccompress&rect=0%2C80%2C3500%2C2625&w=960&h=720","mobilePath":"https://images.prismic.io/royal-opera-house/adkkf51ZCF7ETF1x_PhilippSt%C3%B6lzl_002_CopyrightTommyHetzel_2.jpg?auto=format%2Ccompress&rect=0%2C80%2C3500%2C2625&w=960&h=720","thumbPath":"https://images.prismic.io/royal-opera-house/adkkf51ZCF7ETF1x_PhilippSt%C3%B6lzl_002_CopyrightTommyHetzel_2.jpg?auto=format%2Ccompress&rect=0%2C80%2C3500%2C2625&w=960&h=720","altText":"A black and white headshot of a person standing against a light wall wearing a black jacket, black hat, plastic rimmed glasses and a white knitted scarf. It is an image of the German director Philipp Stölzl.","caption":null},"dateFieldOverride":null,"description":"<p>Join cast and creatives in conversation as they prepare to bring a playfully surreal new production of Verdi&#39;s opera to the Main Stage. </p>","carouselDescription":"<p>Join cast and creatives behind <em>Un ballo in maschera</em> in a discussion on the inspirations and themes of Philipp Stölzl&#39;s new production of Verdi&#39;s opera about murderous political conspiracy and love triangles. </p>","productionPageUrl":"/production/insights-un-ballo-in-maschera","slug":"insights-un-ballo-in-maschera","performances":[{"date":"2026-11-11T19:45:00+00:00","performanceType":"landp-insights"}],"isCancelled":false,"ctaBehaviour":null,"cinemaBroadcastLink":{"validUntil":null,"url":null},"startTime":"2026-11-11T19:45:00+00:00","endTime":"2026-11-11T19:45:00+00:00","isHiddenFromTicketsAndEvents":false,"helpInformation":null,"tags":["585","606","924","1349"],"bookingSeasons":["1001"],"locations":["73"],"performanceTimes":["936"],"onSaleDates":["1000ad5d978cdf1d2d9ed35a98915f049d5d5fcf","5bfadc563bf9dfdf372cb06d772d287200e9a0b2","aa2d1537623290d7573a8dcca7caa5ef2d7c6b78","3a0bc3ec709efed904801f5433e3fb31029a519e","d79204d0ef8c691f2403c3ef25c74e58b557bc25","2607eb06cb0958b7ecc27466cc67af3abdd14a6d","e2aca631972f28b09d3ac444027a5cdc6ed5fb7a","49718da6df662870fa691bfd3d21454d9f8fe1d2"],"runs":[],"festival":null},{"id":"74533","sourceType":"single-production-page","title":"Un ballo in maschera (A Masked Ball)","imageTray":{"desktopPath":"https://images.prismic.io/royal-opera-house/aiA6WQeQX7-eWqg7_szilveszter_mako_RBO-1_EXT_WEB.jpg?auto=format%2Ccompress&rect=49%2C419%2C4902%2C3677&w=1280&h=960","mobilePath":"https://images.prismic.io/royal-opera-house/aiA6WQeQX7-eWqg7_szilveszter_mako_RBO-1_EXT_WEB.jpg?auto=format%2Ccompress&rect=49%2C419%2C4902%2C3677&w=1280&h=960","thumbPath":null,"altText":"Surreal theatrical scene in an empty yellow room, representing the set design of Philipp Stölzl’s Un ballo in maschera. Six black-clad figures with dramatic 1920’s-inspired make-up appear frozen in dramatic poses around the room. One figure lies sprawled on the wooden yellow floor with a red piece of fabric emerging from his vest and twisting through the air at the centre. Other figures emerge from the doorways around the central character, creating a dreamlike, unsettling atmosphere.","caption":null},"imageResult":{"desktopPath":"https://images.prismic.io/royal-opera-house/aiA6WQeQX7-eWqg7_szilveszter_mako_RBO-1_EXT_WEB.jpg?auto=format%2Ccompress&rect=50%2C381%2C4950%2C3713&w=960&h=720","mobilePath":"https://images.prismic.io/royal-opera-house/aiA6WQeQX7-eWqg7_szilveszter_mako_RBO-1_EXT_WEB.jpg?auto=format%2Ccompress&rect=50%2C381%2C4950%2C3713&w=960&h=720","thumbPath":"https://images.prismic.io/royal-opera-house/aiA6WQeQX7-eWqg7_szilveszter_mako_RBO-1_EXT_WEB.jpg?auto=format%2Ccompress&rect=50%2C381%2C4950%2C3713&w=960&h=720","altText":"Surreal theatrical scene in an empty yellow room, representing the set design of Philipp Stölzl’s Un ballo in maschera. Six black-clad figures with dramatic 1920’s-inspired make-up appear frozen in dramatic poses around the room. One figure lies sprawled on the wooden yellow floor with a red piece of fabric emerging from his vest and twisting through the air at the centre. Other figures emerge from the doorways around the central character, creating a dreamlike, unsettling atmosphere.","caption":null},"dateFieldOverride":null,"description":"<p>A love triangle. A conspiracy. A murder foretold. Verdi’s <em>Un ballo in maschera</em> (A Masked Ball) invites you to a twisting world of political and personal tension, all culminating in one treacherous night on the dance floor. Director Philipp Stölzl makes his Royal Opera debut with a playfully surreal new production, featuring costumes by Antony McDonald. </p>","carouselDescription":"<p>Verdi’s stirring political drama is recast against a surreal, theatrical backdrop.</p>","productionPageUrl":"/production/un-ballo-in-maschera-philipp-stolzl","slug":"un-ballo-in-maschera-philipp-stolzl","performances":[{"date":"2026-11-30T19:00:00+00:00","performanceType":"standard"},{"date":"2026-12-02T19:30:00+00:00","performanceType":"standard"},{"date":"2026-12-07T19:30:00+00:00","performanceType":"standard"},{"date":"2026-12-10T19:30:00+00:00","performanceType":"standard"},{"date":"2026-12-12T19:30:00+00:00","performanceType":"standard"},{"date":"2026-12-15T19:30:00+00:00","performanceType":"standard"},{"date":"2026-12-18T19:30:00+00:00","performanceType":"standard"}],"isCancelled":false,"ctaBehaviour":null,"cinemaBroadcastLink":{"validUntil":null,"url":null},"startTime":"2026-11-30T19:00:00+00:00","endTime":"2026-12-18T19:30:00+00:00","isHiddenFromTicketsAndEvents":false,"helpInformation":null,"tags":["921","1132","1349","993"],"bookingSeasons":["1001"],"locations":["2"],"performanceTimes":["936"],"onSaleDates":["1000ad5d978cdf1d2d9ed35a98915f049d5d5fcf","0558db9dbbbc1a516844d831f451d86397daa44e","5bfadc563bf9dfdf372cb06d772d287200e9a0b2","aa2d1537623290d7573a8dcca7caa5ef2d7c6b78","3a0bc3ec709efed904801f5433e3fb31029a519e","d79204d0ef8c691f2403c3ef25c74e58b557bc25","e2aca631972f28b09d3ac444027a5cdc6ed5fb7a","49718da6df662870fa691bfd3d21454d9f8fe1d2"],"runs":[],"festival":null},{"id":"10437","sourceType":"single-production-page","title":"Insights: Sir Peter Wright and The Nutcracker","imageTray":{"desktopPath":"https://images.prismic.io/royal-opera-house/acKukJGXnQHGY60L_PETERWRIGHT_2627_StudioportraitofPeterWright1951%C2%A9RogerWood.jpg?auto=format,compress&rect=31,0,1249,937&w=1280&h=960","mobilePath":"https://images.prismic.io/royal-opera-house/acKukJGXnQHGY60L_PETERWRIGHT_2627_StudioportraitofPeterWright1951%C2%A9RogerWood.jpg?auto=format,compress&rect=31,0,1249,937&w=1280&h=960","thumbPath":null,"altText":"A black and white studio portrait photograph of the choreographer Peter Wright in 1951. He stands wearing black leotard and black top. ","caption":null},"imageResult":{"desktopPath":"https://images.prismic.io/royal-opera-house/acKukJGXnQHGY60L_PETERWRIGHT_2627_StudioportraitofPeterWright1951%C2%A9RogerWood.jpg?auto=format,compress&rect=31,0,1249,937&w=960&h=720","mobilePath":"https://images.prismic.io/royal-opera-house/acKukJGXnQHGY60L_PETERWRIGHT_2627_StudioportraitofPeterWright1951%C2%A9RogerWood.jpg?auto=format,compress&rect=31,0,1249,937&w=960&h=720","thumbPath":"https://images.prismic.io/royal-opera-house/acKukJGXnQHGY60L_PETERWRIGHT_2627_StudioportraitofPeterWright1951%C2%A9RogerWood.jpg?auto=format,compress&rect=31,0,1249,937&w=960&h=720","altText":"A black and white studio portrait photograph of the choreographer Peter Wright in 1951. He stands wearing black leotard and black top. ","caption":null},"dateFieldOverride":null,"description":"<p>As The Royal Ballet prepares for <em>The Nutcracker</em> to return to the Main Stage, join cast and creatives in a celebration of the career of Sir Peter Wright, the man behind The Royal Ballet’s magical production. This Season marks Peter Wright’s centenary.</p>","carouselDescription":"<p>As The Royal Ballet prepares for <em>The Nutcracker</em> to return to the Main Stage, join cast and creatives in a celebration of the career of Sir Peter Wright, the man behind The Royal Ballet’s magical production. This Season marks Peter Wright’s centenary.</p>","productionPageUrl":"/production/insights-sir-peter-wright-and-the-nutcracker","slug":"insights-sir-peter-wright-and-the-nutcracker","performances":[{"date":"2026-12-02T19:00:00+00:00","performanceType":"landp-insights"}],"isCancelled":false,"ctaBehaviour":null,"cinemaBroadcastLink":{"validUntil":null,"url":null},"startTime":"2026-12-02T19:00:00+00:00","endTime":"2026-12-02T19:00:00+00:00","isHiddenFromTicketsAndEvents":false,"helpInformation":null,"tags":["585","606","924","1349"],"bookingSeasons":["1001"],"locations":["73"],"performanceTimes":["936"],"onSaleDates":["1000ad5d978cdf1d2d9ed35a98915f049d5d5fcf","5bfadc563bf9dfdf372cb06d772d287200e9a0b2","aa2d1537623290d7573a8dcca7caa5ef2d7c6b78","3a0bc3ec709efed904801f5433e3fb31029a519e","d79204d0ef8c691f2403c3ef25c74e58b557bc25","2607eb06cb0958b7ecc27466cc67af3abdd14a6d","e2aca631972f28b09d3ac444027a5cdc6ed5fb7a","49718da6df662870fa691bfd3d21454d9f8fe1d2"],"runs":[],"festival":null},{"id":"56","sourceType":"single-production-page","title":"The Nutcracker","imageTray":{"desktopPath":"https://images.prismic.io/royal-opera-house/acv5qZGXnQHGZI_t_HERO_NUTS_V2_2627_DSC3599_V2.jpg?auto=format,compress&rect=0,1134,5430,4073&w=1280&h=960","mobilePath":"https://images.prismic.io/royal-opera-house/acv5qZGXnQHGZI_t_HERO_NUTS_V2_2627_DSC3599_V2.jpg?auto=format,compress&rect=0,1134,5430,4073&w=1280&h=960","thumbPath":null,"altText":"A man dressed in a red military jacket, white tights and black boots jumps in front of a large christmas tree with presents underneath.","caption":null},"imageResult":{"desktopPath":"https://images.prismic.io/royal-opera-house/acv5qZGXnQHGZI_t_HERO_NUTS_V2_2627_DSC3599_V2.jpg?auto=format,compress&rect=0,1134,5430,4073&w=960&h=720","mobilePath":"https://images.prismic.io/royal-opera-house/acv5qZGXnQHGZI_t_HERO_NUTS_V2_2627_DSC3599_V2.jpg?auto=format,compress&rect=0,1134,5430,4073&w=960&h=720","thumbPath":"https://images.prismic.io/royal-opera-house/acv5qZGXnQHGZI_t_HERO_NUTS_V2_2627_DSC3599_V2.jpg?auto=format,compress&rect=0,1134,5430,4073&w=960&h=720","altText":"A man dressed in a red military jacket, white tights and black boots jumps in front of a large christmas tree with presents underneath.","caption":null},"dateFieldOverride":null,"description":"<p>Peter Wright&#39;s classic production of this festive family favourite sparkles to the swell of Tchaikovsky’s orchestral score, alongside the glow and grandeur of Julia Trevelyan Oman’s period designs. This Season marks Peter Wright’s centenary.</p>","carouselDescription":"<p>Experience the most magical of adventures.</p>","productionPageUrl":"/production/the-nutcracker-peter-wright","slug":"the-nutcracker-peter-wright","performances":[{"date":"2026-12-03T19:30:00+00:00","performanceType":"standard"},{"date":"2026-12-04T12:30:00+00:00","performanceType":"schools-matinee"},{"date":"2026-12-04T19:00:00+00:00","performanceType":"standard"},{"date":"2026-12-05T14:00:00+00:00","performanceType":"standard"},{"date":"2026-12-05T19:30:00+00:00","performanceType":"standard"},{"date":"2026-12-08T19:30:00+00:00","performanceType":"standard"},{"date":"2026-12-09T19:30:00+00:00","performanceType":"standard"},{"date":"2026-12-11T19:30:00+00:00","performanceType":"standard"},{"date":"2