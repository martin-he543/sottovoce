a-house/aasKS1xvIZEnjbP-_HERO_BALLETBLACK_2627_ASH_151225_0114.jpg?auto=format,compress&rect=0,1362,5447,4085&w=960&h=720","thumbPath":"https://images.prismic.io/royal-opera-house/aasKS1xvIZEnjbP-_HERO_BALLETBLACK_2627_ASH_151225_0114.jpg?auto=format,compress&rect=0,1362,5447,4085&w=960&h=720","altText":"Eleven ballet dancers who are part of Ballet Black pose together in an ornate building in front of stained glass windows. ","caption":null},"dateFieldOverride":null,"description":"<p>Experience three distinctive ballets demonstrating the range, individuality and unmistakable spirit of Cassa Pancho&#39;s Ballet Black. </p>","carouselDescription":"<p>Cassa Pancho&#39;s dynamic dance company returns to the Linbury Theatre.</p>","productionPageUrl":"/production/ballet-black-27","slug":"ballet-black-27","performances":[{"date":"2027-03-22T19:15:00+00:00","performanceType":"standard"},{"date":"2027-03-23T19:15:00+00:00","performanceType":"standard"},{"date":"2027-03-24T19:15:00+00:00","performanceType":"standard"},{"date":"2027-03-25T19:15:00+00:00","performanceType":"standard"},{"date":"2027-03-27T19:15:00+00:00","performanceType":"standard"}],"isCancelled":false,"ctaBehaviour":null,"cinemaBroadcastLink":{"validUntil":null,"url":null},"startTime":"2027-03-22T19:15:00+00:00","endTime":"2027-03-27T19:15:00+00:00","isHiddenFromTicketsAndEvents":false,"helpInformation":null,"tags":["922","1132","1349"],"bookingSeasons":["1002"],"locations":["73"],"performanceTimes":["936"],"onSaleDates":["56acd2c71f4dd81e38737e29bf5e42d9b801b016","89c4fc939ddc25844651aeb528c63c4ef361890f","0558db9dbbbc1a516844d831f451d86397daa44e","4dea8cdd62d70185e3dc2feac037ff9c74e5a36e","4c636a8472121d512d4893830bc48b0d59ee0065","076d9e4636d8c0a604c62daf5f87e02472b4c54d","2f8c1e30683833b6d172dd5f2a643dc2a07c3ec6","727ac4dda2a8242d2100221df9dfcfca7629646a"],"runs":[],"festival":null},{"id":"chroma-wayne-mcgregor","sourceType":"single-production-page","title":"Chroma","imageTray":{"desktopPath":"https://images.prismic.io/royal-opera-house/abgxUbbci2UF6EQI_DISRUPTORS_Chroma.ArtistsoftheRoyalBallet.%C2%A9ROH%2C2016%2CPhotographedbyAndrejUspenski.jpg?auto=format%2Ccompress&rect=1528%2C0%2C4223%2C3167&w=1280&h=960","mobilePath":"https://images.prismic.io/royal-opera-house/abgxUbbci2UF6EQI_DISRUPTORS_Chroma.ArtistsoftheRoyalBallet.%C2%A9ROH%2C2016%2CPhotographedbyAndrejUspenski.jpg?auto=format%2Ccompress&rect=1528%2C0%2C4223%2C3167&w=1280&h=960","thumbPath":null,"altText":"A group of dancers stand on stage, they wear skin coloured costumes. The stage is bare except for a black rectangle on the backdrop. The female dancers hold a their legs in the air.","caption":null},"imageResult":{"desktopPath":"https://images.prismic.io/royal-opera-house/abgxUbbci2UF6EQI_DISRUPTORS_Chroma.ArtistsoftheRoyalBallet.%C2%A9ROH%2C2016%2CPhotographedbyAndrejUspenski.jpg?auto=format%2Ccompress&rect=1538%2C0%2C4223%2C3167&w=960&h=720","mobilePath":"https://images.prismic.io/royal-opera-house/abgxUbbci2UF6EQI_DISRUPTORS_Chroma.ArtistsoftheRoyalBallet.%C2%A9ROH%2C2016%2CPhotographedbyAndrejUspenski.jpg?auto=format%2Ccompress&rect=1538%2C0%2C4223%2C3167&w=960&h=720","thumbPath":"https://images.prismic.io/royal-opera-house/abgxUbbci2UF6EQI_DISRUPTORS_Chroma.ArtistsoftheRoyalBallet.%C2%A9ROH%2C2016%2CPhotographedbyAndrejUspenski.jpg?auto=format%2Ccompress&rect=1538%2C0%2C4223%2C3167&w=960&h=720","altText":"A group of dancers stand on stage, they wear skin coloured costumes. The stage is bare except for a black rectangle on the backdrop. The female dancers hold a their legs in the air.","caption":null},"dateFieldOverride":null,"description":"<p>Wayne McGregor&#39;s <em>Chroma </em>burst onto the scene in 2006, electrifying audiences with its radical exploration of the extremes of the human body. With a powerful high-voltage score by Joby Talbot and Jack White III, <em>Chroma</em> and its success led to McGregor&#39;s appointment in his current role as Resident Choreographer and earned him an Olivier award. </p>","carouselDescription":"<p>Wayne McGregor&#39;s <em>Chroma </em>burst onto the scene in 2006, electrifying audiences with its radical exploration of the extremes of the human body. With a powerful high-voltage score by Joby Talbot and Jack White III, <em>Chroma</em> and its success led to McGregor&#39;s appointment in his current role as Resident Choreographer and earned him an Olivier award. </p>","productionPageUrl":"/production/chroma-wayne-mcgregor","slug":"chroma-wayne-mcgregor","performances":[],"isCancelled":false,"ctaBehaviour":null,"cinemaBroadcastLink":{"validUntil":null,"url":null},"startTime":null,"endTime":null,"isHiddenFromTicketsAndEvents":false,"helpInformation":null,"tags":[],"bookingSeasons":[],"locations":[],"performanceTimes":[],"onSaleDates":[],"runs":[],"festival":null},{"id":"concerto-kenneth-macmillan","sourceType":"single-production-page","title":"Concerto","imageTray":{"desktopPath":"https://images.prismic.io/royal-opera-house/T8WNtmuGfp-AKM24_Concerto.ReeceClarkeandLaurenCuthbertson.%C2%A9ROH%2C2019.PhotographedbyTristramKenton.-3-.JPG?auto=format,compress&rect=57,0,4104,3078&w=1280&h=960","mobilePath":"https://images.prismic.io/royal-opera-house/T8WNtmuGfp-AKM24_Concerto.ReeceClarkeandLaurenCuthbertson.%C2%A9ROH%2C2019.PhotographedbyTristramKenton.-3-.JPG?auto=format,compress&rect=57,0,4104,3078&w=1280&h=960","thumbPath":null,"altText":"Two dancers wearing yellow leotards appear on stage. The dancer in front crouches with one knee bent in front of him and arms outstretched to the side. Behind him the other dancer has her legs in the splits in a vertical line from the floor, she balances her body on the man's back.","caption":null},"imageResult":{"desktopPath":"https://images.prismic.io/royal-opera-house/T8WNtmuGfp-AKM24_Concerto.ReeceClarkeandLaurenCuthbertson.%C2%A9ROH%2C2019.PhotographedbyTristramKenton.-3-.JPG?auto=format,compress&rect=57,0,4104,3078&w=960&h=720","mobilePath":"https://images.prismic.io/royal-opera-house/T8WNtmuGfp-AKM24_Concerto.ReeceClarkeandLaurenCuthbertson.%C2%A9ROH%2C2019.PhotographedbyTristramKenton.-3-.JPG?auto=format,compress&rect=57,0,4104,3078&w=960&h=720","thumbPath":"https://images.prismic.io/royal-opera-house/T8WNtmuGfp-AKM24_Concerto.ReeceClarkeandLaurenCuthbertson.%C2%A9ROH%2C2019.PhotographedbyTristramKenton.-3-.JPG?auto=format,compress&rect=57,0,4104,3078&w=960&h=720","altText":"Two dancers wearing yellow leotards appear on stage. The dancer in front crouches with one knee bent in front of him and arms outstretched to the side. Behind him the other dancer has her legs in the splits in a vertical line from the floor, she balances her body on the man's back.","caption":null},"dateFieldOverride":null,"description":"<p>Resplendent and blazing bright, Kenneth MacMillan&#39;s <em>Concerto </em>is a non-narrative ballet from 1966, set to Dmitri Shostakovich&#39;s evocative second piano concerto, at turns both exuberant and languorous. </p>","carouselDescription":"<p>Resplendent and blazing bright, Kenneth MacMillan&#39;s <em>Concerto </em>is a non-narrative ballet from 1966, set to Dmitri Shostakovich&#39;s evocative second piano concerto, at turns both exuberant and languorous. </p>","productionPageUrl":"/production/concerto-kenneth-macmillan","slug":"concerto-kenneth-macmillan","performances":[],"isCancelled":false,"ctaBehaviour":null,"cinemaBroadcastLink":{"validUntil":null,"url":null},"startTime":null,"endTime":null,"isHiddenFromTicketsAndEvents":false,"helpInformation":null,"tags":[],"bookingSeasons":[],"locations":[],"performanceTimes":[],"onSaleDates":[],"runs":[],"festival":null},{"id":"74609","sourceType":"single-production-page","title":"Così fan tutte","imageTray":{"desktopPath":"https://images.prismic.io/royal-opera-house/cRgDppZdm2h4b_l5_MS_260721_RoyalOperaHouse_Shot06_024.jpg?auto=format%2Ccompress&rect=72%2C34%2C4365%2C3274&w=1280&h=960","mobilePath":"https://images.prismic.io/royal-opera-house/cRgDppZdm2h4b_l5_MS_260721_RoyalOperaHouse_Shot06_024.jpg?auto=format%2Ccompress&rect=72%2C34%2C4365%2C3274&w=1280&h=960","thumbPath":null,"altText":"A woman in a maid costume with a white shirt and black trousers bends over on a lawn to collect empty cans from the ground, while a performer in an elaborate pink period costume lies across her back, holding an electric fan above her head.","caption":null},"imageResult":{"desktopPath":"https://images.prismic.io/royal-opera-house/cRgDppZdm2h4b_l5_MS_260721_RoyalOperaHouse_Shot06_024.jpg?auto=format%2Ccompress&rect=72%2C37%2C4360%2C3270&w=960&h=720","mobilePath":"https://images.prismic.io/royal-opera-house/cRgDppZdm2h4b_l5_MS_260721_RoyalOperaHouse_Shot06_024.jpg?auto=format%2Ccompress&rect=72%2C37%2C4360%2C3270&w=960&h=720","thumbPath":"https://images.prismic.io/royal-opera-house/cRgDppZdm2h4b_l5_MS_260721_RoyalOperaHouse_Shot06_024.jpg?auto=format%2Ccompress&rect=72%2C37%2C4360%2C3270&w=960&h=720","altText":"A woman in a maid costume with a white shirt and black trousers bends over on a lawn to collect empty cans from the ground, while a performer in an elaborate pink period costume lies across her back, holding an electric fan above her head.","caption":null},"dateFieldOverride":null,"description":"<p>Netia Jones reimagines Mozart’s comedy of manners through a sharp contemporary lens, where 18th-century romantic trickery meets deeply satirical high-tech deceit. Louise Alder, Simone McIntosh, Mingjie Lei and Huw Montague Rendall are the four lovers, with Gerald Finley as their manipulative game-master Don Alfonso and Emily Pogorelc as Despina. Thomas Hengelbrock conducts.</p>","carouselDescription":"<p>Power plays and dangerous liaisons. Mozart&#39;s comedy of manners returns in a sharp contemporary new staging.</p>","productionPageUrl":"/production/cosi-fan-tutte-netia-jones","slug":"cosi-fan-tutte-netia-jones","performances":[{"date":"2027-02-10T18:30:00+00:00","performanceType":"standard"},{"date":"2027-02-12T19:00:00+00:00","performanceType":"standard"},{"date":"