        toggle() {
            if (this.open) return this.close();
            this.$refs.button.focus();
            this.open = true;
        },
        close(focusAfter) {
            if (!this.open) return;
            this.open = false;
            focusAfter && focusAfter.focus();
        },
        checkStuck() {
            const rect = this.$el.getBoundingClientRect();
            if (! rect.height) return;
            const offset = parseFloat(getComputedStyle(this.$el).top) || 0;
            this.stuck = rect.top <= offset + 1;
        }
    }"
    x-init="$nextTick(() => checkStuck())"
    x-on:scroll.window.passive="checkStuck()"
    x-on:resize.window="checkStuck()"
