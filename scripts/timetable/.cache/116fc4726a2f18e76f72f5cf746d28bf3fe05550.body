                class="flex justify-center items-center mt-1 px-4 py-3 bg-primary border border-transparent rounded-md font-semibold text-xs text-white uppercase tracking-widest hover:bg-hover transition-colors"
                aria-label="Submit search">
                Search
            </button>
        </div>
