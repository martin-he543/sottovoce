    id="search-panel"
    class="fixed top-0 right-0 z-50 flex justify-center items-center px-12 py-6 w-screen max-w-full bg-white shadow-lg outline-none focus:outline-none">

    <form action="/search" method="get" class="mx-auto w-full max-w-screen-md" role="search">
        <h2 id="search-heading" class="sr-only">Search Delfont Mackintosh Theatres website</h2>
        <div class="flex justify-between items-center gap-2 my-4 pl-2 pr-1 pt-0 pb-1 border-none rounded-md bg-gray-light w-full">
            <div class="text-copy">
