            </div>
            <div class="flex-1">
                <label for="search" class="sr-only">Search for shows, theatres, experiences and more from Delfont Mackintosh Theatres</label>
                <input
                    class="mt-1 block w-full border-transparent bg-transparent placeholder:text-gray-400 rounded-sm focus:outline-none focus:ring-0 focus-visible:outline-none"
