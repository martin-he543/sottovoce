                    id="search"
                    name="q"
                    value=""
                    type="search"
                    required="required"
                    autocomplete="off"
                    x-ref="searchInput"
                    x-init="$watch('open_search', value => { if(value) { setTimeout(() => $refs.searchInput.focus(), 150) } })"
