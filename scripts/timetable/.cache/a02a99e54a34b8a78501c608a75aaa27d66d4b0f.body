    <!--[if BLOCK]><![endif]-->        <div class="accordion-block">
            <section aria-label="Accordion" class="accordion-wrapper"     x-data="{
        active: null,
        init() {
            this.scrollToHash();

            /*
             * In-page links written into an item's content are plain anchors, so the
             * browser scrolls to the fragment ITSELF the moment one is clicked —
             * instantly, and at the pre-collapse position, because nothing has
             * animated yet. Our own corrected scroll then arrived a quarter-second
             * later and pulled the page back: two scrolls, the first one wrong.
             *
             * pushState changes the hash WITHOUT that native jump, which is the whole
             * point of routing through it; hashchange does not fire for pushState, so
             * it is dispatched by hand. Exactly one hashchange either way, which is
             * what the accordion items match themselves against.
             */
            this.$el.addEventListener('click', (e) => {
                const link = e.target.closest('a[href^=\'#\']');
                if (! link || ! this.$el.contains(link)) return;

                const id = link.getAttribute('href').slice(1);
                if (! id || ! document.getElementById(id)) return;

                e.preventDefault();

                if (window.location.hash !== '#' + id) {
                    history.pushState(null, '', '#' + id);
                }

                window.dispatchEvent(new HashChangeEvent('hashchange'));
            });

            window.addEventListener('hashchange', () => {
                /*
                 * Clear before the items re-match, so a level the new hash does not name
                 * ends up closed rather than keeping whatever it had open. Without this,
                 * '#ways-to-save/family-tickets' then '#access' left family-tickets still
                 * open inside the collapsed Ways To Save panel, and a later plain
                 * '#ways-to-save' would reveal it.
                 *
                 * Ordering is what makes this work: Alpine initialises a parent before its
                 * children, so this listener is registered before each item's
                 * x-on:hashchange, and therefore runs first. A nested accordion clears its
                 * own `active` the same way, after the outer items have matched.
                 *
                 * Only clear when the first segment names a real element, though. Every
                 * section renders its anchor as an id, so a genuine section link always
                 * resolves — while a bare sub-anchor ('#images', naming only a tab) or a
                 * typo does not. Clearing on those collapsed the whole accordion and left
                 * the tab selected inside a closed section.
                 */
                if (document.getElementById(this.hashSegments()[0] ?? '')) {
                    this.active = null;
                }
                this.scrollToHash();
            });
        },
        /*
         * Deep links address one level per segment: '#gallery/videos' opens the
         * 'gallery' section and selects the 'videos' tab inside it.
         *
         * Opening is NOT done here, because this component does not know its
         * items' ids — each accordion-item matches itself against these segments
         * instead. That is also why nesting needs no depth tracking: a nested
         * accordion declares its own x-data (so its own `active`), and its items
         * match the same segment list.
         */
        hashSegments() {
            return window.location.hash.slice(1).split('/').filter(Boolean).map(s => s.toLowerCase());
        },
        /*
         * Only the first segment names a scroll target — the deeper ones are tabs
         * and sub-items inside it. A nested accordion runs this too and resolves
         * to the same element, which is harmless.
         */
        scrollToHash() {
            const first = this.hashSegments()[0];
            if (! first) return;
            this.$nextTick(() => {
                const el = document.getElementById(first);
                if (! el) return;

                /*
                 * Wait for the layout to stop moving before scrolling, rather than
                 * scrolling on the next tick.
                 *
                 * Following a link from inside one open item to another changes the
                 * hash, which closes the current item and opens the target. Both are
                 * ANIMATED height transitions (x-collapse). $nextTick is one Alpine
                 * tick, long before they finish, so the target was measured while the
                 * item above it was still at full height — and the smooth scroll then
                 * animated to a position that was wrong by exactly that height,
                 * overshooting well past the item.
                 *
                 * offsetTop, not getBoundingClientRect(): it is relative to the
                 * offsetParent, so it changes as panels above collapse but NOT as the
                 * page scrolls. That distinction is what makes it usable as a settle
                 * signal — a viewport-relative measure would keep changing under the
                 * smooth scroll itself and never settle.
                 *
                 * Two stable frames rather than one, since a transition can report the
                 * same height twice in a row mid-animation on a slow frame. The 40
                 * frame cap (~0.7s) is a floor under a transition that never ends;
                 * with nothing open it settles on the second frame, so a plain deep
                 * link from a cold page is unaffected.
                 */
                let done = false;
                const go = () => {
                    if (done) return;
                    done = true;
                    el.scrollIntoView({ behavior: 'smooth', block: 'start' });
                };

                let last = null, stable = 0, frames = 0;
                const settle = () => {
                    if (done) return;

                    const top = el.offsetTop;
                    stable = top === last ? stable + 1 : 0;
                    last = top;

                    if (stable >= 2 || ++frames > 40) return go();

                    requestAnimationFrame(settle);
                };
                requestAnimationFrame(settle);

                /*
                 * rAF does not fire in a background tab, and the loop above would then
                 * never reach its own frame cap -- leaving the scroll undone rather than
                 * merely late. Timers are throttled there but still fire, so this is the
                 * floor. `done` makes the two paths idempotent: whichever arrives first
                 * scrolls, the other returns.
                 */
                setTimeout(go, 700);
            });
        }
    }"
