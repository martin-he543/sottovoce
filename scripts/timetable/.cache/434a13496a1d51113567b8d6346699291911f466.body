                                                                            <template data-dialog-content="dialog-person-cast-and-creatives-6adca65e47ee6">
                                            <article class="person-dialog">
                                                <div class="person-dialog__image">
                                                    

                                                                                                            <ul role="list" class="social-links" aria-label="Social media links">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    </ul>
                                                                                                    </div>


                                                <div class="person-dialog__content">
                                                    <div class="person-dialog__header margin-trim">
                                                        <h2>Thom Southerland </h2>

                                                                                                                    <h4>Adaptor & Director</h4>
                                                                                                            </div>

                                                    <div class="person-dialog__bio">
                                                        <p class="type-body-xl"></p>

                                                        <div class="person-dialog__bio__main__text">
                                                            <p><span data-contrast="auto">Thom is a freelance theatre director, writer, and practitioner, and has served as Artistic Director at both the Mayflower Theatre and Studios in Southampton and the Charing Cross Theatre in London. </span><span data-ccp-props="{}"> </span></p>
<p><span data-contrast="auto">Theatre Credits Include: DISNEY’S REMEMBER (Disney Live Entertainment); NOEL &amp; GERTIE (UK Tour); CHITTY CHITTY BANG BANG (UK tour); TITANIC (UK and international tours, Charing Cross Theatre, Princess of Wales, Toronto, Umeda Arts, Tokyo, Osaka &amp; Southwark Playhouse); GRAND HOTEL (Umeda Arts, Tokyo &amp; Southwark Playhouse); SHE LOVES YOU (Copenhagen); ANGELA’S ANGELS (Irish and UK tours); THE PAJAMA GAME (Umeda Arts, Tokyo); SANXINGDUI (China tour); NOISES OFF (Berlin); CANDIDE (Bergen National Opera); HAROLD AND MAUDE, THE WOMAN IN WHITE, DEATH TAKES A HOLIDAY, RAGTIME &#8211; Off West End Award for Best Musical Production, THE MIKADO (Charing Cross Theatre); ALLEGRO, GREY GARDENS, VICTOR/VICTORIA, MACK AND MABEL, PARADE &#8211; Longlisted for Evening Standard Theatre Award for Best Musical, nominated for WhatsOnStage Award for Best Musical Revival and Off West End Award for Best Musical Production (Southwark Playhouse); THE SMALLEST SHOW ON EARTH (UK tour); PETER PAN (US tour); THE GRAND TOUR, ME AND JULIET &#8211; Off West End Award for Best Director, STATE FAIR (Finborough &amp; Trafalgar Studios).</span><span data-ccp-props="{}"> </span></p>

                                                        </div>
                                                    </div>
                                                </div>
                                            </article>
                                        </template>
                                    
                                    


