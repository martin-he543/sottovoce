                                                                            <template data-dialog-content="dialog-person-cast-and-creatives-6adca65e481c7">
                                            <article class="person-dialog">
                                                <div class="person-dialog__image">
                                                    

                                                                                                            <ul role="list" class="social-links" aria-label="Social media links">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    </ul>
                                                                                                    </div>


                                                <div class="person-dialog__content">
                                                    <div class="person-dialog__header margin-trim">
                                                        <h2>Gareth Tucker</h2>

                                                                                                                    <h4>Sound Designer for Autograph Sound</h4>
                                                                                                            </div>

                                                    <div class="person-dialog__bio">
                                                        <p class="type-body-xl"></p>

                                                        <div class="person-dialog__bio__main__text">
                                                            <p><span data-contrast="auto">Theatre Design Credits Include: THE UNLIKELY PILGRIMAGE OF HAROLD FRY (Chichester &amp; London); NATASHA, PIERRE AND THE GREAT COMET OF 1812 (Donmar Warehouse); COME ALIVE, THE GREATEST SHOWMAN (Earls Court); CHITTY CHITTY BANG BANG (UK Tour 2024); 42nd STREET (UK Tour, Toronto); GARY BARLOW, A DIFFERENT STAGE (UK Tour/London); THE LION, THE WITCH &amp; THE WARDROBE (UK Tour/London); SPRING AWAKENING (Central School Of Speech &amp; Drama); MY FAIR LADY</span> <span data-contrast="auto">(Grange Opera); INTO THE WOODS (Central School Of Speech And Drama); STREET SCENE (Opera North); MOBY DICK (Union Theatre); LIKE ME THE MUSICAL (Waterloo East Theatre); MUCH ADO ABOUT NOTHING (Ludlow Shakespeare Festival); JEST END (Leicester Square Theatre); COPA CABANA (Watermill Theatre); TWELFTH NIGHT (Ludlow Shakespeare Festival).</span><span data-ccp-props="{}"> </span></p>
<p><span data-contrast="auto">Associate Design Credits Include: THE HUNGER GAMES (Troubadour, Canary Wharf); GOOD NIGHT OSCAR (Barbican); DIRTY DANCING (Secret Cinema); 2:22 A GHOST STORY, A CHRISTMAS CAROL (Dominion Theatre); CITY OF ANGELS (Garrick Theatre); SWEENEY TODD (Royal Danish Opera); STRANGER THINGS (Secret Cinema, London); BIG THE MUSICAL (Dominion Theatre); THE BAND (UK, Germany); CALENDAR GIRLS (UK Tour); JESUS CHRIST SUPERSTAR (Barbican); EVITA (Regents Park). </span><span data-ccp-props="{}"> </span></p>
<p><span data-contrast="auto">Television Design Credits include: ROMEO &amp; JULIET (CBeebies).</span><span data-ccp-props="{}"> </span></p>
<p><span data-contrast="auto">Mixing Credits include: HAMILTON (Victoria Palace Theatre); THE GIRLS (Phoenix Theatre); JESUS CHRIST SUPERSTAR (Regents Park); SEVEN BRIDES FOR SEVEN BROTHERS (Regents Park Open Air Theatre); A VIEW FROM THE BRIDGE (Wyndham’s Theatre), URINETOWN (St James / Apollo Theatre), SPAMALOT (Playhouse Theatre), FINDING NEVERLAND (Leicester Curve); SINGIN’ IN THE RAIN Singin’ (Palace Theatre); FELA (International/American Tour); LOVE STORY (Duchess Theatre); GREASE (Piccadilly Theatre); WE WILL ROCK YOU (Dominion Theatre); CATS (Tour, Germany); SUNSET BOULEVARD (Watermill Theatre); OLIVIER AWARDS 2015/2016 (Royal Opera House).</span><span data-ccp-props="{}"> </span></p>

                                                        </div>
                                                    </div>
                                                </div>
                                            </article>
                                        </template>
                                    
                                    


