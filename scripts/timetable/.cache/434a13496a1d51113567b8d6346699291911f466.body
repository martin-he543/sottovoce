                                                                            <template data-dialog-content="dialog-person-cast-and-creatives-6adca65e481e6">
                                            <article class="person-dialog">
                                                <div class="person-dialog__image">
                                                    

                                                                                                            <ul role="list" class="social-links" aria-label="Social media links">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    </ul>
                                                                                                    </div>


                                                <div class="person-dialog__content">
                                                    <div class="person-dialog__header margin-trim">
                                                        <h2>Jonathan Lipman</h2>

                                                                                                                    <h4>Costume Designer </h4>
                                                                                                            </div>

                                                    <div class="person-dialog__bio">
                                                        <p class="type-body-xl"></p>

                                                        <div class="person-dialog__bio__main__text">
                                                            <p><span data-contrast="auto">Theatre Costume Design credits include: MIDNIGHT AT THE NEVER GET</span> <span data-contrast="auto">(Menier Chocolate Factory);</span><i><span data-contrast="auto"> </span></i><span data-contrast="auto">ALFRED HITCHCOCK PRESENTS &#8211; THE MUSICAL (Theatre Royal Bath); CLOSE UP &#8211; THE TWIGGY MUSICAL (Menier Chocolate Factory); IDENTICAL</span><i><span data-contrast="auto"> </span></i><span data-contrast="auto">(Nottingham Playhouse, Kenny Wax Productions</span><i><span data-contrast="auto">)</span></i><span data-contrast="auto">; FIDDLER ON THE ROOF</span><i><span data-contrast="auto"> (</span></i><span data-contrast="auto">Menier Chocolate Factory, West End, Olivier award nomination, Best Costume Design); CANDIDE (Bergen Opera, Norway); VIOLET HAROLD AND MAUDE, THE WOMAN IN WHITE, THE KNOWLEDGE, THE BRAILLE LEGACY, DEATH TAKES A HOLIDAY</span><i><span data-contrast="auto"> &#8211; </span></i><span data-contrast="auto">OFFIE award, Best Costume</span> <span data-contrast="auto">Design</span><i><span data-contrast="auto"> &#8211; </span></i><span data-contrast="auto">RAGTIME, IN THE BAR OF A TOKYO HOTEL, THE MIKADO (Charing Cross Theatre, London); SUMMER IN LONDON (Theatre Royal Stratford East, London); ALLEGRO, GREY GARDENS (Southwark Playhouse, London); THE COUNTRY GIRL (West End &amp; UK Tour); LARKRISE TO CANDLEFORD, KEELER, THE HAUNTING, THE HANDYMAN, JEKYLL &amp; HYDE: THE MUSICAL, BLOCKBUSTER: THE MUSICAL (UK Tours); LA FANCIULLA DEL WEST, UN BALLO IN MASCHERA, DIE FLEDERMAUS (Opera Up Close, King’s Head Theatre, UK tour and West End); VIEUX CARRÉ, QUASIMODO, A TALE OF TWO CITIES (Theatre Up Close, London).</span><span data-ccp-props="{}"> </span></p>
<p><span data-contrast="auto">Associate Costume Design credits include: DEATH OF A SALESMAN (Zorlu Performing Arts, Istanbul); AMERICAN PSYCHO (Almeida Theatre); MERRILY WE ROLL ALONG (Menier Chocolate Factory, Sonia Friedman Productions); RICHARD III </span><i><span data-contrast="auto">(</span></i><span data-contrast="auto">Old Vic, BAM &amp; World Tour); DR DEE</span><i><span data-contrast="auto"> </span></i><span data-contrast="auto">(Manchester International Festival &amp; ENO). </span><span data-ccp-props="{}"> </span></p>
<p><span data-contrast="auto">Film, Costume Design credits include: SOMETHING BORROWED SOMETHING BLUE; CASE 237; ORIGINAL SIN; BESHERT; AUNTY JI; SEED OF DOUBT; SPOOR; THE EFFECTS OF LYING; PRISONER C 33; JOY; ROSE; SUNLIGHT; THE HOUDINI GIRL; THE MONKEY’S PAW.  </span><span data-ccp-props="{}"> </span></p>

                                                        </div>
                                                    </div>
                                                </div>
                                            </article>
                                        </template>
                                    
                                    


