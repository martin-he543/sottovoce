                                                                            <template data-dialog-content="dialog-person-cast-and-creatives-6adca65e481ac">
                                            <article class="person-dialog">
                                                <div class="person-dialog__image">
                                                    

                                                                                                            <ul role="list" class="social-links" aria-label="Social media links">
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    </ul>
                                                                                                    </div>


                                                <div class="person-dialog__content">
                                                    <div class="person-dialog__header margin-trim">
                                                        <h2>Robbie Butler </h2>

                                                                                                                    <h4>Lighting Designer </h4>
                                                                                                            </div>

                                                    <div class="person-dialog__bio">
                                                        <p class="type-body-xl"></p>

                                                        <div class="person-dialog__bio__main__text">
                                                            <p><span data-contrast="auto">Robbie is an Olivier Award nominated lighting designer, he won the inaugural Profile Award for Outstanding Achievement in Opera, an Off West End Award for Best Lighting Design, and was the winner of the 2015 ETC Award. He is also one of only a handful of Life Members of the Association for Lighting Production and Design.</span><span data-ccp-props="{&quot;201341983&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:240}"> </span></p>
<p><span data-contrast="auto">Training: Royal Conservatoire of Scotland.</span><span data-ccp-props="{&quot;201341983&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:240}"> </span></p>
<p><span data-contrast="auto">Theatre Credits Include: THE SHINING (Malmö Opera); THE RESISTIBLE RISE OF ARTURO UI (Royal Shakespeare Company, Stratford); PUNCH (Broadway, West End, Young Vic, UK Tour, Nottingham Playhouse); REVERBERATION, HOW TO WIN AGAINST HISTORY (Bristol Old Vic); DEATH IN VENICE (Welsh National Opera); THE MAKROPULOS AFFAIR (Scottish Opera).</span><span data-ccp-props="{&quot;201341983&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:240}"> </span></p>
<p><span data-contrast="auto">He has further worked with The National Theatre of Scotland, Greek National Opera, Polish National Opera, Den Norske Opera and Ballet and The English Theatre, Frankfurt.</span><span data-ccp-props="{&quot;201341983&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:240}"> </span></p>
<p><span data-ccp-props="{&quot;201341983&quot;:0,&quot;335559739&quot;:0,&quot;335559740&quot;:240}"> </span></p>

                                                        </div>
                                                    </div>
                                                </div>
                                            </article>
                                        </template>
                                    
                                    


