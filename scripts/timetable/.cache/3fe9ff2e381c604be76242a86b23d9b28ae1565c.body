ngReport":true,"attribute_Location":"Studio 1","attribute_LongEventName":"2026: Dear Jack, Dear Louise","attribute_Festival":""},{"description":"16+, Content warning: Strong language, flashing lights, audience participation, puppetry, Camilla Parker-Bowles \r\n\r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":75,"imageUrl":"","isOnSale":true,"name":"2026: Diana: The Untold and Untrue Story","instanceDates":"6 July-11 July","thumbnailUrl":"","webUrl":"","webEventId":"01-2026:005","id":"204493APLCGBLBGBHDRHJJHQRNDPVSBLN","firstInstanceDateTime":"2026-07-06T19:30:00","firstInstanceDateTimeUtc":"2026-07-06T18:30:00Z","lastInstanceDateTime":"2026-07-11T19:30:00","lastInstanceDateTimeUtc":"2026-07-11T18:30:00Z","altText":"","attribute_AccountCode":"01-2026:005","attribute_AgreedServiceChargeExclusion":false,"attribute_EventCopyLine":"2026: Diana: The Untold and Untrue Story","attribute_Genre":"Theatre","attribute_IncludeInFundingReport":false,"attribute_Location":"Studio 1","attribute_LongEventName":"Diana: The Untold and Untrue Story","attribute_Festival":""},{"description":"Inspired by the shocking true story of 19-year-old black woman Tyisha Miller, who was shot dead by four California police officers while she lay unconscious in a car, this electrifying fusion of beatboxing, spoken word and hip-hop dance reimagines her final living moments.  \r\n\r\nDreamscape is structured around an autopsy report. As each of the twelve bullet wounds is described Tyisha’s life bursts into vivid detail on stage - from the joy of dancing and softball to first kisses and hair styling. The violence of her death is juxtaposed with lyrical remembrance of her life.\r\n\r\nThis highly acclaimed, clear-eyed look at the relationship between race, the body and violence got rave reviews at the Edinburgh Festival last year, won an Edinburgh Festival Fringe Theatre Award, was one of The Stage’s Best Shows To See and One of The Scotsman’s Top 5 Shows. ","htmlDescription":"<div id>\r\n\r\n</div>","duration":75,"imageUrl":"","isOnSale":true,"name":"2026: Dreamscape","instanceDates":"28 July-8 August","thumbnailUrl":"","webUrl":"","webEventId":"02-2026:207","id":"204893ABLTMMMPJNNMLVPJNQJJMHRNHLP","firstInstanceDateTime":"2026-07-28T19:00:00","firstInstanceDateTimeUtc":"2026-07-28T18:00:00Z","lastInstanceDateTime":"2026-08-08T19:00:00","lastInstanceDateTimeUtc":"2026-08-08T18:00:00Z","altText":"","attribute_AccountCode":"02-2026:207","attribute_AgreedServiceChargeExclusion":false,"attribute_EventCopyLine":"2026: Dreamscape","attribute_Genre":"Theatre","attribute_IncludeInFundingReport":false,"attribute_Location":"Studio 2","attribute_LongEventName":"2026: Dreamscape","attribute_Festival":""},{"description":"50/50 Box Office Split with Metal Rabbit Productions","htmlDescription":"<div id>\r\n\r\n</div>","duration":80,"imageUrl":"","isOnSale":true,"name":"2026: Fire Fire","instanceDates":"9 September-3 October","thumbnailUrl":"","webUrl":"","webEventId":"02-2026:208","id":"205293AHVDRKTNCSVKNTKJJQSKVGPMSHV","firstInstanceDateTime":"2026-09-09T19:00:00","firstInstanceDateTimeUtc":"2026-09-09T18:00:00Z","lastInstanceDateTime":"2026-10-03T19:00:00","lastInstanceDateTimeUtc":"2026-10-03T18:00:00Z","altText":"","attribute_AccountCode":"02-2026:208","attribute_AgreedServiceChargeExclusion":false,"attribute_EventCopyLine":"2026: Fire Fire","attribute_Genre":"Theatre","attribute_IncludeInFundingReport":false,"attribute_Location":"Studio 2","attribute_LongEventName":"2026: Fire Fire","attribute_Festival":""},{"description":"This show contains flashing lights, haze, the use of vapes, strong language, depictions of drug use, and distressing or potentially triggering themes including sexual assault.","htmlDescription":"<div id>\r\n\r\n</div>","duration":75,"imageUrl":"","isOnSale":true,"name":"2026: FLUSH","instanceDates":"6 May-6 June","thumbnailUrl":"","webUrl":"","webEventId":"02-2026:202","id":"197093ABDPLTJRMJHBBRVJLQQHQPDCPTV","firstInstanceDateTime":"2026-05-