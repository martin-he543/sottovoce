025: Tristan Und Isolde Masterclass","attribute_IncludeInFundingReport":false,"attribute_Location":"Studio 1","attribute_LongEventName":"2025: Tristan Und Isolde Masterclas","attribute_Festival":"","attribute_Genre":""},{"description":"","htmlDescription":"<div id>\r\n\t<h1> We Are Not Numbers</h1>\r\n</div>","duration":90,"imageUrl":"","isOnSale":true,"name":"2025: We Are Not Numbers - Fundraiser","instanceDates":"7 December-7 December","thumbnailUrl":"","webUrl":"","webEventId":"01-2026:004","id":"199493ASKCLMNNPJHDPJHDCSLQMSMCQGD","firstInstanceDateTime":"2025-12-07T19:30:00","firstInstanceDateTimeUtc":"2025-12-07T19:30:00Z","lastInstanceDateTime":"2025-12-07T19:30:00","lastInstanceDateTimeUtc":"2025-12-07T19:30:00Z","altText":"","attribute_AccountCode":"01-2026:004","attribute_AgreedServiceChargeExclusion":false,"attribute_EventCopyLine":"We Are Not Numbers","attribute_Genre":"Fundraiser","attribute_IncludeInFundingReport":false,"attribute_Location":"Studio 1","attribute_Festival":"","attribute_LongEventName":""},{"description":"Participation workshops","htmlDescription":"<div id>\r\n\t<h1>Community Company Serious Play Adult Workshops</h1>\r\n</div>","duration":0,"imageUrl":"","isOnSale":true,"name":"2025:Community Company Serious Play Adult Workshops","instanceDates":"7 May-2 July","thumbnailUrl":"","webUrl":"","webEventId":"05-2025:205","id":"188693ARVJHPLBKQVBTBQNDVRHDPQHLMG","firstInstanceDateTime":"2025-05-07T19:45:00","firstInstanceDateTimeUtc":"2025-05-07T18:45:00Z","lastInstanceDateTime":"2025-07-02T19:45:00","lastInstanceDateTimeUtc":"2025-07-02T18:45:00Z","altText":"","attribute_AccountCode":"05-2025:205","attribute_AgreedServiceChargeExclusion":false,"attribute_IncludeInFundingReport":false,"attribute_Location":"Participation","attribute_LongEventName":"Community Company Serious Play Adul","attribute_Festival":"","attribute_EventCopyLine":"","attribute_Genre":""},{"description":"50/50 split\r\n\r\nHave not given confirmation of press night and therefore amount of previews for this show as of 19/11","htmlDescription":"<div id>\r\n\r\n</div>","duration":125,"imageUrl":"","isOnSale":true,"name":"2026: A Fine Idea ","instanceDates":"11 June-4 July","thumbnailUrl":"","webUrl":"","webEventId":"02-2026:203","id":"199093ALRGDDDJBTSNPRLQNLCVMPGNVMJ","firstInstanceDateTime":"2026-06-11T19:00:00","firstInstanceDateTimeUtc":"2026-06-11T18:00:00Z","lastInstanceDateTime":"2026-07-04T19:00:00","lastInstanceDateTimeUtc":"2026-07-04T18:00:00Z","altText":"","attribute_AccountCode":"02-2026:203","attribute_AgreedServiceChargeExclusion":false,"attribute_EventCopyLine":"2026: A Fine Idea","attribute_Genre":"Theatre","attribute_IncludeInFundingReport":false,"attribute_Location":"Studio 2","attribute_LongEventName":"2026: A Fine Idea","attribute_Festival":""},{"description":"***This production includes themes of war, trauma and distress.***\r\n\r\n**Commissioned by London Palestine Film Festival\r\nSupported by Liverpool Arab Arts Festival\r\nAdapted from A Million Kites: Testimonies and Poems from the Children of Gaza by Leila Boukarim and Asaf Luzon\r\n\r\nRenad, a young Gazan girl, embarks on a dangerous journey. Carrying only the echoes of her grandmother’s tales and the spark of her own imagination, she searches for her family and the ‘Anqaa’ - the mythical Palestinian Phoenix.\r\n\r\nA Grain of Sand is a one-woman show that takes an intimate look at war through the eyes of a child, blending Palestinian folklore with real-life testimonies from children in contemporary Gaza. Renad’s story is one of resilience, hope and the right of children to be children.**\r\n\r\n**Q&A's over various dates post-show with the performer and writer, most likely every night but waiting for confirmation from Good Chance **","htmlDescription":"<div id>\r\n\r\n</div>","duration":50,"imageUrl":"","isOnSale":true,"name":"2026: A Grain of Sand","instanceDates":"21 January-31 January","thumbnailUrl":"","webUrl":"","webEventId":"01-2026:001","id":"195893APPKQTNRPQQSTBQQDQTRQHCRHSS","firstInstanceDateTime":"2026-01-21T19:30:00","firstInstanceDateTimeUtc":"2026-01-21T19:30:00Z","lastInstanceDateTime":"2026-01-31T19:30:00","lastInstanceDateTimeUtc":"2026-01-31T19:30:00Z","altText":"","attribute_AccountCode":"01-2026:001","attribute_AgreedServiceChargeExclusion":false,"attribute_EventCopyLine":"2026: A Grain of Sand","attribute_Genre":"Theatre","attribute_IncludeInFundingReport":false,"attribute_Location":"Studio 1","attribute_LongEventName":"2026: A Grain of Sand","attribute_Festival":""},{"description":"","htmlDescription":"<div id>\r\n\t<h1>Arcola 50 plus, Spring term fees, January to March 2026</h1>\r\n</div>","duration":0,"imageUrl":"","isOnSale":true,"name":"2026: Arcola 50 plus Spring term fees","instanceDates":"25 March-25 March","thumbnailUrl":"","webUrl":"","webEventId":"05-2026:202","id":"200293AJBBSLQCBKVVJMDLDSHMHMCJDVR","firstInstanceDateTime":"2026-03-25T19:30:00","firstInstanceDateTimeUtc":"2026-03-25T19:30:00Z","lastInstanceDateTime":"2026-03-25T19:30:00","lastInstanceDateTimeUtc":"2026-03-25T19:30:00Z","altText":"","attribute_AccountCode":"05-2026:202","attribute_AgreedServiceChargeExclusion":false,"attribute_EventCopyLine":"Arcola 50 plus spring fees 2026","attribute_Genre":"Workshop","attribute_IncludeInFundingReport":false,"attribute_Location":"Participation","attribute_Festival":"","attribute_LongEventName":""},{"description":"Wednesday 6 May - 2pm - 4pm RR2\r\nWednesday 3 June - 2pm - 4pm BAR\r\nWednesday 1 July - 2pm - 4pm RR2\r\nWednesday 5 August - 2pm - 4pm RR2\r\nWednesday 2 September - 2pm - 4pm BAR \r\n\r\nEach event costs £5 to book and there are 25 spaces available each session. Bursaries through Aoife only. Names and emails needed so Participation can contact directly before the workshop.","htmlDescription":"<div id>\r\n\r\n</div>","duration":0,"imageUrl":"","isOnSale":true,"name":"2026: Arcola 50+ Serious Play - Summer workshops","instanceDates":"6 May-5 August","thumbnailUrl":"","webUrl