</svg></div>
			<h6>Search</h6>
		</button>

		<button type="button" data-dialog-open="site-header-overlay" aria-label="Open the full main menu" aria-haspopup="true" aria-expanded="false" aria-controls="site-header-overlay" class="btn btn--brand-1 btn--square btn-hamburger">
