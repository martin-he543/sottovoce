\"filmEvents\":{\"title\":\"Explore film\",\"ctaButton\":\"View all\",\"bookButton\":\"Book now\",\"ariaLabel\":\"Explore film events\"}},\"quickFilters\":{\"title\":\"Explore categories\"},\"arriveInConfidence\":{\"title\":\"Arrive in confidence\",\"description\":\"From finding the right entrance to moving through the venue, here's what to know before you arrive.\"}},\"communityEvents\":{\"title\":\"Community events\",\"description\":\"We're proud to host a lively mix of community events.\",\"ctaButton\":\"Learn More\",\"bookButton\":\"Book now\",\"ariaLabel\":\"Explore community events\"},\"eventDetails\":{\"soldOut\":\"Sold out\",\"performanceLoadError\":{\"message\":\"Failed to load data. Please try again later or\",\"contactUsLinkText\":\"contact us\"},\"importantInfo\":{\"title\":\"Important to know\",\"onlineSalesOnlyMessage\":\"Online sales only. Customers with access requirements should call ##PHONE_NUMBER##\"},\"menuItems\":{\"about\":\"About\",\"overview\":\"Overview\",\"sponsorsSpecialThanks\":\"Special thanks to our Sponsor for this event\",\"reviews\":\"Reviews\",\"cast\":\"Cast \u0026 Creatives\",\"castAndProduction\":\"Cast \u0026 Creatives\",\"pricingInfo\":\"Pricing \u0026 Discounts\",\"termsAndConditions\":\"Terms \u0026 conditions\"},\"memberOnlyOffersInfo\":{\"defaultIntro\":\"Priority Live members can unlock exclusive ticket offers on these performances.\",\"defaultIntroWithLink\":\"Select a performance to choose seats, or learn more about ##REDIRECT_URL##\",\"showAllPerformances\":\"Show all performances\",\"showFewerPerformances\":\"Show fewer performances\",\"priorityLiveMembership\":\"Priority Live Membership\",\"tags\":{\"bslInterpreted\":\"BSL\",\"captioned\":\"captioned\",\"relaxed\":\"relaxed\",\"audioDescribed\":\"audio described\"}},\"accessibilityInfo\":{\"title\":\"Accessibility\",\"defaultIntro\":\"We offer dedicated performances to make this event more accessible for everyone.\",\"memberZones\":\"Offer available in zone:\",\"tags\":{\"bslInterpreted\":\"BSL\",\"captioned\":\"captioned\",\"relaxed\":\"relaxed\",\"audioDescribed\":\"audio described\"}},\"ticketInfoBox\":{\"freeEvent\":\"Free\",\"change\":\"Change\"},\"relatedEvents\":\"You might also like\",\"eventKeyInfo\":{\"bookTickets\":\"Book tickets\",\"onlineSalesOnly\":\"online sales only\",\"venue\":\"Venue\",\"runtime\":\"Runtime\",\"runtimeIntervalSuffix\":\"incl. interval\",\"from\":\"from\",\"getDirections\":\"Get directions\",\"ageRestriction\":\"Age\",\"externalTicketsLinkText\":\"Tickets are sold via an official ticketing partner. You’ll be redirected to complete your booking.\"},\"bookSection\":{\"soldOutTitle\":\"See dates \u0026 times\",\"selectPerformance\":\"Choose a performance\",\"soldOutPerformance\":\"Find a performance\",\"selectDate\":\"Choose a date to book\",\"soldOutDate\":\"Choose a date\",\"nextShowings\":\"Next Showings\",\"memberOnlyOffers\":\"Member-only offers\"},\"subscriptionSection\":{\"disclaimer\":\"Offer available when booking both performances together\",\"description\":\"Mix and match your favourite shows and unlock exclusive discounts.\",\"cta\":{\"explore\":\"Explore\",\"getBundle\":\"Get Bundle\"}},\"groupBooking\":{\"title\":\"Booking for a group?\",\"ariaLabel\":\"Group booking link\",\"cta\":\"Get in touch\"}},\"whatsOn\":{\"featuredEventsTitle\":\"Featured\",\"pageHeader\":{\"campaignHeader\":{\"heading\":\"Grab exclusive tickets deals on must see shows\",\"description\":\"Looking for a good laugh? You're in the right place. From big name acts to rising stars, our comedy line-up brings all the fun to Bridge Theatre.\"},\"defaultHeader\":{\"heading\":\"What's On\",\"description\":\"Explore must-see theatre, comedy to live music and family shows.\"}},\"pageBody\":{\"results\":{\"noResultsTitle\":\"No events match your filters\",\"loadMore\":\"Load more\",\"showingCount\":\"Showing ##VISIBLE## of ##TOTAL## events\"}},\"supportingContent\":{\"defaultHeading\":\"What's on at Bridge Theatre in London\"},\"genreContent\":{\"classical-and-opera\":{\"metaTitle\":\"Classical \u0026 Opera Performances at Bridge Theatre | Book now\",\"metaDescription\":\"Discover stunning live classical concerts and opera at Bridge Theatre. Book your tickets for unforgettable musical experiences today.\",\"title\":\"Classical \u0026 Opera Shows at Bridge Theatre\",\"description\":\"Enjoy world-class classical \u0026 opera performances at Bridge Theatre. From symphony orchestras to timeless operatic works — book your tickets to a night of elegance now.\"},\"comedy\":{\"metaTitle\":\"Comedy Shows at Bridge Theatre | Book Online\",\"metaDescription\":\"Enjoy some of the hottest names in comedy at Bridge Theatre! Discover top comedy shows and book your tickets easily online today.\",\"title\":\"Comedy Shows at Bridge Theatre\",\"description\":\"Looking for a night of laughter? See some of the biggest and well-known comedians or discover the next big thing with up-and-coming comedy acts, Bridge Theatre is the place to see comedy.\"},\"dance\":{\"metaTitle\":\"Dance Shows at Bridge Theatre | Book Tickets Online\",\"metaDescription\":\"Experience the rhythm, movement, and energy of live dance at Bridge Theatre. Ballet, contemporary, and more — Book now.\",\"title\":\"Dance Shows at Bridge Theatre\",\"description\":\"From graceful ballet to high-energy street dance, Bridge Theatre brings powerful movement to the stage. Explore upcoming dance performances and secure your dance show tickets today.\"},\"family\":{\"metaTitle\":\"Family Shows at Bridge Theatre | Fun for All Ages\",\"metaDescription\":\"Discover exciting, family-friendly theatre at Bridge Theatre. Perfect for children and grown-ups alike — book your tickets today.\",\"title\":\"Family Shows at Bridge Theatre\",\"description\":\"Treat the whole family to live entertainment they'll love. From children's shows to heartwarming stories, our family lineup is designed to delight all generations. Book your family show tickets today.\"},\"film\":{\"metaTitle\":\"Film Events at Bridge Theatre | Book Tickets Online\",\"metaDescription\":\"Discover film screenings and special film events at Bridge Theatre. Browse upcoming events and book tickets online.\",\"title\":\"Film Events at Bridge Theatre\",\"description\":\"Experience film on the big screen at Bridge Theatre, from family favourites and timeless classics to special screenings. Browse upcoming film events and book your tickets.\"},\"music\":{\"metaTitle\":\"Live Music at Bridge Theatre | Book Concert Tickets\",\"metaDescription\":\"From tribute acts to chart-topping stars, Bridge Theatre hosts unforgettable live music. Browse gigs and book your tickets today.\",\"title\":\"Live Music at Bridge Theatre\",\"description\":\"Feel the beat with live music at Bridge Theatre. From solo artists to live bands, find a music night that gets you moving — and book early to avoid missing out.\"},\"musical\":{\"metaTitle\":\"Musical Tickets at Bridge Theatre | West End Hits \u0026 More\",\"metaDescription\":\"See smash-hit musicals at Bridge Theatre — from beloved classics to the latest sensations. Book now for a night of musical magic.\",\"title\":\"Musicals at Bridge Theatre\",\"description\":\"Step into a world of song, story, and spectacle. Whether it's a dazzling West End classic or a brand-new production, musicals at Bridge Theatre unmissable. Book tickets to musicals now.\"},\"other\":{\"metaTitle\":\"Unique Shows at Bridge Theatre | Book Other Events\",\"metaDescription\":\"Explore a variety of live events beyond traditional genres — comedy, talks, and one-night specials at Bridge Theatre.\",\"title\":\"Special Events at Bridge Theatre\",\"description\":\"Looking for something a little different? Discover an eclectic mix of events from spoken word to live podcasts — perfect for curious minds and adventurous nights out. Book and secure your tickets early.\"},\"pantomime\":{\"metaTitle\":\"Pantomime at Bridge Theatre | Festive Fun for Everyone\",\"metaDescription\":\"Book your panto tickets now for a magical Christmas at Bridge Theatre! Packed with laughs, songs, and festive cheer.\",\"title\":\"Pantomime at Bridge Theatre\",\"description\":\"Oh yes it is! Panto season is the highlight of the year at Bridge Theatre. Join the fun with jokes, songs, and seasonal sparkle — perfect for the whole family. Book your tickets to Panto now and secure your seats for the Christmas season.\"},\"play\":{\"metaTitle\":\"Plays at Bridge Theatre | Powerful Live Theatre\",\"metaDescription\":\"Discover edge-of-your-seat thrillers and classic comedies at Bridge Theatre. Book tickets for acclaimed plays and UK tours now.\",\"title\":\"Plays at Bridge Theatre\",\"description\":\"For lovers of great storytelling, Bridge Theatre offers entertaining plays that stir the imagination — from celebrated classics to contemporary voices. Book play tickets today.\"},\"community\":{\"metaTitle\":\"Community at Bridge Theatre | Inspiring creativity\",\"metaDescription\":\"Community at Bridge Theatre — inspiring creativity through youth theatre, workshops and local projects.\",\"title\":\"Community Events at Bridge Theatre\",\"description\":\"Discover community programmes at Bridge Theatre, bringing people together through youth theatre, creative workshops, and local partnerships that welcome all ages and abilities. There's something for everyone to join, learn, and enjoy.\"},\"creative-learning\":{\"metaTitle\":\"Creative Learning at Bridge Theatre | Inspiring creativity\",\"metaDescription\":\"Creative Learning at Bridge Theatre — inspiring creativity through youth theatre, workshops and local projects.\",\"title\":\"Creative Learning at Bridge Theatre\",\"description\":\"Discover creative learning programmes at Bridge Theatre, bringing people together through youth theatre, creative workshops, and local partnerships that welcome all ages and abilities. There's something for everyone to join, learn, and enjoy.\"},\"christmas\":{\"metaTitle\":\"Christmas Events \u0026 Shows at Bridge Theatre | Dining \u0026 Family Fun\",\"metaDescription\":\"Celebrate Christmas at Bridge Theatre — with festive shows, dining events, and community activities for all ages this holiday season.\",\"title\":\"Christmas Events \u0026 Festive Fun at Bridge Theatre\",\"description\":\"Celebrate the season at Bridge Theatre with festive shows, dining experiences, and community events. Join us for magical moments and fun for all ages this Christmas.\"}}},\"getInvolved\":{\"eventsSection\":{\"title\":\"Community \u0026 creative events\"}},\"membership\":{\"metadata\":{\"metaTitle\":\"Membership | Trafalgar Tickets | Priority Live\",\"metaDescription\":\"Join Priority Live. Get early ticket access, member savings and exclusive perks. Membership £45 per year.\"},\"info\":{\"heading\":\"One membership, across all our Trafalgar venues\",\"description\":\"Get early access to tickets, exclusive member savings and perks at the bar. All for just £45 a year.\",\"cards\":[{\"key\":\"presale-access\",\"title\":\"Book before the crowds\",\"description\":\"Get first pick of seats with early access before general sales\",\"icon\":\"event_available\"},{\"key\":\"member-savings\",\"title\":\"Member only savings\",\"description\":\"Unlock discounts on the shows you love most\",\"icon\":\"loyalty\"},{\"key\":\"food-and-drink-discount\",\"title\":\"20% off food \u0026 drinks\",\"description\":\"Enjoy interval drinks and snacks for less at the bar\",\"icon\":\"fork_spoon\"}],\"cta\":{\"title\":\"Become a member\",\"description\":\"Renews annually, cancel anytime\",\"url\":\"https://booking.bridgetheatre.co.uk/en/bridge-theatre-london/buyingflow/membership/priority-live-br\"}},\"exclusiveOffers\":{\"title\":\"Explore exclusive offers\",\"bookButton\":\"View all\",\"ariaLabel\":\"Explore exclusive offers\"},\"goodToKnow\":{\"heading\":\"Good to know\",\"description\":\"A few key things to know about how your membership works.\",\"cards\":[{\"title\":\"Renewals made simple\",\"description\":\"Your membership lasts a full year and renews automatically\",\"icon\":\"check\"},{\"title\":\"Cancel anytime\",\"description\":\"Stop your renewal whenever you like, no strings attached\",\"icon\":\"check\"},{\"title\":\"14-day money back\",\"description\":\"Changed your mind? Cancel within 14 days for a full refund\",\"icon\":\"check\"},{\"title\":\"Always up to date\",\"description\":\"Benefits and savings may change, but you'll always have the latest perks\",\"icon\":\"check\"}],\"cta\":{\"text\":\"Join for £45/year\",\"action\":\"https://booking.bridgetheatre.co.uk/en/bridge-theatre-london/buyingflow/membership/priority-live-br\"},\"secondaryCta\":{\"text\":\"See full Terms \u0026 Conditions\",\"action\":\"/terms-and-conditions\"}},\"faq\":{\"heading\":\"Frequently asked questions\",\"items\":[{\"title\":\"Can I change my mind after joining?\",\"description\":\"Yes. If you’ve changed your mind, just get in touch with our team within 14 days of joining and we’ll arrange a refund in line with our terms.\"},{\"title\":\"How long does my membership last?\",\"description\":\"Your membership lasts 12 months from the date you join. You’ll have full access to your benefits during this time.\"},{\"title\":\"Will my membership renew automatically?\",\"description\":\"Yes. To make sure you don’t lose access to your benefits, we’ll renew your membership for another 12 months around your expiry date. You can cancel any time before renewal.\"}]},\"perks\":{\"heading\":\"Even more perks!\",\"description\":\"Small details that make a big difference to your experience.\",\"cards\":[{\"key\":\"fee-free-date-swaps\",\"title\":\"Fee-free date swaps\",\"description\":\"Switch tickets to another performance of the same show, for free\",\"icon\":\"compare_arrows\"},{\"key\":\"member-phone-line\",\"title\":\"Members-only phone line\",\"description\":\"Skip the queue with a dedicated line for members\",\"icon\":\"phone_in_talk\"},{\"key\":\"digital-membership\",\"title\":\"Digital membership\",\"description\":\"Your perks, always in your pocket\",\"icon\":\"card_membership\"},{\"key\":\"newsletters\",\"title\":\"Regular newsletters\",\"description\":\"Be the first to know when new shows go on sale\",\"icon\":\"drafts\"},{\"key\":\"west-end-discount\",\"title\":\"10% off West End tickets\",\"description\":\"Save on London's biggest shows via London Theatre Direct*\",\"icon\":\"confirmation_number\"}],\"preCtaTitle\":\"Over 12,000 members enjoy the perks of Priority Live\",\"preCtaDescription\":\"You can too for £45 a year.\",\"cta\":{\"text\":\"Become a member\",\"action\":\"https://booking.bridgetheatre.co.uk/en/bridge-theatre-london/buyingflow/membership/priority-live-br\"}},\"promo\":{\"heading\":\"Ready to start enjoying your perks?\",\"description\":\"Unlock savings, flexibility and exclusive extras. All included with Priority Live membership\",\"cta\":{\"description\":\"Learn more\",\"action\":\"/perks\"}},\"reviews\":{\"heading\":\"Our members love the savings, perks and priority access\",\"cards\":[{\"quote\":\"\\\"My membership is good value for money as I use this for discounted drinks, no agents fees and booking tickets on a reduced price.\\\"\"},{\"quote\":\"\\\"Really enjoy having advance info of future shows.\\\"\"},{\"quote\":\"\\\"The priority membership is great. We love it.\\\"\"}],\"cta\":{\"description\":\"Join them today for £45 a year.\",\"ctaText\":\"Become a member\",\"action\":\"https://booking.bridgetheatre.co.uk/en/bridge-theatre-london/buyingflow/membership/priority-live-br\"}},\"genericInformationBox\":[{\"title\":\"Ready to start enjoying your perks?\",\"description\":\"Unlock savings, flexibility and exclusive extras. All included with Priority Live membership\",\"buttonsCollection\":{\"items\":[{\"url\":\"https://booking.bridgetheatre.co.uk/en/bridge-theatre-london/buyingflow/membership/priority-live-br\",\"buttonText\":\"Become a member\",\"buttonVariant\":\"primary\"}]},\"contentAlignment\":\"Right\",\"image\":{\"url\":\"membership-promo-card\",\"title\":\"Membership Promo Card\"}}]},\"giftVouchers\":{\"metadata\":{\"metaTitle\":\"Gift Vouchers | Bridge Theatre\",\"metaDescription\":\"Buy a gift voucher and treat someone to an unforgettable live experience. The perfect present for theatre, comedy and more.\"},\"info\":{\"heading\":\"Give the gift of live experiences\",\"description\":\"For Christmas, birthdays, anniversaries or just to say a massive thanks, our gift vouchers make the perfect present.\",\"cards\":[{\"title\":\"Something for everyone\",\"description\":\"Comedy, concerts, drama or musicals, gift cards cover it all\",\"icon\":\"theater_comedy\"},{\"title\":\"12 months to use\",\"description\":\"Plenty of time to pick the perfect night out.\",\"icon\":\"calendar_month\"},{\"title\":\"More than just tickets\",\"description\":\"Use gift cards for memberships, hospitality packages and more.\",\"icon\":\"redeem\"}],\"cta\":{\"title\":\"Gift a voucher\",\"url\":\"https://booking.bridgetheatre.co.uk/en/bridge-theatre-london/buyingflow/giftcard\"},\"secondaryCta\":{\"title\":\"Check my balance\"}},\"goodToKnow\":{\"heading\":\"Good to know\",\"description\":\"A few key things to know about how our gift vouchers work\",\"cards\":[{\"title\":\"Instant delivery\",\"description\":\"Gift vouchers arrive by email in seconds, ideal for last minute gifts\",\"icon\":\"check\"},{\"title\":\"Plenty of time\",\"description\":\"Valid until the end of the month, one year after purchase\",\"icon\":\"check\"},{\"title\":\"Flexible to use\",\"description\":\"Spend in part or in full online, by phone or at the box office\",\"icon\":\"check\"},{\"title\":\"Not just tickets\",\"description\":\"Redeem on live events, memberships, hospitality packages and more\",\"icon\":\"check\"},{\"title\":\"Refund window\",\"description\":\"Unused vouchers can be refunded within 14 days of purchase\",\"icon\":\"check\"},{\"title\":\"Cash free\",\"description\":\"Vouchers can not be exchanged for cash\",\"icon\":\"check\"}],\"cta\":{\"text\":\"Gift a voucher\",\"action\":\"https://booking.bridgetheatre.co.uk/en/bridge-theatre-london/buyingflow/giftcard\"},\"secondaryCta\":{\"text\":\"See full Terms \u0026 Conditions\",\"action\":\"/terms-and-conditions\"}},\"genericInformationBox\":[{\"title\":\"Give someone special an experience\",\"description\":\"Unlock savings, flexibility and exclusive extras. All included with Priority Live membership\",\"buttonsCollection\":{\"items\":[{\"url\":\"https://booking.bridgetheatre.co.uk/en/bridge-theatre-london/buyingflow/giftcard\",\"buttonText\":\"Gift a voucher\",\"buttonVariant\":\"primary\"}]},\"contentAlignment\":\"Right\",\"image\":{\"url\":\"gift-voucher-card\",\"title\":\"Gift Vouchers Promo Card\"}}]},\"yourVisit\":{\"sections\":{\"travel\":\"Travel\",\"placesToStay\":\"Places to stay\",\"seatmap\":\"Seatmap\",\"virtualTours\":\"Virtual tours\",\"accessibility\":\"Accessibility\"},\"contentNavigation\":{\"backCta\":\"Go Back\"},\"header\":{\"heading\":\"Your visit\",\"seatplan\":\"Seatmap\",\"directionsCta\":\"Get directions\"},\"subVenues\":{\"title\":\"Our Theatres in \",\"cta\":\"Get Directions\"},\"landing\":{\"heading\":\"Plan Your Visit\",\"intro\":\"Bridge Theatre is home to multiple venues. Choose the venue you're visiting to find venue-specific information.\",\"visitingSoon\":{\"title\":\"Visiting us soon?\",\"description\":\"Visit information varies by venue. Choose the venue you're attending to find details on getting here, parking, access facilities and seating plans.\",\"chooseLabel\":\"Choose your venue\"},\"access\":{\"title\":\"Accessibility at Bridge Theatre\",\"paragraphs\":[\"We want every visit to feel as welcoming and straightforward as possible.\",\"Our accessible performances are designed to support deaf, disabled and neurodivergent audiences, as well as anyone with access requirements related to a physical or mental health condition. Depending on the production, this may include audio described, BSL interpreted, captioned or relaxed performances.\"],\"cardsHeading\":\"Access performance types\",\"types\":[{\"tag\":\"Audio described\",\"title\":\"Audio described\",\"description\":\"Audio described performances include live verbal commentary that describes the visual elements of a production for blind and visually impaired audience members.\",\"ctaText\":\"View audio described events\",\"icon\":\"audio_description\"},{\"tag\":\"BSL interpreted\",\"title\":\"BSL Interpreted\",\"description\":\"British Sign Language interpreted performances include a trained interpreter who signs the spoken and heard elements of the production for BSL users.\",\"ctaText\":\"View BSL interpreted events\",\"icon\":\"sign_language\"},{\"tag\":\"Captioned\",\"title\":\"Captioned\",\"description\":\"Captioned performances display the spoken dialogue and key sound effects as text, so d/Deaf, deafened and hard of hearing audience members can follow the performance.\",\"ctaText\":\"View captioned events\",\"icon\":\"closed_caption\"},{\"tag\":\"Relaxed\",\"title\":\"Relaxed\",\"description\":\"Relaxed performances are adapted to create a more welcoming environment for people who may benefit from a less formal theatre experience, including neurodivergent audiences and people with sensory sensitivities.\",\"ctaText\":\"View relaxed events\",\"icon\":\"sentiment_calm\"}]},\"faq\":{\"heading\":\"Frequently asked questions\",\"items\":[{\"title\":\"How can I book access tickets?\",\"description\":\"If you require assistance with your visit we are here to help. To request access tickets, including wheelchair access and companion tickets, please ##LINK## by phone, in person or via our online enquiry form.\",\"link\":{\"text\":\"contact us\",\"href\":\"https://help.trafalgartickets.com/knowledge/contacting-us\"}},{\"title\":\"Can I bring my assistance dog to the theatre?\",\"description\":\"Working dogs are welcome in all our theatres. If you are planning to bring a working dog to an event, please ##LINK## when booking so that seating with suitable access can be arranged.\",\"link\":{\"text\":\"contact us\",\"href\":\"https://help.trafalgartickets.com/knowledge/contacting-us\"}},{\"title\":\"Can I reserve an accessible parking space?\",\"description\":\"While many of our venues offer parking facilities, please note that none of them are able to accommodate advance reservations for parking spaces. Please refer to the article below for additional information about parking. ##LINK##\",\"link\":{\"text\":\"Where can I park?\",\"href\":\"https://help.trafalgartickets.com/knowledge/where-can-i-park\"}}],\"helpCentre\":{\"title\":\"Still have questions?\",\"description\":\"Find guidance on booking tickets, planning your visit, managing your order and more.\",\"ctaText\":\"Visit help centre\",\"ctaHref\":\"https://help.trafalgartickets.com/knowledge/\"}},\"map\":{\"title\":\"Where our venues are\",\"description\":\"Bridge Theatre includes multiple venues. Check your ticket or event page before travelling, then use the map to find the right location.\"}}},\"foodAndDrink\":{\"pageHeading\":\"Food \u0026 Drink\",\"preDiningSectionTitle\":\"Pre Theatre Dining\",\"preDiningSectionDescription\":\"Begin your evening with a relaxed dinner and drinks\",\"preDiningAddButtonText\":\"Add pre-theatre dining\",\"preDiningViewMenuButtonText\":\"View menu\",\"packagesSectionTitle\":\"Add a touch of indulgence\",\"packagesSectionDescription\":\"Start your visit in style with one of our food and drink packages. Skip the queues with private lounge access and relax before the show, making your experience even more special. \u003cbr /\u003e \u003cbr /\u003e Add a package when booking your ticket, or upgrade at any time.\",\"packagesAddButtonText\":\"Add package\",\"diningSectionTitle\":\"Make it an experience you’ll never forget\",\"findYourPerformanceTitle\":\"Find your performance\",\"findYourPerformanceDescription\":\"Select the date of your show to see available packages for that day\",\"chooseYourPerformanceTitle\":\"Choose your performance\",\"chooseYourPerformanceDescription\":\"Select the performance you've already booked tickets for\",\"chooseYourVenueTitle\":\"Choose your venue\",\"chooseYourVenueDescription\":\"Select the venue you've already booked tickets for\",\"performancesForSelectedDate\":\"Performances for your selected date will appear here\",\"performancesForSelectedVenueAndDate\":\"Performances for your selected venue \u0026 date will appear here\",\"noPackagesAvailableOnThisDate\":\"There aren't any packages available on this date\",\"bookingClosedForThisDate\":\"Packages must be booked at least 24 hours before your performance\",\"changeDateButtonText\":\"Change date\",\"changeVenueButtonText\":\"Change venue\",\"goodToKnow\":{\"heading\":\"Good to know\",\"description\":\"A few key things to know about our packages\",\"cards\":[{\"icon\":\"event\",\"title\":\"Availability\",\"description\":\"Packages are offered for selected performances and may vary by show\"},{\"icon\":\"add_shopping_cart\",\"title\":\"How it works\",\"description\":\"Show your booking confirmation to hospitality staff who will show you to your table\"},{\"icon\":\"event_available\",\"title\":\"Booking window\",\"description\":\"Packages can be booked up to 8 hours of your show\"},{\"icon\":\"brunch_dining\",\"title\":\"On arrival\",\"description\":\"Show your booking confirmation to a member of our team, who will welcome you and get you settled\"},{\"icon\":\"menu_book_2\",\"title\":\"Allergens \u0026 dietary\",\"description\":\"If you have any dietary requirements, please speak to our team before booking\"},{\"icon\":\"fmd_bad\",\"title\":\"Location\",\"description\":\"Package locations vary by type, Full details will be confirmed in your booking email\"}]},\"preDiningGoodToKnow\":{\"heading\":\"Good to know\",\"description\":\"A few key things to know about our pre-show dining\",\"cards\":[{\"icon\":\"event\",\"titl