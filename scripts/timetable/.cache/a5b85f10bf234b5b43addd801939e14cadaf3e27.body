","name":"Emily C. Williams Trio \u2013 An Evening of Original Jazz \u0026 Timeless Classics","description":"Emily C. Williams Trio \u2013 An Evening of Original Jazz \u0026 Timeless Classics ...Live band","startDate":"2026-10-24","endDate":"2026-10-24","image":"https://img.evbuc.com/https%3A%2F%2Fcdn.evbuc.com%2Fimages%2F1194989026%2F1281613329793%2F1%2Foriginal.20261003-215607?crop=focalpoint\u0026fit=crop\u0026h=200\u0026auto=format%2Ccompress\u0026q=75\u0026sharp=10\u0026fp-x=0.47\u0026fp-y=0.227\u0026s=8601b6b8bcb047acd073f8f903098947","url":"https://www.eventbrite.com/e/emily-c-williams-trio-an-evening-of-original-jazz-timeless-classics-tickets-2002902089065","location":{"@type":"Place","name":"Station Ten","address":{"@type":"PostalAddress","addressRegion":"England","streetAddress":"10 Sydenham Station Approach","addressLocality":"London","addressCountry":"GB","postalCode":"SE26 5EU"},"geo":{"@type":"GeoCoordinates","latitude":"51.4268239","longitude":"-0.05422519999999999"}},"eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode"}},{"@type":"ListItem","position":6,"item":{"@type":"Event","name":"WAY OUT WEST PRESENTS: CELEBRATING THE CENTENARY OF TONY BENNETT!","description":"WayOut West Collective celebrates the musical legacy of the legendary jazz vocalist Tony Bennett in what would have been his hundredth year!","startDate":"2026-10-30","endDate":"2026-10-30","image":"https://img.evbuc.com/https%3A%2F%2Fcdn.evbuc.com%2Fimages%2F1194135326%2F1926300711373%2F1%2Foriginal.20260922-200159?h=200\u0026w=310\u0026auto=format%2Ccompress\u0026q=75\u0026sharp=10\u0026s=fd7ab15d9f5d809fb160fa00f5f79679","url":"https://www.eventbrite.co.uk/e/way-out-west-presents-celebrating-the-centenary-of-tony-bennett-tickets-2002094306967","location":{"@type":"Place","name":"Polish Social and Cultural Association POSK","address":{"@type":"PostalAddress","addressRegion":"England","streetAddress":"238-246 King Street","addressLocality":"London","addressCountry":"GB","