appening vibes of the 'Jazz, Soul, Funk Collective' at Tonic. Let the groove move you.","is_online_event":false,"eid":"2002195730327","id":"2002195730327","published":"2026-03-03T08:30:30Z","privacy_setting":"unlocked","primary_organizer_id":"26269636189","is_series":true,"timezone":"Europe/London","start_date":"2026-10-29","start_time":"20:30","end_date":"2026-10-29","end_time":"23:30","tags":[],"eventbrite_event_id":"2002195730327","promoted_listing_metadata":{"ad_id":"502187","is_promoted_event":true,"placement_id":"ea3fe714-ec04-4c16-bea0-89209e01f667","campaign_id":"502187","experiments":[],"index_in_results":0,"include_follow_cta":false,"goal_adj_bid":0.0035},"primary_venue":{"user_id":"326864888173","name":"Downstairs at Sucre","address":{"city":"London","country":"GB","region":"England","longitude":"-0.1384772","localized_address_display":"47b Great Marlborough Street, London, W1F 7JP","postal_code":"W1F 7JP","address_1":"47b Great Marlborough Street","address_2":"","latitude":"51.5143745","localized_multi_line_address_display":["47b Great Marlborough Street","London","W1F 7JP"],"localized_area_display":"London"},"organizer_id":"26269636189","google_place_id":"295911419","id":"296680863"},"primary_organizer":{"website":"http://www.diffplanet.net","organization_id":"326864888173","_type":"organizer","user_id":"326864888173","description":{"text":"Established in London during 2002 Different Planet is a cosmopolitan network for people who like to enjoy art - culture and wellness activities.Through the activities we organise or attend, e.g. socials, gallery tours, live music gigs, literary events, board games, dance/ fitness sessions etc Different Planet (dp) has brought together nationals from most continents spanning over forty countries.\u00a0 We are secular by nature.After a lengthy hiatus events were resumed in September 2019The network generally attracts professionals, artists, students and the genuinely open-minded.(dp) places a great emphasis on providing a relaxed and informal atmosphere for people to engage and interact.\u00a0 It is free to join and most events take place in London.\u00a0 Applicants must be 18+."},"followed_by_you":false,"url":"https://www.eventbrite.co.uk/o/different-planet-art-culture-wellness-network-26269636189","twitter":"@DifferentPlane3","long_description":{"text":"Established in London during 2002 Different Planet is a cosmopolitan network for people who like to enjoy art - culture and wellness activities.Through the activities we organise or attend, e.g. socials, gallery tours, live music gigs, literary events, board games, dance/ fitness sessions etc Different Planet (dp) has brought together nationals from most continents spanning over forty countries.\u00a0 We are secular by nature.After a lengthy hiatus events were resumed in September 2019The network generally attracts professionals, artists, students and the genuinely open-minded.(dp) places a great emphasis on providing a relaxed and informal atmosphere for people to engage and interact.\u00a0 It is free to join and most events take place in London.\u00a0 Applicants must be 18+."},"logo_id":"82689451","num_followers":841,"num_future_events":0,"is_saved":true,"num_past_events":0,"disable_marketing_opt_in":false,"id":"26269636189","name":"Different Planet: art - culture - wellness network"},"ticket_availability":{"start_sales_date":null,"quantity_sold_add_on":0,"minimum_ticket_price_rounded":{"currency":"GBP","display":"0 GBP","value":0},"quantity_sold_paid":0,"remaining_capacity":83,"end_sales_date":{"timezone":"Europe/London","local":"2026-10-29T18:30:00","utc":"2026-10-29T18:30:00Z"},"num_ticket_classes":1,"has_available_hidden_tickets":false,"maximum_ticket_price":{"currency":"GBP","display":"0.00 GBP","value":0},"minimum_ticket_price":{"currency":"GBP","display":"0.00 GBP","value":0},"is_free":true,"maximum_ticket_price_rounded":{"currency":"GBP","display":"0 GBP","value":0},"is_hold_unavailable":false,"waitlist_enabled":false,