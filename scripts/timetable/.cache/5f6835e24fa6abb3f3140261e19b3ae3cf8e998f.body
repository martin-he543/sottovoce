<script>
jQuery(function($){

    if ($(window).width() <= 800) {
        $('li.menu-item-has-children > a').on('click', function(e){
            e.preventDefault();
            $(this).toggleClass('open');
            $(this).siblings('.sub-menu').toggleClass('open');
        });
    }

    if( $('li.featured-item').length ) {
        $('li.featured-item').parent('.sub-menu').addClass('sub-menu-featured');
    }
	
	$("#menu-toggle").on("click",function(){
		$("html").toggleClass("toggled");
	});
	
	if($(".hero .bxslider").length>0){
		$(".hero .bxslider").bxSlider({
			touchEnabled: false,	
		});
	}
	
	if($("#may-also-like .bxslider").length>0){
		$("#may-also-like .bxslider").bxSlider({
		  minSlides: 3,
		  maxSlides: 3,
		  slideWidth: 500,
		  slideMargin: 40,
		  pager: false,
		  moveSlides: 1,
		});
	}
	
	
	if($("#home-carousel .bxslider").length>0){
		/*
		$("#home-carousel .bxslider").bxSlider({
		  minSlides: 6,
		  maxSlides: 6,
		  slideWidth: 200,
		  slideMargin: 40,
		  pager: false,
		  moveSlides: 2,
		  infiniteLoop: false,
		});
		*/
		$('#home-carousel .bxslider').slick({
		  infinite: true,
		  slidesToShow: 3,
		  slidesToScroll: 2,
		  prevArrow: '<a class="bx-prev">Prev</a>',
		  nextArrow: '<a class="bx-next">Next</a>',
		  responsive: [
			{
			  breakpoint: 991,
			  settings: {
				slidesToShow: 1,
				slidesToScroll: 1
			  }
			},
		  ]
		});
	}
	
	$("section.faq-topic h4").on("click",function(){
		$(this).parents("section.faq-topic").toggleClass("open");
		$(this).parents("section.faq-topic").find("article").removeClass("open");
	});
	
	$("section.faq-topic h5").on("click",function(){
		$(this).parents("article").toggleClass("open");
	});
	
	$("#home-calendar .book-now").on("click",function(){
		window.location.href=$(this).find("a").attr("href");
	});
	
	$("#home-calendar .book-now a").on("click",function(e){
		e.stopPropagation();
	});
	
	$("#event-details nav li").on("click",function(){
		$("#event-details nav li").removeClass("active");
		$(this).addClass("active");
		
		var ref = $(this).attr("data-ref");
		
		// console.log(ref);
		
		if(ref=="details"){
			$("#event-details .two-thirds").addClass("on-details");
		} else {
			$("#event-details .two-thirds").removeClass("on-details");	
		}
				
		$("#event-variable > div").hide();
		
		$("#event-variable > div[data-ref="+ref+"]").show();
	});
	
	var isOldIE = (navigator.userAgent.indexOf("MSIE") !== -1); // Detect IE10 and below
	
	//iFrameResize({checkOrigin:false,heightCalculationMethod:isOldIE ? 'max' : 'lowestElement'}, '#SpektrixIFrame')
	
		
	var ajax_cal;
	
	function cal_get_event(day,month,year){
		$("#home-calendar").addClass("loading");
		if(typeof(ajax_cal)!="undefined") ajax_cal.abort();
		
		ajax_cal = $.ajax({
			type: "GET",
			url: "https://theatre503.com/wp-admin/admin-ajax.php",
			data: {"action":"cal_get_event","year":year,"month":month,"day":day},
			dataType: "JSON",
			beforeSend: function(){
				$("#home-calendar .day").html(day);
				$("#home-calendar .month").html(months[parseInt(month)-1]);
			},
			success: function(response){
				//console.log(response);
				
				if(response.events>0){
					console.log("Updating calendar event...");
					$("#home-calendar .event").html(response.html);
					$("#home-calendar").removeClass("loading empty");
					$("#home-calendar .book-now a").attr("href",response.permalink);
				} else {
					$("#home-calendar").addClass("empty").removeClass("loading");
					$("#home-calendar .book-now a").attr("href","");
				}
			}
		});
	}
	
	$("#event-details nav li[data-ref=details]").on("mouseenter",function(){
		$("#event-details .two-thirds").addClass("on-details");
	});
	
	$("#event-details nav li[data-ref=details]").on("mouseleave",function(){
		//console.log($(this).hasClass("active"));
		if(!$(this).hasClass("active")){
			$("#event-details .two-thirds").removeClass("on-details");
		}
	});
	
	$("#submit-script").on("submit",function(){
		var error = false;
		
		$("#submit-script input[type=submit]").addClass("loading");
		
		$("#submit-script .error-message").removeClass("active");
		
		$("#submit-script #script-variable .variable.active input, #submit-script .basics input, #submit-script #script-variable .variable.active textarea, #submit-script #script-variable .variable.active .attach.required"
		).removeClass("error");
		
		$("#submit-script #script-variable .variable.active > input, #submit-script .basics input, #submit-script #script-variable .variable.active > textarea").each(function(i,el){
			if($(el).val()==""){
				error = true;
				//console.log($(el).attr("name"));
				$(el).addClass("error");	
			}
		});
		
		$("#submit-script #script-variable .variable.active .attach.required label").each(function(i,el){
			if($(el).attr("data-doc")==""||typeof($(el).attr("data-doc"))=="undefined"){
				//console.log($(el).find("input").attr("name"));
				error = true;
				$(el).addClass("error");	
			}
		});
		
		if(error){
			$("#submit-script .error-message").addClass("active");
			$("#submit-script input[type=submit]").removeClass("loading");
			return false;
		}
	});
	
	$("body").on("change","#submit-script select[name=script-type]",function(){
		var ref = $(this).find("option:selected").attr("data-ref");
		
		$("#submit-script #script-variable, #submit-script #script-variable .variable").removeClass("active");
		$("#submit-script input[type=submit]").addClass("disabled");
		
		if(ref!=""){
			//console.log("#submit-script #script-variable .variable.show-"+ref);
			$("#submit-script input[type=submit]").removeClass("disabled");
			$("#submit-script #script-variable").addClass("active");
			$("#submit-script #script-variable .variable.show-"+ref).addClass("active");
		}
	});
	
	$("body").on("change",".attach input[type=file]",function(){
				
		var par = $(this).parents("label");		
		if(par.hasClass("loading")) return false;
		par.attr("data-doc","");
		
		var file = $(this)[0].files[0];
		var ref = $(this).attr("name");
		var f = $(this).val().replace(/C:\\fakepath\\/i, '');
		
		if(f==""){
			return;	
		}
		
		//console.log(f);
		par.removeClass("error added");
		
		var ext = f.split('.').pop();
		
		var allowed = ["jpg","pdf","jpeg","png","gif","doc","docx","txt","rtf","pages"];
		
		if(allowed.indexOf(ext.toLowerCase())<0){
			par.addClass("error");
			alert('Oops - to keep your data safe we can only take files that are images, documents or PDFs.');
			return;
		}
		
		par.attr("data-doc",f);
	});
	
	$("#submit-feedback").on("submit",function(){
		var error = false;
		
		$("#submit-feedback input[type=submit]").addClass("loading");
		
		$("#submit-feedback .error-message").removeClass("active");
		
		$("#submit-feedback input, #submit-feedback textarea").removeClass("error");
		
		$("#submit-feedback input:not([type=submit]), #submit-feedback textarea").each(function(i,el){
			if($(el).val()==""){
				error = true;
				//console.log($(el).attr("name"));
				$(el).addClass("error");	
			}
		});
		
		if($("#submit-feedback input[type=radio]").length>0 && $("#submit-feedback input[type=radio]:checked").length<1){
			error = true;
		}
		
		if(error){
			$("#submit-feedback .error-message").addClass("active");
			$("#submit-feedback input[type=submit]").removeClass("loading");
			return false;
		}
	});
	
	$("#submit-script input[type=submit].loading, #submit-feedback input[type=submit].loading").on("click",function(e){
		e.preventDefault();
		return false;
	});
});
</script>
</body>
</html>