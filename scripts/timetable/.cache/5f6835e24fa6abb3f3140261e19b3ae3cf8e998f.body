                    	<a class="twitter" href="https://twitter.com/theatre503" target="_blank"></a>
                        <a class="facebook" href="https://www.facebook.com/theatre503" target="_blank"></a>
                    </div>
                </div>
    		</div>
        </div>
        <div class="container thin">
        	<div class="noverflow">
                <div id="copyright">
                © Theatre503. Charity no 1115555. Company no 5694721. 503 Battersea Park Road, London SW11 3BW
                </div>
                
                <div id="crucible-credit">
                    Site by <a href="http://crucible.io/" target="_blank" alt="creative design agency london" title="creative design agency london">Crucible</a>
                </div>
            </div>
        </div>
        
    </div>
</footer>
