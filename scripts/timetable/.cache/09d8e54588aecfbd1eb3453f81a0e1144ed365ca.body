    <div class="article-header">
        <div class="container">
        
            <div class="page-title">
                <h1 data-post-title="Christmas with Opera Holland Park 2026">


                                        Christmas with Opera Holland Park 2026
                </h1>
                <h2 class="composer">
                                    </h2>
                <div class="subtitle"></div>
            </div>

        </div>
    </div>
    


            
        </div>

                
    </header>

    

    <div class="container">
        <div class="wrap content-wrap">
            
<div class="article-content">

    

	<div
		class="instances">


				<div class="months">
			
				<div class="month">
					<div class="month-name">December 2026</div>
					<ul class="nav nav-tabs month-instances" role="tablist">
													<li role="presentation">
								<div data-target="#I147201ACHPJHNRRRVRHLDHHJVQBDSHSPG" aria-controls="I147201ACHPJHNRRRVRHLDHHJVQBDSHSPG" role="tab" data-toggle="tab">
									<span class="weekday">Sat</span>
									<span class="monthday">5</span>

									<span class="time">7.00pm</span>

									<span class="booking">Book</span>
								</div>
							</li>
											</ul>
				</div>


					</div>

		<!-- Tab panes -->
		<div class="tab-content">
							
					<div role="tabpanel" class="tab-pane" id="I147201ACHPJHNRRRVRHLDHHJVQBDSHSPG">

						
						
						

																				
							<table class="table table-condensed">
