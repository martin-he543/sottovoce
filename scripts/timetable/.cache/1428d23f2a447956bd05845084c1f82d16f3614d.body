                                            title="Lucy-Fennell">
                                    </figure>'
                                                                class="c-dialog--open c-link">
                                                                            <h4 class="c-col-bio__name u-h5">Lucy Fennell</h4>
                                                                    </a>
                                                    </div>
                    				                                            <div class="o-layout__item c-col-bio-single">
                            <h3 class="c-col-bio__role u-h3">Movement Director</h3>
                                                            <a href="#0"
                                data-a11y-dialog-show="a11y-dialog"
                                data-dialog-title='Aline David'
                                data-dialog-content='<p>Previous work at Shakespeare’s Globe includes <em>Much Ado About Nothing</em><em>, </em><em>Three Sisters, </em><em>Henry VIII, Romeo and Juliet, Women Beware Women, Antony and Cleopatra, Much Ado About Nothing, Troilus and Cressida, Handel and the First Messiah</em>.</p>
<p>&nbsp;</p>
<br>
                                                                    <a href="https://www.shakespearesglobe.com/bio/aline-david/">View full biography</a>
                                '

                                                                    data-dialog-img='<figure class="c-col-bio__mugshot">
                                        <img
                                            src="https://images.shakespearesglobe.com/uploads/2020/02/Aline-David-resized.jpg?resize=320%2C320&gravity"
                                            alt="This is a headshot of Aline David."
                                            title="Aline-David">
                                    </figure>'
                                                                class="c-dialog--open c-link">
                                                                            <h4 class="c-col-bio__name u-h5">Aline David</h4>
                                                                    </a>
                                                    </div>
                    				                                            <div class="o-layout__item c-col-bio-single">
                            <h3 class="c-col-bio__role u-h3">Voice and Text</h3>
                                                            <a href="#0"
                                data-a11y-dialog-show="a11y-dialog"
                                data-dialog-title='Annemette Verspeak'
                                data-dialog-content='<p>Annemette Verspeak is a Voice, Text and Singing Coach. She is Head of Voice at the Guildhall School of Music and Drama. Previous work at Shakespeare’s Globe includes <em>Othello, All’s Well that Ends Well, Three Sisters, The Crucible </em>and <em>The Tempest.</em></p>
<br>
                                                                    <a href="https://www.shakespearesglobe.com/bio/annemette-verspeak/">View full biography</a>
                                '

