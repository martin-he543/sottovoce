                                            title="Henry-V-musicians_0003_Maddie-Cutter-2022_300x300_acf_cropped">
                                    </figure>'
                                                                class="c-dialog--open c-link">
                                                                            <h4 class="c-col-bio__name u-h5">Maddie Cutter </h4>
                                                                    </a>
                                                    </div>
                    				                                            <div class="o-layout__item c-col-bio-single">
                            <h3 class="c-col-bio__role u-h3">Cello</h3>
                                                            <a href="#0"
                                data-a11y-dialog-show="a11y-dialog"
                                data-dialog-title='Zosia Jagodzinska'
                                data-dialog-content='<p>Cellist, Improvisor, Composer, Songwriter and Vocalist Zosia Jagodzinska works across multiple genres including Contemporary Classical, Electronic, Jazz and Folk.</p>
<br>
                                                                    <a href="https://www.shakespearesglobe.com/bio/zosia-jagodzinska/">View full biography</a>
                                '

                                                                    data-dialog-img='<figure class="c-col-bio__mugshot">
                                        <img
                                            src="https://images.shakespearesglobe.com/uploads/2026/05/Zosia.jpg?resize=320%2C320&gravity"
                                            alt="Zosia Jagodzinska playing the cello."
                                            title="Zosia">
                                    </figure>'
                                                                class="c-dialog--open c-link">
                                                                            <h4 class="c-col-bio__name u-h5">Zosia Jagodzinska</h4>
                                                                    </a>
                                                    </div>
                    				                                            <div class="o-layout__item c-col-bio-single">
                            <h3 class="c-col-bio__role u-h3">Cello</h3>
                                                            <a href="#0"
                                data-a11y-dialog-show="a11y-dialog"
                                data-dialog-title='Richard Phillips'
                                data-dialog-content='<p>Hailing from Gloucestershire, ‘teenage’ Richard sang and played guitar in a (self-labelled) ‘Brit-rock’ band. He moved to London to study modern and baroque cello at the Royal College of Music, and later, the Rachmaninov Tambov Institute.</p>
<br>
                                                                    <a href="https://www.shakespearesglobe.com/bio/richard-phillips/">View full biography</a>
                                '

                                                                    data-dialog-img='<figure class="c-col-bio__mugshot">
                                        <img
                                            src="https://images.shakespearesglobe.com/uploads/2026/05/Richard-Phillips.jpg?resize=320%2C320&gravity"
                                            alt="Richard Phillips looking directly at the camera whilst holding their cello."
                                            title="Richard-Phillips">
                                    </figure>'
                                                                class="c-dialog--open c-link">
                                                                            <h4 class="c-col-bio__name u-h5">Richard Phillips</h4>
                                                                    </a>
                                                    </div>
                    				                                            <div class="o-layout__item c-col-bio-single">
                            <h3 class="c-col-bio__role u-h3">Guitar</h3>
                                                            <a href="#0"
                                data-a11y-dialog-show="a11y-dialog"
                                data-dialog-title='Charlie Laffer'
                                data-dialog-content='<p>Charlie Laffer is a graduate of the Guildhall School of Music. He has toured internationally with the band All Saints, R&amp;B artist Kelis, and the multi-platinum group TLC.</p>
<br>
                                                                    <a href="https://www.shakespearesglobe.com/bio/charlie-laffer/">View full biography</a>
                                '

                                                                    data-dialog-img='<figure class="c-col-bio__mugshot">
                                        <img
                                            src="https://images.shakespearesglobe.com/uploads/2023/12/Charlie-Laffer.png?resize=320%2C320&gravity"
                                            alt="This is a headshot of Charlie Laffer looking directly to camera."
                                            title="Charlie-Laffer">
                                    </figure>'
                                                                class="c-dialog--open c-link">
                                                                            <h4 class="c-col-bio__name u-h5">Charlie Laffer</h4>
                                                                    </a>
                                                    </div>
                    				                                            <div class="o-layout__item c-col-bio-single">
                            <h3 class="c-col-bio__role u-h3">Musical Director/ Percussion</h3>
                                                            <a href="#0"
                                data-a11y-dialog-show="a11y-dialog"
                                data-dialog-title='Zands Duggan'
                                data-dialog-content='<p>Previous work at Shakespeare’s Globe includes: <em>Macbeth, Playing Shakespeare</em> (Composer), <em>Much Ado About Nothing</em> (Musical Director), <em>Swive</em> (Musical Director), <em>Merry Wives of Windsor</em> (Musical Director), <em>A Midsummer Night’s Dream, Richard III,</em> <em>Mother Courage and her Children. </em></p>
<br>
                                                                    <a href="https://www.shakespearesglobe.com/bio/zands-duggan/">View full biography</a>
                                '

                                                                    data-dialog-img='<figure class="c-col-bio__mugshot">
                                        <img
                                            src="https://images.shakespearesglobe.com/uploads/2022/01/zands-duggan.jpg?resize=320%2C320&gravity"
                                            alt="Black and white photo of Zands Duggan looking away from the camera."
                                            title="zands-duggan">
                                    </figure>'
                                                                class="c-dialog--open c-link">
                                                                            <h4 class="c-col-bio__name u-h5">Zands Duggan</h4>
                                                                    </a>
                                                    </div>
                    							</div>
		
    </div>
</div>
