					<div class="o-layout o-layout--flush">
			                                                <div class="o-layout__item c-col-bio-single">
                            <h3 class="c-col-bio__role u-h3">Cello</h3>
                                                            <a href="#0"
                                data-a11y-dialog-show="a11y-dialog"
                                data-dialog-title='Maddie Cutter '
                                data-dialog-content='<p>Since graduating from the Guildhall School of Music and Drama in 2016, Maddie has gained a reputation as a versatile, collaborative cellist.</p>
<br>
                                                                    <a href="https://www.shakespearesglobe.com/bio/maddie-cutter/">View full biography</a>
                                '

                                                                    data-dialog-img='<figure class="c-col-bio__mugshot">
                                        <img
                                            src="https://images.shakespearesglobe.com/uploads/2022/10/Henry-V-musicians_0003_Maddie-Cutter-2022_300x300_acf_cropped.jpg?resize=320%2C320&gravity"
