                                                            <a href="#0"
                                data-a11y-dialog-show="a11y-dialog"
                                data-dialog-title='Sami Fendall'
                                data-dialog-content='<p>Sami is an award-winning production designer whose work spans live performance, stage, and screen.</p>
<br>
                                                                    <a href="https://www.shakespearesglobe.com/bio/sami-fendall/">View full biography</a>
                                '

                                                                    data-dialog-img='<figure class="c-col-bio__mugshot">
