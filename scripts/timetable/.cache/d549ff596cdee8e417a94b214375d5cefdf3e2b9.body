om/parktheatre/files/11d9434b-de1e-446e-850b-5ea55a50eac6-thumbnail.jpg","webUrl":"","webEventId":null,"id":"89001AJHBVGSNNCRSDJSGMLLHVGPBDRNB","firstInstanceDateTime":"2026-10-01T15:00:00","firstInstanceDateTimeUtc":"2026-10-01T14:00:00Z","lastInstanceDateTime":"2027-11-27T19:00:00","lastInstanceDateTimeUtc":"2027-11-27T19:00:00Z","altText":"","attribute_ExcludeFromDonationSlider":false,"attribute_Genre":"Supplementary event","attribute_HasInterval":false,"attribute_Season":"Other","attribute_Venue":"Events Elsewhere","attribute_AgeSuitability":"","attribute_RunningTime":"","attribute_RecommendationCategory1":"","attribute_RecommendationCategory2":"","attribute_RecommendationCategory3":"","attribute_Interval":""},{"description":"","htmlDescription":"<div id>\r\n\r\n</div>","duration":110,"imageUrl":"","isOnSale":true,"name":"An Audience With Martin Freeman & Romesh Ranganathan","instanceDates":"20 September-20 September","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"141401ABJQPSTCPSRRGNSCLMDRNGDVBHD","firstInstanceDateTime":"2026-09-20T18:00:00","firstInstanceDateTimeUtc":"2026-09-20T17:00:00Z","lastInstanceDateTime":"2026-09-20T18:00:00","lastInstanceDateTimeUtc":"2026-09-20T17:00:00Z","altText":"","attribute_AgeSuitability":"14+","attribute_ExcludeFromDonationSlider":false,"attribute_Genre":"One-off events","attribute_HasInterval":true,"attribute_Interval":"20 minutes","attribute_RecommendationCategory1":"An Audience With events","attribute_RecommendationCategory2":"Stand-up comedy","attribute_RunningTime":"110 minutes","attribute_Season":"Park Main Season","attribute_Venue":"Park200","attribute_RecommendationCategory3":""},{"description":"Directors Cut showcase","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"Art from the Heart","instanceDates":"9 August-9 August","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"119401AKGDHRCDVSGJLGMDPTGQQQSKKRQ","firstInstanceDateTime":"2026-08-09T19:00:00","firstInstanceDateTimeUtc":"2026-08-09T18:00:00Z","lastInstanceDateTime":"2026-08-09T19:00:00","lastInstanceDateTimeUtc":"2026-08-09T18:00:00Z","altText":"","attribute_ExcludeFromDonationSlider":true,"attribute_Genre":"One-off events","attribute_HasInterval":false,"attribute_Season":"Other","attribute_Venue":"Park90","attribute_AgeSuitability":"","attribute_RunningTime":"","attribute_RecommendationCategory1":"","attribute_RecommendationCategory2":"","attribute_RecommendationCategory3":"","attribute_Interval":""},{"description":"","htmlDescription":"<div id>\r\n\r\n</div>","duration":90,"imageUrl":"","isOnSale":true,"name":"Birdcatcher","instanceDates":"2 March-27 March","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"144801ASGJPQDCDQNNCQTTNNLLPBNQQBG","firstInstanceDateTime":"2027-03-02T19:15:00","firstInstanceDateTimeUtc":"2027-03-02T19:15:00Z","lastInstanceDateTime":"2027-03-27T19:15:00","lastInstanceDateTimeUtc":"2027-03-27T19:15:00Z","altText":"","attribute_AgeSuitability":"12+","attribute_ExcludeFromDonationSlider":false,"attribute_Genre":"Drama","attribute_HasInterval":false,"attribute_RunningTime":"90 minutes (no interval)","attribute_Season":"Park Main Season","attribute_Venue":"Park90","attribute_RecommendationCategory1":"","attribute_RecommendationCategory2":"","attribute_RecommendationCategory3":"","attribute_Interval":""},{"description":"Who gets to stay? \r\nWho is pushed out? \r\nAnd who decides? \r\n\r\nFour colleagues sit in a meeting room. \r\nJobs are on the line. \r\nThe rules are unspoken, but everyone knows them. \r\n\r\nBull is a strained and unsettling examination of workplace bullying, power and survival. As pressure builds, alliances shift and cruelty surfaces, exposing a system where fear thrives and empathy disappears. \r\n\r\nSharp, darkly funny and deeply uncomfortable, Bull lays bare the human cost of a working culture shaped by competition, hierarchy and silence. How far will people go to protect themselves?  \r\n\r\nThis is Deafinitely Theatre’s second adaptation of a play by Mike Bartlett, following the Off West End Award-winning, critically acclaimed and sold-out production of Contractions in 2017. Bull is presented in the company’s distinctive bilingual style, combining British Sign Language, spoken English and creative captions and is directed by Deafinitely’s award-winning Artistic Director Paula Garfield MBE. \r\n\r\n“It’s not personal. It’s just business.” \r\n\r\nrunning time tbc, but will be straight through without interval","htmlDescription":"<div id>\r\n\r\n</div>","duration":75,"imageUrl":"","isOnSale":true,"name":"Bull","instanceDates":"30 September-24 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"131601ADBGLDRVQKGBQBCSBTRLNPTJMVL","firstInstanceDateTime":"2026-09-30T19:45:00","firstInstanceDateTimeUtc":"2026-09-30T18:45:00Z","lastInstanceDateTime":"2026-10-24T19:45:00","lastInstanceDateTimeUtc":"2026-10-24T18:45:00Z","altText":"","attribute_AgeSuitability":"16+","attribute_ExcludeFromDonationSlider":false,"attribute_Genre":"Drama","attribute_HasInterval":false,"attribute_RecommendationCategory1":"Drama","attribute_RunningTime":"75 mins with no interval","attribute_Season":"Park Main Season","attribute_Venue":"Park90","attribute_RecommendationCategory2":"","attribute_RecommendationCategory3":"","attribute_Interval":""},{"description":"","htmlDescription":"<div id>\r\n\r\n</div>","duration":0,"imageUrl":"","isOnSale":true,"name":"Chamber","instanceDates":"28 October-27 November","thumbnailUrl":"","webUrl":"https://parktheatre.co.uk/events/papatango-prize-winner-2026/","webEventId":null,"id":"143601AHLSTHQSQMJGVSQDVBLJPTCTLVP","firstInstanceDateTime":"2027-10-28T19:00:00","firstInstanceDateTimeUtc":"2027-10-28T18:00:00Z","lastInstanceDateTime":"2027-11-27T19:00:00","lastInstanceDateTimeUtc":"2027-11-27T19:00:00Z","altText":"","attribute_AgeSuitability":"TBC","attribute_ExcludeFromDonationSlider":false,"attribute_Genre":"Drama","attribute_HasInterval":false,"attribute_Rec