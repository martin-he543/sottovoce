            <section class="c-event-listings u-pure-white-bg" id="book">
            <div class="o-max o-max--800">
                                    
<div class="u-txt-center">
    <h3 class="u-margin-bottom-small c-small-label u-pure-red-txt">Dates &amp; Tickets</h3>
    <h2 class="u-margin-bottom-none">MakeBeth</h2>
    <time class="c-small-label"><i class="far fa-calendar"></i> 24 October - 1 November</time>
            <div class="c-small-label c-event-locations" role="list" aria-label="Locations">
            <i class="fal fa-map-marker-alt" aria-hidden="true"></i>
                            <span role="listitem">Bankside</span>
                    </div>
            <div class="c-event-booking-instructions u-rich-white-bg">
        <div class="c-col-text-area">
                                <p>*Includes a £3 transaction fee per order, and a £1 restoration levy per ticket. Become a <a href="https://www.shakespearesglobe.com/join-and-support/best-friends/">Best Friend</a> or <a href="https://www.shakespearesglobe.com/join-and-support/membership/patron-membership/">Patron</a> to book without transaction fee. Free events and £5 or £10 standing tickets for performances are exempt.</p>
                                    </div>
    </div>
    </div>

                                            
<div class="c-event-listing">

    <span class="c-event-listing__data c-event-listing__date">SAT 24 OCTOBER</span>

    <div class="c-event-listing__data c-event-listing__times">

