<style>
	.arcola-cmp-prefs-link-inline {
		display: inline-block;
		margin-left: 8px;
		color: inherit;
		text-decoration: underline;
		text-underline-offset: 2px;
	}
	.arcola-cmp-prefs-link-inline:hover,
	.arcola-cmp-prefs-link-inline:focus { opacity: 0.7; }
</style>
<script id="arcola-cmp-inject-prefs-link">
(function () {
	function inject() {
		var info = document.querySelector('.site-footer__company-info');
		if (!info) return;
		if (info.querySelector('.arcola-cmp-prefs-link-inline')) return;
		var sep = document.createTextNode(' ');
		var link = document.createElement('a');
		link.href = '#';
		link.setAttribute('data-cc', 'show-preferencesModal');
		link.className = 'arcola-cmp-prefs-link-inline';
		link.textContent = 'Cookie preferences';
		// VCC v3 binds [data-cc=show-preferencesModal] handlers only at run()
		// time. Our link is injected after init, so the attribute alone isn't
		// enough — bind directly to the public API. The data-cc attribute is
		// retained so VCC's own init would still pick it up if init order ever
		// changes.
		link.addEventListener('click', function (ev) {
			ev.preventDefault();
			if (window.CookieConsent && typeof window.CookieConsent.showPreferences === 'function') {
				window.CookieConsent.showPreferences();
			} else {
				console.warn('CookieConsent not initialised; cannot show preferences');
			}
		});
		info.appendChild(sep);
		info.appendChild(link);
	}
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', inject);
	} else {
		inject();
	}
})();
</script>
	

