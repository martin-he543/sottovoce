                                                                                                                        <h1 class="page-header__heading">
                                                Incident at Vichy
                                            </h1>
                                                                                                                    <div class="type-h3 m:d-none page-header__event-date">15 Jan - 20 Feb 2027</div>
                                
                                                                                                                                                    <h2 class="page-header__subheading">
                                            By Arthur Miller
                                        </h2>
                                                    <div class="type-body-l page-header__additional-credits">Directed by Melly Still</div>
                                                                        
                                                                                                                                </div>    <div class="page-header__sidebar margin-trim">
        <div class="page-header__actions stack stack--s">
