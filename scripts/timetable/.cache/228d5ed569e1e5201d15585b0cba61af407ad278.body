<link rel='stylesheet' id='arcola-cmp-css' integrity='sha384-9KcNFt4axT+TNOVPHpwGHOm4Kv0UcMjdVya1kl+EPBQG+Vmqtz28cnx0f5PZYcnF' crossorigin='anonymous' href='https://www.arcolatheatre.com/wp-content/mu-plugins/arcola-cmp/cookieconsent.css?ver=3.1.0' media='all' />
<style id="arcola-cmp-inline-css">
/* Arcola CMP — full dark palette tuned for the Arcola brand.
   Mirrors VCC v3's built-in darkmode but tints primary buttons with the
   Arcola orange. Critical fix: --cc-cookie-category-block-bg, which
   defaulted to light grey #f0f4f7 and made our white category labels
   illegible. WCAG AA: white (#ebf3f6) on dark card (#2a2825) ≈ 12.5:1. */
:root {
	--cc-bg:                              #1f1e1c;
	--cc-primary-color:                   #ebf3f6;
	--cc-secondary-color:                 #aebbc5;
	--cc-link-color:                      #ff7b5e;

	--cc-btn-primary-bg:                  #eb432b;
	--cc-btn-primary-color:               #ffffff;
	--cc-btn-primary-border-color:        #eb432b;
	--cc-btn-primary-hover-bg:            #d33b25;
	--cc-btn-primary-hover-color:         #ffffff;
	--cc-btn-primary-hover-border-color:  #d33b25;

	--cc-btn-secondary-bg:                #2a2825;
	--cc-btn-secondary-color:             #ebf3f6;
	--cc-btn-secondary-border-color:      #2a2825;
	--cc-btn-secondary-hover-bg:          #35312d;
	--cc-btn-secondary-hover-color:       #ffffff;
	--cc-btn-secondary-hover-border-color:#35312d;

	--cc-separator-border-color:          rgba(255,255,255,0.08);

