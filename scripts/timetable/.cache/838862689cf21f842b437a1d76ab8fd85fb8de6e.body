                                data-a11y-dialog-show="a11y-dialog"
                                data-dialog-title='Emma King'
                                data-dialog-content='<p>After completing her studies at the Guildhall School of Music and Drama in 2013, Emma joined the smash hit show <em>STOMP</em> in 2014 and toured extensively throughout Europe, Asia, Australia and South America with the company.</p>
<br>
                                                                    <a href="https://www.shakespearesglobe.com/bio/emma-king/">View full biography</a>
                                '

                                                                    data-dialog-img='<figure class="c-col-bio__mugshot">
