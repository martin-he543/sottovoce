                                            alt="Marley-Rose Liburd smiling at the camera. They have black shoulder length hair and are wearing a purple top."
                                            title="MarleyRose-Liburd">
                                    </figure>'
                                                                class="c-dialog--open c-link">
                                                                            <h4 class="c-col-bio__name u-h5">Marley-Rose Liburd</h4>
                                                                    </a>
                                                    </div>
                    				                                            <div class="o-layout__item c-col-bio-single">
                            <h3 class="c-col-bio__role u-h3">Casting Associate</h3>
                                                            <a href="#0"
                                data-a11y-dialog-show="a11y-dialog"
                                data-dialog-title='Alice Walters'
                                data-dialog-content='<p>Alice is Casting Associate at Shakespeare’s Globe. She supports Head of Casting Becky Paris in the casting of all in-house productions, events, and workshops for the Globe Theatre and Sam Wanamaker Playhouse.</p>
<br>
                                                                    <a href="https://www.shakespearesglobe.com/bio/alice-walters/">View full biography</a>
                                '

                                                                    data-dialog-img='<figure class="c-col-bio__mugshot">
                                        <img
                                            src="https://images.shakespearesglobe.com/uploads/2025/04/Alice-Walters-headshot.jpg?resize=320%2C320&gravity"
                                            alt="This is a headshot of Alice Walters looking directly to camera."
                                            title="Alice-Walters-headshot">
                                    </figure>'
                                                                class="c-dialog--open c-link">
                                                                            <h4 class="c-col-bio__name u-h5">Alice Walters</h4>
                                                                    </a>
                                                    </div>
                    				                                            <div class="o-layout__item c-col-bio-single">
                            <h3 class="c-col-bio__role u-h3">Casting Director</h3>
                                                            <a href="#0"
                                data-a11y-dialog-show="a11y-dialog"
                                data-dialog-title='Becky Paris CDG'
                                data-dialog-content='<p>Becky is Head of Casting at Shakespeare’s Globe, overseeing the casting of all in-house productions, events and workshops for the Globe Theatre and Sam Wanamaker Playhouse.</p>
<br>
                                                                    <a href="https://www.shakespearesglobe.com/bio/becky-paris/">View full biography</a>
                                '

                                                                    data-dialog-img='<figure class="c-col-bio__mugshot">
                                        <img
                                            src="https://images.shakespearesglobe.com/uploads/2022/03/Becky-Paris-bio.png?resize=320%2C320&gravity"
                                            alt=""
                                            title="Becky Paris">
                                    </figure>'
                                                                class="c-dialog--open c-link">
                                                                            <h4 class="c-col-bio__name u-h5">Becky Paris CDG</h4>
                                                                    </a>
                                                    </div>
                    				                                            <div class="o-layout__item c-col-bio-single">
                            <h3 class="c-col-bio__role u-h3">Composer</h3>
                                                            <a href="#0"
                                data-a11y-dialog-show="a11y-dialog"
                                data-dialog-title='Katie Richardson'
                                data-dialog-content='<p>Katie is a composer, songwriter, sound designer, recording artist, choral director and music producer with a wide range of experience across many different music and sound-based projects for stage, screen immersive and live</p>
<br>
                                                                    <a href="https://www.shakespearesglobe.com/bio/katie-richardson/">View full biography</a>
                                '

                                                                    data-dialog-img='<figure class="c-col-bio__mugshot">
                                        <img
                                            src="https://images.shakespearesglobe.com/uploads/2026/07/Katie-Richardson.jpg?resize=320%2C320&gravity"
                                            alt="Katie Richardson lit up by a purple light and looking directly at the camera."
                                            title="Katie-Richardson">
                                    </figure>'
                                                                class="c-dialog--open c-link">
                                                                            <h4 class="c-col-bio__name u-h5">Katie Richardson</h4>
                                                                    </a>
                                                    </div>
                    				                                            <div class="o-layout__item c-col-bio-single">
                            <h3 class="c-col-bio__role u-h3">Co-Director</h3>
                                                            <a href="#0"
                                data-a11y-dialog-show="a11y-dialog"
                                data-dialog-title='Sean Holmes'
                                data-dialog-content='<p>Sean is currently Associate Artistic Director of Shakespeare’s Globe. Prior to this, he was the Artistic Director of the Lyric Hammersmith.</p>
<br>
                                                                    <a href="https://www.shakespearesglobe.com/bio/sean-holmes/">View full biography</a>
                                '

                                                                    data-dialog-img='<figure class="c-col-bio__mugshot">
                                        <img
                                            src="https://images.shakespearesglobe.com/uploads/2022/05/Sean-Holmes-e1553855723793_300x300_acf_cropped.jpg?resize=320%2C320&gravity"
                                            alt="Sean Holmes leaning on a table. Sean is wearing a blue tshirt"
                                            title="Sean-Holmes-e1553855723793_300x300_acf_cropped">
                                    </figure>'
                                                                class="c-dialog--open c-link">
                                                                            <h4 class="c-col-bio__name u-h5">Sean Holmes</h4>
                                                                    </a>
                                                    </div>
                    				                                            <div class="o-layout__item c-col-bio-single">
                            <h3 class="c-col-bio__role u-h3">Co-Director</h3>
                                                            <a href="#0"
                                data-a11y-dialog-show="a11y-dialog"
                                data-dialog-title='Charlie Josephine'
                                data-dialog-content='<p><span data-teams="true">Their play <em>Cowbois</em>, which Charlie also co-directed with Sean Holmes, enjoyed a successful run at The RSC and the Royal Court in 2024. In 2022, their play <em>I, Joan</em> opened to great acclaim at Shakespeare’s Globe. Other work at Shakespeare&#8217;s Globe includes <em>Metamorphoses </em>and<em> As You Like It.</em></span></p>
<br>
                                                                    <a href="https://www.shakespearesglobe.com/bio/charlie-josephine/">View full biography</a>
                                '

                                                                    data-dialog-img='<figure class="c-col-bio__mugshot">
                                        <img
                                            src="https://images.shakespearesglobe.com/uploads/2021/09/CharlieJosephine.jpg?resize=320%2C320&gravity"
                                            alt="Charlie Josephine wearing a grey t-shirt and looking directly at the camera."
                                            title="CharlieJosephine">
                                    </figure>'
                                                                class="c-dialog--open c-link">
                                                                            <h4 class="c-col-bio__name u-h5">Charlie Josephine</h4>
                                                                    </a>
                                                    </div>
                    				                                            <div class="o-layout__item c-col-bio-single">
                            <h3 class="c-col-bio__role u-h3">Designer</h3>
                                                            <a href="#0"
                                data-a11y-dialog-show="a11y-dialog"
                                data-dialog-title='Paul Wills'
                                data-dialog-content='<p>Paul Wills is a critically acclaimed International Set and Costume Designer. Previous work at Shakespeare’s Globe includes <em>Romeo and Juliet,</em> <em>The Comedy of Errors</em>, <em>The Tempest</em>, <em>The Four Seasons</em>, <em>Richard II</em>, <em>Dr Faustus</em>, <em>The Lightning Child</em>, <em>The Frontline</em>.</p>
<br>
                                                                    <a href="https://www.shakespearesglobe.com/bio/paul-wills/">View full biography</a>
                                '

                                                                    data-dialog-img='<figure class="c-col-bio__mugshot">
                                        <img
                                            src="https://images.shakespearesglobe.com/uploads/2022/05/The-Tempest_0001_Paul-Wills-2.jpg?resize=320%2C320&gravity"
                                            alt="This is a headshot of Paul Wills looking directly into the camera."
                                            title="Paul Wills">
                                    </figure>'
                                                                class="c-dialog--open c-link">
                                                                            <h4 class="c-col-bio__name u-h5">Paul Wills</h4>
                                                                    </a>
                                                    </div>
                    				                                            <div class="o-layout__item c-col-bio-single">
                            <h3 class="c-col-bio__role u-h3">Fight and Intimacy Director</h3>
                                                            <a href="#0"
                                data-a11y-dialog-show="a11y-dialog"
                                data-dialog-title='Bethan Clark'
                                data-dialog-content='<p>Bethan Clark is a Fight and Intimacy Director and a certified senior teacher with the British Academy of Dramatic Combat. Previous credits for Shakespeare’s Globe include <em>Romeo and Juliet, The Merry Wives of Windsor</em> and<em> Princess Essex</em>.</p>
<br>
                                                                    <a href="https://www.shakespearesglobe.com/bio/bethan-clark/">View full biography</a>
                                '

                                                                    data-dialog-img='<figure class="c-col-bio__mugshot">
                                        <img
                                            src="https://images.shakespearesglobe.com/uploads/2024/08/Bethan-Clark.jpg?resize=320%2C320&gravity"
                                            alt="This is a headshot of Bethan Clark looking direct to camera."
                                            title="Bethan-Clark">
                                    </figure>'
                                                                class="c-dialog--open c-link">
                                                                            <h4 class="c-col-bio__name u-h5">Bethan Clark</h4>
                                                                    </a>
                                                    </div>
                    				                                            <div class="o-layout__item c-col-bio-single">
                            <h3 class="c-col-bio__role u-h3">Movement Director</h3>
                                                            <a href="#0"
                                data-a11y-dialog-show="a11y-dialog"
                                data-dialog-title='Tamsin Hurtado Clarke'
                                data-dialog-content='<p>Tamsin Hurtado Clarke is a British-Venezuelan movement director, theatre-maker and performer who lives in Bristol. She trained at Ecole Internationale Jacques Lecoq in Paris from 2006-2008. Her work has toured the UK, Europe, and Latin America. Previous work for Shakespeare’s Globe includes <em>The Winter’s Tale, The Comedy of Errors, Much Ado About Nothing, Romeo &amp; Juliet </em>and<em> The Merry Wives Of Windsor</em>.</p>
<br>
                                                                    <a href="https://www.shakespearesglobe.com/bio/tamsin-hurtado-clarke/">View full biography</a>
                                '

                                                                    data-dialog-img='<figure class="c-col-bio__mugshot">
                                        <img
                                            src="https://images.shakespearesglobe.com/uploads/2024/01/Tamsin-Hurtado-Clarke-aspect-ratio-1000-911-e1742296018228.png?resize=320%2C320&gravity"
                                            alt="This is a headshot of Tasmin Hurtado-Clarke looking directly into camera."
                                            title="Tamsin-Hurtado-Clarke">
                                    </figure>'
                                                                class="c-dialog--open c-link">
                                                                            <h4 class="c-col-bio__name u-h5">Tamsin Hurtado Clarke</h4>
                                                                    </a>
                                                    </div>
                    				                                            <div class="o-layout__item c-col-bio-single">
                            <h3 class="c-col-bio__role u-h3">Text Consultant</h3>
                                                            <a href="#0"
                                data-a11y-dialog-show="a11y-dialog"
                                data-dialog-title='Simon Trinder'
                                data-dialog-content='<p>Simon Trinder trained at the Royal Welsh College of Music and Drama and is a Shakespeare&#8217;s Globe Associate Artist.</p>
<br>
                                                                    <a href="https://www.shakespearesglobe.com/bio/simon-trinder/">View full biography</a>
                                '

                                                                    data-dialog-img='<figure class="c-col-bio__mugshot">
                                        <img
                                            src="https://images.shakespearesglobe.com/uploads/2024/03/Simon-Trinder-aspect-ratio-1000-985.jpg?resize=320%2C320&gravity"
                                            alt="This is a headshot of Si Trinder looking directly to camera."
                                            title="Si-Trinder">
                                    </figure>'
                                                                class="c-dialog--open c-link">
                                                                            <h4 class="c-col-bio__name u-h5">Simon Trinder</h4>
                                                                    </a>
                                                    </div>
                    				                                            <div class="o-layout__item c-col-bio-single">
                            <h3 class="c-col-bio__role u-h3">Voice Coach</h3>
                                                            <a href="#0"
                                data-a11y-dialog-show="a11y-dialog"
                                data-dialog-title='Gary Horner'
                                data-dialog-content='<p>Gary trained as an actor at Guildford School of Acting and, after working as an actor, returned to education to study his MA in Voice at The Royal Central School of Speech and Drama. Gary is a designated tutor of the Linklater Voice Technique and a Trauma Informed Somatic Therapist. Previous work at Shakespeare’s Globe includes, <em>Midsummer Night&#8217;s Dream</em>, <em>The Merry Wives of Windsor </em>and <em>Comedy of Errors.</em></p>
<br>
                                                                    <a href="https://www.shakespearesglobe.com/bio/gary-horner/">View full biography</a>
                                '

                                                                    data-dialog-img='<figure class="c-col-bio__mugshot">
                                        <img
                                            src="https://images.shakespearesglobe.com/uploads/2023/04/Gary-Horner.jpg?resize=320%2C320&gravity"
                                            alt="This is a headshot of Gary Horner looking directly to camera."
                                            title="Gary-Horner">
                                    </figure>'
                                                                class="c-dialog--open c-link">
                                                                            <h4 class="c-col-bio__name u-h5">Gary Horner</h4>
                                                                    </a>
                                                    </div>
                    							</div>
		
    </div>
</div>
