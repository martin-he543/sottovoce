mbnailUrl":"https://system.spektrix.com/sohotheatre/files/39c99627-ffdb-4cf7-b522-e62009e8233e-thumbnail.jpg","webUrl":"","webEventId":null,"id":"442803AMBHQNLTSBBDRPPVHKKDCLHVTMG","firstInstanceDateTime":"2023-06-01T19:30:00","firstInstanceDateTimeUtc":"2023-06-01T18:30:00Z","lastInstanceDateTime":"2023-08-02T19:30:00","lastInstanceDateTimeUtc":"2023-08-02T18:30:00Z","altText":"","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_WebsiteFilterCategory1":"Cabaret","attribute_WebsiteFilterCategory2":"Theatre","attribute_WebsiteFilterCategory3":"Comedy","attribute_Venue":"","attribute_AudiencePreference1":"","attribute_AudiencePreference2":""},{"description":"","htmlDescription":"<div id>\r\n\r\n</div>","duration":0,"imageUrl":"https://system.spektrix.com/sohotheatre/files/8ac46de2-35cb-4ae6-97bc-e00b255d444b.jpg","isOnSale":true,"name":"Cog Test Event - Priority","instanceDates":"1 July-31 January","thumbnailUrl":"https://system.spektrix.com/sohotheatre/files/8ac46de2-35cb-4ae6-97bc-e00b255d444b-thumbnail.jpg","webUrl":"","webEventId":null,"id":"444603AGGGSBKNSQGMMHLMDHMMVVNTMTB","firstInstanceDateTime":"2023-07-01T19:30:00","firstInstanceDateTimeUtc":"2023-07-01T18:30:00Z","lastInstanceDateTime":"2025-01-31T20:00:00","lastInstanceDateTimeUtc":"2025-01-31T20:00:00Z","altText":"","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"","attribute_WebsiteFilterCategory1":"","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":"","attribute_AudiencePreference1":"","attribute_AudiencePreference2":""},{"description":"","htmlDescription":"<div id>\r\n\r\n</div>","duration":0,"imageUrl":"","isOnSale":true,"name":"Cog Test Event - Sold Out","instanceDates":"2 April-2 April","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"457403ACBKRJPCCRJKKNTVRDRPLVKPCNV","firstInstanceDateTime":"2025-04-02T20:00:00","firstInstanceDateTimeUtc":"2025-04-02T19:00:00Z","lastInstanceDateTime":"2025-04-02T20:00:00","lastInstanceDateTimeUtc":"2025-04-02T19:00:00Z","altText":"","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"","attribute_WebsiteFilterCategory1":"","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":"","attribute_AudiencePreference1":"","attribute_AudiencePreference2":""},{"description":"","htmlDescription":"<div id>\r\n\r\n</div>","duration":0,"imageUrl":"https://system.spektrix.com/sohotheatre/files/97bf0c88-c005-4488-825e-0184bec1ccc3.jpg","isOnSale":true,"name":"Cog Test Event - with Extras","instanceDates":"1 May-8 May","thumbnailUrl":"https://system.spektrix.com/sohotheatre/files/97bf0c88-c005-4488-825e-0184bec1ccc3-thumbnail.jpg","webUrl":"","webEventId":null,"id":"442403AGRCHPGBVMQDGCNCRLBDBVSSLDG","firstInstanceDateTime":"2023-05-01T19:30:00","firstInstanceDateTimeUtc":"2023-05-01T18:30:00Z","lastInstanceDateTime":"2026-05-08T12:00:00","lastInstanceDateTimeUtc":"2026-05-08T11:00:00Z","altText":"","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_WebsiteFilterCategory1":"Comedy","attribute_WebsiteFilterCategory2":"Theatre","attribute_WebsiteFilterCategory3":"Cabaret","attribute_Venue":"","attribute_AudiencePreference1":"","attribute_AudiencePreference2":""},{"description":"For testing purposes only","htmlDescription":"<div id>\r\n\r\n</div>","duration":0,"imageUrl":"","isOnSale":true,"name":"Cog test: food","instanceDates":"25 June-25 June","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"641603ADTNKHNDKGHNVKGHDGKKBPTVSDJ","firstInstanceDateTime":"2025-06-25T12:00:00","firstInstanceDateTimeUtc":"2025-06-25T11:00:00Z","lastInstanceDateTime":"2025-06-25T12:00:00","lastInstanceDateTimeUtc":"2025-06-25T11:00:00Z","altText":"","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"","attribute_WebsiteFilterCategory1":"","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":"","attribute_AudiencePreference1":"","attribute_AudiencePreference2":""},{"description":"The 2022 Edinburgh Comedy Award nominee heads back out on tour. This time as himself, Colin.\r\nAs seen in Netflix’s Afterlife, BBC’s Ghosts, and BBC’s This Time With Alan Partridge, Colin Hoult heads across the UK with a not-to-be-missed stand-up show!\r\nFollowing a huge national tour of ‘The Death of Anna Mann’ in 2022/2023 that saw Colin sell out shows across the country, including additional performances in London’s West End, the critically acclaimed comedian is back with a stand-up show about family, fatherhood, and a formative childhood experience with a ouija board and a gorilla.\r\nAs seen in Avoidance (BBC), The Completely Made Up Adventures Of Dick Turpin (AppleTV) and judging the 2023 BBC New Comedy Awards.\r\n14+","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"Colin Hoult: Colin","instanceDates":"23 September-11 January","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"548203AHTSNCBQMBGKHMSLVSCGQBJMVSD","firstInstanceDateTime":"2024-09-23T19:30:00","firstInstanceDateTimeUtc":"2024-09-23T18:30:00Z","lastInstanceDateTime":"2025-01-11T19:30:00","lastInstanceDateTimeUtc":"2025-01-11T19:30:00Z","altText":"","attribute_AudiencePreference1":"Comedy","attribute_AudiencePreference2":"Stand Up","attribute_DynamicPricing":"Yes","attribute_PriorityBooking":false,"attribute_Venue":"Downstairs","attribute_WebsiteFilterCategory1":"Comedy","attribute_WebsiteFilterCategory2":"Stand Up","attribute_WebsiteFilterCategory3":""},{"description":"Anna Mann is back! The acclaimed actress, singer & welder (gotta have a back up) returns after five long years to tell the incredible story of her life in the arts in this: her final hour. Visceral, real and achingly brave, Colin Hoult (After Life, Netflix) presents a hilarious meditation on life, death and literally everything in between. You will leave screaming “f*** off I love it!”\r\n“Funnier than almost all other shows at this year’s fringe” ★★★★ (The Telegraph)\r\n“Deliciously funny” ★★★★ (The Times)\r\n★★★★ The Scotsman\r\n★★★★ Time Out\r\n\r\n16+","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"Colin Hoult: The Death of Anna Mann","instanceDates":"4 April-7 April","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"445403APSRRJKGLSBJQJHMNTSTVLLHSDG","firstInstanceDateTime":"2023-04-04T19:15:00","firstInstanceDateTimeUtc":"2023-04-04T18:15:00Z","lastInstanceDateTime":"2023-04-07T19:15:00","lastInstanceDateTimeUtc":"2023-04-07T18:15:00Z","altText":"","attribute_DynamicPricing":"Yes","attribute_PriorityBooking":false,"attribute_Venue":"Downstairs","attribute_WebsiteFilterCategory1":"","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":"","attribute_AudiencePreference1":"","attribute_AudiencePreference2":""},{"description":"A one-night mega sing-song featuring comedians singing, you guessed it, carols. \r\nWith Amy Annette, Jack Rooke, Lolly Adefope, Nish Kumar, James Acaster, Charlie Craggs, Himesh Patel and more surprise special guests to be announced.\r\nBring your voice, your friends and a sense of joy. Raising money for the UK Transcommunity and, in our festive best, thinking about how we all can best protect all our rights... Let's be 'Free Wise QUEENS' together (sorry) (three wise men/kings) (you got it).\r\nEveryone, e.g. Any/no/lots of, religion, is welcome. \r\n\r\nThis is about being loud, singing the wrong descant and, in the splendour of Soho Walthamshow, enjoying comedians taking you through our version of a Carol Service. Come join the congreSLAYtion (v sorry).  \r\n\r\nProfits from the show will go to FiveforFive, a mutual aid charity that supports trans people directly:\r\nhttps://www.fiveforfive.co.uk/\r\n14+","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"Comedians Do Carols","instanceDates":"16 December-16 December","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"676003ACCJNHPJHJLLRPGHJSQGLNPKCML","firstInstanceDateTime":"2025-12-16T19:30:00","firstInstanceDateTimeUtc":"2025-12-16T19:30:00Z","lastInstanceDateTime":"2025-12-16T19:30:00","lastInstanceDateTimeUtc":"2025-12-16T19:30:00Z","altText":"","attribute_AudiencePreference1":"Comedy","attribute_AudiencePreference2":"Music","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"Soho Theatre Walthamstow","attribute_WebsiteFilterCategory1":"Music","attribute_WebsiteFilterCategory2":"Comedy","attribute_WebsiteFilterCategory3":"LGBTQ+"},{"description":"Join host Scott Aukerman, along with Paul F. Tompkins & The Comedy Bang! Bang! All-Stars, as they perform a totally improvised version of the award-winning podcast!\r\n16+","htmlDescription":"<div id>\r\n\r\n</div>","duration":110,"imageUrl":"","isOnSale":true,"name":"Comedy Bang! Bang!","instanceDates":"22 July-22 July","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"710403APQSLTVTSHLGPBGDGNSSQQVVVJG","firstInstanceDateTime":"2026-07-22T20:00:00","firstInstanceDateTimeUtc":"2026-07-22T19:00:00Z","lastInstanceDateTime":"2026-07-22T20:00:00","lastInstanceDateTimeUtc":"2026-07-22T19:00:00Z","altText":"","attribute_AudiencePreference1":"Comedy","attribute_AudiencePreference2":"Sketch","attribute_DynamicPricing":"No","attribute_PriorityBooking":true,"attribute_Venue":"Soho Theatre Walthamstow","attribute_WebsiteFilterCategory1":"Comedy","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":""},{"description":"Come and see participants of Soho Theatre’s Comedy Lab: Plus perform at Soho for one night (well, afternoon) only!\r\n\r\n\r\nThe group have spent the last 10 weeks honing their comedy material and performance skills with course leader Esther Manito and guest artists Lucy Hopkins, Jet Vevers, Kelly Fogarty, Hannah Martin and Jamie Allerton.\r\n\r\nIf you’re thinking about applying to the course yourself, come along and see what it’s all about.\r\n16+","htmlDescriptio