te_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":"","attribute_AudiencePreference1":"","attribute_AudiencePreference2":""},{"description":"","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"Urooj Ashfaq: Oh No! At The Hen & Chickens, Bristol","instanceDates":"1 February-1 February","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"506803AVNCHMRPJSBSVCGSPPCLCHPLNHP","firstInstanceDateTime":"2024-02-01T20:00:00","firstInstanceDateTimeUtc":"2024-02-01T20:00:00Z","lastInstanceDateTime":"2024-02-01T20:00:00","lastInstanceDateTimeUtc":"2024-02-01T20:00:00Z","altText":"","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"The Hen & Chickens, Bristol","attribute_WebsiteFilterCategory1":"","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":"","attribute_AudiencePreference1":"","attribute_AudiencePreference2":""},{"description":"","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":false,"name":"Urooj Ashfaq: Oh No! At The Stand, Glasgow","instanceDates":"24 January-24 January","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"506003AQTQLTGPHTCKGBSBMKLQRDTCMGP","firstInstanceDateTime":"2024-01-24T20:30:00","firstInstanceDateTimeUtc":"2024-01-24T20:30:00Z","lastInstanceDateTime":"2024-01-24T20:30:00","lastInstanceDateTimeUtc":"2024-01-24T20:30:00Z","altText":"","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"The Stand, Glasgow","attribute_WebsiteFilterCategory1":"","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":"","attribute_AudiencePreference1":"","attribute_AudiencePreference2":""},{"description":"","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"Urooj Ashfaq: Oh No! At The Wardrobe, Leeds","instanceDates":"7 February-7 February","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"506004AJDBPMHRNTBSQLMSBPGNGKRGDKQ","firstInstanceDateTime":"2024-02-07T19:30:00","firstInstanceDateTimeUtc":"2024-02-07T19:30:00Z","lastInstanceDateTime":"2024-02-07T19:30:00","lastInstanceDateTimeUtc":"2024-02-07T19:30:00Z","altText":"","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"The Wardrobe, Leeds","attribute_WebsiteFilterCategory1":"","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":"","attribute_AudiencePreference1":"","attribute_AudiencePreference2":""},{"description":"","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"Urooj Ashfaq: Oh No! At Warwick Arts Centre, Coventry","instanceDates":"27 January-27 January","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"509003AMJPPDQHKMJQNJBMTKBJTDBPBMB","firstInstanceDateTime":"2024-01-27T19:45:00","firstInstanceDateTimeUtc":"2024-01-27T19:45:00Z","lastInstanceDateTime":"2024-01-27T19:45:00","lastInstanceDateTimeUtc":"2024-01-27T19:45:00Z","altText":"","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"Warwick Arts Centre, Coventry","attribute_WebsiteFilterCategory1":"","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":"","attribute_AudiencePreference1":"","attribute_AudiencePreference2":""},{"description":"After bursting onto the scene in 2010, Varun Thakur is one of the pioneers of the Indian stand-up comedy scene.\r\nFollowing a hit tour across 3 continents, he brings his new show Space Cadet to London. Varun is behind the popular social media avatar Struggling Actor Vicky Malhotra and one of India’s top comedy podcasts ‘The Internet Said So’. \r\n\r\nIn his Soho Theatre debut, come and witness an hour packed with hilarious stories, impersonations and observations from his life, from being married to wanting kids, his love for Mumbai and why he thinks marijuana should be legalised.\r\n16+","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"Varun Thakur: Space Cadet","instanceDates":"20 November-25 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"502603AVTCNNKCVRKDMLKGQCCSVVQHMTC","firstInstanceDateTime":"2023-11-20T20:45:00","firstInstanceDateTimeUtc":"2023-11-20T20:45:00Z","lastInstanceDateTime":"2023-11-25T20:45:00","lastInstanceDateTimeUtc":"2023-11-25T20:45:00Z","altText":"","attribute_AudiencePreference1":"Comedy","attribute_AudiencePreference2":"Stand Up","attribute_DynamicPricing":"Yes","attribute_PriorityBooking":false,"attribute_Venue":"Upstairs","attribute_WebsiteFilterCategory1":"Comedy","attribute_WebsiteFilterCategory2":"India/South Asian heritage","attribute_WebsiteFilterCategory3":"Stand Up"},{"description":"If you live, work or study in Waltham Forest, join us as we explore all aspects of this years Verity Bargate Award.\r\nWith the submission window for the Verity Bargate Award open until 17 June, Soho Theatre have been hosting playwriting workshops at venues across the UK and Ireland.\r\n\r\nFor this workshop, we’re specifically inviting participants who live, work or study in Waltham Forest, to join us at Soho Theatre, Dean Street.\r\n\r\nWithin the workshop, writers will be provided with information about the scope of Soho Theatre’s current programs, their three theatre spaces, and what storytelling and theatricality mean to us.\r\n\r\nIn the first part of the workshop, writers will learn about the Verity Bargate Award and Soho Theatre’s heritage of new writing.\r\n\r\nIn the second part we look at samples from a number of plays to investigate how they are structured, the form they take, their style and subject matter.\r\n\r\nThere will also be a chance for participants to attend a Saturday matinee performance of the most recent Verity Bargate Award winning play, Boys On the Verge of Tears by Sam Grabiner. \r\n18+","htmlDescription":"<div id>\r\n\r\n</div>","duration":165,"imageUrl":"","isOnSale":true,"name":"Verity Bargate Award 2024 Workshop for Waltham Forest Based Artists","instanceDates":"20 April-20 April","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"540203AMBTCPCKQHBJKBTVNJTQLDJNMML","firstInstanceDateTime":"2024-04-20T11:00:00","firstInstanceDateTimeUtc":"2024-04-20T10:00:00Z","lastInstanceDateTime":"2024-04-20T11:00:00","lastInstanceDateTimeUtc":"2024-04-20T10:00:00Z","altText":"","attribute_AudiencePreference1":"Theatre","attribute_AudiencePreference2":"New Writing","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"Upstairs","attribute_WebsiteFilterCategory1":"Theatre","attribute_WebsiteFilterCategory2":"New Writing","attribute_WebsiteFilterCategory3":""},{"description":"Join us for an online session to find out more about this years Verity Bargate Award and ask any questions ahead of the deadline. \r\nWith the submission window for the Verity Bargate Award open until 17 June, Soho Theatre will be running an online information session. \r\n\r\nWriters are invited to hear from our theatre team about the award and it’s history. There will also be an opportunity for participants to ask questions ahead of the deadline.\r\n\r\nThis session will be taking place online but we will also be running a similar session in the venue on 9 May at 5.30pm.\r\n\r\nAll participants can attend for free. \r\n18+\r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":45,"imageUrl":"","isOnSale":true,"name":"Verity Bargate Award 2024: Free Online Information Session","instanceDates":"1 May-1 May","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"545603AHDKVKCKKQKSGLBHVBLGNMCSNPK","firstInstanceDateTime":"2024-05-01T19:30:00","firstInstanceDateTimeUtc":"2024-05-01T18:30:00Z","lastInstanceDateTime":"2024-05-01T19:30:00","lastInstanceDateTimeUtc":"2024-05-01T18:30:00Z","altText":"","attribute_AudiencePreference1":"Theatre","attribute_AudiencePreference2":"New Writing","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"Online","attribute_WebsiteFilterCategory1":"Theatre","attribute_WebsiteFilterCategory2":"New Writing","attribute_WebsiteFilterCategory3":""},{"description":"Join us for an in-person session to find out more about this years Verity Bargate Award and ask any questions ahead of the deadline. \r\nWith the submission window for the Verity Bargate Award open until 17 June, Soho Theatre will be running this in-person information session. \r\n\r\nWriters are invited to hear from our theatre team about the award and it’s history. There will also be an opportunity for participants to ask questions ahead of the deadline.\r\n\r\nThis session will be taking place in-person but we will also be running a free session online on 1 May at 7.30pm.\r\n\r\n£5/Free with a ticket to that days matinee performance of Boys On The Verge of Tears by Sam Grabiner (this years Verity Bargate Award Winner). \r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":45,"imageUrl":"","isOnSale":true,"name":"Verity Bargate Award 2024: In-Person Information Session","instanceDates":"9 May-9 May","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"545203AQKVNGTJDHSRRDBVLRBJKLPMGNK","firstInstanceDateTime":"2024-05-09T17:30:00","firstInstanceDateTimeUtc":"2024-05-09T16:30:00Z","lastInstanceDateTime":"2024-05-09T17:30:00","lastInstanceDateTimeUtc":"2024-05-09T16:30:00Z","altText":"","attribute_AudiencePreference1":"Theatre","attribute_AudiencePreference2":"New Writing","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"Upstairs","attribute_WebsiteFilterCategory1":"Theatre","attribute_WebsiteFilterCategory2":"New Writing","attribute_WebsiteFilterCategory3":""},{"description":"Join us as we explore all aspects of this years Verity Bargate Award, from how to apply to what to consider as you prepare your script for its submission. \r\nWith the submission window for the Verity Bargate Award open from 11 April until 17 June, Soho Theatre have been hosting playwriting workshops at venues across the UK and Ireland.\r\nFor this relaxed environment online workshop, led by Matilda Feyiṣayọ Ibini, we’re inviting artists who identify as disabled to join us on Zoom. Within the workshop, writers will be provided with information about the scope of Soho Theatre’s current programs, the three theatre spaces, and what storytelling and theatricality mean to us.\r\nIn the first part of the workshop, writers will learn about the Verity Bargate Award and Soho Theatre’s heritage of new writing.\r\nIn the second part we’ll discuss a script sample or two, investigating how they are structured, the form they take, their style and subject matter.\r\nThis workshop has been tailored to be a more relaxed workshop specifically for disabled and neurodivergent participants and will be hosted on Zoom with captions.\r\nIf you would like to discus any particular access requirements please email max@sohotheatre.com\r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":165,"imageUrl":"","isOnSale":true,"name":"Verity Bargate Award 2024: Online Workshop for Disabled Artists ","instanceDates":"15 May-15 May","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"542403ANTLQCNNDMBGGBHVHSTLCTRTTTQ","firstInstanceDateTime":"2024-05-15T19:00:00","firstInstanceDateTimeUtc":"2024-05-15T18:00:00Z","lastInstanceDateTime":"2024-05-15T19:00:00","lastInstanceDateTimeUtc":"2024-05-15T18:00:00Z","altText":"","attribute_AudiencePreference1":"Theatre","attribute_AudiencePreference2":"New Writing","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"Online","attribute_WebsiteFilterCategory1":"Theatre","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":""},{"description":"Hot on the heels of The Mighty Spurs' European glory, The Athletic's award-winning Tottenham Hotspur podcast, The View From The Lane, returns to the live stage.\r\n\r\nJoin host Danny Kelly and Jack Pitt-Brooke, James Maw, Jay Harris and Charlie Eccleshare for a night of Spurs stories you won't have heard anywhere before - plus plenty of laughter and nostalgia, and, inevitably, just a hint of angst about the season to come (because: Spurs).\r\n\r\nGuests to be confirmed\r\n16+","htmlDescription":"<div id>\r\n\r\n</div>","duration":90,"imageUrl":"","isOnSale":true,"name":"View From The Lane Podcast Live","instanceDates":"29 September-29 September","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"646803ACMCVLSTHSGRBPLJDRJQNCJGQJM","firstInstanceDateTime":"2025-09-29T20:00:00","firstInstanceDateTimeUtc":"2025-09-29T19:00:00Z","lastInstanceDateTime":"2025-09-29T20:00:00","lastInstanceDateTimeUtc":"2025-09-29T19:00:00Z","altText":"","attribute_AudiencePreference1":"Comedy","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"Soho Theatre Walthamstow","attribute_WebsiteFilterCategory1":"Comedy","attribute_WebsiteFilterCategory2":"Theatre","attribute_WebsiteFilterCategory3":"","attribute_AudiencePreference2":""},{"description":"Norwegian clown Viggo Venn has moved to London to follow his life-long dream of becoming a British Comedian. \r\n“Viggo is Norwegian” EdFestMag.com\r\n“Viggo is Norwegian” The Scotsman\r\n“Viggo is a... Norwegian” BroadwayBaby.com\r\n\r\nWinner: NATYS New Act of The Year 2022\r\nRunner-up: Leicester Square New Comedian of The Year 2022. \r\nTotal sell-out at Edinburgh Fringe 2022, Viggo is doing his show for 1 night only at London Clown Festival!\r\nNo clowning to see here... \r\n\r\n“The most stupid act we have had this year” Simon Cowell \r\n“I thought you were gonna do stand up comedy” Alesha Dixon \r\n\r\n16+","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"Viggo Venn: British Comedian","instanceDates":"16 June-17 June","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"478603AGNGHLLLBKDRDHTTSJHBTLGCKJS","firstInstanceDateTime":"2023-06-16T19:00:00","firstInstanceDateTimeUtc":"2023-06-16T18:00:00Z","lastInstanceDateTime":"2023-06-17T22:15:00","lastInstanceDateTimeUtc":"2023-06-17T21:15:00Z","altText":"","attribute_AudiencePreference1":"Comedy","attribute_AudiencePreference2":"Clowning","attribute_DynamicPricing":"Yes","attribute_PriorityBooking":false,"attribute_Venue":"Upstairs","attribute_WebsiteFilterCategory1":"Comedy","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":""},{"description":"Norwegian clown Viggo Venn moved to the UK to follow his dream of being a British club comedian. It worked... sort of.\r\nArmed with a billion hi-vis jackets, a balloon much bigger than his head and a commitment to absolute mayhem, Venn entered, and accidentally won, Britain's Got Talent 2023, becoming an overnight sensation. \r\n\r\nSince then, things have been a bit crazy. A complete sell-out run at the Edinburgh Fringe this year \r\n16+","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"Viggo Venn: Tour Preview","instanceDates":"10 October-14 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"498203ACJQLQVCMLRPBQVTKLKBNGHPHDT","firstInstanceDateTime":"2023-10-10T21:30:00","firstInstanceDateTimeUtc":"2023-10-10T20:30:00Z","lastInstanceDateTime":"2023-10-14T21:30:00","lastInstanceDateTimeUtc":"2023-10-14T20:30:00Z","altText":"","attribute_AudiencePreference1":"Work In Progress","attribute_AudiencePreference2":"Clowning","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"Theatre","attribute_WebsiteFilterCategory1":"Comedy","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":""},{"description":"We are beyond thrilled to be bringing one of our favourite acts in the world back to London, the phenomenal Vir Das. \r\n\r\nVir will be performing his new show, Mind Fool, at the Hammersmith Eventim Apollo on 15th December. Tickets available now. \r\n\r\nComedian and actor Vir Das has hit the global comedy mega-leagues thanks to his boundless comedic talent, wildly successful world tours and incredible four Netflix specials. His latest special, Landing, premiered on the streamer on December 26, 2022 with Decider praising his “refreshingly different take on our current obsession with “punching up” and “cancel culture”” and Paste Magazine gushing “even if he’s sending barbs someone’s way, his criticisms are packaged up so beautifully that you’re simply in awe until they hit their mark.” Vir taped the special in New York City after a hit run at The Edinburgh Fringe Festival where The New York Times declared 'no artist embodies the globalization of stand-up like Vir Das.” Vir’s third Netflix special Vir Das: For India garnered an International Emmy-nomination for “Best Comedy” in 2021.\r\n\r\nAs India’s biggest stand-up comedian and a Bollywood star, Vir was the second best-selling live act in the country in 2022. He has increasingly gained worldwide appeal through his various international tours as well as his beloved appearances in multiple comedy fan-favorite films and TV series. He starred in Judd Apatow’s feature The Bubble on Netflix as well as the ABC spy dramedy Whiskey Cavalier in the role of “Jai Datta” opposite Scott Foley and Lauren Cohen. Vir has created, produced, and starred in multiple series, including the scripted thriller Hasmokh for Netflix and the unscripted travel show Jestination Unknown for Amazon. He is also the lead singer for India’s premiere comedy-rock band Alien Chutney.\r\n\r\n16+","htmlDescription":"<div id>\r\n\r\n</div>","duration":105,"imageUrl":"","isOnSale":true,"name":"Vir Das: Mind Fool at the Hammersmith Eventim Apollo","instanceDates":"15 December-15 December","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"487203ANDQNMTJQDVTVKRQLCBBCBKGKVD","firstInstanceDateTime":"2023-12-15T19:30:00","firstInstanceDateTimeUtc":"2023-12-15T19:30:00Z","lastInstanceDateTime":"2023-12-15T19:30:00","lastInstanceDateTimeUtc":"2023-12-15T19:30:00Z","altText":"","attribute_AudiencePreference1":"Stand Up","attribute_AudiencePreference2":"India/South Asian heritage","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"Hammersmith Eventim Apollo","attribute_WebsiteFilterCategory1":"Comedy","attribute_WebsiteFilterCategory2":"Stand Up","attribute_WebsiteFilterCategory3":"India/South Asian heritage"},{"description":"Vir Das returns to Soho Theatre to test shoot his special every night and work out his best stuff.\r\n\r\nIn Vir’s words; “If you came to see me do Hey Stranger at Royal Albert Hall there will be some overlap of material. I will be using these dates to test shoot my new special for a platform. Material will change night to night as we sharpen and hone the show to get my best stuff.”\r\n\r\nOne of the most beloved voices in comedy worldwide, Vir has 5 Netflix comedy specials and has performed in many of the world’s most iconic venues including Carnegie Hall in New York City, Esplenade in Singapore, Dubai Opera in UAE, The Eventim Apollo and recently the Royal Albert Hall.\r\n\r\n‘No artist embodies the globalization of stand-up like Vir Das.’ New York Times\r\n\r\nBeyond stand-up, Vir has built an eclectic career as an actor, writer, producer and filmmaker. He has created, produced and starred in multiple series, including the ABC spy drama-comedy Whiskey Cavalier, the Netflix thriller Hasmukh and the travel show Jestination Unknown for Amazon. He also starred in Judd Apatow’s Netflix feature The Bubble.\r\n\r\nIn 2026, Das made his directorial debut with Happy Patel: Khatarnak Jasoos, a comedy backed by Aamir Khan Productions, in which he also stars. He is now expanding further into filmmaking with Baara Number, his second directorial venture, a found-footage psychological horror film featuring an ensemble cast Alongside his work in comedy, film and television, Vir is also made his debut as an author in 2025 with The Outsider: A Memoir for Misfits.\r\n\r\nPlease note that every show in this run will be filmed. \r\n\r\n16+","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"Vir Das: The Test Run","instanceDates":"7 December-23 December","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"752003ABLMLLPTBDCNTKBTQQDTMNMQDGP","firstInstanceDateTime":"2026-12-07T21:00:00","firstInstanceDateTimeUtc":"2026-12-07T21:00:00Z","lastInstanceDateTime":"2026-12-23T21:00:00","lastInstanceDateTimeUtc":"2026-12-23T21:00:00Z","altText":"","attribute_AudiencePreference1":"Comedy","attribute_AudiencePreference2":"Stand Up","attribute_DynamicPricing":"No","attribute_PriorityBooking":true,"attribute_Venue":"Theatre","attribute_WebsiteFilterCategory1":"Comedy","attribute_WebsiteFilterCategory2":"India/South Asian heritage","attribute_WebsiteFilterCategory3":""},{"description":"International Emmy Award winner and India’s biggest stand-up comedian is back at Soho Theatre working out his brand new show. One of the most beloved voices in comedy worldwide, Vir has 5 Netflix comedy specials and has performed in many of the world’s most iconic venues including Carnegie Hall in New York City, Esplenade in Singapore, Dubai Opera in UAE, and The Eventim Apollo in London. \r\n \r\nVir has created, produced, and starred in multiple series, including the ABC spy drama-comedy Whiskey Cavalier, the thriller Hasmokh for Netflix, and the travel show Jestination Unknown for Amazon. He starred in Judd Apatow’s Netflix feature The Bubble and he is currently developing various tv and film projects. \r\n16+","htmlDescription":"<div id>\r\n\r\n</div>","duration":90,"imageUrl":"","isOnSale":true,"name":"Vir Das: Work in Progress","instanceDates":"2 June-14 June","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"628403AVKDQRTLLMQJLPMBNKVRLNDNPHQ","firstInstanceDateTime":"2025-06-02T21:00:00","firstInstanceDateTimeUtc":"2025-06-02T20:00:00Z","lastInstanceDateTime":"2025-06-14T21:00:00","lastInstanceDateTimeUtc":"2025-06-14T20:00:00Z","altText":"","attribute_AudiencePreference1":"Comedy","attribute_AudiencePreference2":"Stand Up","attribute_DynamicPricing":"No","attribute_PriorityBooking":true,"attribute_Venue":"Theatre","attribute_WebsiteFilterCategory1":"Comedy","attribute_WebsiteFilterCategory2":"India/South Asian heritage","attribute_WebsiteFilterCategory3":"Stand Up"},{"description":"Written by Saher Shah\r\nDirected by Melina Namdar\r\nPresented by Samia Djilli and Sarah Allen \r\nCopy\r\nLarki is moving back in with her parents, and going through a divorce…it’s tragic. She’s facing opinions, questions and smothering love from friends, family, aunties and “BFF’s\", plus the epic decision between jalebi or gulaab jamun. She's searching for something, she just hasn't quite figured out what yet.\r\nFollowing its award-winning and sell-out tour, Vitamin D looks at the changing relationships between women, complexities of emotional crises, British South Asian culture and the stigma of divorce. \r\nCan Larki be a happy woman in the face of her own and others’ judgements?\r\nWinner - London Pub Theatre Best New Play Raising Awareness \r\nFinalist - Asian Media Awards Best Stage Production\r\n11+","htmlDescription":"<div id>\r\n\r\n</div>","duration":90,"imageUrl":"","isOnSale":true,"name":"Vitamin D","instanceDates":"3 September-21 September","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"562403AGTSDCQQTHRPTJCSTMDQCBVVBJJ","firstInstanceDateTime":"2024-09-03T19:00:00","firstInstanceDateTimeUtc":"2024-09-03T18:00:00Z","lastInstanceDateTime":"2024-09-21T19:00:00","lastInstanceDateTimeUtc":"2024-09-21T18:00:00Z","altText":"","attribute_AudiencePreference1":"Theatre","attribute_AudiencePreference2":"India/South Asian heritage","attribute_DynamicPricing":"Yes","attribute_PriorityBooking":false,"attribute_Venue":"Theatre","attribute_WebsiteFilterCategory1":"Theatre","attribute_WebsiteFilterCategory2":"India/South Asian heritage","attribute_WebsiteFilterCategory3":"New Writing"},{"description":"Star of the hit Amazon series Overcompensating, don’t miss Wally Baram’s first ever UK tour dates!\r\n\r\nWally is a Mexican-Syrian stand-up comedian, writer, and actress currently living in NYC, who earned a 2026 Independent Spirit Award nomination for ‘Best Breakthrough Performance’ for her acting debut as a high school outsider on a mission to fit in at all costs in college. She is also a co-executive producer of the show created by Benito Skinner, with its second season on the way later this year. Wally was named a Just For Laughs ‘New Face’ of stand-up comedy, made her late-night debut on The Late Show With Stephen Colbert, and performs regularly at clubs and venues across the US. She was a producer on the Netflix series, Neon, a co-producer on Apple TV’s, Shrinking, and has written for the Disney+ series English Teacher, What We Do In The Shadows on the BBC, HBO’s Betty, and Amazon’s Sprung. Her comedy brings a unique perspective on the strange banalities of entering the adult world as well as growing up with a strong multi-cultural identity. She is also, unfortunately, Gen-Z.\r\n16+","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"Wally Baram: My Snake's Quinceañera","instanceDates":"8 September-12 September","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"728003ALHCTGMPTDBQTDDMDHHPKTJSTKD","firstInstanceDateTime":"2026-09-08T21:30:00","firstInstanceDateTimeUtc":"2026-09-08T20:30:00Z","lastInstanceDateTime":"2026-09-12T21:30:00","lastInstanceDateTimeUtc":"2026-09-12T20:30:00Z","altText":"","attribute_AudiencePreference1":"Comedy","attribute_AudiencePreference2":"Stand Up","attribute_DynamicPricing":"Yes","attribute_PriorityBooking":false,"attribute_Venue":"Downstairs","attribute_WebsiteFilterCategory1":"Comedy","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":""},{"description":"","htmlDescription":"<div id>\r\n\r\n</div>","duration":300,"imageUrl":"","isOnSale":true,"name":"Walthamstow’s International Women’s Day Festival ","instanceDates":"8 March-8 March","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"700203ANVKDBTKQHHTSVVJQNTNSKJKGHK","firstInstanceDateTime":"2026-03-08T12:00:00","firstInstanceDateTimeUtc":"2026-03-08T12:00:00Z","lastInstanceDateTime":"2026-03-08T12:00:00","lastInstanceDateTimeUtc":"2026-03-08T12:00:00Z","altText":"","attribute_AudiencePreference1":"Female Led","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"Soho Theatre Walthamstow","attribute_WebsiteFilterCategory1":"Theatre","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":"","attribute_AudiencePreference2":""},{"description":"A bin-man swaps steel-toed boots for stilettos to chase his dream of becoming a drag queen.\r\nBased on writer/performer Joe Leather's real-life experiences working as a Refuse Loader during lockdown, this\r\nOffie-Aware Winning, one-person comedic play is a love letter to both hard-working Northerners and gender euphoria through\r\nmonologue, music, and drag.\r\n16+","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"Wasteman by Joe Leather","instanceDates":"14 February-15 February","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"589603ARSGBSJDBBRQQKDGDRMSQMBMSJK","firstInstanceDateTime":"2025-02-14T18:45:00","firstInstanceDateTimeUtc":"2025-02-14T18:45:00Z","lastInstanceDateTime":"2025-02-15T18:45:00","lastInstanceDateTimeUtc":"2025-02-15T18:45:00Z","altText":"","attribute_AudiencePreference1":"Theatre","attribute_AudiencePreference2":"Storytelling","attribute_DynamicPricing":"Yes","attribute_PriorityBooking":false,"attribute_Venue":"Upstairs","attribute_WebsiteFilterCategory1":"Theatre","attribute_WebsiteFilterCategory2":"New Writing","attribute_WebsiteFilterCategory3":""},{"description":"Following a multi-award winning, sell out run at the Edinburgh Festival this blistering dark comedy by Brain Watkins transfers to Soho Theatre.\r\nStacey is a California weather girl. An oversexed and underpaid harbinger of our dying planet. But today, her regular routine of wildfires, prosecco and teeth whitening descends into a scorched earth catastrophe, before she discovers something that will save us all.\r\n\r\nThe Award-Winning Producers of Fleabag, Baby Reindeer and Kathy and Stella Solve a Murder bring you this ”smart and sharp’ (The Times) production where ‘The laughs keep coming’ (The Telegraph). From Lucille Lortel Award-nominated Brian Watkins, creator of the hit Amazon series Outer Range, and Drama Desk-nominated director Tyne Rafaeli, ‘brilliantly performed’ (The Times) by off-Broadway star Julia McDermott.\r\n\r\nA dizzying rampage into the soul of American strangeness. Seatbelts not provided.\r\n12+","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"WEATHER GIRL","instanceDates":"5 March-5 April","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"583603ANJPRSPBBRNMHVRNKSJKDHKGHHP","firstInstanceDateTime":"2025-03-05T19:00:00","firstInstanceDateTimeUtc":"2025-03-05T19:00:00Z","lastInstanceDateTime":"2025-04-05T19:00:00","lastInstanceDateTimeUtc":"2025-04-05T18:00:00Z","altText":"","attribute_AudiencePreference1":"Theatre","attribute_AudiencePreference2":"Storytelling","attribute_DynamicPricing":"Yes","attribute_PriorityBooking":false,"attribute_Venue":"Theatre","attribute_WebsiteFilterCategory1":"Theatre","attribute_WebsiteFilterCategory2":"New Writing","attribute_WebsiteFilterCategory3":""},{"description":"Uma's running a struggling countryside castle, and everything's finally falling into place for Pemfort's first Living History event. Glenn's got his sword-fighting down, Ria's befriended a deer, and new arrival Kurtis is settling in well. \r\nBut in a village where everybody knows everybody, some truths refuse to stay buried.\r\nA new play from writer Sarah Power (Grud) and director Ed Madden (The Habits) about what we owe each other when the past demands a reckoning.\r\nDirected by Ed Madden\r\n16+ restriction","htmlDescription":"<div id>\r\n\r\n</div>","duration":90,"imageUrl":"","isOnSale":true,"name":"Welcome to Pemfort","instanceDates":"13 March-18 April","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"661203ACBRQTRRSTDQTVPVQVDRRQRMGNJ","firstInstanceDateTime":"2026-03-13T19:00:00","firstInstanceDateTimeUtc":"2026-03-13T19:00:00Z","lastInstanceDateTime":"2026-04-18T19:00:00","lastInstanceDateTimeUtc":"2026-04-18T18:00:00Z","altText":"","attribute_AudiencePreference1":"Theatre","attribute_AudiencePreference2":"Political","attribute_DynamicPricing":"Yes","attribute_PriorityBooking":true,"attribute_Venue":"Theatre","attribute_WebsiteFilterCategory1":"Theatre","attribute_WebsiteFilterCategory2":"New Writing","attribute_WebsiteFilterCategory3":""},{"description":"More stand up than dance around, WATCH IT! asks questions about identity, personal truth and political ideology in a ridiculous Game Show for One. \r\n‘A brilliant renaissance woman of performance art’ New York Times \r\n‘As compelling as ever’ The Guardian \r\nWATCH IT! In quite possibly her last ever show Wendy Houstoun teams up with Kate Champion (Australia) and Hannes Langolf (UK, Germany) to create a personal and irreverent solo. \r\nMore stand up than dance around, WATCH IT! asks questions about identity, personal truth and political ideology in a ridiculous Game Show for One. \r\nWhat happens to the individual in the midst of ideological regulation? \r\nIs it possible to ask questions without being cast as a reactionary? Is self-censorship driving thought underground ? Secrecy, privacy and the public domain are all on the table in a show that combines projection, spoken word and idiosyncratic movement. \r\nQuotes from audience “Well that was brilliant wasn’t it?” “Utterly devastated” \r\nCREDITS: Made with financial support as part of DV8 Physical Theatre’s Legacy Commissions.\r\n16+","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"Wendy Houstoun: WATCH IT!","instanceDates":"20 March-23 March","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"526003AVKLVCBGSMBTNGGHBTVGBPSLVMV","firstInstanceDateTime":"2024-03-20T19:00:00","firstInstanceDateTimeUtc":"2024-03-20T19:00:00Z","lastInstanceDateTime":"2024-03-23T19:00:00","lastInstanceDateTimeUtc":"2024-03-23T19:00:00Z","altText":"","attribute_AudiencePreference1":"Theatre","attribute_AudiencePreference2":"Dance","attribute_DynamicPricing":"Yes","attribute_PriorityBooking":false,"attribute_Venue":"Theatre","attribute_WebsiteFilterCategory1":"Theatre","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":""},{"description":"Watch as an all-star line-up of comedians backstab, manipulate and fight for survival in cult game show Werewolf: Live.\r\nPrevious guests include Rose Matafeo, Nish Kumar, Ed Gamble, London Hughes, Adam Hills, Iain Stirling, Mark Watson, Mae Martin and many more. Expect chaos.\r\n16+","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"Werewolf Live","instanceDates":"24 June-24 June","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"551203ACRLMQSJLHSSMNKLNDGBDQHQCRL","firstInstanceDateTime":"2024-06-24T19:30:00","firstInstanceDateTimeUtc":"2024-06-24T18:30:00Z","lastInstanceDateTime":"2024-06-24T19:30:00","lastInstanceDateTimeUtc":"2024-06-24T18:30:00Z","altText":"","attribute_AudiencePreference1":"Comedy","attribute_DynamicPricing":"Yes","attribute_PriorityBooking":false,"attribute_Venue":"Downstairs","attribute_WebsiteFilterCategory1":"Comedy","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":"","attribute_AudiencePreference2":""},{"description":"Watch as an all-star line-up of comedians backstab, manipulate and fight for survival in cult game show Werewolf: Live. \r\nPrevious guests include Rose Matafeo, Nish Kumar, Ed Gamble, London Hughes, Adam Hills, Iain Stirling, Mark Watson, Mae Martin and many more. \r\n\r\nExpect chaos.\r\n\r\n'Refreshingly great' \r\n***** Voice Mag \r\n\r\n'A rare and special experience' A Younger Theatre\r\n16+","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"Werewolf: Live [old]","instanceDates":"13 December-13 December","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"516203ATMSQSMMNHSKHKBKLBVTGVJGRLL","firstInstanceDateTime":"2023-12-13T19:30:00","firstInstanceDateTimeUtc":"2023-12-13T19:30:00Z","lastInstanceDateTime":"2023-12-13T19:30:00","lastInstanceDateTimeUtc":"2023-12-13T19:30:00Z","altText":"","attribute_AudiencePreference1":"Comedy","attribute_AudiencePreference2":"Stand Up","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"Downstairs","attribute_WebsiteFilterCategory1":"Comedy","attribute_WebsiteFilterCategory2":"Stand Up","attribute_WebsiteFilterCategory3":""},{"description":"Watch as an all-star line-up of comedians backstab, manipulate and fight for survival in cult game show Werewolf: Live.\r\nPrevious guests include Rose Matafeo, Nish Kumar, Ed Gamble, London Hughes, Adam Hills, Iain Stirling, Mark Watson, Mae Martin and many more. Expect chaos.\r\n16+","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"Werewolf: Live Apr24","instanceDates":"22 April-23 April","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"537404ASSHVKCKMHQGNBNQLTQBNGQNPKG","firstInstanceDateTime":"2024-04-22T21:15:00","firstInstanceDateTimeUtc":"2024-04-22T20:15:00Z","lastInstanceDateTime":"2024-04-23T21:15:00","lastInstanceDateTimeUtc":"2024-04-23T20:15:00Z","altText":"","attribute_AudiencePreference1":"Comedy","attribute_DynamicPricing":"Yes","attribute_PriorityBooking":false,"attribute_Venue":"Downstairs","attribute_WebsiteFilterCategory1":"Comedy","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":"","attribute_AudiencePreference2":""},{"description":"Behold! This is, WHAM BAM THANK YOU MAM! This absurdist trio of award-winning comedians brings you an hour of off-the-wall stand-up and sketch comedy through the Welsh, Irish and Malaysian perspective. Expect nothing short of absolute mayhem, exciting punches and rolling variation delivered with confidence and a resounding joy. \r\nMarty is magically surreal, Frances is way too open about her private life, and Su is…simply indescribable. \r\nEach give their take on navigating life as a thirty-something goofball, through storytelling, visual aids and character comedy, along with some ukulele, violin and bodhrán accompaniment. Their love of comedy and of each other shines through in this show. Come with your mates and make three more! \r\n16+","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"WHAM BAM THANK YOU MAM!","instanceDates":"13 February-13 February","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"685803AVCDHQSJRQHBCJJMHNSCCJPSQBB","firstInstanceDateTime":"2026-02-13T22:15:00","firstInstanceDateTimeUtc":"2026-02-13T22:15:00Z","lastInstanceDateTime":"2026-02-13T22:15:00","lastInstanceDateTimeUtc":"2026-02-13T22:15:00Z","altText":"","attribute_AudiencePreference1":"Comedy","attribute_AudiencePreference2":"Stand Up","attribute_DynamicPricing":"Yes","attribute_PriorityBooking":false,"attribute_Venue":"Upstairs","attribute_WebsiteFilterCategory1":"Comedy","attribute_WebsiteFilterCategory2":"Stand Up","attribute_WebsiteFilterCategory3":""},{"description":"Three-time consecutive Fringe First Award winners Xhloe and Natasha return to London with their critically acclaimed piece.\r\nThere are three rules every housewife knows: never return a dish empty, always have dinner ready by the time he gets home, and some things are best kept under the table. After all, you never know who’s listening. \r\nYou’ve heard whispers of absent husbands? Missing children? Spaghetti Recipes? Or was it scones? You just can’t trust everything you hear through the walls these days. \r\nThree-time consecutive Fringe First Award winners, Xhloe and Natasha, return to London with their critically acclaimed piece.\r\nXhloe Rice (Creator/ Performer) \r\nNatasha Roland (Creator/ Performer) \r\nAngelo Sagnelli (Lighting Designer/ Technical Director)\r\n13+","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"What If They Ate The Baby","instanceDates":"17 March-28 March","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"597003AKJGMTMVLKVQNRHRNVTBTGNRPRM","firstInstanceDateTime":"2025-03-17T18:45:00","firstInstanceDateTimeUtc":"2025-03-17T18:45:00Z","lastInstanceDateTime":"2025-03-28T18:45:00","lastInstanceDateTimeUtc":"2025-03-28T18:45:00Z","altText":"","attribute_AudiencePreference1":"Theatre","attribute_AudiencePreference2":"Performance Art","attribute_DynamicPricing":"Yes","attribute_PriorityBooking":false,"attribute_Venue":"Upstairs","attribute_WebsiteFilterCategory1":"Theatre","attribute_WebsiteFilterCategory2":"Cabaret","attribute_WebsiteFilterCategory3":"Comedy"},{"description":"“Big Baby” (Whitmer's follow-up to his acclaimed HBO special, The Golden One) is a silly exploration of insecurity, committing too hard to the bit, and (of course) Christopher Nolan's “The Dark Knight”, told through stories and songs centered around Whitmer’s childhood. \r\nWhitmer’s albums “Songs From the Golden One” and “The Older I Get The Funnier I Was” are both available via Hardly Art, and he can also be seen most recently in his feature length screenwriting debut The Civil Dead, released by Utopia Pictures.\r\n\r\n16+ restriction","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"Whitmer Thomas: Big Baby","instanceDates":"1 August-5 August","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"467203APBVGBRPTDHCBHHRHDMLJGTQPMT","firstInstanceDateTime":"2023-08-01T19:15:00","firstInstanceDateTimeUtc":"2023-08-01T18:15:00Z","lastInstanceDateTime":"2023-08-05T19:15:00","lastInstanceDateTimeUtc":"2023-08-05T18:15:00Z","altText":"","attribute_AudiencePreference1":"Comedy","attribute_AudiencePreference2":"Storytelling","attribute_DynamicPricing":"Yes","attribute_PriorityBooking":false,"attribute_Venue":"Downstairs","attribute_WebsiteFilterCategory1":"Comedy","attribute_WebsiteFilterCategory2":"Stand Up","attribute_WebsiteFilterCategory3":""},{"description":"A glittering, gay stand-up extravaganza full of twists, from a TV fanatic whose life hasn’t taken any.\r\nAs featured on British Comedy Guide’s Best-Reviewed shows of the Fringe, the Edinburgh hit “with snarling charisma to burn” (The Scotsman) comes to London. Join Winner of Leicester Square New Comedian and Loose Women apologist Will Owen for an hour of not-so-showbiz tales about life after the X Factor, from someone who only ever watched the show from home. \r\nHe'll dance like nobody’s watching, as long as somebody definitely is.\r\n\r\nBest Reviewed Shows of the Fringe 2024 (British Comedy Guide)\r\nEntertainment Now WoW Award Winner \r\n16+","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"Will Owen: Like, Nobody’s Watching","instanceDates":"10 April-12 April","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"594803ALQGGMQMSKQKGVRBKHGSRCQNQNG","firstInstanceDateTime":"2025-04-10T21:00:00","firstInstanceDateTimeUtc":"2025-04-10T20:00:00Z","lastInstanceDateTime":"2025-04-12T21:00:00","lastInstanceDateTimeUtc":"2025-04-12T20:00:00Z","altText":"","attribute_AudiencePreference1":"Comedy","attribute_AudiencePreference2":"Stand Up","attribute_DynamicPricing":"Yes","attribute_PriorityBooking":false,"attribute_Venue":"Upstairs","attribute_WebsiteFilterCategory1":"Comedy","attribute_WebsiteFilterCategory2":"LGBTQ+","attribute_WebsiteFilterCategory3":"Stand Up"},{"description":"26-year-old comedian Will Owen thinks the future looks bright (no further questions).\r\nFresh from The Edinburgh Fringe 2025, Will is going on a UK-wide tour, as he seeks to replace the empty gratifications of his forlorn life with the deep profundity of light entertainment. He’s gay! He’s lonely! But most importantly, he’s live! \r\nThe Times Best Jokes Of Edinburgh Fringe 2025. \r\nOne of 2024’s best reviewed shows of the Fringe. \r\nWinner: Leicester Square New Comedian of the Year. \r\nTour support for Ania Magliano and Rhys Nicholson. \r\n18+","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"Will Owen: Looking Fab at Fifty","instanceDates":"2 April-4 April","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"680203AQLRMVMRVPJNPPCBTVVCBSCKGNK","firstInstanceDateTime":"2026-04-02T20:45:00","firstInstanceDateTimeUtc":"2026-04-02T19:45:00Z","lastInstanceDateTime":"2026-04-04T20:45:00","lastInstanceDateTimeUtc":"2026-04-04T19:45:00Z","altText":"","attribute_AudiencePreference1":"Comedy","attribute_AudiencePreference2":"Stand Up","attribute_DynamicPricing":"Yes","attribute_PriorityBooking":false,"attribute_Venue":"Upstairs","attribute_WebsiteFilterCategory1":"Comedy","attribute_WebsiteFilterCategory2":"LGBTQ+","attribute_WebsiteFilterCategory3":"Stand Up"},{"description":"A Theatre Centre and Sheffield Theatres co-production\r\nWritten by Katie Redford\r\n“I might not be able to drive legally, but I’m pretty nifty in a dodgem”\r\nAfter all those extra shifts, all Lorna wants is a night out on the town and time to reconnect with her daughter. All 16-year-old Mila wants is for the world to stop burning. And for someone to take down that ‘Beach Body Ready’ poster. Please. As mum and daughter check into their ‘premium’ room where they can almost see the sea, they quickly discover that their favourite seaside town, which was once their annual sunny escape, could really use some attention – just like their relationship. \r\nWISH YOU WEREN’T HERE is a hilarious and heart-warming exploration of family relationships, the agony of growing up, and how to find your way in the world when you can’t help thinking you’re just not good enough.\r\nWritten by Katie Redford (TAPPED, Theatre503; YELLOW LIPS, BBC Radio 4), directed by Rob Watt (HUMAN NURTURE, BIRDS AND BEES), and produced by Theatre Centre and Sheffield theatres, this world premiere production has been created in conversation with hundreds of young people across the country. \r\n14+","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"Wish You Weren’t Here","instanceDates":"19 February-2 March","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"512603AGDVRMGDMTQQNVMJQJVHPNVBPKQ","firstInstanceDateTime":"2024-02-19T19:15:00","firstInstanceDateTimeUtc":"2024-02-19T19:15:00Z","lastInstanceDateTime":"2024-03-02T19:15:00","lastInstanceDateTimeUtc":"2024-03-02T19:15:00Z","altText":"","attribute_AudiencePreference1":"Theatre","attribute_AudiencePreference2":"Storytelling","attribute_DynamicPricing":"Yes","attribute_PriorityBooking":false,"attribute_Venue":"Upstairs","attribute_WebsiteFilterCategory1":"Theatre","attribute_WebsiteFilterCategory2":"New Writing","attribute_WebsiteFilterCategory3":""},{"description":"‘This time last year I would NEVER have thought I’d have written a play. It’s amazing.’ \r\n\r\n    Writers' Lab participant \r\n\r\nWrite Night is a series of monthly sessions for anyone interested in writing for the stage.    \r\n\r\nSessions are on the first Wednesday evening of every month, run by Soho Theatre’s own iconic Bombay-born, London-based Creative Associate Pooja Sivaraman (Clean Break, Theatre503, Coney) and award winning Walthamstow playwright Sonali Bhattacharyya (Bristol Old Vic, Young Vic, Chichester Festival Theatre, Donmar Warehouse, BBC)  \r\n\r\nWhether you’re a total beginner or a more experienced writer, Write Night is open to everyone!   \r\n\r\nEach session will be organised around a theme and you can book them as standalone sessions, or you can book the whole lot! Totally up to you.   \r\n\r\n‘Now I know what the future can hold for me as a writer… I feel a lot more confident.’  \r\n\r\nWriters' Lab participant  \r\n\r\nSessions  \r\n\r\nWed 3 Jun 7pm: Idea Machine  \r\nA workshop designed to inspire new ideas and generate new material for first-time writers or anyone in the depths of writers’ block.  \r\n\r\nWed 1 Jul 7pm: Drumroll Please  \r\nA workshop dissecting the art of dialogue, but with a twist – it's taught by our playwrights in collaboration with a rhythm, poetry and drumming expert!  \r\n\r\nWed 2 Sep 7pm: Adaptation  \r\nA workshop all about adapting existing materials into a new play, from novels to films to documentary and verbatim.  \r\n\r\nWed 7 Oct 7pm: Performing Activism  \r\nA workshop looking at how theatre troupes around the world use the stage as a medium of protest. What are the tools to keep in hand when you’re writing about something that makes you angry?  \r\n\r\nWed 4 Nov 7pm: Rap, Rhyme and Musical theatre  \r\nA workshop all about how to write lyrics and rhyme for musicals and gig theatre  \r\n\r\nWed 2 Dec 7pm: Writing is Rewriting  \r\nA workshop on the redrafting process and how to crack pivotal scenes  \r\n\r\nThere will be teaching, writing exercises and discussion (not to mention tea and biscuits). If any or all of the above sessions sound interesting to you, we’d love for you to pop by and try it out.  \r\n\r\nIf you have any questions at all, email us at engagement@sohotheatre.com – we’re happy to help.  \r\n18+","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"Write Night","instanceDates":"3 June-2 December","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"710203ABNJTJCNTTDNMGSJCCVHNLSVCCR","firstInstanceDateTime":"2026-06-03T19:00:00","firstInstanceDateTimeUtc":"2026-06-03T18:00:00Z","lastInstanceDateTime":"2026-12-02T19:00:00","lastInstanceDateTimeUtc":"2026-12-02T19:00:00Z","altText":"","attribute_AudiencePreference1":"Theatre","attribute_AudiencePreference2":"Storytelling","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"Studio 1","attribute_WebsiteFilterCategory1":"Theatre","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":""},{"description":"Soho Theatre has played a unique and award-winning role in the development of new writing in Britain for more than 40 years.\r\n‘This time last year I would NEVER have thought I’d have written a play. It’s amazing.’\r\n-\tWriters' Lab participant\r\nWrite Night is a series of monthly sessions for anyone interested in writing for the stage. \r\nSessions are on the first Thursday evening of every month, run by Walthamstow playwright Sonali Bhattacharyya (who has written plays for the Young Vic, Donmar Warehouse, Orange Tree Theatre as well as many more for stage and screen) and Soho Theatre’s own Creative Associate Pooja Sivaraman. \r\nWhether you’re a total beginner or a more experienced writer, Write Night is open to everyone!\r\nEach session will be organised around a theme and you can book them as standalone sessions, or you can book the whole lot! Totally up to you. The sessions are:\r\no    Thu Jun 05 19:00 – 21:30, IDEA MACHINE - a workshop designed to inspire new ideas and generate new material for first-time writers or anyone in the depths of writers’ block.\r\no    Thu Jul 03 19:00 – 21:30, BIG EARS - a workshop all about dialogue, exploring listening to and writing conversation.\r\no    Thu Aug 07 19:00 – 21:30, WRITING YOUR GENERATION (TEENS AND YOUNG ADULTS) - a writing workshop for teenage and young adult participants aged 16-25. Please only book if you or whoever you are booking for is within the age range!\r\no    Thu Sep 04 19:00 – 21:30, DRUMROLL PLEASE - a workshop dissecting the art of dialogue through rhythm, with a professional drummer.\r\no    Thu Oct 02 19:00 – 21:30, JUST SHUT UP! - a workshop designed to interrogate and silence your internal censor, freeing you up to write your imagination. \r\no    Thu Nov 06 19:00 – 21:30, PERFORMING ACTIVISM - a workshop looking at how theatre troupes around the world use the stage as a medium of protest. What are the tools to keep in hand when you’re writing about something that makes you angry?\r\no    Thu Dec 04 19:00 – 21:30, RAP, RHYME AND MUSICAL THEATRE - a workshop all about how to write lyrics and rhyme for musicals and gig theatre.\r\no    Thu Jan 08 19:00 – 21:30, ADAPTATION - a workshop all about adapting existing materials into a new play, from novels and films to documentary and verbatim. \r\no    Thu Feb 05 19:00 – 21:30, STRUCTURE & HOPE - a workshop all about structure, how to get to the end of your draft, and writing from a place of hope. \r\no    Thu Mar 05 19:00 – 21:30, WRITING IS REWRITING - a workshop on the redrafting process and how to crack pivotal scenes.\r\nThere will be teaching, writing exercises and discussion (not to mention tea and biscuits). If any or all of the above sessions sound interesting to you, we’d love for you to pop by and try it out. Please note that you will initially only be able to book the first three sessions, with tickets for the remaining 7 sessions going on sale in June/July. \r\nIf you have any questions at all, email us at engagement@sohotheatre.com – we’re happy to help. \r\nSee you at Write Night!\r\n“Now I know what the future can hold for me as a writer… I feel a lot more confident.”\r\nMontel, Writers’ Lab participant\r\n18+","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"Write Night 2025","instanceDates":"5 June-5 March","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"622203ANLGDVTKKLLSGLSLLHCVLKRKDHM","firstInstanceDateTime":"2025-06-05T19:00:00","firstInstanceDateTimeUtc":"2025-06-05T18:00:00Z","lastInstanceDateTime":"2026-03-05T19:00:00","lastInstanceDateTimeUtc":"2026-03-05T19:00:00Z","altText":"","attribute_AudiencePreference1":"Theatre","attribute_AudiencePreference2":"Storytelling","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"Studio 1","attribute_WebsiteFilterCategory1":"Theatre","attribute_WebsiteFilterCategory3":"Theatre","attribute_WebsiteFilterCategory2":""},{"description":"18+","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"Writers' Lab Taster - for Disabled Participants","instanceDates":"3 July-3 July","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"557203ATTSCTCPDJHTMJSRQPTMHDHQHHC","firstInstanceDateTime":"2024-07-03T19:00:00","firstInstanceDateTimeUtc":"2024-07-03T18:00:00Z","lastInstanceDateTime":"2024-07-03T19:00:00","lastInstanceDateTimeUtc":"2024-07-03T18:00:00Z","altText":"","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"","attribute_WebsiteFilterCategory1":"","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":"","attribute_AudiencePreference1":"","attribute_AudiencePreference2":""},{"description":"18+","htmlDescription":"<div id>\r\n\r\n</div>","duration":360,"imageUrl":"","isOnSale":true,"name":"Writers' Lab Winter23","instanceDates":"14 October-14 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"497803ANDHQCKRKDHQGSLRRSGMTQQVJNK","firstInstanceDateTime":"2023-10-14T11:00:00","firstInstanceDateTimeUtc":"2023-10-14T10:00:00Z","lastInstanceDateTime":"2023-10-14T11:00:00","lastInstanceDateTimeUtc":"2023-10-14T10:00:00Z","altText":"","attribute_DynamicPricing":"Yes","attribute_PriorityBooking":false,"attribute_Venue":"Theatre","attribute_WebsiteFilterCategory1":"","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":"","attribute_AudiencePreference1":"","attribute_AudiencePreference2":""},{"description":"Our online Writers’ Lab taster session will introduce you to a range of introductory playwriting skills including: how to develop characters, build your world, write sparky dialogue, and much more. All lead by one of our wonderful Soho Theatre Writers’ Lab facilitators, queer & disabled theatre maker Jules Haworth.\r\n18+","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"Writers’ Lab Taster – d/Deaf, Disabled and Neurodivergent","instanceDates":"21 July-21 July","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"737003AGRLVVPRHNHMSBDRLGNRQNKJJPD","firstInstanceDateTime":"2026-07-21T17:30:00","firstInstanceDateTimeUtc":"2026-07-21T16:30:00Z","lastInstanceDateTime":"2026-07-21T17:30:00","lastInstanceDateTimeUtc":"2026-07-21T16:30:00Z","altText":"","attribute_AudiencePreference1":"Theatre","attribute_AudiencePreference2":"New Writing","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"Online","attribute_WebsiteFilterCategory1":"Theatre","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":""},{"description":"Curious to try writing and not sure where to begin? Want to find out more about opportunities for aspiring and emerging playwrights at Soho Theatre in a safe community environment together with other d/Deaf, disabled and neurodivergent artists? \r\nOur online Writers’ Lab taster session for d/Deaf, disabled and neurodivergent writers will introduce you to a range of introductory playwriting skills including: how to develop characters, build your world, write sparky dialogue, and much more. All lead by one of our wonderful Soho Theatre Writers’ Lab facilitators, disabled artist Jules Haworth.  \r\nIf you’ve ever been curious to try a bit of creative writing for the stage, come along and check it out. You will meet a friendly community of peers in a safe and warm environment. The session is online so you can do it from the comfort of your home – and it’s only a fiver for a two-hour session. Once you’ve booked, we will be in touch to check in about any access provisions we can arrange to make sure you have the best experience of the session that we can arrange. \r\nAnd if you enjoy the taster, we warmly invite you to apply for our 9-month Writers’ Lab programme. \r\n18+","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"Writers’ Lab Taster – d/Deaf, Disabled and Neurodivergent Jul25","instanceDates":"22 July-22 July","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"640403ACCTQNCKCLHPHJDMSPCJVGLKMGG","firstInstanceDateTime":"2025-07-22T17:30:00","firstInstanceDateTimeUtc":"2025-07-22T16:30:00Z","lastInstanceDateTime":"2025-07-22T17:30:00","lastInstanceDateTimeUtc":"2025-07-22T16:30:00Z","altText":"","attribute_AudiencePreference1":"Theatre","attribute_AudiencePreference2":"New Writing","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"Online","attribute_WebsiteFilterCategory1":"Theatre","attribute_WebsiteFilterCategory2":"New Writing","attribute_WebsiteFilterCategory3":""},{"description":"Do you live, work or study in Waltham Forest? Curious to try writing and not sure where to begin? Want to find out more about opportunities for aspiring and emerging playwrights at Soho Theatre?\r\n18+","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"Writers’ Lab Taster – E17 Art Trail","instanceDates":"9 June-12 June","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"724603ALBQKPBGGKDNPTDTLBHCNRNRVPR","firstInstanceDateTime":"2026-06-09T17:30:00","firstInstanceDateTimeUtc":"2026-06-09T16:30:00Z","lastInstanceDateTime":"2026-06-12T15:00:00","lastInstanceDateTimeUtc":"2026-06-12T14:00:00Z","altText":"","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"Studio","attribute_WebsiteFilterCategory1":"","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":"","attribute_AudiencePreference1":"","attribute_AudiencePreference2":""},{"description":"18+","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"Writers’ Lab Taster - for LGBTQIA+ Writers","instanceDates":"26 June-26 June","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"557003ADJHBLSJHPTMJCKQKCJBRMBGHNQ","firstInstanceDateTime":"2024-06-26T19:00:00","firstInstanceDateTimeUtc":"2024-06-26T18:00:00Z","lastInstanceDateTime":"2024-06-26T19:00:00","lastInstanceDateTimeUtc":"2024-06-26T18:00:00Z","altText":"","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"Zoom","attribute_WebsiteFilterCategory1":"","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":"","attribute_AudiencePreference1":"","attribute_AudiencePreference2":""},{"description":"18+","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"Writers’ Lab Taster - for Writers from the Global Majority","instanceDates":"9 July-9 July","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"557403AMCCNNPCKBMLMSRTJCTMGNKKJQB","firstInstanceDateTime":"2024-07-09T17:30:00","firstInstanceDateTimeUtc":"2024-07-09T16:30:00Z","lastInstanceDateTime":"2024-07-09T17:30:00","lastInstanceDateTimeUtc":"2024-07-09T16:30:00Z","altText":"","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"Zoom","attribute_WebsiteFilterCategory1":"","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":"","attribute_AudiencePreference1":"","attribute_AudiencePreference2":""},{"description":"Our online Writers’ Lab taster session for global majority* writers will introduce you to a range of introductory playwriting skills including: how to develop characters, build your world, write sparky dialogue, and much more. All lead by one of our wonderful Soho Theatre Writers’ Lab facilitators, playwright Sharmila Chauhan.\r\n18+","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"Writers’ Lab Taster – Global Majority","instanceDates":"20 July-20 July","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"737203ARBRSMVCDNRHKLKTVCTMTPVSLVJ","firstInstanceDateTime":"2026-07-20T17:30:00","firstInstanceDateTimeUtc":"2026-07-20T16:30:00Z","lastInstanceDateTime":"2026-07-20T17:30:00","lastInstanceDateTimeUtc":"2026-07-20T16:30:00Z","altText":"","attribute_AudiencePreference1":"Theatre","attribute_AudiencePreference2":"New Writing","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"Online","attribute_WebsiteFilterCategory1":"Theatre","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":""},{"description":"Curious to try writing and not sure where to begin? Want to find out more about opportunities for aspiring and emerging playwrights at Soho Theatre in a safe community environment together with other global majority artists? \r\nOur online Writers’ Lab taster session for global majority* writers will introduce you to a range of introductory playwriting skills including: how to develop characters, build your world, write sparky dialogue, and much more. All lead by one of our wonderful Soho Theatre Writers’ Lab facilitators, playwright Sharmila Chauhan. \r\nIf you’ve ever been curious to try a bit of creative writing for the stage, come along and check it out. You will meet a friendly community of peers in a safe and warm environment. The session is online so you can do it from the comfort of your home – and it’s only a fiver for a two-hour session. \r\nAnd if you enjoy the taster, we warmly invite you to apply for our 9-month Writers’ Lab programme. \r\n*people who identify as Black Caribbean, Black African, South Asian, East Asian, Middle Eastern or Latinx.\r\n18+","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"Writers’ Lab Taster – Global Majority Jul25 ","instanceDates":"14 July-14 July","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"640603AGRLCNPQHRVPBDTKDNNPGGNLRPG","firstInstanceDateTime":"2025-07-14T17:30:00","firstInstanceDateTimeUtc":"2025-07-14T16:30:00Z","lastInstanceDateTime":"2025-07-14T17:30:00","lastInstanceDateTimeUtc":"2025-07-14T16:30:00Z","altText":"","attribute_AudiencePreference1":"Theatre","attribute_AudiencePreference2":"New Writing","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"Online","attribute_WebsiteFilterCategory1":"Theatre","attribute_WebsiteFilterCategory2":"India/South Asian heritage","attribute_WebsiteFilterCategory3":"New Writing"},{"description":"Our online Writers’ Lab taster session for LGBTQIA+ writers will introduce you to a range of introductory playwriting skills including: how to develop characters, build your world, write sparky dialogue, and much more. All lead by one of our wonderful Soho Theatre Writers’ Lab facilitators and queer artists, Jules Haworth. \r\n18+","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"Writers’ Lab Taster – LGBTQIA+","instanceDates":"22 July-22 July","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"737403AKHDDJDRNKDNHBGKGRPHVBVNKCQ","firstInstanceDateTime":"2026-07-22T17:30:00","firstInstanceDateTimeUtc":"2026-07-22T16:30:00Z","lastInstanceDateTime":"2026-07-22T17:30:00","lastInstanceDateTimeUtc":"2026-07-22T16:30:00Z","altText":"","attribute_AudiencePreference1":"Theatre","attribute_AudiencePreference2":"New Writing","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"Online","attribute_WebsiteFilterCategory1":"Theatre","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":""},{"description":"Curious to try writing and not sure where to begin? Want to find out more about opportunities for aspiring and emerging playwrights at Soho Theatre in a safe, LGBTQIA+ community environment? \r\nOur online Writers’ Lab taster session for LGBTQIA+ writers will introduce you to a range of introductory playwriting skills including: how to develop characters, build your world, write sparky dialogue, and much more. All lead by one of our wonderful facilitators and queer artists who runs our Soho Theatre Writers’ Lab: Jules Haworth. \r\nIf you’ve ever been curious to try a bit of creative writing for the stage, come along and check it out. You will meet a friendly community of LGBTQIA+ peers in a safe and warm environment. The session is online so you can do it from the comfort of your home – and it’s only a fiver for a two-hour session. \r\nAnd if you enjoy the taster, we warmly invite you to apply for our 9-month Writers’ Lab programme. \r\n18+","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"Writers’ Lab Taster – LGBTQIA+ Jul25","instanceDates":"8 July-8 July","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"640803AHBGNBGSSSPLCQTSLLTHTLCNMQK","firstInstanceDateTime":"2025-07-08T17:30:00","firstInstanceDateTimeUtc":"2025-07-08T16:30:00Z","lastInstanceDateTime":"2025-07-08T17:30:00","lastInstanceDateTimeUtc":"2025-07-08T16:30:00Z","altText":"","attribute_AudiencePreference1":"Theatre","attribute_AudiencePreference2":"LGBTQ+","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"Online","attribute_WebsiteFilterCategory1":"Theatre","attribute_WebsiteFilterCategory2":"LGBTQ+","attribute_WebsiteFilterCategory3":"New Writing"},{"description":"Our online Writers’ Lab taster session will introduce you to a range of introductory playwriting skills including: how to develop characters, build your world, write sparky dialogue, and much more. All lead by one of our wonderful Soho Theatre Writers’ Lab facilitators, playwright Sharmila Chauhan.\r\n18+","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"Writers’ Lab Taster – Open to All","instanceDates":"16 July-16 July","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"737803AKGDDGCLHRLHQCCKSJHJHTJPNJT","firstInstanceDateTime":"2026-07-16T17:30:00","firstInstanceDateTimeUtc":"2026-07-16T16:30:00Z","lastInstanceDateTime":"2026-07-16T17:30:00","lastInstanceDateTimeUtc":"2026-07-16T16:30:00Z","altText":"","attribute_AudiencePreference1":"Theatre","attribute_AudiencePreference2":"New Writing","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"Online","attribute_WebsiteFilterCategory1":"Theatre","attribute_WebsiteFilterCategory2":"Theatre","attribute_WebsiteFilterCategory3":""},{"description":"Curious to try writing and not sure where to begin? Want to find out more about opportunities for aspiring and emerging playwrights at Soho Theatre? \r\nOur online Writers’ Lab taster sessions will introduce you to a range of introductory playwriting skills including: how to develop characters, build your world, write sparky dialogue, and much more. All lead by the wonderful playwrights and facilitators who run our Soho Theatre Writers’ Lab: Sharmila Chauhan and Jules Haworth. \r\nIf you’ve ever been curious to try a bit of creative writing for the stage, come along and check it out. Most of the sessions are online so you can do them from the comfort of your home – and they’re only a fiver for a two-hour session. \r\nAnd if you enjoy the taster, we warmly invite you to apply for our 9-month Writers’ Lab programme. \r\n18+","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"Writers’ Lab Taster – Open to All Jul25","instanceDates":"9 July-9 July","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"641003AJGRLCTPGCDHHHDKHDHGTTQLJTN","firstInstanceDateTime":"2025-07-09T17:30:00","firstInstanceDateTimeUtc":"2025-07-09T16:30:00Z","lastInstanceDateTime":"2025-07-09T17:30:00","lastInstanceDateTimeUtc":"2025-07-09T16:30:00Z","altText":"","attribute_AudiencePreference1":"Theatre","attribute_AudiencePreference2":"New Writing","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"Online","attribute_WebsiteFilterCategory1":"Theatre","attribute_WebsiteFilterCategory2":"New Writing","attribute_WebsiteFilterCategory3":""},{"description":"18+","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"Writers’ Lab Taster - Open to All Jun24","instanceDates":"25 June-25 June","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"556603APKGGMVSVQKBJPBTVRPVTMVSTNP","firstInstanceDateTime":"2024-06-25T17:30:00","firstInstanceDateTimeUtc":"2024-06-25T16:30:00Z","lastInstanceDateTime":"2024-06-25T17:30:00","lastInstanceDateTimeUtc":"2024-06-25T16:30:00Z","altText":"","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"Zoom","attribute_WebsiteFilterCategory1":"","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":"","attribute_AudiencePreference1":"","attribute_AudiencePreference2":""},{"description":"Our Writers’ Lab taster session for people who live, work or study in Waltham Forest will introduce you to a range of introductory playwriting skills including: how to develop characters, build your world, write sparky dialogue, and much more. All lead by one of our wonderful Soho Theatre Writers’ Lab facilitators, playwright Sharmila Chauhan\r\n18+","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"Writers’ Lab Taster – Waltham Forest","instanceDates":"23 July-23 July","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"738003ASJVRRJKBJBLPCLCHRRKLTGBTTM","firstInstanceDateTime":"2026-07-23T17:30:00","firstInstanceDateTimeUtc":"2026-07-23T16:30:00Z","lastInstanceDateTime":"2026-07-23T17:30:00","lastInstanceDateTimeUtc":"2026-07-23T16:30:00Z","altText":"","attribute_AudiencePreference1":"Theatre","attribute_AudiencePreference2":"New Writing","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_WebsiteFilterCategory1":"Theatre","attribute_Venue":"","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":""},{"description":"If you live, work or study in Waltham Forest and you're thinking about trying writing for the first time, come along to our friendly informal introduction to playwriting.\r\n\r\nTasters will introduce you to a range of introductory playwriting skills including developing character, location and dialogue, all expertly guided by a Soho Theatre’s Writers’ Lab Course Leader.\r\n\r\nThis taster is free to attend and only open to people aged 18+ who live, work or study in Waltham Forest.\r\n18+","htmlDescription":"<div id>\r\n\r\n</div>","duration":90,"imageUrl":"","isOnSale":true,"name":"Writers’ Lab Taster - Waltham Forest Jul24","instanceDates":"9 July-9 July","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"560603ARHKJMMKHDGVQBMDMKVCLRLRTCP","firstInstanceDateTime":"2024-07-09T13:30:00","firstInstanceDateTimeUtc":"2024-07-09T12:30:00Z","lastInstanceDateTime":"2024-07-09T13:30:00","lastInstanceDateTimeUtc":"2024-07-09T12:30:00Z","altText":"","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"The Mill, Walthamstow","attribute_WebsiteFilterCategory1":"","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":"","attribute_AudiencePreference1":"","attribute_AudiencePreference2":""},{"description":"Do you live, work or study in Waltham Forest? Curious to try writing and not sure where to begin? Want to find out more about opportunities for aspiring and emerging playwrights at Soho Theatre?\r\nOur Writers’ Lab taster session for people who live, work or study in Waltham Forest will introduce you to a range of introductory playwriting skills including: how to develop characters, build your world, write sparky dialogue, and much more. All lead by one of our Soho Theatre Writers’ Lab facilitators, playwright Sharmila Chauhan.  \r\n\r\nIf you’ve ever been curious to try a bit of creative writing for the stage, come along and check it out. The workshop will take place at Soho Theatre Walthamstow – and it’s only a fiver for a two-hour session. \r\n\r\nIf you enjoy the taster, we warmly invite you to apply for our 9-month Writers’ Lab programme. \r\n18+","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"Writers’ Lab Taster – Waltham Forest Jul25","instanceDates":"17 July-17 July","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"641203ALVSSQSGHGSTBCVSBNLTHCJTCSK","firstInstanceDateTime":"2025-07-17T17:30:00","firstInstanceDateTimeUtc":"2025-07-17T16:30:00Z","lastInstanceDateTime":"2025-07-17T17:30:00","lastInstanceDateTimeUtc":"2025-07-17T16:30:00Z","altText":"","attribute_AudiencePreference1":"Theatre","attribute_AudiencePreference2":"New Writing","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"Studio 1","attribute_WebsiteFilterCategory1":"Theatre","attribute_WebsiteFilterCategory2":"New Writing","attribute_WebsiteFilterCategory3":""},{"description":"Thinking about trying writing for the first time? Not sure where to begin? Come along to our friendly informal introduction to playwriting. Tasters will introduce you to a range of introductory playwriting skills including developing character, location and dialogue, all expertly guided by Soho Theatre’s Writers’ Lab Course Leader Lakesha Arie-Angelo.\r\n\r\nThis taster is for people aged 18+ who identify as disabled participants.\r\n\r\nBursaries are available for those who receive Universal Credit or other welfare benefits. However, if cost is a barrier to you taking part for any reason, please contact engagement@sohotheatre.com and we can discuss possible bursary options.\r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"Writers’ Lab Taster: Disabled Participants Jul23","instanceDates":"20 July-20 July","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"483003ASTVMLMDGDJMHPHMGCGKSBBVCVJ","firstInstanceDateTime":"2023-07-20T18:30:00","firstInstanceDateTimeUtc":"2023-07-20T17:30:00Z","lastInstanceDateTime":"2023-07-20T18:30:00","lastInstanceDateTimeUtc":"2023-07-20T17:30:00Z","altText":"","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"Zoom","attribute_WebsiteFilterCategory1":"","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":"","attribute_AudiencePreference1":"","attribute_AudiencePreference2":""},{"description":"Thinking about trying writing for the first time? Not sure where to begin? Come along to our friendly informal introduction to playwriting. Tasters will introduce you to a range of introductory playwriting skills including developing character, location and dialogue, all expertly guided by Soho Theatre’s Writers’ Lab Course Leader Lakesha Arie-Angelo.\r\n\r\nThis taster is for people aged 18+ who identify as being from the Global Majority. \r\n\r\nBursaries are available for those who receive Universal Credit or other welfare benefits. However, if cost is a barrier to you taking part for any reason, please contact engagement@sohotheatre.com and we can discuss possible bursary options.\r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"Writers’ Lab Taster: For people from the Global Majority Writers’ Lab Taster Jul23","instanceDates":"10 July-10 July","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"482403ATKCRBVPNSGBTSTLKQCTBSPRKTH","firstInstanceDateTime":"2023-07-10T18:30:00","firstInstanceDateTimeUtc":"2023-07-10T17:30:00Z","lastInstanceDateTime":"2023-07-10T18:30:00","lastInstanceDateTimeUtc":"2023-07-10T17:30:00Z","altText":"","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"Zoom","attribute_WebsiteFilterCategory1":"","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":"","attribute_AudiencePreference1":"","attribute_AudiencePreference2":""},{"description":"Thinking about trying writing for the first time? Not sure where to begin? Come along to our friendly informal introduction to playwriting. Tasters will introduce you to a range of introductory playwriting skills including developing character, location and dialogue, all expertly guided by Soho Theatre’s Writers’ Lab Course Leader Lakesha Arie-Angelo.\r\n\r\nThis taster is for people aged 18+ who identify as LGBTQIA+ Participants.\r\n\r\nBursaries are available for those who receive Universal Credit or other welfare benefits. However, if cost is a barrier to you taking part for any reason, please contact engagement@sohotheatre.com and we can discuss possible bursary options.\r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"Writers’ Lab Taster: LGBTQIA+ Participants Jul23","instanceDates":"11 July-11 July","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"482603ATRHLQMNNLDJSQLKGPHNPSDNSCP","firstInstanceDateTime":"2023-07-11T18:30:00","firstInstanceDateTimeUtc":"2023-07-11T17:30:00Z","lastInstanceDateTime":"2023-07-11T18:30:00","lastInstanceDateTimeUtc":"2023-07-11T17:30:00Z","altText":"","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"Zoom","attribute_WebsiteFilterCategory1":"","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":"","attribute_AudiencePreference1":"","attribute_AudiencePreference2":""},{"description":"Thinking about trying writing for the first time? Not sure where to begin? Come along to our friendly informal introduction to playwriting. Tasters will introduce you to a range of introductory playwriting skills including developing character, location and dialogue, all expertly guided by Soho Theatre’s Writers’ Lab Course Leader Lakesha Arie-Angelo.\r\n\r\nThis taster is for people aged 18+\r\n\r\nBursaries are available for those who receive Universal Credit or other welfare benefits. However, if cost is a barrier to you taking part for any reason, please contact engagement@sohotheatre.com and we can discuss possible bursary options.","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"Writers’ Lab Taster: Open To All Jul23","instanceDates":"25 July-25 July","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"482404AMVTBHDNTRCJNMCRCQQQJGMLKQR","firstInstanceDateTime":"2023-07-25T18:30:00","firstInstanceDateTimeUtc":"2023-07-25T17:30:00Z","lastInstanceDateTime":"2023-07-25T18:30:00","lastInstanceDateTimeUtc":"2023-07-25T17:30:00Z","altText":"","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"Zoom","attribute_WebsiteFilterCategory1":"","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":"","attribute_AudiencePreference1":"","attribute_AudiencePreference2":""},{"description":"Thinking about trying writing for the first time? Not sure where to begin? Come along to our friendly informal introduction to playwriting. Tasters will introduce you to a range of introductory playwriting skills including developing character, location and dialogue, all expertly guided by Soho Theatre’s Writers’ Lab Course Leader Lakesha Arie-Angelo.\r\n\r\nThis taster is for people aged 18+.\r\n\r\nBursaries are available for those who receive Universal Credit or other welfare benefits. However, if cost is a barrier to you taking part for any reason, please contact engagement@sohotheatre.com and we can discuss possible bursary options.\r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"Writers’ Lab Taster: Q&A open to all Jul23","instanceDates":"18 July-18 July","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"482803ATNCSSMVDBCCNCKDHCSCSPCLVVC","firstInstanceDateTime":"2023-07-18T16:30:00","firstInstanceDateTimeUtc":"2023-07-18T15:30:00Z","lastInstanceDateTime":"2023-07-18T16:30:00","lastInstanceDateTimeUtc":"2023-07-18T15:30:00Z","altText":"","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"Zoom","attribute_WebsiteFilterCategory1":"","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":"","attribute_AudiencePreference1":"","attribute_AudiencePreference2":""},{"description":"Thinking about trying writing for the first time? Not sure where to begin? Come along to our friendly informal introduction to playwriting. Tasters will introduce you to a range of introductory playwriting skills including developing character, location and dialogue, all expertly guided by Soho Theatre’s Writers’ Lab Course Leader Sharmila Chauhan. \r\nThis taster is for people aged 18+ who lives, works or studies in Waltham Forest \r\nBursaries are available for those who receive Universal Credit or other welfare benefits. However, if cost is a barrier to you taking part for any reason, please contact engagement@sohotheatre.com and we can discuss possible bursary options.\r\nThis taster is delivered in conjunction with Waltham Forest Library \r\n","htmlDescription":"<div id>\r\n\r\n</div>","duration":90,"imageUrl":"","isOnSale":true,"name":"Writers’ Lab Taster: Waltham Forest Jul23","instanceDates":"14 July-14 July","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"484203AMPBDHTGKGKTJKJMKQQSMGJRNHQ","firstInstanceDateTime":"2023-07-14T12:30:00","firstInstanceDateTimeUtc":"2023-07-14T11:30:00Z","lastInstanceDateTime":"2023-07-14T12:30:00","lastInstanceDateTimeUtc":"2023-07-14T11:30:00Z","altText":"","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"Waltham Forest Library","attribute_WebsiteFilterCategory1":"","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":"","attribute_AudiencePreference1":"","attribute_AudiencePreference2":""},{"description":"A whirlwind one-woman comedy about a wannabe yummy mummy manifesting it all. Wummy is broke, flat-sharing and craving luxury. Her dream? A Chelsea townhouse, husband, baby, nanny and most importantly - a bin hidden within a kitchen island. Wummy attempts to manifest her dream life, but the universe throws her an unexpected, cosmic curveball. 16+","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"Wummy","instanceDates":"14 February-14 February","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"686003AKHMKQSDKCQQSJSSBLRHMGMDQSB","firstInstanceDateTime":"2026-02-14T20:30:00","firstInstanceDateTimeUtc":"2026-02-14T20:30:00Z","lastInstanceDateTime":"2026-02-14T20:30:00","lastInstanceDateTimeUtc":"2026-02-14T20:30:00Z","altText":"","attribute_AudiencePreference1":"Comedy","attribute_AudiencePreference2":"Character","attribute_DynamicPricing":"Yes","attribute_PriorityBooking":false,"attribute_Venue":"Upstairs","attribute_WebsiteFilterCategory1":"Comedy","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":""},{"description":"A show on the complex and not-so-complex men seen in today's Jewish society.\r\nHave you ever met a Jewish man you haven’t liked? Don’t answer that question. \r\n\r\nThe Wise Men present hilarious and uncomfortably familiar stories of Jewish men grappling with their masculinity and whether or not to call their mums back. \r\n\r\nDid you know Jewish Rock is a valid genre of music? Let Mordy, a professional camp counsellor, teach the rules of Jewish summer camp with his guitar, also named Mordy. Just John is an active listener and wants to give you the space to ask him out on a date. Yoni Yonatan wants you to know he DOES NOT CARE about your feelings!! These Jewish men will pull at your heartstrings, get you hot and heavy, and teach you a thing or two about feminism. \r\n\r\nWelcome to Yaya's “city of fools”, inspired by the Jewish folklore stories of “The Wise Men of Chelm.” \r\nCreated by Yael Elisheva, directed by Lara Robinson\r\n16+","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"Yael Elisheva: The Wise Men","instanceDates":"20 February-20 February","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"592003ARPLPSNVJCKQBKDMMRVMNSNQMTK","firstInstanceDateTime":"2025-02-20T20:30:00","firstInstanceDateTimeUtc":"2025-02-20T20:30:00Z","lastInstanceDateTime":"2025-02-20T20:30:00","lastInstanceDateTimeUtc":"2025-02-20T20:30:00Z","altText":"","attribute_AudiencePreference1":"Drag","attribute_AudiencePreference2":"Character","attribute_DynamicPricing":"Yes","attribute_PriorityBooking":false,"attribute_Venue":"Upstairs","attribute_WebsiteFilterCategory1":"Comedy","attribute_WebsiteFilterCategory2":"Theatre","attribute_WebsiteFilterCategory3":"LGBTQ+"},{"description":"Ahead of Failure Project in Soho Upstairs, award-winning artist Yolanda Mercy shares tips and tools about making work as a writer-performer.\r\nThis 2-hour masterclass is for anyone looking to create original work for the stage as a writer-performer, led by multi award-winning artist and BAFTA nominee Yolanda Mercy. The session will explore how to generate ideas, shape them into shows/projects, and navigate the unique challenges of performing your own writing. Through practical exercises, honest insights, and open discussion, you’ll gain tools to build confidence, find your voice, and take your ideas further. Whether you’re just starting out or developing your next piece, this session offers inspiration and strategies to support your creative journey.\r\n18+","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"Yolanda Mercy Masterclass: Making work as a Writer-Performer","instanceDates":"9 May-9 May","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"626203AHBNSHMKMPCVTKNJQNQPGGJRMPJ","firstInstanceDateTime":"2025-05-09T14:30:00","firstInstanceDateTimeUtc":"2025-05-09T13:30:00Z","lastInstanceDateTime":"2025-05-09T14:30:00","lastInstanceDateTimeUtc":"2025-05-09T13:30:00Z","altText":"","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"Upstairs","attribute_WebsiteFilterCategory1":"","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":"","attribute_AudiencePreference1":"","attribute_AudiencePreference2":""},{"description":"“There are no small parts. Only weak children.” \r\n\r\nMiss June teaches baby ballet in a crumbling village hall, drilling good-toes-naughty-toes into a generation of tiny dancers while her own dreams of greatness quietly rot. But when her final shot at fame vanishes, she doubles down, and fights to transform the end-of-term sharing into an all-consuming quest for glory. This is going to be the battle of a lifetime. \r\n\r\nA surreal, razor-sharp dark comedy about ambition, delusion, and what happens when the dream refuses to die.\r\n18+","htmlDescription":"<div id>\r\n\r\n</div>","duration":70,"imageUrl":"","isOnSale":true,"name":"You’re So Special","instanceDates":"3 September-26 September","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"728803ACNBPBSRCBSGQVNPVNVQSNBLDLH","firstInstanceDateTime":"2026-09-03T18:45:00","firstInstanceDateTimeUtc":"2026-09-03T17:45:00Z","lastInstanceDateTime":"2026-09-26T18:45:00","lastInstanceDateTimeUtc":"2026-09-26T17:45:00Z","altText":"","attribute_AudiencePreference1":"New Writing","attribute_DynamicPricing":"Yes","attribute_PriorityBooking":false,"attribute_Venue":"Upstairs","attribute_WebsiteFilterCategory1":"Theatre","attribute_WebsiteFilterCategory2":"Theatre","attribute_WebsiteFilterCategory3":"Theatre","attribute_AudiencePreference2":""},{"description":"Straight off the back of their riotous Edinburgh Fringe run, Your Aunt Fanny are taking their latest sketch show, Muff Said, across the UK.  Prepare for an hour of ambitious and fiery writing, the perfect balance of cutting observations and overly friendly Geordie embraces. \r\nYour Aunt Fanny are an all-womxn comedy collective hailing from the North East, whose infectious laughter and effortless performance style is like a perfect night out with your wildest, oldest, filthiest friend.\r\n\r\n16+","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"Your Aunt Fanny: Muff Said","instanceDates":"13 April-15 April","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"457203AHJDTMDDJPTHDPNMRSDQCJHSQTR","firstInstanceDateTime":"2023-04-13T22:30:00","firstInstanceDateTimeUtc":"2023-04-13T21:30:00Z","lastInstanceDateTime":"2023-04-15T22:30:00","lastInstanceDateTimeUtc":"2023-04-15T21:30:00Z","altText":"","attribute_DynamicPricing":"Yes","attribute_PriorityBooking":false,"attribute_Venue":"Upstairs","attribute_WebsiteFilterCategory1":"","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":"","attribute_AudiencePreference1":"","attribute_AudiencePreference2":""},{"description":"Multi-hyphenate comedy genius Zachary Ruane (Aunty Donna, Mish & Zach, Dungeons & Dragons: Honour Among Thieves*) is finally gifting the world with his debut solo show\r\n\r\nComedy promises to be the most important and definitive comedic work of the 21st century. Join Zachary as he explores the history and future of comedy and his place within it as a generational talent. Comedy is not to be missed.","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"Zachary Ruane: Comedy","instanceDates":"1 September-5 September","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"728403AHHHBPDDRKLVPCGTPJRLHRQMNDS","firstInstanceDateTime":"2026-09-01T19:00:00","firstInstanceDateTimeUtc":"2026-09-01T18:00:00Z","lastInstanceDateTime":"2026-09-05T19:00:00","lastInstanceDateTimeUtc":"2026-09-05T18:00:00Z","altText":"","attribute_AudiencePreference1":"Comedy","attribute_AudiencePreference2":"International","attribute_DynamicPricing":"Yes","attribute_PriorityBooking":false,"attribute_Venue":"Theatre","attribute_WebsiteFilterCategory1":"Comedy","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":""},{"description":"Excited to return after her 9 sold out shows at Soho Theatre in November, Zainab Johnson is back and the audience gets to decide what she talks about! The Crowd Work Show is improvised stand-up inspired by audience suggestions. Nothing written, nothing planned, and no topic is off limits.","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"Zainab Johnson: A Crowd Work Show","instanceDates":"21 July-26 July","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"627003AVJDPBPCQTHNKCHBMJSSLSSHQCV","firstInstanceDateTime":"2025-07-21T20:15:00","firstInstanceDateTimeUtc":"2025-07-21T19:15:00Z","lastInstanceDateTime":"2025-07-26T20:15:00","lastInstanceDateTimeUtc":"2025-07-26T19:15:00Z","altText":"","attribute_AudiencePreference1":"Stand Up","attribute_AudiencePreference2":"International","attribute_DynamicPricing":"Yes","attribute_PriorityBooking":false,"attribute_Venue":"Upstairs","attribute_WebsiteFilterCategory1":"Comedy","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":""},{"description":"Excited to return after her 9 sold out shows at Soho Theatre in November, Zainab Johnson is back and the audience gets to decide what she talks about! The Crowd Work Show is improvised standup inspired by audience suggestions. Nothing written, nothing planned, and no topic is off limits.\r\n16+","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"Zainab Johnson: A Crowd Work Show","instanceDates":"21 July-26 July","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"660203AVPCNLNJJTTBHKCSCJSVSKTCMKC","firstInstanceDateTime":"2025-07-21T20:15:00","firstInstanceDateTimeUtc":"2025-07-21T19:15:00Z","lastInstanceDateTime":"2025-07-26T20:15:00","lastInstanceDateTimeUtc":"2025-07-26T19:15:00Z","altText":"","attribute_AudiencePreference1":"Stand Up","attribute_AudiencePreference2":"International","attribute_DynamicPricing":"Yes","attribute_PriorityBooking":false,"attribute_Venue":"Upstairs","attribute_WebsiteFilterCategory1":"Comedy","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":""},{"description":"Following her hit debut stand-up special ‘Hijabs off’ on Amazon Prime, comedian, actress, and writer Zainab Johnson comes to the Soho Theatre for a strictly limited run.\r\nQuickly propelled as one of the most unique and engaging performers on stage and screen, Zainab explores her identity as a Black female Muslim with 13 siblings, growing up in Harlem, gun ownership, purchasing her first home, being too nice on dates, and revealing her toxic trait: Optimism. \r\n16+","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"Zainab Johnson: Live","instanceDates":"18 November-23 November","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"550603ADCSLKMNRHJTTGMMGBHJMQHMLTC","firstInstanceDateTime":"2024-11-18T19:15:00","firstInstanceDateTimeUtc":"2024-11-18T19:15:00Z","lastInstanceDateTime":"2024-11-23T21:15:00","lastInstanceDateTimeUtc":"2024-11-23T21:15:00Z","altText":"","attribute_AudiencePreference1":"Comedy","attribute_AudiencePreference2":"Stand Up","attribute_DynamicPricing":"Yes","attribute_PriorityBooking":false,"attribute_Venue":"Downstairs","attribute_WebsiteFilterCategory1":"Comedy","attribute_WebsiteFilterCategory2":"Stand Up","attribute_WebsiteFilterCategory3":""},{"description":"15+","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"Zakir Khan: Live","instanceDates":"31 July-31 July","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"636203AJTSVKMSTVPPSDMHTPTVCPRBHHM","firstInstanceDateTime":"2025-07-31T19:00:00","firstInstanceDateTimeUtc":"2025-07-31T18:00:00Z","lastInstanceDateTime":"2025-07-31T19:00:00","lastInstanceDateTimeUtc":"2025-07-31T18:00:00Z","altText":"","attribute_AudiencePreference1":"Comedy","attribute_AudiencePreference2":"India/South Asian heritage","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"Soho Theatre Walthamstow","attribute_WebsiteFilterCategory1":"Comedy","attribute_WebsiteFilterCategory2":"India/South Asian heritage","attribute_WebsiteFilterCategory3":"Stand Up"},{"description":"We are beyond thrilled to be bringing one of our favourite acts in the world back to London, the sublime Zakir Khan. He will be performing at the iconic Royal Albert Hall on 8th October. Please note this show will be performed in Hindi.\r\n\r\nZakir Khan is one of the most loved and celebrated stand-up comedians in India. From winning the title of ‘India’s Best Stand Up’ in a 2012 Comedy Central show to selling 100,000 tickets across 72 cities in 2019 alone, his has been an incredible journey.\r\n\r\nZakir’s approach to comedy is anecdotal, personal and heartfelt, and his delivery poetic and rustic at the same time. His appeal lies in his relatability – he has often said he used humour as a shield when bullied as a child, and his stories are punctuated with phrases that have become catchphrases, including the iconic ‘sakht launda’.\r\n16+","htmlDescription":"<div id>\r\n\r\n</div>","duration":105,"imageUrl":"","isOnSale":true,"name":"Zakir Khan: Live At The Royal Albert Hall","instanceDates":"8 October-8 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"491403ADVPQPLCCKQNLTVQTVMGDMKGJLM","firstInstanceDateTime":"2023-10-08T19:30:00","firstInstanceDateTimeUtc":"2023-10-08T18:30:00Z","lastInstanceDateTime":"2023-10-08T19:30:00","lastInstanceDateTimeUtc":"2023-10-08T18:30:00Z","altText":"","attribute_AudiencePreference1":"Comedy","attribute_AudiencePreference2":"India/South Asian heritage","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"Royal Albert Hall","attribute_WebsiteFilterCategory1":"Comedy","attribute_WebsiteFilterCategory2":"Stand Up","attribute_WebsiteFilterCategory3":"India/South Asian heritage"},{"description":"Zakir is back at Soho Theatre to try out his new show.\r\nWith over 7.7 million subscribers on YouTube, Zakir Khan is India’s biggest stand-up comic. He has sold over 100,000 tickets in the last 12 months globally, including a sell-out show at the iconic Royal Albert Hall in London.  \r\n\r\nPerformed in Hindi\r\n16+","htmlDescription":"<div id>\r\n\r\n</div>","duration":150,"imageUrl":"","isOnSale":true,"name":"Zakir Khan: Live Oct24","instanceDates":"19 October-20 October","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"572603ALLBTPVTKPCRCVVNPJMBJMHQRDD","firstInstanceDateTime":"2024-10-19T21:15:00","firstInstanceDateTimeUtc":"2024-10-19T20:15:00Z","lastInstanceDateTime":"2024-10-20T19:00:00","lastInstanceDateTimeUtc":"2024-10-20T18:00:00Z","altText":"","attribute_AudiencePreference1":"Comedy","attribute_AudiencePreference2":"Stand Up","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"Downstairs","attribute_WebsiteFilterCategory1":"Comedy","attribute_WebsiteFilterCategory2":"India/South Asian heritage","attribute_WebsiteFilterCategory3":""},{"description":"Through anecdotes packed with wit, emotion, and his signature poetic flair, Zakir brings to life the most relatable yet unsaid aspects of every Indian son's relationship with his father. \r\n\r\nPapa Yaar isn’t just a comedy show; it’s a celebration of fatherhood and the universal experiences that tie us all together. And this time, it’s more than just a performance—it’s an invitation to share the laughs and love with your own Papa. \r\n\r\nSo bring your Papa along and let Zakir’s stories remind you of all the reasons why your bond is special. Trust us, it’s a show both of you will cherish forever.\r\n\r\nPerformed in Hindi\r\n16+","htmlDescription":"<div id>\r\n\r\n</div>","duration":120,"imageUrl":"","isOnSale":true,"name":"Zakir Khan: Papa Yaar","instanceDates":"1 August-6 August","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"603603ATLTTMBGKNSNRLCCBBVRJCDQJMN","firstInstanceDateTime":"2025-08-01T18:30:00","firstInstanceDateTimeUtc":"2025-08-01T17:30:00Z","lastInstanceDateTime":"2025-08-06T18:30:00","lastInstanceDateTimeUtc":"2025-08-06T17:30:00Z","altText":"","attribute_DynamicPricing":"No","attribute_PriorityBooking":false,"attribute_Venue":"Downstairs","attribute_WebsiteFilterCategory1":"","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":"","attribute_AudiencePreference1":"","attribute_AudiencePreference2":""},{"description":"Strap in. Let’s go. Welcome to The Splash Zone. Known for award-winning, high-concept meta-comedy, this is Zoë stripped back: her funniest, most straight-shooting stand-up hour yet. A joyfully untethered ADHD stream of consciousness about leaning into discomfort and talking to strangers. Let's chat. You might've seen Zoë's Amazon Prime special or on Harry Hill's Club Nite (Channel 4). Zoë's performed at Netflix Is A Joke in LA and JFL Montreal, been nominated for Best Show in Edinburgh and won Best Show in Melbourne.","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"Zoe Coombs Marr : The Splash Zone","instanceDates":"4 February-7 February","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"663003AVKLQMLCNLTGGSVBDJJMLRNGGGL","firstInstanceDateTime":"2026-02-04T21:15:00","firstInstanceDateTimeUtc":"2026-02-04T21:15:00Z","lastInstanceDateTime":"2026-02-07T21:15:00","lastInstanceDateTimeUtc":"2026-02-07T21:15:00Z","altText":"","attribute_AudiencePreference1":"Stand Up","attribute_AudiencePreference2":"International","attribute_DynamicPricing":"Yes","attribute_PriorityBooking":false,"attribute_Venue":"Downstairs","attribute_WebsiteFilterCategory1":"Comedy","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":""},{"description":"This is a tell-all, personal storytelling comedy show.\r\nNothing fancy, no big concepts, it’s just going to cover every single thing in Zoë’s whole entire life. You might have seen Zoë on her Amazon Prime special or Harry Hill’s Club Nite (Channel 4). She’s performed at Netflix Is A Joke in LA, been nominated for Best Show at the Edinburgh Comedy Awards and won Best Show in Melbourne. Good on her. \r\n16+","htmlDescription":"<div id>\r\n\r\n</div>","duration":65,"imageUrl":"","isOnSale":true,"name":"Zoë Coombs Marr: Every Single Thing in My Whole Entire Life","instanceDates":"10 September-21 September","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"553203ALRKLTDKRHGQCVJDRMMSBMGPKQP","firstInstanceDateTime":"2024-09-10T19:15:00","firstInstanceDateTimeUtc":"2024-09-10T18:15:00Z","lastInstanceDateTime":"2024-09-21T19:15:00","lastInstanceDateTimeUtc":"2024-09-21T18:15:00Z","altText":"","attribute_AudiencePreference1":"Comedy","attribute_AudiencePreference2":"LGBTQ+","attribute_DynamicPricing":"Yes","attribute_PriorityBooking":true,"attribute_Venue":"Downstairs","attribute_WebsiteFilterCategory1":"Comedy","attribute_WebsiteFilterCategory2":"LGBTQ+","attribute_WebsiteFilterCategory3":""},{"description":"We regret to inform you that Dave is back. After entering a coma in 2016, now he’s woke and asking the big questions, like...  “anyone here from out of town?!”\r\nThe latest unmissable fiasco from comedy mastermind Zoë Coombs Marr, as seen on Channel 4 and her Amazon Prime special.\r\nWinner: Herald Angel Edinburgh Fringe 2019.\r\nWinner: Best Show, Melbourne Comedy Festival 2016.\r\nNominee: Best Show, Edinburgh Comedy Awards 2016.\r\n“A masterclass in meta humour.” ★★★★★ The Herald.\r\n“Daring, high-wire comedy at its best.” ★★★★★ Chortle.\r\n★★★★★ Mirror. ★★★★ Scotsman.\r\n16+","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"Zoë Coombs Marr: The Opener","instanceDates":"12 September-16 September","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"481603AQVTDMSTSSQRJDJQSGPVSSPCNJS","firstInstanceDateTime":"2023-09-12T21:30:00","firstInstanceDateTimeUtc":"2023-09-12T20:30:00Z","lastInstanceDateTime":"2023-09-16T21:30:00","lastInstanceDateTimeUtc":"2023-09-16T20:30:00Z","altText":"","attribute_AudiencePreference1":"Female Led","attribute_AudiencePreference2":"International","attribute_DynamicPricing":"Yes","attribute_PriorityBooking":false,"attribute_Venue":"Theatre","attribute_WebsiteFilterCategory1":"Comedy","attribute_WebsiteFilterCategory2":"LGBTQ+","attribute_WebsiteFilterCategory3":"Comedy"},{"description":"Take the “fun” out of “funeral” and throw the rest away! Zoe W (Gaulier trained American clown) is holding a funeral for her childhood dog, and you’re invited! Yay! Dressed in Victorian mourning garb and ready to cry on command, she’s here to teach you how to properly perform your grief. All she wants is your sympathy, your tears, and a goddamn glass of Pinot Grigio (please!). Sadness is Zoe's passion and this dog was Zoe's best friend. It's gonna be a rough one, so join the solemn ceremony and pay your respects with the good boys (may they rest in peace) “A hilariously unconventional take on grief... masterfully orchestrated.” Cog Journal “Prima Donna of the Absurd.” Gutter Comedy. 16+","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"Zoe Wohlfeld: DOG FUNERAL","instanceDates":"10 September-12 September","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"734203ANVHKRRDRBMSSGLTQNDMDPVTKCP","firstInstanceDateTime":"2026-09-10T22:30:00","firstInstanceDateTimeUtc":"2026-09-10T21:30:00Z","lastInstanceDateTime":"2026-09-12T22:30:00","lastInstanceDateTimeUtc":"2026-09-12T21:30:00Z","altText":"","attribute_AudiencePreference1":"Comedy","attribute_AudiencePreference2":"Clowning","attribute_DynamicPricing":"Yes","attribute_PriorityBooking":false,"attribute_Venue":"Upstairs","attribute_WebsiteFilterCategory1":"Comedy","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":""},{"description":"Take the “fun” out of “funeral” and throw the rest away!\r\n Zoe W (Gaulier trained American clown) is holding a funeral for her childhood dog, and you’re invited! Yay! Dressed in Victorian mourning garb and ready to cry on command, she’s here to teach you how to properly perform your grief. All she wants is your sympathy, your tears, and a goddamn glass of Pinot Grigio (please!). Sadness is Zoe's passion and this dog was Zoe's best friend. It's gonna be a rough one, so join the solemn ceremony and pay your respects with the good boys (may they rest in peace)\r\n16+","htmlDescription":"<div id>\r\n\r\n</div>","duration":60,"imageUrl":"","isOnSale":true,"name":"Zoe Wohlfeld: DOG FUNERAL : June","instanceDates":"6 June-6 June","thumbnailUrl":"","webUrl":"","webEventId":null,"id":"713004ACTSJMHLGRJRPTMRPRDLJHJRTPJ","firstInstanceDateTime":"2026-06-06T20:30:00","firstInstanceDateTimeUtc":"2026-06-06T19:30:00Z","lastInstanceDateTime":"2026-06-06T20:30:00","lastInstanceDateTimeUtc":"2026-06-06T19:30:00Z","altText":"","attribute_AudiencePreference1":"Comedy","attribute_AudiencePreference2":"Clowning","attribute_DynamicPricing":"Yes","attribute_PriorityBooking":false,"attribute_Venue":"Upstairs","attribute_WebsiteFilterCategory1":"Comedy","attribute_WebsiteFilterCategory2":"","attribute_WebsiteFilterCategory3":""}]