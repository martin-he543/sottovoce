ow_cta":false,"goal_adj_bid":0.0025},"primary_venue":{"user_id":"2685090431171","name":"Dabbers Social Bingo City","address":{"city":"London","country":"GB","region":"England","longitude":"-0.07760199999999999","localized_address_display":"18 - 22 Houndsditch, London, EC3A 7DB","postal_code":"EC3A 7DB","address_1":"18 - 22 Houndsditch","address_2":"","latitude":"51.5144569","localized_multi_line_address_display":["18 - 22 Houndsditch","London","EC3A 7DB"],"localized_area_display":"London"},"organizer_id":"108816604281","google_place_id":"ChIJ-1RjuH0DdkgRkksA-TCRT94","id":"299539931"},"primary_organizer":{"website":"https://www.eventbrite.co.uk/o/shai-guy-events-108816483441","organization_id":"2685090431171","_type":"organizer","user_id":"2685090431171","description":{"text":"Zero chill, 100% Bollywood."},"followed_by_you":false,"url":"https://www.eventbrite.co.uk/o/shai-guy-events-108816483441","twitter":"","long_description":{"text":"Welcome to Shai Guy Events, the home of the UK\u2019s most vibrant, high-energy Bollywood experiences!We believe that the best parties don't need to wait until midnight. But more importantly, we believe in parties without the attitude. We are not the place for the \"sexy and mysterious,\" and we certainly aren't a party where people just stand around to watch and be watched.We are the place to let your hair down, go crazy, dance senseless, and scream the lyrics to your favourite old-school anthems AND new bangers with old friends AND new ones.Everyone is WelcomeOur dancefloor is a safe, completely inclusive space. Regardless of your nationality, sexual orientation, age, or background\u2014you belong here. At our events, everyone in the room might be different, but we are all dancing to the same beat.Our Signature Events Include:Bollyday:The UK\u2019s #1 strictly Bollywood daytimer party. Famous for our epic seasonal themes like BollyDil (Valentine\u2019s), BollyChella (our festival takeover), BollyXmas, and the legendary Bollyday of the Dead.Bollywood Bingo:The UK\u2019s rowdiest, most masala-filled bingo night! Expect wild prizes, hilarious hosts, and non-stop Bollywood chaos.Bollyday Express:Taking the magic of our sold-out London daytimers to cities all across the UK.Whether you\u2019re screaming \"Full House!\" at Bingo, dancing to Sheila Ki Jawani at 4 PM, or bringing your ultimate festival fit to BollyChella, you are guaranteed an unforgettable time in a room full of good energy.Don't Miss A Beat!Hit the Follow button on our Eventbrite page to get instant alerts for our newest ticket drops, exclusive early-bird discounts, and massive event announcements."},"logo_id":"1178746650","num_followers":179,"num_future_events":0,"is_saved":true,"num_past_events":0,"disable_marketing_opt_in":false,"id":"108816483441","name":"Shai Guy Events"},"ticket_availability":{"start_sales_date":{"timezone":"Europe/London","local":"2026-09-06T00:00:00","utc":"2026-09-05T23:00:00Z"},"quantity_sold_add_on":0,"minimum_ticket_price_rounded":{"currency":"GBP","display":"23 GBP","value":2300},"quantity_sold_paid":0,"remaining_capacity":298,"end_sales_date":{"timezone":"Europe/London","local":"2026-11-20T17:30:00","utc":"2026-11-20T17:30:00Z"},"num_ticket_classes":11,"has_available_hidden_tickets":false,"maximum_ticket_price":{"currency":"GBP","display":"33.22 GBP","value":3322},"minimum_ticket_price":{"currency":"GBP","display":"23.46 GBP","value":2346},"is_free":false,"maximum_ticket_price_rounded":{"currency":"GBP","display":"33 GBP","value":3300},"is_hold_unavailable":false,"waitlist_enabled":false,"has_bogo_tickets":false,"has_available_tickets":true,"common_sales_end_date":null,"is_sold_out":false,"waitlist_available":false,"quantity_sold_free":0,"quantity_sold":0,"open_discount":null},"urgency_signals":{"messages":[],"categories":[]},"image_large":{"edge_color_set":true,"edge_color":"#a97d4e","url":"https://img.evbuc.com/https%3A%2F%2Fcdn.evbuc.com%2Fimages%2F1179769088%2F2685090400961%2F1%2Foriginal.20260313-1