tbrite.co.uk/e/bollywood-bingo-diwali-special-tickets-2002083343174","hide_start_date":false,"hide_end_date":true,"summary":"Get ready for a fun\u2011filled night at Bollywood Bingo\u2014where classic bingo meets the colour, music, and playful chaos of Bollywood!","is_online_event":false,"eid":"2002083343174","id":"2002083343174","published":"2026-09-22T17:15:26Z","privacy_setting":"unlocked","primary_organizer_id":"108816483441","is_series":false,"timezone":"Europe/London","start_date":"2026-11-20","start_time":"18:30","end_date":"2026-11-20","end_time":"23:59","tags":[],"eventbrite_event_id":"2002083343174","promoted_listing_metadata":{"ad_id":"491113","is_promoted_event":true,"placement_id":"a40d6d51-5a02-40dc-81ee-515e514ec9ba","campaign_id":"491113","experiments":[],"index_in_results":0,"include_follow_cta":false,"goal_adj_bid":0.0025},"primary_venue":{"user_id":"2685090431171","name":"Dabbers Social Bingo City","address":{"city":"London","country":"GB","region":"England","longitude":"-0.07760199999999999","localized_address_display":"18 - 22 Houndsditch, London, EC3A 7DB","postal_code":"EC3A 7DB","address_1":"18 - 22 Houndsditch","address_2":"","latitude":"51.5144569","localized_multi_line_address_display":["18 - 22 Houndsditch","London","EC3A 7DB"],"localized_area_display":"London"},"organizer_id":"108816604281","google_place_id":"ChIJ-1RjuH0DdkgRkksA-TCRT94","id":"299539931"},"primary_organizer":{"website":"https://www.eventbrite.co.uk/o/shai-guy-events-108816483441","organization_id":"2685090431171","_type":"organizer","user_id":"2685090431171","description":{"text":"Zero chill, 100% Bollywood."},"followed_by_you":false,"url":"https://www.eventbrite.co.uk/o/shai-guy-events-108816483441","twitter":"","long_description":{"text":"Welcome to Shai Guy Events, the home of the UK\u2019s most vibrant, high-energy Bollywood experiences!We believe that the best parties don't need to wait until midnight. But more importantly, we believe in parties without the attitude. We are not the place for the \"sexy and mysterious,\" and we certainly aren't a party where people just stand around to watch and be watched.We are the place to let your hair down, go crazy, dance senseless, and scream the lyrics to your favourite old-school anthems AND new bangers with old friends AND new ones.Everyone is WelcomeOur dancefloor is a safe, completely inclusive space. Regardless of your nationality, sexual orientation, age, or background\u2014you belong here. At our events, everyone in the room might be different, but we are all dancing to the same beat.Our Signature Events Include:Bollyday:The UK\u2019s #1 strictly Bollywood daytimer party. Famous for our epic seasonal themes like BollyDil (Valentine\u2019s), BollyChella (our festival takeover), BollyXmas, and the legendary Bollyday of the Dead.Bollywood Bingo:The UK\u2019s rowdiest, most masala-filled bingo night! Expect wild prizes, hilarious hosts, and non-stop Bollywood chaos.Bollyday Express:Taking the magic of our sold-out London daytimers to cities all across the UK.Whether you\u2019re screaming \"Full House!\" at Bingo, dancing to Sheila Ki Jawani at 4 PM, or bringing your ultimate festival fit to BollyChella, you are guaranteed an unforgettable time in a room full of good energy.Don't Miss A Beat!Hit the Follow button on our Eventbrite page to get instant alerts for our newest ticket drops, exclusive early-bird discounts, and massive event announcements."},"logo_id":"1178746650","num_followers":179,"num_future_events":0,"is_saved":true,"num_past_events":0,"disable_marketing_opt_in":false,"id":"108816483441","name":"Shai Guy Events"},"ticket_availability":{"start_sales_date":{"timezone":"Europe/London","local":"2026-09-06T00:00:00","utc":"2026-09-05T23:00:00Z"},"quantity_sold_add_on":0,"minimum_ticket_price_rounded":{"currency":"GBP","display":"23 GBP","value":2300},"quantity_sold_paid":0,"remaining_capacity":298,"end_sales_date":{"timezone":"Europe/London","local":"2026-11-20T17:30:00","ut