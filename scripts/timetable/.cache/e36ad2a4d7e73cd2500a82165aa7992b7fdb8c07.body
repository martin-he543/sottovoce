            <div class="o-layout__item u-1/2@tablet">

                <h1 class="c-prod__heading">Highlights of Verdi’s Don Carlo</h1>

                <div class="c-prod__meta">

                    
                                            <p class="c-prod__date"><span>Tuesday 24 November 2026, 7pm</span></p>
                    
                    
                                            <p class="c-prod__prices">
