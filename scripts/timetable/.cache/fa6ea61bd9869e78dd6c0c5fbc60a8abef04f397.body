        <script>
            function resize() {
                const tolerance = 60;

                let vh = window.innerHeight * 0.01;
                document.documentElement.style.setProperty('--vh', `${ vh }px`);
                let lastHeight = window.innerHeight;

                let vw = window.innerWidth * 0.01;
                document.documentElement.style.setProperty('--vw', `${ vw }px`);
                let lastWidth = window.innerWidth;

                if (document.querySelector('.site-header')) {
                    const headerHeight = document.querySelector('.site-header');
                    let offsetHeight = 0;

                    if (headerHeight) {
                        offsetHeight = headerHeight.offsetHeight;
                    } else {
                        offsetHeight = 100;
                    }
                    document.documentElement.style.setProperty('--header-height', `${ offsetHeight }px`);
                }

                const resizeVars = () => {
                    if (Math.abs(lastHeight - window.innerHeight) > tolerance) {
                        vh = window.innerHeight * 0.01;
                        document.documentElement.style.setProperty('--vh', `${ vh }px`);
                        lastHeight = window.innerHeight;
                    }

                    if (lastWidth !== window.innerWidth) {
                        vw = window.innerWidth * 0.01;
                        document.documentElement.style.setProperty('--vw', `${ vw }px`);
                        lastWidth = window.innerWidth;
                    }

                    if (document.querySelector('.site-header')) {
                        const headerHeight = document.querySelector('.site-header');
                        let offsetHeight = 0;

                        if (headerHeight) {
                            offsetHeight = headerHeight.offsetHeight;
                        } else {
                            offsetHeight = 100;
                        }
                        document.documentElement.style.setProperty('--header-height', `${ offsetHeight }px`);
                    }
                };
                window.addEventListener('resize', () => {
                    resizeVars();
                });
                setTimeout(function() {
                    resizeVars();
                }, 100);
            }

            // Generic dataLayer push for any element with data-event.
            // Collects all data-* attributes and pushes them as a dataLayer event.
            // Works with dynamically loaded content (delegated on document).
            document.addEventListener('click', function(e) {
                var el = e.target.closest('[data-event]');
                if (!el) return;
                var d = el.dataset;
                var payload = { event: d.event };
                for (var key in d) {
                    if (key !== 'event') payload[key] = d[key];
                }
                window.dataLayer = window.dataLayer || [];
                window.dataLayer.push(payload);

                // Push GA4 select_item ecommerce event for card clicks
                if (d.event === 'card_click' && d.postId) {
                    var price = d.minPrice ? parseFloat(d.minPrice) : 0;
                    var genres = (d.genres || '').split(',').filter(Boolean);
                    var item = {
                        item_id: d.postId,
                        item_name: d.name || '',
                        price: price,
                        quantity: 1,
                        discount: d.discount ? parseInt(d.discount, 10) : 0
                    };
                    genres.forEach(function(g, i) {
                        item[i === 0 ? 'item_category' : 'item_category' + (i + 1)] = g.trim();
                    });
                    window.dataLayer.push({ ecommerce: null });
                    window.dataLayer.push({
                        event: 'select_item',
                        ecommerce: {
                            currency: 'GBP',
                            value: price,
                            items: [item]
                        }
                    });
                }
            });

            document.addEventListener('DOMContentLoaded', function() {
                resize();

                var header = document.querySelector('.site-header');
                if (!header) return;

                var THRESHOLD = 500;
                var DOWN_BUFFER = 50;
                var HIDDEN = 'site-header--hidden';
                var SCROLLED = 'site-header--scrolled';
                var lastY = window.scrollY;
                var dirChangeY = window.scrollY;
                var wasGoingDown = false;
                var ticking = false;

                function onScroll() {
                    var y = window.scrollY;
                    var goingDown = y > lastY;

                    if (!document.body.classList.contains('site-navigation--open')) {
                        // Track direction changes for the down-scroll buffer
                        if (goingDown && !wasGoingDown) {
                            dirChangeY = y;
                        }

                        if (y <= THRESHOLD) {
                            header.classList.remove(HIDDEN);
                            header.classList.remove(SCROLLED);
                        } else if (goingDown && y - dirChangeY > DOWN_BUFFER) {
                            header.classList.add(HIDDEN);
                        } else if (!goingDown) {
                            header.classList.remove(HIDDEN);
                            header.classList.add(SCROLLED);
                        }
                    }

                    wasGoingDown = goingDown;
                    lastY = y;
                    ticking = false;
                }

                window.addEventListener('scroll', function() {
                    if (!ticking) {
                        requestAnimationFrame(onScroll);
                        ticking = true;
                    }
                }, { passive: true });
            });

        </script>

