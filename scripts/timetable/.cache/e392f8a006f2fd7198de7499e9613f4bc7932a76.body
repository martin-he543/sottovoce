            <h1 class="show-details__title ">
              Global Majority                              <span class="show-details__title-tickets flex">
                  <span class="show-details__title-tickets-icon icon">
                            <div class="farlo-ui-icons__icon-container farlo-ui-icons__icon-container--ticket" style="--size:3;--fill:var(--global-primary-text-colour)">
