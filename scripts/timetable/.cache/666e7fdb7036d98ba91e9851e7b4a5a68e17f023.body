								        <script id="arcola-consent-foundation">
window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('consent', 'default', {
	ad_storage:             'denied',
	ad_user_data:           'denied',
	ad_personalization:     'denied',
	analytics_storage:      'denied',
	functionality_storage:  'denied',
	personalization_storage:'denied',
	security_storage:       'granted',
	wait_for_update:        500
});
gtag('set', 'ads_data_redaction', true);
</script>
<script id="arcola-consent-replay">
(function(){
	try {
		var m = document.cookie.match(/(?:^|;\s*)cc_cookie=([^;]+)/);
		if (!m) return;
		var cc = JSON.parse(decodeURIComponent(m[1]));
		if (!cc || !Array.isArray(cc.categories)) return;
		var cats = cc.categories;
		var adv = cats.indexOf('advertising') > -1;
		var ana = cats.indexOf('analytics')   > -1;
		var fn  = cats.indexOf('functional')  > -1;
		gtag('consent','update', {
			ad_storage:              adv ? 'granted' : 'denied',
			ad_user_data:            adv ? 'granted' : 'denied',
			ad_personalization:      adv ? 'granted' : 'denied',
			analytics_storage:       ana ? 'granted' : 'denied',
			functionality_storage:   fn  ? 'granted' : 'denied',
			personalization_storage: fn  ? 'granted' : 'denied',
			security_storage:        'granted'
		});
	} catch(e) { /* swallow: leave defaults denied */ }
})();
</script>
