                                                                    data-srcset="https://images.almeida.co.uk/uploads/2026/06/Jason-Barnett.jpg?resize=150%2C150&gravity 150w, https://images.almeida.co.uk/uploads/2026/06/Jason-Barnett.jpg?resize=10%2C10&gravity 10w, https://images.almeida.co.uk/uploads/2026/06/Jason-Barnett.jpg?resize=300%2C300&gravity 300w, https://images.almeida.co.uk/uploads/2026/06/Jason-Barnett.jpg?resize=450%2C450&gravity 450w, https://images.almeida.co.uk/uploads/2026/06/Jason-Barnett.jpg?resize=600%2C600&gravity 600w, https://images.almeida.co.uk/uploads/2026/06/Jason-Barnett.jpg?resize=900%2C900&gravity 900w, https://images.almeida.co.uk/uploads/2026/06/Jason-Barnett.jpg?resize=400%2C400&gravity 400w"
