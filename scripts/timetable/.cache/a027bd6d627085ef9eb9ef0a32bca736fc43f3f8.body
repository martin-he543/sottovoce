ight-100/TikTok.svg","width":22},"url":"https://www.tiktok.com/@wigmore_hall"}],"copyright":"© Wigmore Hall 2026 | Company Registered in England No. 2754525 • Charity No. 1024838 • VAT No. 625680628","highlightedMessage":"<p data-block-key=\"l70xq\">Box Office — 020 7935 2141</p>","donationHeading":"Donate","donationDescription":"<p data-block-key=\"10dop\">Please give in support of our Audience Fund, thank you</p>","donationCategory":{"id":"RG9uYXRpb25DYXRlZ29yeTo0","title":"Audience Fund","heading":"Thank you for your support.","description":"<p data-block-key=\"pt1n9\">Please select your donation amount and payment method from the options below.</p><p data-block-key=\"3l2mk\">To set up an annually recurring gift or to split your donation across 12 monthly instalments select ‘Pay by Direct Debit’ – applicable for UK bank accounts only.</p>","fundId":"122","onAccountId":null,"amounts":[30,50,150,500,1000],"minimumAmount":1,"allowOtherAmount":true,"callToAction":"Donate","displayDirectDebitButton":true,"requireLogin":true,"subcategories":[]},"newsletterHeading":"Stay in touch","newsletterDescription":"<p data-block-key=\"vw1tp\">We will send you only one or two emails each week, highlighting forthcoming concerts, special events, live streams and news.</p>"},"codeSnippet":{"id":"Q29kZVNuaXBwZXQ6MQ==","code":"<\!-- Matomo -->\r\n<script>\r\n  var _paq = window._paq = window._paq || [];\r\n  /* tracker methods like \"setCustomDimension\" should be called before \"trackPageView\" */\r\n  _paq.push(['requireCookieConsent']);\r\n  _paq.push([\"setDoNotTrack\", true]);\r\n  _paq.push([\"setExcludedQueryParams\", [\"email\",\"password\"]]);\r\n  _paq.push([\"setExcludedReferrers\", [\"wigmore-hall.org.uk\\/administrator\"]]);\r\n  _paq.push(['trackPageView']);\r\n  _paq.push(['enableLinkTracking']);\r\n  (function() {\r\n    var u=\"https://wigmorehall.matomo.cloud/\";\r\n    _paq.push(['setTrackerUrl', u+'matomo.php']);\r\n    _paq.push(['setSiteId', '2']);\r\n    var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];\r\n    g.async=true; g.src='https://cdn.matomo.cloud/wigmorehall.matomo.cloud/matomo.js'; s.parentNode.insertBefore(g,s);\r\n  })();\r\n<\/script>\r\n<noscript><p><img src=\"https://matomo.wigmore-hall.org.uk/matomo.php?idsite=2&amp;rec=1\" style=\"border:0;\" alt=\"\" /></p></noscript>\r\n<\!-- End Matomo Code -->\r\n<script>\r\nvar waitForTrackerCount = 0;\r\nfunction matomoWaitForTracker() {\r\n  if (typeof _paq === 'undefined' || typeof Cookiebot === 'undefined') {\r\n    if (waitForTrackerCount < 40) {\r\n      setTimeout(matomoWaitForTracker, 250);\r\n      waitForTrackerCount++;\r\n      return;\r\n    }\r\n  } else {\r\n    window.addEventListener('CookiebotOnAccept', function (e) {\r\n        consentSet();\r\n    });\r\n    window.addEventListener('CookiebotOnDecline', function (e) {\r\n        consentSet();\r\n    })\r\n  }\r\n}\r\nfunction consentSet() {\r\n  if (Cookiebot.consent.statistics) {\r\n    _paq.push(['setCookieConsentGiven']);\r\n    _paq.push(['setConsentGiven']);\r\n  } else {\r\n    _paq.push(['forgetCookieConsentGiven']);\r\n    _paq.push(['forgetConsentGiven']);\r\n  }\r\n}\r\ndocument.addEventListener('DOMContentLoaded', matomoWaitForTracker());\r\n<\/script>"},"newsletterSignupSettings":{"confirmedMessage":"You have successfully subscribed to our newsletter."},"popupNewsletterSignup":{"newsletterHeading":"Email Newsletter","newsletterDescription":"<p data-block-key=\"8jgt0\">Sign up to our twice-weekly digest of world-class live concerts, events, live streams and news.</p>","fundraisingCheckboxLabel":"Please send me emails about campaigns, memberships and support","timer":"3000","disclaimerText":"<p data-block-key=\"iywzq\">Your personal data will be processed as described in our <a href=\"https://www.wigmore-hall.org.uk/box-office-help/policies-terms-and-conditions/privacy-notice\">Privacy Notice</a>.</p>","disablePopup":false},"uri":"whats-on","siteCopy":[{"id":"U2l0ZUNvcHk6MQ==","key":"PRIVACY_NOTICE","richText":"<p>Your personal data will be processed as described in our <a href=\"/box-office-help/policies-terms-and-conditions/privacy-policy\">Privacy Notice</a>.</p>","plainText":"Your personal data will be processed as described in our Privacy Notice."},{"id":"U2l0ZUNvcHk6Mw==","key":"REGISTER_NOTICE","richText":"<p data-block-key=\"4og2d\">Already have an account? <a href=\"/login\">Sign in.</a><br/>Your personal data will be processed as described in our <a href=\"/box-office-help/policies-terms-and-conditions/privacy-notice\">Privacy Notice</a>.</p>","plainText":"Already have an account? Sign in.Your personal data will be processed as described in our Privacy Notice."},{"id":"U2l0ZUNvcHk6Ng==","key":"LEGACY_MEMBERSHIP_DONATION_DISABLED_MESSAGE","richText":"<p data-block-key=\"6vpc1\">This donation option is not available online for Supporter Friend members. Please contact the Friends office directly to make this donation.</p>","plainText":"This donation option is not available online for Supporter Friend members. Please contact the Friends office directly to make this donation."},{"id":"U2l0ZUNvcHk6NQ==","key":"LEGACY_MEMBERSHIP_MESSAGE_AFTER","richText":"<p data-block-key=\"wvxl9\">If you need help with your Supporter Friends membership, please get in touch with the Membership Office.</p>","plainText":"If you need help with your Supporter Friends membership, please get in touch with the Membership Office."},{"id":"U2l0ZUNvcHk6NA==","key":"LEGACY_MEMBERSHIP_MESSAGE_BEFORE","richText":"<p data-block-key=\"xsabv\">From 1 September 2026, Supporter Friends memberships can no longer be managed online. Please contact the Membership Office directly to renew, upgrade, or make any other changes to your membership.</p>","plainText":"From 1 September 2026, Supporter Friends memberships can no longer be managed online. Please contact the Membership Office directly to renew, upgrade, or make any other changes to your membership."},{"id":"U2l0ZUNvcHk6Mg==","key":"PAYMENT_TOKENISATION_NOTICE","richText":"<p data-block-key=\"lnaap\">We do not hold your payment card data. We use payment tokenisation, a process where an organisation holds a unique identifier which has no exploitable value if breached. You can read more <a href=\"https://en.wikipedia.org/wiki/Payment_tokenization\" rel=\"noopener noreferrer\" target=\"_blank\">here</a>.</p>","plainText":"We do not hold your payment card data. We use payment tokenisation, a process where an organisation holds a unique identifier which has no exploitable value if breached. You can read more here."}]},"shouldRenderPage":true,"domain":"https://www.wigmore-hall.org.uk","location":"http://www.wigmore-hall.org.uk/whats-on?startDate=2027-02-26&page=5","pageComponent":"UnionPage","timezone":"Europe/London","userAgent":{"family":"Other","major":"0","minor":"0","patch":"0","device":{"family":"Other","major":"0","minor":"0","patch":"0"},"os":{"family":"Other","major":"0","minor":"0","patch":"0"}},"dev":false}</script>
