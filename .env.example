# GEMINI_API_KEY: Required for Gemini AI API calls (gemini-4-argon at thinking_level "low"; gemini-3.8-flash only as a fallback).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# MONGODB_URI: Optional MongoDB Atlas connection string (mongodb+srv://...).
# When omitted, sottovoce runs its built-in MongoDB Atlas $rankFusion & 2dsphere engine in-memory.
MONGODB_URI=""

# Accounts (sign-in + cross-device sync of saved events, history and taste) need MONGODB_URI above.
# BETTER_AUTH_SECRET: long random string signing sessions, e.g. `openssl rand -base64 32`. APP_URL (above) must be the public URL.
# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET: optional "Continue with Google"; redirect URI is {APP_URL}/api/auth/callback/google.
BETTER_AUTH_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# VOYAGE_API_KEY: Optional Voyage AI API key for voyage-3 / voyage-multimodal-3 embeddings.
VOYAGE_API_KEY=""

# ZERO-KEY OPEN CIVIC DATA SOURCES (No API key required):
# - OpenStreetMap Overpass API: https://overpass-api.de/api/interpreter
# - Open-Meteo Weather & Air Quality API: https://api.open-meteo.com/v1/forecast
# - UK Environment Agency Flood Monitoring API: https://environment.data.gov.uk/flood-monitoring
# - iNaturalist & GBIF Urban Biodiversity API: https://api.inaturalist.org/v1/observations
# - London Datastore Cultural & Refill Infrastructure: https://data.london.gov.uk

# CORS_ALLOWED_ORIGINS: Extra comma-separated origins allowed to call /api (the Tauri app origins are built in).
CORS_ALLOWED_ORIGINS=""

# VITE_API_BASE_URL: Build-time only. Backend URL the native (Tauri) apps call for /api/*,
# e.g. https://sottovoce.example.com. Leave empty for the web build (same origin) — native apps then run on seed data.
VITE_API_BASE_URL=""

# LASTFM_API_KEY: Free key from https://www.last.fm/api/account/create. Needed for the Taste tab — last.fm serves a
# bot-check page to plain page requests, so profiles are read through the official API instead.
# LASTFM_DEFAULT_USER is the profile loaded when the Taste tab opens.
LASTFM_API_KEY=""
LASTFM_DEFAULT_USER="martinhe543"

# Timetable aggregator sources (scripts/timetable, `npm run timetable`). Each is skipped when its key is empty.
# TICKETMASTER_API_KEY: free consumer key from https://developer.ticketmaster.com/ (Discovery API).
# SEATGEEK_CLIENT_ID: free client id from https://seatgeek.com/account/develop.
# SKIDDLE_API_KEY: free key from https://www.skiddle.com/api/join.php.
TICKETMASTER_API_KEY=""
SEATGEEK_CLIENT_ID=""
SKIDDLE_API_KEY=""

# SPOTIFY_CLIENT_ID / SPOTIFY_CLIENT_SECRET: free app from https://developer.spotify.com/dashboard. Lets the Spotify dock
# search tracks and play them in an embedded player; without them the dock offers a link to Spotify's own search.
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
